# Estimates: rec_per_key and ranges follow the data
##################################################################
SELECT INDEX_NAME, SEQ_IN_INDEX, COLUMN_NAME, CARDINALITY FROM information_schema.STATISTICS WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 'm2' ORDER BY INDEX_NAME, SEQ_IN_INDEX;
INDEX_NAME	SEQ_IN_INDEX	COLUMN_NAME	CARDINALITY
clock_idx	1	clock	NULL
host_item_clock	1	hostid	4
host_item_clock	2	itemid	61
host_item_clock	3	clock	9005
DROP TABLE m, i, m2, i2;
DROP PROCEDURE moosedb_compact;
DROP PROCEDURE moosedb_apply_retention;
DROP FUNCTION moosedb_compact_impl;
DROP FUNCTION moosedb_retention_impl;
