##################################################################
# DDL: which indexes are accepted
##################################################################
# TAG columns followed by the time column, any number of them
CREATE TABLE a1 (clock INT NOT NULL, itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', value DOUBLE,
INDEX clock_idx (clock), INDEX item_clock (itemid, clock))
ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
SHOW CREATE TABLE a1;
Table	Create Table
a1	CREATE TABLE `a1` (
  `clock` int(11) NOT NULL,
  `itemid` bigint(20) unsigned NOT NULL COMMENT 'TAG',
  `value` double DEFAULT NULL,
  KEY `clock_idx` (`clock`),
  KEY `item_clock` (`itemid`,`clock`)
) ENGINE=MooseDB DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci `TIMESTAMP_COLUMN`='clock'
SHOW INDEX FROM a1;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Ignored
a1	1	clock_idx	1	clock	A	NULL	NULL	NULL		TSIDX			NO
a1	1	item_clock	1	itemid	A	NULL	NULL	NULL		TSIDX			NO
a1	1	item_clock	2	clock	A	NULL	NULL	NULL		TSIDX			NO
CREATE TABLE a2 (ts DATETIME NOT NULL, host VARCHAR(20) NOT NULL COMMENT 'TAG', item INT NOT NULL COMMENT 'TAG',
v INT, INDEX (ts), INDEX (host, item, ts), INDEX (item, host, ts), INDEX (host, ts))
ENGINE=MooseDB;
# TAG columns without the time column
CREATE TABLE a3 (ts TIMESTAMP NOT NULL, host CHAR(8) NOT NULL COMMENT 'TAG', item SMALLINT NOT NULL COMMENT 'TAG',
INDEX (ts), INDEX (host), INDEX (host, item))
ENGINE=MooseDB;
# The indexes survive ALTER TABLE ... ADD/DROP INDEX
ALTER TABLE a3 DROP INDEX host, ADD INDEX (item, host, ts);
SHOW INDEX FROM a3;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Ignored
a3	1	ts	1	ts	A	NULL	NULL	NULL		TSIDX			NO
a3	1	host_2	1	host	A	NULL	NULL	NULL		TSIDX			NO
a3	1	host_2	2	item	A	NULL	NULL	NULL		TSIDX			NO
a3	1	item	1	item	A	NULL	NULL	NULL		TSIDX			NO
a3	1	item	2	host	A	NULL	NULL	NULL		TSIDX			NO
a3	1	item	3	ts	A	NULL	NULL	NULL		TSIDX			NO
DROP TABLE a1, a2, a3;
# UNIQUE / PRIMARY (all TAGs, time) is accepted (primary_key.test); a key without the time is refused
CREATE TABLE e (clock INT NOT NULL, itemid BIGINT NOT NULL COMMENT 'TAG', INDEX (clock), UNIQUE (itemid)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: index 'itemid' is not supported: must include the timestamp column after the TAG columns. A MooseDB UNIQUE/PRIMARY key is (every TAG column, the timestamp column [, up to 2 integer NOT NULL columns]), e.g. PRIMARY KEY (itemid, clock, ns)
# Refused: the time column must be the last part
CREATE TABLE e (clock INT NOT NULL, itemid BIGINT NOT NULL COMMENT 'TAG', INDEX (clock), INDEX (clock, itemid)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: index 'clock_2' is not supported: column 'clock' (the timestamp) must be the last part. MooseDB indexes the timestamp column alone, or TAG columns optionally followed by the timestamp (INDEX (itemid, clock))
# Refused: a part that is neither a TAG nor the time column
CREATE TABLE e (clock INT NOT NULL, itemid BIGINT NOT NULL COMMENT 'TAG', v INT NOT NULL, INDEX (clock), INDEX (itemid, v)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: index 'itemid' is not supported: column 'v' is not a TAG column or the timestamp column. MooseDB indexes the timestamp column alone, or TAG columns optionally followed by the timestamp (INDEX (itemid, clock))
CREATE TABLE e (clock INT NOT NULL, itemid BIGINT NOT NULL COMMENT 'TAG', v INT NOT NULL, INDEX (clock), INDEX (itemid, v, clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: index 'itemid' is not supported: column 'v' is not a TAG column or the timestamp column. MooseDB indexes the timestamp column alone, or TAG columns optionally followed by the timestamp (INDEX (itemid, clock))
# Refused: TAG columns of an unsupported type, or only partly indexed
CREATE TABLE e (clock INT NOT NULL, itemid BIGINT COMMENT 'TAG', INDEX (clock), INDEX (itemid, clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR 42000: Table handler doesn't support NULL in given index. Please change column 'itemid' to be NOT NULL or use another handler
CREATE TABLE e (clock INT NOT NULL, d DOUBLE NOT NULL COMMENT 'TAG', INDEX (clock), INDEX (d, clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: index 'd' is not supported: TAG column 'd' must be an integer, CHAR or VARCHAR to be indexed. MooseDB indexes the timestamp column alone, or TAG columns optionally followed by the timestamp (INDEX (itemid, clock))
CREATE TABLE e (clock INT NOT NULL, d DECIMAL(10,2) NOT NULL COMMENT 'TAG', INDEX (clock), INDEX (d)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: index 'd' is not supported: TAG column 'd' must be an integer, CHAR or VARCHAR to be indexed. MooseDB indexes the timestamp column alone, or TAG columns optionally followed by the timestamp (INDEX (itemid, clock))
CREATE TABLE e (clock INT NOT NULL, y YEAR NOT NULL COMMENT 'TAG', INDEX (clock), INDEX (y)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: index 'y' is not supported: TAG column 'y' must be an integer, CHAR or VARCHAR to be indexed. MooseDB indexes the timestamp column alone, or TAG columns optionally followed by the timestamp (INDEX (itemid, clock))
CREATE TABLE e (clock INT NOT NULL, e ENUM('a','b') NOT NULL COMMENT 'TAG', INDEX (clock), INDEX (e)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: index 'e' is not supported: TAG column 'e' must be an integer, CHAR or VARCHAR to be indexed. MooseDB indexes the timestamp column alone, or TAG columns optionally followed by the timestamp (INDEX (itemid, clock))
CREATE TABLE e (clock INT NOT NULL, t TEXT NOT NULL COMMENT 'TAG', INDEX (clock), INDEX (t(8))) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR 42000: BLOB column `t` can't be used in key specification in the MooseDB table
CREATE TABLE e (clock INT NOT NULL, n VARCHAR(40) NOT NULL COMMENT 'TAG', INDEX (clock), INDEX (n(8), clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: index 'n' is not supported: column 'n': index prefixes are not supported. MooseDB indexes the timestamp column alone, or TAG columns optionally followed by the timestamp (INDEX (itemid, clock))
# Refused: a column twice, descending parts, FULLTEXT
CREATE TABLE e (clock INT NOT NULL, itemid BIGINT NOT NULL COMMENT 'TAG', INDEX (clock), INDEX (itemid, itemid, clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR 42S21: Duplicate column name 'itemid'
CREATE TABLE e (clock INT NOT NULL, itemid BIGINT NOT NULL COMMENT 'TAG', INDEX (clock), INDEX (itemid, clock DESC)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: index 'itemid' is not supported: column 'clock': descending index parts are not supported. MooseDB indexes the timestamp column alone, or TAG columns optionally followed by the timestamp (INDEX (itemid, clock))
CREATE TABLE e (clock INT NOT NULL, itemid BIGINT NOT NULL COMMENT 'TAG', INDEX (clock DESC)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: index 'clock' is not supported: descending index parts
CREATE TABLE e (clock INT NOT NULL, n VARCHAR(40) NOT NULL COMMENT 'TAG', INDEX (clock), FULLTEXT (n)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: The storage engine MooseDB doesn't support FULLTEXT indexes
# The index on the time column alone is still required
CREATE TABLE e (clock INT NOT NULL, itemid BIGINT NOT NULL COMMENT 'TAG', INDEX (itemid, clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: missing index on the timestamp column: add INDEX (clock)
##################################################################
# Data: 60 items on 4 hosts, 120 samples each, 3 chunks (1 HOUR),
# first half sealed, second half in the MemTable
##################################################################
CREATE TABLE m (
hostid BIGINT UNSIGNED NOT NULL COMMENT 'TAG',
itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG',
clock  INT NOT NULL,
value  DOUBLE NOT NULL,
ns     INT NOT NULL,
INDEX clock_idx (clock),
INDEX item_clock (itemid, clock)
) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 HOUR';
CREATE TABLE i (
hostid BIGINT UNSIGNED NOT NULL,
itemid BIGINT UNSIGNED NOT NULL,
clock  INT NOT NULL,
value  DOUBLE NOT NULL,
ns     INT NOT NULL,
KEY clock_idx (clock)
) ENGINE=InnoDB;
INSERT INTO m SELECT 1 + (a.seq MOD 4), 100 + a.seq, 1700000000 + b.seq * 60, ROUND(a.seq * 1000 + b.seq + (b.seq MOD 7) / 10, 1), (a.seq * 7919 + b.seq * 104729) MOD 1000000000 FROM seq_1_to_60 a, seq_0_to_59 b;
INSERT INTO i SELECT 1 + (a.seq MOD 4), 100 + a.seq, 1700000000 + b.seq * 60, ROUND(a.seq * 1000 + b.seq + (b.seq MOD 7) / 10, 1), (a.seq * 7919 + b.seq * 104729) MOD 1000000000 FROM seq_1_to_60 a, seq_0_to_59 b;
FLUSH TABLES m;
INSERT INTO m SELECT 1 + (a.seq MOD 4), 100 + a.seq, 1700000000 + b.seq * 60, ROUND(a.seq * 1000 + b.seq + (b.seq MOD 7) / 10, 1), (a.seq * 7919 + b.seq * 104729) MOD 1000000000 FROM seq_1_to_60 a, seq_60_to_119 b;
INSERT INTO i SELECT 1 + (a.seq MOD 4), 100 + a.seq, 1700000000 + b.seq * 60, ROUND(a.seq * 1000 + b.seq + (b.seq MOD 7) / 10, 1), (a.seq * 7919 + b.seq * 104729) MOD 1000000000 FROM seq_1_to_60 a, seq_60_to_119 b;
# Item 105 also has two samples at the same second (different ns), item 999 one sample
INSERT INTO m VALUES (2, 105, 1700000600, -1, 5), (2, 105, 1700000600, -2, 999999999), (3, 999, 1700003000, 9, 9);
INSERT INTO i VALUES (2, 105, 1700000600, -1, 5), (2, 105, 1700000600, -2, 999999999), (3, 999, 1700003000, 9, 9);
SELECT COUNT(*), COUNT(DISTINCT itemid), MIN(clock), MAX(clock) FROM m;
COUNT(*)	COUNT(DISTINCT itemid)	MIN(clock)	MAX(clock)
7203	61	1700000000	1700007140
SELECT COUNT(*), COUNT(DISTINCT itemid), MIN(clock), MAX(clock) FROM i;
COUNT(*)	COUNT(DISTINCT itemid)	MIN(clock)	MAX(clock)
7203	61	1700000000	1700007140
