result_rows	vs_innodb
1	SAME
# A new series is visible to the next statement at once
INSERT INTO m VALUES (1, 7777, 1700000001, 1, 1);
INSERT INTO i VALUES (1, 7777, 1700000001, 1, 1);
# itemid = 7777 (series created by the previous statement)
result_rows	vs_innodb
1	SAME
# MAX(itemid) sees the new series
result_rows	vs_innodb
1	SAME
##################################################################
# Restart: the same answers from the WAL and the sealed chunks
##################################################################
FLUSH TABLES m;
INSERT INTO m VALUES (4, 8888, 1700000005, 2, 2);
INSERT INTO i VALUES (4, 8888, 1700000005, 2, 2);
# restart
# after restart: itemid IN (105, 7777, 8888, 130)
result_rows	vs_innodb
1	SAME
# after restart: MAX/MIN(clock) of a series that only lived in the WAL
result_rows	vs_innodb
1	SAME
# after restart: MAX/MIN(itemid)
result_rows	vs_innodb
1	SAME
CHECK TABLE m;
Table	Op	Msg_type	Msg_text
test.m	check	status	OK
##################################################################
# Retention: series without rows are skipped by the ordered reads
##################################################################
CREATE TABLE r (
ts DATETIME NOT NULL, k INT NOT NULL COMMENT 'TAG', v INT NOT NULL,
INDEX (ts), INDEX (k, ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 DAY' RETENTION_PERIOD='30 DAYS';
INSERT INTO r VALUES (NOW() - INTERVAL 400 DAY, 1, 10), (NOW() - INTERVAL 399 DAY, 2, 20),
(NOW() - INTERVAL 1 DAY, 3, 30), (NOW(), 4, 40), (NOW() - INTERVAL 398 DAY, 5, 50);
FLUSH TABLES r;
SELECT SERIES, ROW_COUNT FROM information_schema.MOOSEDB_TABLES WHERE TABLE_NAME = 'r';
SERIES	ROW_COUNT
5	5
SELECT MIN(k), MAX(k), COUNT(*) FROM r;
MIN(k)	MAX(k)	COUNT(*)
1	5	5
SELECT COUNT(*) FROM r WHERE k = 1;
COUNT(*)
1
CALL moosedb_apply_retention('test.r');
# the series 1, 2 and 5 are still registered, but hold no rows now
SELECT SERIES, ROW_COUNT FROM information_schema.MOOSEDB_TABLES WHERE TABLE_NAME = 'r';
SERIES	ROW_COUNT
5	2
SELECT MIN(k), MAX(k), COUNT(*) FROM r;
MIN(k)	MAX(k)	COUNT(*)
3	4	2
SELECT MAX(ts) IS NULL AS no_rows FROM r WHERE k = 1;
no_rows
1
SELECT v FROM r WHERE k = 1;
v
SELECT v FROM r WHERE k = 3 AND ts > NOW() - INTERVAL 2 DAY;
v
30
SELECT MIN(k) FROM r WHERE ts > NOW() - INTERVAL 2 DAY;
MIN(k)
3
DROP TABLE r;
##################################################################
# TRUNCATE
##################################################################
SELECT COUNT(*) FROM m WHERE itemid = 105;
COUNT(*)
244
TRUNCATE TABLE m;
TRUNCATE TABLE i;
SELECT COUNT(*) FROM m WHERE itemid = 105;
COUNT(*)
0
SELECT MAX(itemid), MAX(clock) FROM m;
MAX(itemid)	MAX(clock)
NULL	NULL
INSERT INTO m VALUES (1, 105, 1700000000, 1, 1), (1, 105, 1700000060, 2, 2), (2, 106, 1700000030, 3, 3);
INSERT INTO i VALUES (1, 105, 1700000000, 1, 1), (1, 105, 1700000060, 2, 2), (2, 106, 1700000030, 3, 3);
# after TRUNCATE and new rows: itemid IN (105, 106)
result_rows	vs_innodb
1	SAME
# after TRUNCATE: MAX/MIN(clock) of 105
result_rows	vs_innodb
1	SAME
# after TRUNCATE: MAX/MIN(itemid)
result_rows	vs_innodb
1	SAME
