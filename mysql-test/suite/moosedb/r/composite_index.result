EXPLAIN SELECT h.itemid,h.value,h.clock,h.ns,s.tick FROM m h JOIN (SELECT h2.itemid,h2.clock,MAX(h2.ns) AS ns,s2.tick FROM m h2 JOIN (SELECT itemid,CAST(clock AS SIGNED)-MOD(CAST(clock AS SIGNED),3600) AS tick,MAX(clock) AS clock FROM m WHERE itemid=105 AND clock BETWEEN 1700000000 AND 1700007200 GROUP BY itemid,CAST(clock AS SIGNED)-MOD(CAST(clock AS SIGNED),3600)) s2 ON h2.itemid=s2.itemid AND h2.clock=s2.clock WHERE h2.clock BETWEEN 1700000000 AND 1700007200 GROUP BY h2.itemid,h2.clock,s2.tick) s ON h.itemid=s.itemid AND h.clock=s.clock AND h.ns=s.ns WHERE h.clock BETWEEN 1700000000 AND 1700007200;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	PRIMARY	<derived2>	ALL	NULL	NULL	NULL	NULL	119	Using where
1	PRIMARY	h	ref	clock_idx,item_clock	item_clock	12	s.itemid,s.clock	1	Using where
2	DERIVED	<derived3>	ALL	NULL	NULL	NULL	NULL	119	Using where; Using temporary; Using filesort
2	DERIVED	h2	ref	clock_idx,item_clock	item_clock	12	s2.itemid,s2.clock	1	
3	DERIVED	m	range	clock_idx,item_clock	item_clock	12	NULL	119	Using where; Using index; Using temporary; Using filesort
# last value per hour for three items
result_rows	vs_innodb
9	SAME
# Join with a driving table: one index lookup per outer row
CREATE TABLE d (itemid BIGINT UNSIGNED NOT NULL, since INT NOT NULL, KEY (itemid)) ENGINE=InnoDB;
INSERT INTO d VALUES (101, 1700006000), (120, 1700000000), (424242, 0), (160, 1700007100);
EXPLAIN SELECT COUNT(*), ROUND(SUM(m.value), 3) FROM d JOIN m ON m.itemid = d.itemid AND m.clock >= d.since;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	d	ALL	itemid	NULL	NULL	NULL	4	
1	SIMPLE	m	ref	clock_idx,item_clock	item_clock	8	test.d.itemid	118	Using where
FLUSH STATUS;
SELECT COUNT(*), ROUND(SUM(m.value), 3) FROM d JOIN m ON m.itemid = d.itemid AND m.clock >= d.since;
COUNT(*)	ROUND(SUM(m.value), 3)
141	2489490.900
# 4 driving rows = 4 index lookups (Handler_read_key counts the InnoDB side too: its 4-row scan is rnd_next)
