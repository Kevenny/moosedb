##################################################################
# VARCHAR TAG, DATETIME axis, case-insensitive collation
##################################################################
CREATE TABLE v (
ts   DATETIME(3) NOT NULL,
name VARCHAR(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL COMMENT 'TAG',
v    INT NOT NULL,
INDEX (ts), INDEX name_ts (name, ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR';
CREATE TABLE vi (
ts   DATETIME(3) NOT NULL,
name VARCHAR(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL,
v    INT NOT NULL,
KEY (ts)
) ENGINE=InnoDB;
# 'alpha' and 'Alpha' are two series that compare equal; 'ALPHA ' too (PAD SPACE)
INSERT INTO v SELECT '2026-03-01 00:00:00' + INTERVAL seq * 5 MINUTE, ELT(1 + seq MOD 6, 'alpha', 'Alpha', 'beta', 'ALPHA ', 'Gamma', 'delta'), seq FROM seq_0_to_59;
INSERT INTO vi SELECT '2026-03-01 00:00:00' + INTERVAL seq * 5 MINUTE, ELT(1 + seq MOD 6, 'alpha', 'Alpha', 'beta', 'ALPHA ', 'Gamma', 'delta'), seq FROM seq_0_to_59;
