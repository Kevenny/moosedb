##################################################################
# TIMESTAMP axis with two TAGs of different kinds (CHAR + SMALLINT); the
# CHAR tag has series 'a' and 'A' that the case-insensitive collation says are equal
##################################################################
SET time_zone = '+03:00';
CREATE TABLE tt (
ts   TIMESTAMP(2) NOT NULL DEFAULT '2026-01-01 00:00:00',
site CHAR(6) NOT NULL COMMENT 'TAG',
n    SMALLINT NOT NULL COMMENT 'TAG',
v    INT NOT NULL,
INDEX (ts), INDEX (site, n, ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR';
CREATE TABLE tti LIKE tt;
ALTER TABLE tti ENGINE=InnoDB;
ALTER TABLE tti DROP INDEX site;
INSERT INTO tt SELECT '2026-03-01 00:00:00' + INTERVAL seq * 10 MINUTE, ELT(1 + seq MOD 4, 'a', 'b', 'c', 'A'), CAST(seq MOD 5 AS SIGNED) - 2, seq FROM seq_0_to_89;
