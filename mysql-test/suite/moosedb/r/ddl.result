SELECT ENGINE, SUPPORT, TRANSACTIONS, XA, SAVEPOINTS
FROM information_schema.ENGINES WHERE ENGINE = 'MooseDB';
ENGINE	SUPPORT	TRANSACTIONS	XA	SAVEPOINTS
MooseDB	YES	NO	NO	NO
SHOW VARIABLES LIKE 'moosedb%';
Variable_name	Value
moosedb_batch_memory_budget	1073741824
moosedb_bloom_filter_false_positive_rate	0.010000
moosedb_chunk_cache_size	134217728
moosedb_compaction_threads	2
moosedb_compaction_trigger_chunks	10
moosedb_max_open_chunks	100
moosedb_memtable_flush_threshold	67108864
moosedb_retention_check_interval	3600
moosedb_unique_lock_wait_timeout	50
moosedb_wal_sync_mode	fsync
# Full option syntax (spec §7)
CREATE TABLE metricas (
ts          DATETIME(6)  NOT NULL,
host        VARCHAR(64)  NOT NULL  COMMENT 'TAG',
metric      VARCHAR(64)  NOT NULL  COMMENT 'TAG',
value       DOUBLE,
value_int   BIGINT,
status      TINYINT(1),
INDEX ts_idx (ts)
) ENGINE=MooseDB
CHUNK_INTERVAL    = '1 DAY'
  RETENTION_PERIOD  = '90 DAYS'
  COMPRESSION       = 'ZSTD'
  COMPRESSION_LEVEL = 3
HOT_THRESHOLD     = '7 DAYS'
  MEMTABLE_SIZE     = 67108864
TIMESTAMP_COLUMN  = 'ts';
SHOW CREATE TABLE metricas;
Table	Create Table
metricas	CREATE TABLE `metricas` (
  `ts` datetime(6) NOT NULL,
  `host` varchar(64) NOT NULL COMMENT 'TAG',
  `metric` varchar(64) NOT NULL COMMENT 'TAG',
  `value` double DEFAULT NULL,
  `value_int` bigint(20) DEFAULT NULL,
  `status` tinyint(1) DEFAULT NULL,
  KEY `ts_idx` (`ts`)
) ENGINE=MooseDB DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci `CHUNK_INTERVAL`='1 DAY' `RETENTION_PERIOD`='90 DAYS' `COMPRESSION`='ZSTD' `COMPRESSION_LEVEL`='3' `HOT_THRESHOLD`='7 DAYS' `MEMTABLE_SIZE`='67108864' `TIMESTAMP_COLUMN`='ts'
SHOW INDEX FROM metricas;
Table	Non_unique	Key_name	Seq_in_index	Column_name	Collation	Cardinality	Sub_part	Packed	Null	Index_type	Comment	Index_comment	Ignored
metricas	1	ts_idx	1	ts	A	NULL	NULL	NULL		TSIDX			NO
DROP TABLE metricas;
# Invalid option values are rejected by the engine
CREATE TABLE t1 (ts DATETIME NOT NULL, INDEX(ts)) ENGINE=MooseDB CHUNK_INTERVAL='2 DAY';
ERROR HY000: MooseDB: invalid argument: CHUNK_INTERVAL '2 DAY' not supported; use 1 HOUR, 6 HOUR, 12 HOUR, 1 DAY, 1 WEEK or 1 MONTH
CREATE TABLE t1 (ts DATETIME NOT NULL, INDEX(ts)) ENGINE=MooseDB RETENTION_PERIOD='soon';
ERROR HY000: MooseDB: invalid argument: expected '<N> <UNIT>', got 'soon'
CREATE TABLE t1 (ts DATETIME NOT NULL, INDEX(ts)) ENGINE=MooseDB COMPRESSION='GZIP';
ERROR HY000: MooseDB: invalid argument: COMPRESSION 'GZIP' not supported; use ZSTD, LZ4 or NONE
CREATE TABLE t1 (ts DATETIME NOT NULL, INDEX(ts)) ENGINE=MooseDB COMPRESSION_LEVEL=25;
ERROR HY000: Incorrect value '25' for option 'COMPRESSION_LEVEL'
CREATE TABLE t1 (ts DATETIME NOT NULL, INDEX(ts)) ENGINE=MooseDB MEMTABLE_SIZE=100;
ERROR HY000: MooseDB: invalid argument: MEMTABLE_SIZE must be at least 1048576 bytes (1 MiB)
# Table definition rules
CREATE TABLE t1 (ts DATETIME NOT NULL, v INT) ENGINE=MooseDB;
ERROR HY000: MooseDB: a MooseDB table needs a DATETIME/TIMESTAMP column with an index (INDEX ts_idx (ts)) or TIMESTAMP_COLUMN = '<column>'
CREATE TABLE t1 (ts DATETIME NULL, INDEX(ts)) ENGINE=MooseDB;
ERROR 42000: Table handler doesn't support NULL in given index. Please change column 'ts' to be NOT NULL or use another handler
# (PRIMARY KEY on the time column of a table without TAG columns is accepted: primary_key.test)
CREATE TABLE t1 (ts DATETIME NOT NULL, PRIMARY KEY(ts)) ENGINE=MooseDB;
DROP TABLE t1;
CREATE TABLE t1 (ts DATETIME NOT NULL, v INT NOT NULL, INDEX(ts), INDEX(v)) ENGINE=MooseDB;
ERROR HY000: MooseDB: index 'v' is not supported: column 'v' is not a TAG column or the timestamp column. MooseDB indexes the timestamp column alone, or TAG columns optionally followed by the timestamp (INDEX (itemid, clock))
CREATE TABLE t1 (ts DATETIME NOT NULL, INDEX(ts)) ENGINE=MooseDB TIMESTAMP_COLUMN='nope';
ERROR HY000: MooseDB: TIMESTAMP_COLUMN 'nope' does not exist
CREATE TABLE t1 (ts DATETIME NOT NULL, v DOUBLE NOT NULL, INDEX(ts)) ENGINE=MooseDB TIMESTAMP_COLUMN='v';
ERROR HY000: MooseDB: timestamp column 'v' must be a stored DATETIME, TIMESTAMP, INT or BIGINT column
CREATE TABLE t1 (id INT NOT NULL AUTO_INCREMENT, ts DATETIME NOT NULL, INDEX(id), INDEX(ts)) ENGINE=MooseDB;
ERROR 42000: Storage engine MooseDB doesn't support AUTO_INCREMENT columns
# TIMESTAMP columns work as the time axis too
CREATE TABLE t1 (ts TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3), v INT, INDEX(ts)) ENGINE=MooseDB;
SET time_zone = '+00:00';
INSERT INTO t1 VALUES ('2026-10-01 12:00:00.123', 1);
SET time_zone = '-03:00';
SELECT * FROM t1;
ts	v
2026-10-01 09:00:00.123	1
SET time_zone = DEFAULT;
DROP TABLE t1;
# DROP DATABASE removes MooseDB table directories
CREATE DATABASE tfdb;
CREATE TABLE tfdb.t1 (ts DATETIME NOT NULL, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO tfdb.t1 VALUES ('2026-01-01');
DROP DATABASE tfdb;
