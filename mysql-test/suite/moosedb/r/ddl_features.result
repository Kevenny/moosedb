# ---- Which column is the time axis ----
CREATE TABLE a1 (t1 DATETIME NOT NULL, t2 DATETIME NOT NULL, v INT, INDEX(t1), INDEX(t2)) ENGINE=MooseDB;
ERROR HY000: MooseDB: index 't2' is not supported: column 't2' is not a TAG column or the timestamp column. MooseDB indexes the timestamp column alone, or TAG columns optionally followed by the timestamp (INDEX (itemid, clock))
CREATE TABLE a2 (t1 DATETIME NOT NULL, t2 DATETIME NOT NULL, v INT, INDEX(t1)) ENGINE=MooseDB TIMESTAMP_COLUMN='t2';
ERROR HY000: MooseDB: index 't1' is not supported: column 't1' is not a TAG column or the timestamp column. MooseDB indexes the timestamp column alone, or TAG columns optionally followed by the timestamp (INDEX (itemid, clock))
CREATE TABLE a3 (t1 DATETIME NOT NULL, t2 DATETIME NOT NULL, v INT, INDEX(t1)) ENGINE=MooseDB TIMESTAMP_COLUMN='t1';
INSERT INTO a3 VALUES ('2026-01-01', '2020-01-01', 1), ('2026-01-01', '2030-06-01', 2);
FLUSH TABLES a3;
SELECT * FROM a3 ORDER BY v;
t1	t2	v
2026-01-01 00:00:00	2020-01-01 00:00:00	1
2026-01-01 00:00:00	2030-06-01 00:00:00	2
SELECT MIN(t2), MAX(t2) FROM a3;
MIN(t2)	MAX(t2)
2020-01-01 00:00:00	2030-06-01 00:00:00
CREATE TABLE a4 (ts DATETIME NOT NULL COMMENT 'TAG', INDEX(ts)) ENGINE=MooseDB;
ERROR HY000: MooseDB: the timestamp column cannot be a TAG
CREATE TABLE a5 (ts DATE NOT NULL, INDEX(ts)) ENGINE=MooseDB;
ERROR HY000: MooseDB: a MooseDB table needs a DATETIME/TIMESTAMP column with an index (INDEX ts_idx (ts)) or TIMESTAMP_COLUMN = '<column>'
CREATE TABLE a6 (ts BIGINT NOT NULL, INDEX(ts)) ENGINE=MooseDB;
ERROR HY000: MooseDB: a MooseDB table needs a DATETIME/TIMESTAMP column with an index (INDEX ts_idx (ts)) or TIMESTAMP_COLUMN = '<column>'
CREATE TABLE a7 (a INT) ENGINE=MooseDB;
ERROR HY000: MooseDB: a MooseDB table needs a DATETIME/TIMESTAMP column with an index (INDEX ts_idx (ts)) or TIMESTAMP_COLUMN = '<column>'
SET default_storage_engine = MooseDB;
CREATE TABLE a8 (a INT);
ERROR HY000: MooseDB: a MooseDB table needs a DATETIME/TIMESTAMP column with an index (INDEX ts_idx (ts)) or TIMESTAMP_COLUMN = '<column>'
SET default_storage_engine = DEFAULT;
DROP TABLE a3;
# ---- Generic features the engine does not support ----
CREATE TABLE g1 (ts DATETIME NOT NULL, v INT, g INT AS (v * 2) VIRTUAL, INDEX(ts)) ENGINE=MooseDB;
ERROR HY000: MooseDB storage engine does not support generated columns
CREATE TABLE g2 (ts DATETIME NOT NULL, v INT, g INT AS (v + 1) PERSISTENT, INDEX(ts)) ENGINE=MooseDB;
ERROR HY000: MooseDB storage engine does not support generated columns
CREATE TABLE g3 (ts DATETIME NOT NULL, v INT, g INT AS (v * 2) VIRTUAL COMMENT 'TAG', INDEX(ts)) ENGINE=MooseDB;
ERROR HY000: MooseDB storage engine does not support generated columns
CREATE TABLE g4 (ts DATETIME NOT NULL, v INT, g INT AS (v * 2) VIRTUAL, INDEX(ts), INDEX(g)) ENGINE=MooseDB;
ERROR 42000: Table handler doesn't support NULL in given index. Please change column 'g' to be NOT NULL or use another handler
CREATE TABLE ft (ts DATETIME NOT NULL, t TEXT, INDEX(ts), FULLTEXT(t)) ENGINE=MooseDB;
ERROR HY000: The storage engine MooseDB doesn't support FULLTEXT indexes
CREATE TABLE fk (ts DATETIME NOT NULL, v INT, INDEX(ts), FOREIGN KEY (v) REFERENCES a3 (t1)) ENGINE=MooseDB;
ERROR 42000: Table handler doesn't support NULL in given index. Please change column 'v' to be NOT NULL or use another handler
CREATE TABLE pf (ts DATETIME NOT NULL, v INT, INDEX(ts(1))) ENGINE=MooseDB;
ERROR HY000: Incorrect prefix key; the used key part isn't a string, the used length is longer than the key part, or the storage engine doesn't support unique prefix keys
CREATE TABLE sp (ts DATETIME NOT NULL, v INT NOT NULL, INDEX a(ts), INDEX c(ts, v)) ENGINE=MooseDB;
ERROR HY000: MooseDB: index 'c' is not supported: column 'ts' (the timestamp) must be the last part. MooseDB indexes the timestamp column alone, or TAG columns optionally followed by the timestamp (INDEX (itemid, clock))
CREATE TABLE sq SEQUENCE=1 ENGINE=MooseDB;
ERROR 42000: A table must have at least 1 column
CREATE SEQUENCE s1 ENGINE=MooseDB;
ERROR HY000: Table storage engine 'MooseDB' does not support the create option 'SEQUENCE'
# ---- CHECK constraints are enforced by the server ----
CREATE TABLE c1 (ts DATETIME NOT NULL, v INT CHECK (v > 0), INDEX(ts)) ENGINE=MooseDB;
INSERT INTO c1 VALUES ('2026-01-01', 5);
INSERT INTO c1 VALUES ('2026-01-02', -5);
ERROR 23000: CONSTRAINT `c1.v` failed for `test`.`c1`
SELECT * FROM c1;
ts	v
2026-01-01 00:00:00	5
DROP TABLE c1;
# ---- Column attributes ----
CREATE TABLE ic (ts DATETIME NOT NULL, v INT INVISIBLE, w INT, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO ic (ts, v, w) VALUES ('2026-01-01', 1, 2);
FLUSH TABLES ic;
SELECT * FROM ic;
ts	w
2026-01-01 00:00:00	2
SELECT ts, v, w FROM ic;
ts	v	w
2026-01-01 00:00:00	1	2
CREATE TABLE ds (ts DATETIME NOT NULL DEFAULT '2020-01-01', v INT DEFAULT 7, s VARCHAR(5) NOT NULL DEFAULT 'dflt', INDEX(ts)) ENGINE=MooseDB;
INSERT INTO ds () VALUES ();
INSERT INTO ds (v) VALUES (1);
INSERT INTO ds (s) VALUES (DEFAULT);
FLUSH TABLES ds;
SELECT * FROM ds ORDER BY v;
ts	v	s
2020-01-01 00:00:00	1	dflt
2020-01-01 00:00:00	7	dflt
2020-01-01 00:00:00	7	dflt
CREATE TABLE ts2 (ts TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP, v INT, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO ts2 (v) VALUES (1);
SELECT COUNT(*) FROM ts2 WHERE ts > NOW() - INTERVAL 1 MINUTE;
COUNT(*)
1
DROP TABLE ic, ds, ts2;
# ---- System versioning: accepted, but only as plain history-less inserts ----
CREATE TABLE v1 (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=MooseDB WITH SYSTEM VERSIONING;
INSERT INTO v1 VALUES ('2026-01-01', 1), ('2026-01-02', 2);
FLUSH TABLES v1;
SELECT ts, v, row_start > '2000-01-01' AS started FROM v1 FOR SYSTEM_TIME ALL;
ts	v	started
2026-01-01 00:00:00	1	1
2026-01-02 00:00:00	2	1
UPDATE v1 SET v = 5;
ERROR HY000: Storage engine MooseDB of the table `test`.`v1` doesn't have this option
DELETE FROM v1 WHERE v = 1;
ERROR HY000: Storage engine MooseDB of the table `test`.`v1` doesn't have this option
TRUNCATE v1;
ERROR HY000: System-versioned tables do not support TRUNCATE TABLE
SELECT COUNT(*) FROM v1;
COUNT(*)
2
DROP TABLE v1;
# ---- A TAG can have any type; pushdown only applies to string constants ----
CREATE TABLE tg (ts DATETIME NOT NULL, a INT NOT NULL COMMENT 'TAG', b DOUBLE COMMENT 'TAG', c DECIMAL(10,2) COMMENT 'TAG',
d TEXT COMMENT 'TAG', e BLOB COMMENT 'TAG', f DATE COMMENT 'TAG', h ENUM('x','y') COMMENT 'TAG', j JSON COMMENT 'TAG', INDEX(ts))
ENGINE=MooseDB;
CREATE TABLE tg_ctl (ts DATETIME NOT NULL, a INT NOT NULL, b DOUBLE, c DECIMAL(10,2), d TEXT, e BLOB, f DATE, h ENUM('x','y'), j JSON, INDEX(ts))
ENGINE=MyISAM;
INSERT INTO tg VALUES ('2026-01-01', 1, 1.5, 2.25, 'text', 'blob', '2026-01-01', 'y', '{"a":1}'),
('2026-01-02', 1, NULL, NULL, NULL, NULL, NULL, 'x', NULL),
('2026-01-03', 2, 1.5, 2.25, 'text', 'blob2', '2026-01-02', 'x', '{"a":2}'),
('2026-01-04', 2, 1.5, 2.20, 'TEXT ', 'blob', '2026-01-01', 'y', '[]');
INSERT INTO tg_ctl SELECT * FROM tg;
FLUSH TABLES tg;
INSERT INTO tg VALUES ('2026-01-05', 1, 1.5, 2.25, 'text', 'blob', '2026-01-01', 'y', '{"a":1}');
INSERT INTO tg_ctl VALUES ('2026-01-05', 1, 1.5, 2.25, 'text', 'blob', '2026-01-01', 'y', '{"a":1}');
CREATE PROCEDURE cmp(p TEXT)
BEGIN
EXECUTE IMMEDIATE CONCAT('SELECT CONCAT(COUNT(*), ''/'', IFNULL(SUM(a), 0)) INTO @a FROM tg WHERE ', p);
EXECUTE IMMEDIATE CONCAT('SELECT CONCAT(COUNT(*), ''/'', IFNULL(SUM(a), 0)) INTO @b FROM tg_ctl WHERE ', p);
SELECT IF(@a = @b, 'OK', 'FAIL') AS status, p AS predicate, @a AS moosedb, @b AS control;
END//
CALL cmp("a = 1");
status	predicate	moosedb	control
OK	a = 1	3/3	3/3
CALL cmp("a = '1'");
status	predicate	moosedb	control
OK	a = '1'	3/3	3/3
CALL cmp("a IN (1, 2)");
status	predicate	moosedb	control
OK	a IN (1, 2)	5/7	5/7
CALL cmp("a = 1.0");
status	predicate	moosedb	control
OK	a = 1.0	3/3	3/3
CALL cmp("b = 1.5");
status	predicate	moosedb	control
OK	b = 1.5	4/6	4/6
CALL cmp("b = '1.5'");
status	predicate	moosedb	control
OK	b = '1.5'	4/6	4/6
CALL cmp("b IS NULL");
status	predicate	moosedb	control
OK	b IS NULL	1/1	1/1
CALL cmp("c = 2.25");
status	predicate	moosedb	control
OK	c = 2.25	3/4	3/4
CALL cmp("c = 2.2");
status	predicate	moosedb	control
OK	c = 2.2	1/2	1/2
CALL cmp("c = '2.20'");
status	predicate	moosedb	control
OK	c = '2.20'	1/2	1/2
CALL cmp("d = 'text'");
status	predicate	moosedb	control
OK	d = 'text'	4/6	4/6
CALL cmp("d = 'TEXT'");
status	predicate	moosedb	control
OK	d = 'TEXT'	4/6	4/6
CALL cmp("d = 'text '");
status	predicate	moosedb	control
OK	d = 'text '	4/6	4/6
CALL cmp("d IN ('text', 'nope')");
status	predicate	moosedb	control
OK	d IN ('text', 'nope')	4/6	4/6
CALL cmp("d IS NULL");
status	predicate	moosedb	control
OK	d IS NULL	1/1	1/1
CALL cmp("e = 'blob'");
status	predicate	moosedb	control
OK	e = 'blob'	3/4	3/4
CALL cmp("e = 'BLOB'");
status	predicate	moosedb	control
OK	e = 'BLOB'	0/0	0/0
CALL cmp("e = X'626C6F62'");
status	predicate	moosedb	control
OK	e = X'626C6F62'	3/4	3/4
CALL cmp("f = '2026-01-01'");
status	predicate	moosedb	control
OK	f = '2026-01-01'	3/4	3/4
CALL cmp("f = 20260101");
status	predicate	moosedb	control
OK	f = 20260101	3/4	3/4
CALL cmp("f = '2026-01-01 10:00:00'");
status	predicate	moosedb	control
OK	f = '2026-01-01 10:00:00'	0/0	0/0
CALL cmp("h = 'x'");
status	predicate	moosedb	control
OK	h = 'x'	2/3	2/3
CALL cmp("h = 'X'");
status	predicate	moosedb	control
OK	h = 'X'	2/3	2/3
CALL cmp("h = 2");
status	predicate	moosedb	control
OK	h = 2	3/4	3/4
CALL cmp("h = 'z'");
status	predicate	moosedb	control
OK	h = 'z'	0/0	0/0
CALL cmp("h IN ('x', 'y') AND a = 2");
status	predicate	moosedb	control
OK	h IN ('x', 'y') AND a = 2	2/4	2/4
CALL cmp("j = '{\"a\":1}'");
status	predicate	moosedb	control
OK	j = '{"a":1}'	2/2	2/2
CALL cmp("j = JSON_OBJECT('a', 1)");
status	predicate	moosedb	control
OK	j = JSON_OBJECT('a', 1)	0/0	0/0
CALL cmp("a = 1 AND d = 'text' AND h = 'y'");
status	predicate	moosedb	control
OK	a = 1 AND d = 'text' AND h = 'y'	2/2	2/2
CALL cmp("a = 1 AND d = 'text' AND h = 'x'");
status	predicate	moosedb	control
OK	a = 1 AND d = 'text' AND h = 'x'	0/0	0/0
CALL cmp("a = 2 OR h = 'y'");
status	predicate	moosedb	control
OK	a = 2 OR h = 'y'	4/6	4/6
DROP PROCEDURE cmp;
DROP TABLE tg, tg_ctl;
# ---- Tables whose only column is the time axis ----
CREATE TABLE only1 (ts DATETIME NOT NULL, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO only1 VALUES ('2026-01-01'), ('2026-01-01'), ('2026-01-02');
SELECT * FROM only1;
ts
2026-01-01 00:00:00
2026-01-01 00:00:00
2026-01-02 00:00:00
FLUSH TABLES only1;
INSERT INTO only1 VALUES ('2026-01-01');
SELECT ts, COUNT(*) FROM only1 GROUP BY ts ORDER BY ts;
ts	COUNT(*)
2026-01-01 00:00:00	3
2026-01-02 00:00:00	1
SELECT COUNT(*) FROM only1 WHERE ts = '2026-01-01';
COUNT(*)
3
SELECT ts FROM only1 ORDER BY ts DESC LIMIT 2;
ts
2026-01-02 00:00:00
2026-01-01 00:00:00
DROP TABLE only1;
# ---- Many columns: 1000 fit, 4000+ are refused by the server ----
FLUSH TABLES wide;
SELECT COUNT(*), SUM(c1), SUM(c500), SUM(c1000) FROM wide;
COUNT(*)	SUM(c1)	SUM(c500)	SUM(c1000)
2	2	1000	2000
SELECT c1, c500, c1000 FROM wide ORDER BY ts DESC LIMIT 1;
c1	c500	c1000
1	500	1000
CHECK TABLE wide;
Table	Op	Msg_type	Msg_text
test.wide	check	status	OK
DROP TABLE wide;
ERROR HY000: Too many columns
# ---- Long values: a 4 MB cell and a 16 MB row ----
CREATE TABLE big (ts DATETIME NOT NULL, a LONGBLOB, b LONGTEXT CHARACTER SET latin1, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO big VALUES ('2026-01-01', REPEAT('a', 4194304), 'x');
INSERT INTO big VALUES ('2026-01-02', REPEAT('b', 8388608), REPEAT('c', 8388608));
FLUSH TABLES big;
SELECT ts, LENGTH(a), LENGTH(b), MD5(a) = MD5(REPEAT(SUBSTR(a, 1, 1), LENGTH(a))) AS intact FROM big ORDER BY ts;
ts	LENGTH(a)	LENGTH(b)	intact
2026-01-01 00:00:00	4194304	1	1
2026-01-02 00:00:00	8388608	8388608	1
DROP TABLE big;
