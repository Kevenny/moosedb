##################################################################
# Chunks and the MemTable: flush, seal cold, compact -- the answers do not move
##################################################################
SET @before= (SELECT COUNT(*) FROM h4);
SELECT ROW_COUNT, PENDING_ROWS FROM information_schema.MOOSEDB_TABLES WHERE TABLE_NAME = 'h4';
ROW_COUNT	PENDING_ROWS
24217	8186
FLUSH TABLES h3, h4;
# v3 after FLUSH
result_rows	vs_innodb
32199	SAME
# v4 after FLUSH
result_rows	vs_innodb
24217	SAME
OPTIMIZE TABLE h3;
Table	Op	Msg_type	Msg_text
test.h3	optimize	status	OK
OPTIMIZE TABLE h4;
Table	Op	Msg_type	Msg_text
test.h4	optimize	status	OK
# v3 after OPTIMIZE (the rows are removed physically)
result_rows	vs_innodb
32199	SAME
# v4 after OPTIMIZE
result_rows	vs_innodb
24217	SAME
SELECT @before = (SELECT COUNT(*) FROM h4) AS count_unchanged_by_optimize;
count_unchanged_by_optimize
1
