##################################################################
# Descending ref read (HA_READ_PREFIX_LAST) on a key with 1 and 2 extra columns
##################################################################
CREATE TABLE k1 (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL, ns INT NOT NULL, value DOUBLE NOT NULL, PRIMARY KEY (itemid, clock, ns))
ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY';
CREATE TABLE k2 (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL, ns INT NOT NULL, seq INT NOT NULL, value DOUBLE NOT NULL, PRIMARY KEY (itemid, clock, ns, seq))
ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY';
CREATE TABLE i1 (itemid BIGINT UNSIGNED NOT NULL, clock INT NOT NULL, ns INT NOT NULL, value DOUBLE NOT NULL, PRIMARY KEY (itemid, clock, ns)) ENGINE=InnoDB;
CREATE TABLE i2 (itemid BIGINT UNSIGNED NOT NULL, clock INT NOT NULL, ns INT NOT NULL, seq INT NOT NULL, value DOUBLE NOT NULL, PRIMARY KEY (itemid, clock, ns, seq)) ENGINE=InnoDB;
INSERT INTO k1 SELECT 1 + a.seq, 1700000000 + b.seq, c.seq, a.seq * 100 + b.seq FROM seq_0_to_2 a, seq_0_to_19 b, seq_0_to_3 c;
INSERT INTO k2 SELECT 1 + a.seq, 1700000000 + b.seq, c.seq, d.seq, a.seq * 100 + b.seq FROM seq_0_to_2 a, seq_0_to_19 b, seq_0_to_3 c, seq_0_to_2 d;
INSERT INTO i1 SELECT * FROM k1;
INSERT INTO i2 SELECT * FROM k2;
FLUSH TABLES k1, k2;
INSERT INTO k1 SELECT 1 + a.seq, 1700000020 + b.seq, c.seq, a.seq * 100 + b.seq FROM seq_0_to_2 a, seq_0_to_4 b, seq_0_to_3 c;
INSERT INTO k2 SELECT 1 + a.seq, 1700000020 + b.seq, c.seq, d.seq, a.seq * 100 + b.seq FROM seq_0_to_2 a, seq_0_to_4 b, seq_0_to_3 c, seq_0_to_2 d;
INSERT INTO i1 SELECT * FROM k1 WHERE clock >= 1700000020;
INSERT INTO i2 SELECT * FROM k2 WHERE clock >= 1700000020;
# k1 const ns = , descending
result_rows	vs_innodb
1	SAME
# k1 clock =, descending
result_rows	vs_innodb
4	SAME
# k1 MemTable ns = , descending
result_rows	vs_innodb
1	SAME
# k2 prefix of 3 key parts, descending
result_rows	vs_innodb
3	SAME
# k2 MemTable prefix of 3 parts, descending
result_rows	vs_innodb
3	SAME
# k2 whole key
result_rows	vs_innodb
1	SAME
# k2 range with ns and seq
result_rows	vs_innodb
6	SAME
# k2 seq <, descending
result_rows	vs_innodb
2	SAME
DROP TABLE k1, k2, i1, i2;
##################################################################
# The same routine deletes, then reads and inserts the same key.
# Like its INSERTs, a statement's DELETE (also in a function/trigger)
# takes effect when the statement ends: re-inserting the key in the same
# statement is a duplicate, and the whole statement is undone.
##################################################################
CREATE TABLE t (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL, value DOUBLE NOT NULL, ns INT NOT NULL, PRIMARY KEY (itemid, clock, ns))
ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY';
CREATE TABLE ctl (v DOUBLE) ENGINE=InnoDB;
CREATE TABLE res (v DOUBLE, n INT) ENGINE=InnoDB;
INSERT INTO t SELECT 1, 1700000000 + seq, seq, 0 FROM seq_0_to_9;
CREATE FUNCTION swap(x DOUBLE) RETURNS INT MODIFIES SQL DATA
BEGIN
DECLARE before_n, after_n INT;
SELECT COUNT(*) INTO before_n FROM t;
DELETE FROM t WHERE value = x;
SELECT COUNT(*) INTO after_n FROM t;
INSERT INTO t VALUES (1, 1700000000 + x, x + 100, 0);
RETURN before_n * 100 + after_n;
END|
CREATE TRIGGER trg AFTER INSERT ON ctl FOR EACH ROW
BEGIN
DECLARE c INT;
DELETE FROM t WHERE value = NEW.v;
SELECT COUNT(*) INTO c FROM t WHERE clock = 1700000000 + NEW.v;
INSERT INTO t VALUES (1, 1700000000 + NEW.v, NEW.v + 200, 0);
INSERT INTO res VALUES (NEW.v, c);
END|
SELECT swap(2);
ERROR 23000: Duplicate entry '1-1700000002-0' for key 'PRIMARY'
SELECT value FROM t WHERE clock = 1700000002;
value
2
INSERT INTO ctl VALUES (3);
ERROR 23000: Duplicate entry '1-1700000003-0' for key 'PRIMARY'
SELECT n FROM res WHERE v = 3;
n
SELECT value FROM t WHERE clock = 1700000003;
value
3
SELECT COUNT(*) FROM t;
COUNT(*)
10
DROP TRIGGER trg;
DROP FUNCTION swap;
# PREPARE once, EXECUTE twice with other parameters
PREPARE st FROM 'DELETE FROM t WHERE itemid = ? AND clock < ?';
SET @i = 1, @c = 1700000003;
EXECUTE st USING @i, @c;
SELECT ROW_COUNT();
ROW_COUNT()
3
SET @c = 1700000006;
EXECUTE st USING @i, @c;
SELECT ROW_COUNT();
ROW_COUNT()
3
SET @i = 2;
EXECUTE st USING @i, @c;
SELECT ROW_COUNT();
ROW_COUNT()
0
DEALLOCATE PREPARE st;
SELECT clock FROM t ORDER BY clock;
clock
1700000006
1700000007
1700000008
1700000009
##################################################################
# A view with a WHERE
##################################################################
INSERT INTO t SELECT 1 + seq MOD 4, 1700001000 + seq, seq, 0 FROM seq_0_to_39;
CREATE TABLE ti (itemid BIGINT UNSIGNED NOT NULL, clock INT NOT NULL, value DOUBLE NOT NULL, ns INT NOT NULL, PRIMARY KEY (itemid, clock, ns)) ENGINE=InnoDB;
INSERT INTO ti SELECT * FROM t;
CREATE VIEW v AS SELECT * FROM t WHERE itemid <= 2;
CREATE VIEW vi AS SELECT * FROM ti WHERE itemid <= 2;
DELETE FROM v WHERE clock < 1700001020;
SELECT ROW_COUNT();
ROW_COUNT()
14
DELETE FROM vi WHERE clock < 1700001020;
SELECT ROW_COUNT();
ROW_COUNT()
14
DELETE FROM v WHERE itemid = 3;
SELECT ROW_COUNT();
ROW_COUNT()
0
DELETE FROM vi WHERE itemid = 3;
SELECT ROW_COUNT();
ROW_COUNT()
0
# after deletes through a view (rows of item 3 are outside it)
result_rows	vs_innodb
30	SAME
DROP VIEW v, vi;
##################################################################
# A constant true WHERE: row by row when the table is open to inserts, never a lost insert
##################################################################
DELETE FROM t WHERE 1;
SELECT ROW_COUNT();
ROW_COUNT()
30
SELECT COUNT(*) FROM t;
COUNT(*)
0
INSERT INTO t VALUES (1, 1700002000, 1, 0);
DELETE FROM t WHERE itemid IS NOT NULL;
SELECT ROW_COUNT();
ROW_COUNT()
1
INSERT INTO t VALUES (1, 1700002000, 1, 0);
DELETE FROM t WHERE 1 = 1 LIMIT 5;
SELECT ROW_COUNT();
ROW_COUNT()
1
SELECT COUNT(*) FROM t;
COUNT(*)
0
DROP TABLE t, ti, ctl, res;
##################################################################
# A TAG with a case-insensitive PAD SPACE collation
##################################################################
CREATE TABLE ci (host VARCHAR(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL COMMENT 'TAG', ts DATETIME NOT NULL, v INT, INDEX (ts), INDEX (host, ts))
ENGINE=MooseDB CHUNK_INTERVAL='1 DAY';
CREATE TABLE cii (host VARCHAR(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL, ts DATETIME NOT NULL, v INT, INDEX (ts), INDEX (host, ts)) ENGINE=InnoDB;
INSERT INTO ci VALUES ('alpha', '2026-01-01 00:00:00', 1), ('Alpha ', '2026-01-01 00:00:01', 2), ('ALPHA', '2026-01-01 00:00:02', 3),
('beta', '2026-01-01 00:00:03', 4), ('alphb', '2026-01-01 00:00:04', 5), ('ALPHA', '2026-01-02 00:00:00', 6);
INSERT INTO cii SELECT * FROM ci;
FLUSH TABLES ci;
INSERT INTO ci VALUES ('aLpHa', '2026-01-01 00:00:05', 7), ('Beta', '2026-01-01 00:00:06', 8);
INSERT INTO cii VALUES ('aLpHa', '2026-01-01 00:00:05', 7), ('Beta', '2026-01-01 00:00:06', 8);
FLUSH STATUS;
DELETE FROM ci WHERE host = 'ALPHA' AND ts < '2026-01-02';
SELECT ROW_COUNT();
ROW_COUNT()
4
SHOW SESSION STATUS LIKE 'Handler_delete';
Variable_name	Value
Handler_delete	4
DELETE FROM cii WHERE host = 'ALPHA' AND ts < '2026-01-02';
SELECT ROW_COUNT();
ROW_COUNT()
4
DELETE FROM ci WHERE host IN ('BETA ', 'zzz');
SELECT ROW_COUNT();
ROW_COUNT()
2
DELETE FROM cii WHERE host IN ('BETA ', 'zzz');
SELECT ROW_COUNT();
ROW_COUNT()
2
# case-insensitive TAG after the deletes
result_rows	vs_innodb
2	SAME
DROP TABLE ci, cii;
##################################################################
# DATETIME time axis: direct delete with exact bounds, fractional bounds, a TIMESTAMP-less range
##################################################################
CREATE TABLE dt (host VARCHAR(8) NOT NULL COMMENT 'TAG', ts DATETIME(6) NOT NULL, v INT, INDEX (ts), INDEX (host, ts)) ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR';
CREATE TABLE dti (host VARCHAR(8) NOT NULL, ts DATETIME(6) NOT NULL, v INT, INDEX (ts), INDEX (host, ts)) ENGINE=InnoDB;
INSERT INTO dt SELECT CONCAT('h', seq MOD 3), '2026-01-01' + INTERVAL seq SECOND + INTERVAL (seq MOD 7) * 100000 MICROSECOND, seq FROM seq_0_to_599;
INSERT INTO dti SELECT * FROM dt;
FLUSH TABLES dt;
INSERT INTO dt SELECT CONCAT('h', seq MOD 3), '2026-01-01 00:20:00' + INTERVAL seq SECOND, 1000 + seq FROM seq_0_to_59;
INSERT INTO dti SELECT * FROM dt WHERE v >= 1000;
FLUSH STATUS;
DELETE FROM dt WHERE host = 'h1' AND ts < '2026-01-01 00:01:00';
SELECT ROW_COUNT();
ROW_COUNT()
20
SHOW SESSION STATUS LIKE 'Handler_delete';
Variable_name	Value
Handler_delete	20
DELETE FROM dti WHERE host = 'h1' AND ts < '2026-01-01 00:01:00';
SELECT ROW_COUNT();
ROW_COUNT()
20
FLUSH STATUS;
DELETE FROM dt WHERE host = 'h2' AND ts BETWEEN '2026-01-01 00:02:00.300000' AND '2026-01-01 00:03:00.250000';
SELECT ROW_COUNT();
ROW_COUNT()
20
SHOW SESSION STATUS LIKE 'Handler_delete';
Variable_name	Value
Handler_delete	0
DELETE FROM dti WHERE host = 'h2' AND ts BETWEEN '2026-01-01 00:02:00.300000' AND '2026-01-01 00:03:00.250000';
SELECT ROW_COUNT();
ROW_COUNT()
20
DELETE FROM dt WHERE ts >= '2026-01-01 00:20:30' AND ts <= '2026-01-01 00:20:40.000001';
SELECT ROW_COUNT();
ROW_COUNT()
11
DELETE FROM dti WHERE ts >= '2026-01-01 00:20:30' AND ts <= '2026-01-01 00:20:40.000001';
SELECT ROW_COUNT();
ROW_COUNT()
11
DELETE FROM dt WHERE ts = '2026-01-01 00:00:01.100000';
SELECT ROW_COUNT();
ROW_COUNT()
0
DELETE FROM dti WHERE ts = '2026-01-01 00:00:01.100000';
SELECT ROW_COUNT();
ROW_COUNT()
0
DELETE FROM dt WHERE ts > '2026-01-01 00:05:00' AND ts < '2026-01-01 00:06:00' AND v MOD 2 = 0;
SELECT ROW_COUNT();
ROW_COUNT()
30
DELETE FROM dti WHERE ts > '2026-01-01 00:05:00' AND ts < '2026-01-01 00:06:00' AND v MOD 2 = 0;
SELECT ROW_COUNT();
ROW_COUNT()
30
# DATETIME axis after the deletes
result_rows	vs_innodb
579	SAME
DROP TABLE dt, dti;
##################################################################
# A table with delete triggers: row by row, the trigger fires once per row
##################################################################
CREATE TABLE tr (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL, value DOUBLE NOT NULL, PRIMARY KEY (itemid, clock))
ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY';
CREATE TABLE audit (n INT) ENGINE=InnoDB;
CREATE TRIGGER trd BEFORE DELETE ON tr FOR EACH ROW INSERT INTO audit VALUES (OLD.clock);
INSERT INTO tr SELECT 1, 1700000000 + seq, seq FROM seq_0_to_9;
FLUSH TABLES tr;
FLUSH STATUS;
DELETE FROM tr WHERE itemid = 1 AND clock < 1700000004;
SELECT ROW_COUNT();
ROW_COUNT()
4
SHOW SESSION STATUS LIKE 'Handler_delete';
Variable_name	Value
Handler_delete	4
SELECT COUNT(*), MIN(n), MAX(n) FROM audit;
COUNT(*)	MIN(n)	MAX(n)
4	1700000000	1700000003
SELECT COUNT(*) FROM tr;
COUNT(*)
6
DROP TABLE tr, audit;
