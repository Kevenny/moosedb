CREATE TABLE t (ts DATETIME NOT NULL, host VARCHAR(8) NOT NULL COMMENT 'TAG', v INT NOT NULL, INDEX(ts))
ENGINE=MooseDB MEMTABLE_SIZE=1048576;
CREATE TABLE c (ts DATETIME NOT NULL, host VARCHAR(8) NOT NULL, v INT NOT NULL, INDEX(ts)) ENGINE=MyISAM;
# ---- Transactions: the engine is not transactional ----
SELECT ENGINE, TRANSACTIONS, XA, SAVEPOINTS FROM information_schema.ENGINES WHERE ENGINE IN ('MooseDB', 'MyISAM') ORDER BY ENGINE;
ENGINE	TRANSACTIONS	XA	SAVEPOINTS
MooseDB	NO	NO	NO
MyISAM	NO	NO	NO
BEGIN;
INSERT INTO t VALUES ('2026-01-01', 'a', 1);
INSERT INTO t VALUES ('2026-01-02', 'a', 2);
# ROLLBACK warns that the rows stay
ROLLBACK;
Warnings:
Warning	1196	Some non-transactional changed tables couldn't be rolled back
SELECT ts, v FROM t ORDER BY ts;
ts	v
2026-01-01 00:00:00	1
2026-01-02 00:00:00	2
START TRANSACTION;
INSERT INTO t VALUES ('2026-01-03', 'a', 3);
SAVEPOINT s1;
INSERT INTO t VALUES ('2026-01-04', 'a', 4);
ROLLBACK TO SAVEPOINT s1;
Warnings:
Warning	1196	Some non-transactional changed tables couldn't be rolled back
COMMIT;
SELECT ts, v FROM t ORDER BY ts;
ts	v
2026-01-01 00:00:00	1
2026-01-02 00:00:00	2
2026-01-03 00:00:00	3
2026-01-04 00:00:00	4
# A transaction mixing both kinds of table: nothing is rolled back
BEGIN;
INSERT INTO c VALUES ('2026-01-01', 'a', 1);
INSERT INTO t VALUES ('2026-01-05', 'a', 5);
ROLLBACK;
Warnings:
Warning	1196	Some non-transactional changed tables couldn't be rolled back
SELECT COUNT(*) FROM c;
COUNT(*)
1
SELECT COUNT(*) FROM t;
COUNT(*)
5
# autocommit=0 does not delay visibility or durability of rows
SET autocommit = 0;
INSERT INTO t VALUES ('2026-01-06', 'a', 6);
connect  other,localhost,root,,test;
SELECT COUNT(*) FROM t;
COUNT(*)
6
disconnect other;
connection default;
ROLLBACK;
Warnings:
Warning	1196	Some non-transactional changed tables couldn't be rolled back
SELECT COUNT(*) FROM t;
COUNT(*)
6
SET autocommit = 1;
# LOCK TABLES
LOCK TABLES t WRITE;
INSERT INTO t VALUES ('2026-01-07', 'a', 7);
SELECT COUNT(*) FROM t;
COUNT(*)
7
UNLOCK TABLES;
LOCK TABLES t READ;
INSERT INTO t VALUES ('2026-01-08', 'a', 8);
ERROR HY000: Table 't' was locked with a READ lock and can't be updated
UNLOCK TABLES;
LOCK TABLES t WRITE, c WRITE;
INSERT INTO t SELECT ts, host, v FROM c;
INSERT INTO c SELECT ts, host, v FROM t;
SELECT COUNT(*) FROM t;
COUNT(*)
8
SELECT COUNT(*) FROM c;
COUNT(*)
9
UNLOCK TABLES;
TRUNCATE TABLE t;
TRUNCATE TABLE c;
# ---- INSERT IGNORE / REPLACE / ON DUPLICATE KEY ----
# Not-null violations are warnings under IGNORE, like in the control table
INSERT IGNORE INTO t VALUES ('2026-02-01', 'a', 1), ('2026-02-02', NULL, 2), ('2026-02-03', 'b', NULL), ('2026-02-04', 'c', 3);
Warnings:
Warning	1048	Column 'host' cannot be null
Warning	1048	Column 'v' cannot be null
INSERT IGNORE INTO c VALUES ('2026-02-01', 'a', 1), ('2026-02-02', NULL, 2), ('2026-02-03', 'b', NULL), ('2026-02-04', 'c', 3);
Warnings:
Warning	1048	Column 'host' cannot be null
Warning	1048	Column 'v' cannot be null
SELECT ts, host, v FROM t ORDER BY ts;
ts	host	v
2026-02-01 00:00:00	a	1
2026-02-02 00:00:00		2
2026-02-03 00:00:00	b	0
2026-02-04 00:00:00	c	3
SELECT ts, host, v FROM c ORDER BY ts;
ts	host	v
2026-02-01 00:00:00	a	1
2026-02-02 00:00:00		2
2026-02-03 00:00:00	b	0
2026-02-04 00:00:00	c	3
# There is no unique key, so REPLACE and ON DUPLICATE KEY UPDATE never find
# a duplicate: they behave as plain INSERT (same as MyISAM without keys)
REPLACE INTO t VALUES ('2026-03-01', 'a', 1);
REPLACE INTO t VALUES ('2026-03-01', 'a', 1);
INSERT INTO t VALUES ('2026-03-01', 'a', 1) ON DUPLICATE KEY UPDATE v = 99;
REPLACE INTO c VALUES ('2026-03-01', 'a', 1);
REPLACE INTO c VALUES ('2026-03-01', 'a', 1);
INSERT INTO c VALUES ('2026-03-01', 'a', 1) ON DUPLICATE KEY UPDATE v = 99;
SELECT COUNT(*), SUM(v) FROM t WHERE ts = '2026-03-01';
COUNT(*)	SUM(v)
3	3
SELECT COUNT(*), SUM(v) FROM c WHERE ts = '2026-03-01';
COUNT(*)	SUM(v)
3	3
REPLACE INTO t SELECT ts, host, v FROM t WHERE ts = '2026-03-01';
SELECT COUNT(*) FROM t WHERE ts = '2026-03-01';
COUNT(*)
6
# ---- Multi-row statements failing in the middle ----
# Rows before the failing one stay (no statement rollback), as in MyISAM
INSERT INTO t VALUES ('2026-05-01', 'a', 1), ('0000-00-00', 'a', 2), ('2026-05-03', 'a', 3);
ERROR HY000: Got error 1205 'column 'ts': zero or partial dates cannot be stored' from MooseDB
INSERT INTO t VALUES ('2026-05-04', 'a', 4), ('2026-05-05', 'a', 5), ('2026-05-06', 'a', 6);
SELECT COUNT(*) FROM t WHERE ts >= '2026-05-01';
COUNT(*)
4
SET sql_mode = '';
INSERT INTO t VALUES ('2026-05-10', 'a', 1), ('0000-00-00', 'a', 2), ('2026-05-12', 'a', 3);
ERROR HY000: Got error 1205 'column 'ts': zero or partial dates cannot be stored' from MooseDB
# IGNORE does not downgrade this engine error to a warning
INSERT IGNORE INTO t VALUES ('2026-05-20', 'a', 1), ('0000-00-00', 'a', 2), ('2026-05-22', 'a', 3);
ERROR HY000: Got error 1205 'column 'ts': zero or partial dates cannot be stored' from MooseDB
SET sql_mode = DEFAULT;
SELECT ts FROM t WHERE ts >= '2026-05-10' ORDER BY ts;
ts
2026-05-10 00:00:00
2026-05-20 00:00:00
# Data too long / NULL / bad numeric values are caught by the server
INSERT INTO t VALUES ('2026-06-01', 'toolongvalue', 1);
ERROR 22001: Data too long for column 'host' at row 1
INSERT INTO t VALUES ('2026-06-02', 'a', NULL);
ERROR 23000: Column 'v' cannot be null
INSERT INTO t VALUES ('2026-06-03', 'a', 'abc');
ERROR 22007: Incorrect integer value: 'abc' for column `test`.`t`.`v` at row 1
INSERT INTO t VALUES ('not a date', 'a', 1);
ERROR 22007: Incorrect datetime value: 'not a date' for column `test`.`t`.`ts` at row 1
INSERT INTO t VALUES ('2026-06-04', 'a');
ERROR 21S01: Column count doesn't match value count at row 1
INSERT INTO t (host, v) VALUES ('a', 1);
ERROR HY000: Field 'ts' doesn't have a default value
SELECT COUNT(*) FROM t WHERE ts >= '2026-06-01';
COUNT(*)
0
# A failing statement leaves the table usable
INSERT INTO t VALUES ('2026-06-05', 'ok', 5);
SELECT host, v FROM t WHERE ts >= '2026-06-01';
host	v
ok	5
# ---- INSERT ... SELECT ----
TRUNCATE TABLE t;
TRUNCATE TABLE c;
# Error half way: the rows produced so far are kept, as in the control
INSERT INTO t SELECT '2026-07-01' + INTERVAL seq DAY, 'a', 10 DIV (5 - seq) FROM seq_0_to_9;
ERROR 22003: BIGINT UNSIGNED value is out of range in '5 - `test`.`seq_0_to_9`.`seq`'
INSERT INTO c SELECT '2026-07-01' + INTERVAL seq DAY, 'a', 10 DIV (5 - seq) FROM seq_0_to_9;
ERROR 22003: BIGINT UNSIGNED value is out of range in '5 - `test`.`seq_0_to_9`.`seq`'
SELECT COUNT(*), SUM(v) FROM t;
COUNT(*)	SUM(v)
6	22
SELECT COUNT(*), SUM(v) FROM c;
COUNT(*)	SUM(v)
6	22
TRUNCATE TABLE t;
TRUNCATE TABLE c;
# 200000 rows in one statement (several MemTable flushes and chunks)
INSERT INTO t SELECT '2026-01-01' + INTERVAL seq SECOND, CONCAT('h', seq MOD 50), seq FROM seq_0_to_199999;
SELECT COUNT(*), SUM(v), MIN(ts), MAX(ts), COUNT(DISTINCT host) FROM t;
COUNT(*)	SUM(v)	MIN(ts)	MAX(ts)	COUNT(DISTINCT host)
200000	19999900000	2026-01-01 00:00:00	2026-01-03 07:33:19	50
SELECT CHUNKS > 1 AS several_chunks, ROW_COUNT FROM information_schema.MOOSEDB_TABLES WHERE TABLE_NAME = 't';
several_chunks	ROW_COUNT
1	200000
# Reading and writing the same table in one statement (snapshot semantics)
INSERT INTO t SELECT ts + INTERVAL 1 YEAR, host, v FROM t;
SELECT COUNT(*), SUM(v) FROM t;
COUNT(*)	SUM(v)
400000	39999800000
INSERT INTO t SELECT ts + INTERVAL 2 YEAR, host, v FROM t WHERE host = 'h7';
SELECT COUNT(*) FROM t;
COUNT(*)
408000
# An empty source adds nothing
INSERT INTO t SELECT ts, host, v FROM t WHERE ts < '2000-01-01';
SELECT COUNT(*) FROM t;
COUNT(*)
408000
TRUNCATE TABLE t;
# ---- LOAD DATA ----
CREATE TABLE src (ts DATETIME NOT NULL, host VARCHAR(8) NOT NULL, v INT NOT NULL) ENGINE=MyISAM;
INSERT INTO src SELECT '2026-01-01' + INTERVAL seq MINUTE, CONCAT('h', seq MOD 7), seq FROM seq_0_to_9999;
SELECT * FROM src INTO OUTFILE 'VARDIR/tmp/tf_load.txt';
LOAD DATA INFILE 'VARDIR/tmp/tf_load.txt' INTO TABLE t;
SELECT COUNT(*), SUM(v), MIN(ts), MAX(ts), COUNT(DISTINCT host) FROM t;
COUNT(*)	SUM(v)	MIN(ts)	MAX(ts)	COUNT(DISTINCT host)
10000	49995000	2026-01-01 00:00:00	2026-01-07 22:39:00	7
SELECT COUNT(*) FROM t WHERE host = 'h3';
COUNT(*)
1429
# LOAD DATA with IGNORE/REPLACE and a duplicated file adds rows again
LOAD DATA INFILE 'VARDIR/tmp/tf_load.txt' IGNORE INTO TABLE t;
LOAD DATA INFILE 'VARDIR/tmp/tf_load.txt' REPLACE INTO TABLE t;
SELECT COUNT(*) FROM t;
COUNT(*)
30000
# Rows are durable at statement end: they survive a flush
FLUSH TABLES t;
SELECT COUNT(*), SUM(v) FROM t;
COUNT(*)	SUM(v)
30000	149985000
TRUNCATE TABLE t;
# Bad lines: rejected rows stop the load in strict mode, the good ones before stay
LOAD DATA INFILE 'VARDIR/tmp/tf_bad.txt' INTO TABLE t;
ERROR HY000: Got error 1205 'column 'ts': zero or partial dates cannot be stored' from MooseDB
SELECT host FROM t ORDER BY ts;
host
a
b
TRUNCATE TABLE t;
# IGNORE does not skip the row either; the rows before it stay
LOAD DATA INFILE 'VARDIR/tmp/tf_bad.txt' IGNORE INTO TABLE t;
ERROR HY000: Got error 1205 'column 'ts': zero or partial dates cannot be stored' from MooseDB
SELECT host FROM t ORDER BY ts;
host
a
b
DROP TABLE src;
TRUNCATE TABLE t;
# ---- UPDATE / DELETE / multi-table statements ----
INSERT INTO t VALUES ('2026-01-01', 'a', 1), ('2026-01-02', 'b', 2);
INSERT INTO c VALUES ('2026-01-01', 'a', 1), ('2026-01-02', 'b', 2);
UPDATE t SET v = v + 1;
ERROR HY000: Storage engine MooseDB of the table `test`.`t` doesn't have this option
UPDATE t SET v = 0 WHERE host = 'a';
ERROR HY000: Storage engine MooseDB of the table `test`.`t` doesn't have this option
UPDATE t SET v = 0 ORDER BY ts LIMIT 1;
ERROR HY000: Storage engine MooseDB of the table `test`.`t` doesn't have this option
UPDATE t, c SET t.v = c.v + 100 WHERE t.host = c.host;
ERROR HY000: Storage engine MooseDB of the table `test`.`t` doesn't have this option
UPDATE c, t SET t.v = 7 WHERE t.host = c.host;
ERROR HY000: Storage engine MooseDB of the table `test`.`t` doesn't have this option
# DELETE is supported (delete.test): range, ORDER BY/LIMIT and multi-table forms
DELETE FROM t WHERE ts < '2030-01-01';
SELECT ROW_COUNT();
ROW_COUNT()
2
INSERT INTO t VALUES ('2026-01-01', 'a', 1), ('2026-01-02', 'b', 2);
DELETE FROM t ORDER BY ts LIMIT 1;
SELECT ROW_COUNT();
ROW_COUNT()
1
SELECT ts, host, v FROM t;
ts	host	v
2026-01-02 00:00:00	b	2
INSERT INTO t VALUES ('2026-01-01', 'a', 1);
DELETE t FROM t JOIN c ON t.host = c.host;
SELECT ROW_COUNT();
ROW_COUNT()
2
INSERT INTO t VALUES ('2026-01-01', 'a', 1), ('2026-01-02', 'b', 2);
# An impossible WHERE never reaches the engine
DELETE FROM t WHERE 1 = 0;
UPDATE t SET v = 0 WHERE 1 = 0;
# A MooseDB table can be the source of a subquery in a statement on another engine
UPDATE c SET v = 0 WHERE host IN (SELECT host FROM t);
SELECT SUM(v) FROM c;
SUM(v)
0
SELECT ts, host, v FROM t ORDER BY ts;
ts	host	v
2026-01-01 00:00:00	a	1
2026-01-02 00:00:00	b	2
DELETE FROM c WHERE host IN (SELECT host FROM t);
SELECT COUNT(*) FROM c;
COUNT(*)
0
SELECT COUNT(*) FROM t;
COUNT(*)
2
# DELETE without WHERE empties the table
DELETE FROM t;
SELECT COUNT(*) FROM t;
COUNT(*)
0
DROP TABLE t, c;
