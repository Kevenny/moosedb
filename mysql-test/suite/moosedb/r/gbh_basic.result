##########################################################
# Session counters
##########################################################
SET SESSION moosedb_group_by_pushdown = ON;
SELECT COUNT(*) FROM (SELECT host FROM g GROUP BY host) x;
COUNT(*)
23
# a derived table is not taken over: counter moved by
# counter moved by 0
SET SESSION moosedb_group_by_pushdown = DEFAULT;
DROP DATABASE mirror;
DROP TABLE g, b, tsx, fr;
