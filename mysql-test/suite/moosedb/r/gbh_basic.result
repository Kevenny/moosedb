CREATE TABLE g (
ts      DATETIME NOT NULL,
host    VARCHAR(16) NOT NULL COMMENT 'TAG',
iface   INT NOT NULL COMMENT 'TAG',
proc    VARCHAR(24) COMMENT 'TAG',
file    VARCHAR(32),
code    INT,
bytes   BIGINT,
latency INT,
INDEX(ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 DAY';
# 20000 rows in chunks, 10000 more left in the MemTable
INSERT INTO g SELECT '2024-03-01' + INTERVAL seq * 20 SECOND,
CONCAT('h', seq MOD 23), seq MOD 4,
IF(seq MOD 13 = 0, NULL, CONCAT('p', seq MOD 17)),
CONCAT('/f/', seq MOD 41),
IF(seq MOD 9 = 0, NULL, seq MOD 7),
(seq * 7919) MOD 100000 + 5000000000,
IF(seq MOD 5 = 0, NULL, (seq * 31) MOD 997)
FROM seq_0_to_19999;
FLUSH TABLES g;
INSERT INTO g SELECT '2024-03-01' + INTERVAL seq * 20 SECOND,
CONCAT('h', seq MOD 23), seq MOD 4,
IF(seq MOD 13 = 0, NULL, CONCAT('p', seq MOD 17)),
CONCAT('/f/', seq MOD 41),
IF(seq MOD 9 = 0, NULL, seq MOD 7),
(seq * 7919) MOD 100000 + 5000000000,
IF(seq MOD 5 = 0, NULL, (seq * 31) MOD 997)
FROM seq_20000_to_29999;
CREATE DATABASE mirror;
CREATE TABLE mirror.g LIKE test.g;
ALTER TABLE mirror.g ENGINE=InnoDB;
INSERT INTO mirror.g SELECT * FROM test.g;
SELECT (SELECT COUNT(*) FROM test.g) = (SELECT COUNT(*) FROM mirror.g) AS same_rows;
same_rows
1
##########################################################
# Monitoring queries
##########################################################
# top 10 hosts by SUM(bytes) in an interval
# SELECT host, SUM(bytes) s FROM g WHERE ts >= '2024-03-02 00:00:00' AND ts < '2024-03-04 00:00:00' GROUP BY host ORDER BY s DESC, host LIMIT 10
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# top processes of a host: COUNT, AVG, MAX
# SELECT proc, COUNT(*) c, AVG(latency) a, MAX(latency) m FROM g WHERE host = 'h3' GROUP BY proc ORDER BY c DESC, proc LIMIT 5
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# top files by COUNT (plain VARCHAR key)
# SELECT file, COUNT(*) c FROM g GROUP BY file ORDER BY c DESC, file LIMIT 10
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# integer TAG key
# SELECT iface, COUNT(*) c, SUM(bytes) s, MIN(bytes) mn, MAX(bytes) mx FROM g GROUP BY iface ORDER BY iface
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# integer plain column key (NULL group included)
# SELECT code, COUNT(*) c, SUM(latency) s FROM g GROUP BY code ORDER BY code
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# host, process (two TAGs, NULL process group)
# SELECT host, proc, COUNT(*) c FROM g GROUP BY host, proc ORDER BY host, proc LIMIT 20 OFFSET 7
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# TAG and plain column together
# SELECT host, code, COUNT(*) c, SUM(bytes) s FROM g WHERE host IN ('h1','h2','h7') GROUP BY host, code ORDER BY host, code
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# no ORDER BY: the implicit GROUP BY order
# SELECT host, COUNT(*) c FROM g GROUP BY host
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# ORDER BY NULL (any order)
# SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY NULL
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
##########################################################
# NULLs, empty results, implicit group
##########################################################
# one row with NULL key parts and NULL argument
# SELECT host, proc, code, COUNT(*) c, COUNT(latency) cl, SUM(latency) sl, AVG(latency) al, MIN(latency) mnl, MAX(latency) mxl FROM g WHERE ts = '2024-03-01 00:00:00' GROUP BY host, proc, code
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# COUNT(col) vs COUNT(*) and aggregates of mostly NULL arguments
# SELECT host, COUNT(*) c, COUNT(latency) cl, SUM(latency) sl, MIN(latency) mnl, MAX(latency) mxl, COUNT(code) cc FROM g GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# no row matches: no group
# SELECT proc, COUNT(*) c, SUM(bytes) s FROM g WHERE host = 'nobody' GROUP BY proc
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# time range with no data
# SELECT host, COUNT(*) c FROM g WHERE ts >= '2030-01-01' GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# implicit single group over no rows (no GROUP BY: not the engine)
# SELECT COUNT(*) c, SUM(bytes) s, MIN(bytes) m, AVG(latency) a FROM g WHERE host = 'nobody'
# same output with and without pushdown and on InnoDB; the engine did not run it
##########################################################
# Predicates: TAG equality / IN, time bounds
##########################################################
# TAG IN, integer TAG equality, time range with BETWEEN
# SELECT host, COUNT(*) c FROM g WHERE host IN ('h1','h4','h22') AND iface = 2 AND ts BETWEEN '2024-03-01 06:00:00' AND '2024-03-03 12:30:00' GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# TAG IN with an integer list, open time bounds
# SELECT iface, COUNT(*) c FROM g WHERE iface IN (1,3) AND ts > '2024-03-01 00:00:20' AND ts <= '2024-03-05' GROUP BY iface ORDER BY iface
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# constant on the left of the time comparison
# SELECT host, COUNT(*) c FROM g WHERE '2024-03-02 00:00:00' <= ts AND ts < '2024-03-02 01:00:00' GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# a plain column predicate: evaluated by the engine through the column dictionary (gbh_where covers it in depth)
# SELECT host, COUNT(*) c FROM g WHERE file = '/f/3' GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
##########################################################
# SUM / AVG / MIN / MAX
##########################################################
CREATE TABLE b (
d  DATETIME NOT NULL,
k  VARCHAR(8) NOT NULL COMMENT 'TAG',
v  BIGINT,
u  INT UNSIGNED,
w  BIGINT UNSIGNED,
s  SMALLINT,
INDEX(d)
) ENGINE=MooseDB;
INSERT INTO b (d, k, v, u, w, s) VALUES
('2024-05-01 00:00:01', 'a', 4611686018427387904, 4294967295, 18446744073709551615, -32768),
('2024-05-01 00:00:02', 'a', 4611686018427387904, 4294967295, 9223372036854775808, 32767),
('2024-05-01 00:00:03', 'a', 4611686018427387904, 4294967295, 1, 0),
('2024-05-01 00:00:04', 'a', 4611686018427387904, 4294967295, 2, 1),
('2024-05-01 00:00:05', 'b', -9223372036854775807, 1, 0, -1),
('2024-05-01 00:00:06', 'b', -9223372036854775807, 2, 0, -2),
('2024-05-01 00:00:07', 'b', 9223372036854775807, 3, 0, NULL),
('2024-05-01 00:00:08', 'c', NULL, NULL, NULL, NULL),
('2024-05-01 00:00:09', 'c', NULL, NULL, NULL, NULL),
('2024-05-01 00:00:10', 'd', 9223372036854775807, 4294967295, 0, 5),
('2024-05-01 00:00:11', 'd', 9223372036854775807, 4294967295, 0, 6);
CREATE TABLE mirror.b LIKE test.b;
ALTER TABLE mirror.b ENGINE=InnoDB;
INSERT INTO mirror.b SELECT * FROM test.b;
# SUM past 2^63 and below -2^63, MIN, MAX, COUNT of BIGINT
# SELECT k, COUNT(*) c, COUNT(v) cv, SUM(v) sv, AVG(v) av, MIN(v) mnv, MAX(v) mxv FROM b GROUP BY k ORDER BY k
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# SUM / AVG / MIN / MAX of INT UNSIGNED and SMALLINT
# SELECT k, SUM(u) su, AVG(u) au, MIN(u) mnu, MAX(u) mxu, SUM(s) ss, AVG(s) aas, MIN(s) mns, MAX(s) mxs FROM b GROUP BY k ORDER BY k
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# BIGINT UNSIGNED aggregates do not fit the core: refused, same answer
# SELECT k, SUM(w) sw, MIN(w) mnw, MAX(w) mxw FROM b GROUP BY k ORDER BY k
# same output with and without pushdown and on InnoDB; the engine did not run it
# MIN / MAX of the time axis
# SELECT k, MIN(d) first_d, MAX(d) last_d FROM b GROUP BY k ORDER BY k
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# AVG with div_precision_increment 0
# SELECT host, AVG(latency) a, AVG(bytes) b FROM g GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# AVG with div_precision_increment 4
# SELECT host, AVG(latency) a, AVG(bytes) b FROM g GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# AVG with div_precision_increment 30
# SELECT host, AVG(latency) a, AVG(bytes) b FROM g GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# AVG of BIGINT near 2^63 with div_precision_increment 30
# SELECT k, AVG(v) av FROM b GROUP BY k ORDER BY k
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
##########################################################
# HAVING, ORDER BY, LIMIT / OFFSET
##########################################################
# HAVING on the aggregate and on a hidden aggregate
# SELECT host, COUNT(*) c FROM g GROUP BY host HAVING c > 1300 AND SUM(bytes) > 0 ORDER BY host
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# HAVING on the key moves to the WHERE as a TAG range: not captured, refused
# SELECT host, COUNT(*) c FROM g GROUP BY host HAVING host > 'h2' ORDER BY c, host
# same output with and without pushdown and on InnoDB; the engine did not run it
# HAVING with LIMIT and OFFSET (top-N must not cut before HAVING)
# SELECT host, SUM(bytes) s FROM g GROUP BY host HAVING s > 0 AND COUNT(*) > 1300 ORDER BY s DESC LIMIT 3 OFFSET 1
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# ORDER BY aggregate ASC
# SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY c, host
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# ORDER BY aggregate DESC, key DESC
# SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY c DESC, host DESC
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# ORDER BY key DESC with LIMIT
# SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY host DESC LIMIT 4
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# ORDER BY AVG DESC (after the division)
# SELECT host, AVG(latency) a FROM g GROUP BY host ORDER BY a DESC, host LIMIT 6
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# ORDER BY MIN / MAX of the time axis, NULL aggregates first
# SELECT host, MIN(ts) t0, MAX(ts) t1, MAX(latency) m FROM g GROUP BY host ORDER BY t1 DESC, t0, host LIMIT 5
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# ORDER BY an aggregate that is not selected
# SELECT host FROM g GROUP BY host ORDER BY SUM(bytes) DESC, host LIMIT 5
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# ORDER BY SUM with NULL sums
# SELECT code, SUM(latency) s FROM g WHERE ts < '2024-03-01 00:01:00' GROUP BY code ORDER BY s, code
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# LIMIT 0 (the server answers it without the hook)
# SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY host LIMIT 0
# same output with and without pushdown and on InnoDB; the engine did not run it
# LIMIT beyond the number of groups, OFFSET beyond too
# SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY host LIMIT 100 OFFSET 20
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# LIMIT without ORDER BY (implicit order)
# SELECT host, COUNT(*) c FROM g GROUP BY host LIMIT 3 OFFSET 2
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# FOUND_ROWS() after a pushed-down LIMIT
# SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY host LIMIT 3; SELECT FOUND_ROWS();
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# FOUND_ROWS() with HAVING and OFFSET
# SELECT host, COUNT(*) c FROM g GROUP BY host HAVING c > 1300 ORDER BY host LIMIT 4 OFFSET 1; SELECT FOUND_ROWS();
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# SQL_CALC_FOUND_ROWS is refused (the server leaves FOUND_ROWS stale)
# SELECT SQL_CALC_FOUND_ROWS host, COUNT(*) c FROM g GROUP BY host ORDER BY host LIMIT 3; SELECT FOUND_ROWS();
# same output with and without pushdown and on InnoDB; the engine did not run it
##########################################################
# PREPARE / EXECUTE, EXPLAIN
##########################################################
# the plan is rebuilt at each EXECUTE with the new parameters
# EXECUTE p USING @a, @b, @c, @d; SET @a = '2024-03-04', @b = '2024-03-06', @c = 'h9', @d = 'h5'; EXECUTE p USING @a, @b, @c, @d;
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=2)
# a session variable changed between EXECUTEs
# EXECUTE p;
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=1 ON=1)
SET SESSION moosedb_group_by_pushdown = 1;
# EXPLAIN shows the engine handles the GROUP BY (and opens nothing)
EXPLAIN SELECT host, COUNT(*) c FROM g GROUP BY host;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	NULL	NULL	NULL	NULL	NULL	NULL	NULL	Storage engine handles GROUP BY
EXPLAIN FORMAT=JSON SELECT host, COUNT(*) c FROM g WHERE host = 'h1' GROUP BY host;
EXPLAIN
{
  "query_block": {
    "select_id": 1,
    "cost": 24.3560666,
    "nested_loop": [
      {
        "table": {
          "table_name": "g",
          "access_type": "ALL",
          "loops": 1,
          "rows": 30000,
          "cost": 4.3248636,
          "filtered": 100,
          "attached_condition": "g.`host` = 'h1'"
        }
      }
    ]
  }
}
EXPLAIN SELECT host, COUNT(*) c FROM g WHERE file = '/f/1' GROUP BY host;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	NULL	NULL	NULL	NULL	NULL	NULL	NULL	Storage engine handles GROUP BY
SET SESSION moosedb_group_by_pushdown = 0;
EXPLAIN SELECT host, COUNT(*) c FROM g GROUP BY host;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	g	ALL	NULL	NULL	NULL	NULL	30000	Using temporary; Using filesort
SET SESSION moosedb_group_by_pushdown = DEFAULT;
##########################################################
# DELETE (tombstones), MemTable and chunks together
##########################################################
DELETE FROM test.g WHERE host = 'h5' AND ts < '2024-03-03';
DELETE FROM mirror.g WHERE host = 'h5' AND ts < '2024-03-03';
DELETE FROM test.g WHERE ts >= '2024-03-06 12:00:00' AND iface = 1;
DELETE FROM mirror.g WHERE ts >= '2024-03-06 12:00:00' AND iface = 1;
SELECT (SELECT COUNT(*) FROM test.g) = (SELECT COUNT(*) FROM mirror.g) AS same_rows_after_delete;
same_rows_after_delete
1
# after DELETE: counts and sums per host
# SELECT host, COUNT(*) c, SUM(bytes) s, MIN(ts) t0, MAX(ts) t1 FROM g GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# after DELETE: integer TAG
# SELECT iface, COUNT(*) c, MAX(latency) m FROM g GROUP BY iface ORDER BY iface
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# after DELETE: a host that lost rows, by time range
# SELECT iface, COUNT(*) c FROM g WHERE host = 'h5' AND ts < '2024-03-04' GROUP BY iface ORDER BY iface
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
OPTIMIZE TABLE test.g;
Table	Op	Msg_type	Msg_text
test.g	optimize	status	OK
# after OPTIMIZE (compacted chunks)
# SELECT host, COUNT(*) c, SUM(bytes) s FROM g GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
##########################################################
# One thread and many threads give the same answer
##########################################################
SET GLOBAL moosedb_agg_threads = 1;
# threads = 1
# SELECT host, proc, COUNT(*) c, SUM(bytes) s, AVG(latency) a FROM g GROUP BY host, proc ORDER BY host, proc
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
SET GLOBAL moosedb_agg_threads = 8;
# threads = 8
# SELECT host, proc, COUNT(*) c, SUM(bytes) s, AVG(latency) a FROM g GROUP BY host, proc ORDER BY host, proc
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
SET GLOBAL moosedb_agg_threads = DEFAULT;
##########################################################
# Refused shapes keep their answer
##########################################################
# expression over an aggregate
# SELECT host, SUM(bytes) / 2 q FROM g GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the engine did not run it
# COUNT(DISTINCT)
# SELECT host, COUNT(DISTINCT code) c FROM g GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the engine did not run it
# GROUP BY the time column
# SELECT ts, COUNT(*) c FROM g WHERE ts < '2024-03-01 00:01:00' GROUP BY ts ORDER BY ts
# same output with and without pushdown and on InnoDB; the engine did not run it
# derived table
# SELECT * FROM (SELECT host, COUNT(*) c FROM g GROUP BY host) d ORDER BY host
# same output with and without pushdown and on InnoDB; the engine did not run it
# ROLLUP
# SELECT host, COUNT(*) c FROM g WHERE host < 'h2' GROUP BY host WITH ROLLUP
# same output with and without pushdown and on InnoDB; the engine did not run it
##########################################################
# Review fixes
##########################################################
# COUNT of a TAG column is refused (the core cannot), same answer
# SELECT host, COUNT(host) c FROM g GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the engine did not run it
# COUNT of an integer TAG is refused too
# SELECT iface, COUNT(iface) c FROM g GROUP BY iface ORDER BY iface
# same output with and without pushdown and on InnoDB; the engine did not run it
# COUNT of a plain column is done by the engine
# SELECT host, COUNT(file) cf, COUNT(code) cc FROM g GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# COUNT(constant that is NULL) counts nothing: refused, same answer
# SELECT host, COUNT(NULLIF(1,1)) a, COUNT(CAST(NULL AS SIGNED)) b, COUNT(IF(1,NULL,2)) c FROM g GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the engine did not run it
# COUNT(non-NULL constant) is COUNT(*)
# SELECT host, COUNT(1) a, COUNT(7) b FROM g GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# the same key twice in the select list
# SELECT host, host h2, COUNT(*) c FROM g GROUP BY host ORDER BY host LIMIT 4
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# aggregate before the key
# SELECT COUNT(*) c, host FROM g GROUP BY host ORDER BY host LIMIT 4
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# keys only in ORDER BY and HAVING
# SELECT COUNT(*) c FROM g GROUP BY host, iface HAVING iface = 2 AND SUM(bytes) > 0 ORDER BY host DESC, iface LIMIT 5
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# GROUP BY a BIGINT UNSIGNED column with the high bit set (unsigned order)
# SELECT w, COUNT(*) c, SUM(s) ss FROM b GROUP BY w ORDER BY w DESC
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# GROUP BY a BIGINT UNSIGNED column, ASC
# SELECT w, COUNT(*) c FROM b GROUP BY w ORDER BY w
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# LOCK TABLES ... READ around the aggregate
# SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY host LIMIT 3; UNLOCK TABLES;
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
CREATE TABLE tsx (
ts TIMESTAMP NOT NULL,
k  VARCHAR(8) NOT NULL COMMENT 'TAG',
n  INT,
INDEX(ts)
) ENGINE=MooseDB;
INSERT INTO tsx VALUES ('2024-02-01 00:00:01', 'a', 1), ('2024-02-01 00:00:02', 'a', 2), ('2024-02-01 00:00:03', 'b', 3);
CREATE TABLE mirror.tsx LIKE test.tsx;
ALTER TABLE mirror.tsx ENGINE=InnoDB;
INSERT INTO mirror.tsx SELECT * FROM test.tsx;
# a TIMESTAMP axis with a time bound is refused (not captured), same answer
# SELECT k, COUNT(*) c, SUM(n) s FROM tsx WHERE ts >= '2024-02-01 00:00:02' GROUP BY k ORDER BY k
# same output with and without pushdown and on InnoDB; the engine did not run it
# a TIMESTAMP axis without a time bound is fine
# SELECT k, COUNT(*) c, SUM(n) s FROM tsx GROUP BY k ORDER BY k
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# Fractions beyond 6 digits in a time bound: the engine uses the server's
# own conversion (flags and rounding of the comparison)
CREATE TABLE fr (
ts DATETIME(6) NOT NULL,
k  VARCHAR(8) NOT NULL COMMENT 'TAG',
n  INT,
INDEX(ts)
) ENGINE=MooseDB;
INSERT INTO fr VALUES
('2024-01-01 00:00:20.999998', 'a', 1), ('2024-01-01 00:00:20.999999', 'a', 2),
('2024-01-01 00:00:21.000000', 'b', 4), ('2024-01-01 00:00:21.000001', 'b', 8),
('2024-01-01 00:00:21.000002', 'c', 16);
CREATE TABLE mirror.fr LIKE test.fr;
ALTER TABLE mirror.fr ENGINE=InnoDB;
INSERT INTO mirror.fr SELECT * FROM test.fr;
# fraction < (string)
# SELECT k, COUNT(*) c, SUM(n) s FROM fr WHERE ts < '2024-01-01 00:00:20.9999995' GROUP BY k ORDER BY k
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# fraction <= (string)
# SELECT k, COUNT(*) c, SUM(n) s FROM fr WHERE ts <= '2024-01-01 00:00:20.9999995' GROUP BY k ORDER BY k
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# fraction > (string)
