##########################################################
# The key shown for a merged group is the smallest by raw bytes
# (the server shows whichever spelling it met first), so it is
# checked on the engine alone
##########################################################
CREATE TABLE t (
ts DATETIME NOT NULL,
tg VARCHAR(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL COMMENT 'TAG',
v INT,
INDEX(ts)
) ENGINE=MooseDB;
INSERT INTO t VALUES ('2024-01-01 00:00:01', 'a', 1), ('2024-01-01 00:00:02', 'A', 2),
('2024-01-01 00:00:03', 'b', 3), ('2024-01-01 00:00:04', 'a ', 4), ('2024-01-01 00:00:05', 'B', 5),
('2024-01-01 00:00:06', 'á', 6);
SET SESSION moosedb_group_by_pushdown = ON;
SELECT tg, COUNT(*) c, SUM(v) s FROM t GROUP BY tg ORDER BY tg;
tg	c	s
A	4	13
B	2	8
SET SESSION moosedb_group_by_pushdown = DEFAULT;
DROP TABLE t;
DROP DATABASE mirror;
