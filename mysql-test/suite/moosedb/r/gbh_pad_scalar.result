CREATE TABLE p (
ts   DATETIME NOT NULL,
host VARCHAR(16) NOT NULL COMMENT 'TAG',
kp   VARCHAR(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin,
kl   VARCHAR(8) CHARACTER SET latin1 COLLATE latin1_bin,
ku   VARCHAR(8) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin,
kb   VARCHAR(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_nopad_bin,
kc   VARCHAR(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci,
v    BIGINT NOT NULL,
bg   BIGINT NOT NULL,
w    INT,
INDEX(ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 DAY';
CREATE TABLE e (
ts   DATETIME NOT NULL,
host VARCHAR(16) NOT NULL COMMENT 'TAG',
kp   VARCHAR(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin,
v    BIGINT NOT NULL,
w    INT,
INDEX(ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 DAY';
# classes of kp under PAD SPACE: {a, 'a ', 'a   '}, {'', '  '}, 'a<0x01>', 'a<TAB>', ' a', 'a b', 'b', NULL
# 20000 rows in chunks, 10000 more in the MemTable
INSERT INTO p SELECT '2024-03-01' + INTERVAL seq * 20 SECOND, CONCAT('h', seq MOD 5),
k, k, k, k, k, (seq * 37) MOD 1000, 9223372036854775807 - seq MOD 3,
IF(seq MOD 4 = 0, NULL, seq MOD 50)
FROM (SELECT seq, ELT(seq MOD 11 + 1, 'a', 'a ', 'a   ', '', '  ', CONCAT('a', CHAR(1)), CONCAT('a', CHAR(9)), ' a', 'a b ', 'b', NULL) k
FROM seq_0_to_19999) x;
FLUSH TABLES p;
INSERT INTO p SELECT '2024-03-01' + INTERVAL seq * 20 SECOND, CONCAT('h', seq MOD 5),
k, k, k, k, k, (seq * 37) MOD 1000, 9223372036854775807 - seq MOD 3,
IF(seq MOD 4 = 0, NULL, seq MOD 50)
FROM (SELECT seq, ELT(seq MOD 11 + 1, 'a', 'a ', 'a   ', '', '  ', CONCAT('a', CHAR(1)), CONCAT('a', CHAR(9)), ' a', 'a b ', 'b', NULL) k
FROM seq_20000_to_29999) x;
CREATE DATABASE mirror;
CREATE TABLE mirror.p LIKE test.p;
ALTER TABLE mirror.p ENGINE=InnoDB;
INSERT INTO mirror.p SELECT * FROM test.p;
CREATE TABLE mirror.e LIKE test.e;
ALTER TABLE mirror.e ENGINE=InnoDB;
##########################################################
# PAD SPACE keys: one group per class, one of its values as the key
##########################################################
# groups (a, 'a ' and 'a   ' are one group; '' and '  ' too)
# SELECT kp, COUNT(*) c, SUM(v) s, MIN(ts) t FROM p GROUP BY kp ORDER BY kp
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=0
# groups (a, 'a ' and 'a   ' are one group; '' and '  ' too)
# SELECT kl, COUNT(*) c FROM p GROUP BY kl ORDER BY kl
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=0
# groups (a, 'a ' and 'a   ' are one group; '' and '  ' too)
# SELECT ku, COUNT(*) c FROM p GROUP BY ku ORDER BY ku
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=0
# PAD SPACE key together with a TAG
# SELECT host, kp, COUNT(*) c FROM p GROUP BY host, kp ORDER BY host, kp
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=0
##########################################################
# Core top-N on PAD SPACE keys (topn=1): ties at the LIMIT boundary follow the
# collation order, not the byte order ('a<0x01>' sorts before 'a': 0x01 < ' ')
##########################################################
# ORDER BY aggregate DESC, key
# SELECT kp, COUNT(*) c FROM p GROUP BY kp ORDER BY c DESC, kp LIMIT 1
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=1
# ORDER BY aggregate DESC, key
# SELECT kp, COUNT(*) c FROM p GROUP BY kp ORDER BY c DESC, kp LIMIT 2
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=1
# ORDER BY aggregate DESC, key
# SELECT kp, COUNT(*) c FROM p GROUP BY kp ORDER BY c DESC, kp LIMIT 4
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=1
# ORDER BY aggregate DESC, key
# SELECT kp, COUNT(*) c FROM p GROUP BY kp ORDER BY c DESC, kp LIMIT 20
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=1
# ORDER BY aggregate ASC, key (the singletons tie)
# SELECT kp, COUNT(*) c FROM p GROUP BY kp ORDER BY c, kp LIMIT 3
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=1
# ORDER BY aggregate ASC, key (the singletons tie)
# SELECT kp, COUNT(*) c FROM p GROUP BY kp ORDER BY c, kp LIMIT 4 OFFSET 2
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=1
# ORDER BY aggregate ASC, key (the singletons tie)
# SELECT kp, COUNT(*) c FROM p GROUP BY kp ORDER BY c, kp LIMIT 100
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=1
# other aggregates, filters
# SELECT kp, SUM(v) s FROM p WHERE ts >= '2024-03-04' GROUP BY kp ORDER BY s DESC, kp LIMIT 3
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=1
# other aggregates, filters
# SELECT kp, MIN(ts) t FROM p GROUP BY kp ORDER BY t, kp LIMIT 5
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=1
# other aggregates, filters
# SELECT kp, MAX(ts) t FROM p WHERE host = 'h1' GROUP BY kp ORDER BY t DESC, kp LIMIT 5
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=1
# other aggregates, filters
# SELECT kp, COUNT(w) c FROM p WHERE v > 500 GROUP BY kp ORDER BY c DESC, kp LIMIT 4
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=1
# other aggregates, filters
# SELECT kp, COUNT(*) c FROM p WHERE kp IN ('a', 'b ', '') GROUP BY kp ORDER BY c DESC, kp LIMIT 2
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=1 core top-N=1
# other aggregates, filters
# SELECT kp, COUNT(*) c FROM p WHERE kp LIKE 'a%' GROUP BY kp ORDER BY c DESC, kp LIMIT 3
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=1
# latin1_bin and utf8mb3_bin
# SELECT kl, COUNT(*) c FROM p GROUP BY kl ORDER BY c DESC, kl LIMIT 3
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=1
# latin1_bin and utf8mb3_bin
# SELECT ku, COUNT(*) c FROM p GROUP BY ku ORDER BY c, ku LIMIT 4
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=1
# a single ORDER BY term without ties at the boundary
# SELECT kp, SUM(v) s FROM p WHERE kp IN ('a', 'a ', 'b') GROUP BY kp ORDER BY s DESC LIMIT 1
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=1 core top-N=1
##########################################################
# Still without the core top-N (topn=0, same answer)
##########################################################
# case-insensitive key, key DESC in the second term
# SELECT kc, COUNT(*) c FROM p GROUP BY kc ORDER BY c DESC, kc LIMIT 3
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=0
# case-insensitive key, key DESC in the second term
# SELECT kp, COUNT(*) c FROM p GROUP BY kp ORDER BY c DESC, kp DESC LIMIT 3
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=0
