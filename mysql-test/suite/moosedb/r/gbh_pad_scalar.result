##########################################################
# The key of a PAD SPACE group is its SHORTEST real member (bytes shown with cat -A,
# end of line shown as a dollar sign by cat -A, a tab as ^I, spaces are visible before it)
##########################################################
CREATE TABLE r (ts DATETIME NOT NULL, host VARCHAR(8) NOT NULL COMMENT 'TAG', k VARCHAR(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO r VALUES ('2024-03-01 00:00:01', 'a', 'x   '), ('2024-03-01 00:00:02', 'a', 'x  '), ('2024-03-01 00:00:03', 'a', 'y '),
('2024-03-01 00:00:04', 'a', 'w'), ('2024-03-01 00:00:05', 'b', 'v '), ('2024-03-01 00:00:06', 'b', 'a b ');
FLUSH TABLES r;
INSERT INTO r VALUES ('2024-03-01 00:00:07', 'b', 'x    '), ('2024-03-01 00:00:08', 'b', 'y   '), ('2024-03-01 00:00:09', 'b', 'y'),
('2024-03-01 00:00:10', 'a', 'v   '), ('2024-03-01 00:00:11', 'a', NULL), ('2024-03-01 00:00:12', 'a', 'u  '), ('2024-03-01 00:00:13', 'a', '  ');
# expected: u (3 chars), v (2: the chunk row beats the MemTable 4), w, x (3), y (1: from the MemTable), 'a b ' (alone, keeps its space), '  ' (alone: the trimmed '' is not a member, so it is not returned), NULL
NULL^I1$
  ^I1$
a b ^I1$
u  ^I1$
v ^I2$
w^I1$
x  ^I3$
y^I3$
x  ^I3$
y^I3$
v ^I2$
NULL^I1$
