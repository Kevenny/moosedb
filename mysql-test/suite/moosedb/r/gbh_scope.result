# inside a stored procedure, a function and a trigger
CREATE PROCEDURE pr() BEGIN SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY host; END|
CREATE FUNCTION fn() RETURNS BIGINT DETERMINISTIC BEGIN DECLARE r BIGINT; SELECT SUM(c) INTO r FROM (SELECT COUNT(*) c FROM g GROUP BY host) z; RETURN r; END|
CALL pr();
