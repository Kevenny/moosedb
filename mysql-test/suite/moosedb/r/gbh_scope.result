CREATE TABLE g (
ts     DATETIME NOT NULL,
host   VARCHAR(16) NOT NULL COMMENT 'TAG',
region VARCHAR(8) COMMENT 'TAG',
code   VARCHAR(8),
n      INT,
big    BIGINT,
d      DECIMAL(10,2),
f      DOUBLE,
INDEX(ts)
) ENGINE=MooseDB;
INSERT INTO g SELECT '2024-01-01' + INTERVAL seq * 10 MINUTE,
CONCAT('h', seq MOD 5),
IF(seq MOD 7 = 0, NULL, CONCAT('r', seq MOD 3)),
CONCAT('c', seq MOD 4),
IF(seq MOD 11 = 0, NULL, seq MOD 50),
seq * 1000000007, seq / 4, seq / 3
FROM seq_0_to_399;
CREATE TABLE gi LIKE g;
ALTER TABLE gi ENGINE=InnoDB;
INSERT INTO gi SELECT * FROM g;
FLUSH TABLES g;
##### Switches: pushdown OFF and debug OFF -> no verdict at all
SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY host;
host	c
h0	80
h1	80
h2	80
h3	80
h4	80
SET SESSION moosedb_group_by_pushdown = ON;
SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY host;
host	c
h0	80
h1	80
h2	80
h3	80
h4	80
##### Debug ON, pushdown OFF: the analysis still reports
SET SESSION moosedb_group_by_pushdown = OFF;
SET SESSION moosedb_gbh_debug = ON;
SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY host;
host	c
h0	80
h1	80
h2	80
h3	80
h4	80
Warnings:
Note	1105	gbh: accepted
SET SESSION moosedb_group_by_pushdown = ON;
