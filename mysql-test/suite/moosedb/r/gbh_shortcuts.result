# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=0
# AVG, HAVING, no LIMIT, ORDER BY the key
# SELECT i, SUM(bytes) s FROM g GROUP BY i HAVING s > 100 ORDER BY s DESC LIMIT 3
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=0
# AVG, HAVING, no LIMIT, ORDER BY the key
# SELECT i, SUM(bytes) s FROM g GROUP BY i ORDER BY s DESC
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# shortcuts taken: exact filters=0 core top-N=0
# AVG, HAVING, no LIMIT, ORDER BY the key
