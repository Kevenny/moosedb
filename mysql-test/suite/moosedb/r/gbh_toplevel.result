# the default of the sysvar is ON (this session was not touched)
SELECT @@GLOBAL.moosedb_group_by_pushdown, @@SESSION.moosedb_group_by_pushdown;
@@GLOBAL.moosedb_group_by_pushdown	@@SESSION.moosedb_group_by_pushdown
1	1
CREATE TABLE t (
ts    DATETIME NOT NULL,
host  VARCHAR(16) NOT NULL COMMENT 'TAG',
svc   VARCHAR(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL COMMENT 'TAG',
name  VARCHAR(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci,
amt   DECIMAL(12,3),
n     INT,
INDEX(ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 DAY';
CREATE DATABASE mirror;
CREATE TABLE mirror.t LIKE test.t;
ALTER TABLE mirror.t ENGINE=InnoDB;
# empty table
# empty table, grouped
# SELECT host, COUNT(*) c, SUM(n) s, MIN(n) mn, MAX(n) mx, AVG(n) a FROM t GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the server answered by itself (the engine did not run it)
# empty table, no GROUP BY
# SELECT COUNT(*), SUM(n), MIN(n), MAX(n), AVG(amt) FROM t
# same output with and without pushdown and on InnoDB; the server answered by itself (the engine did not run it)
INSERT INTO t SELECT '2024-05-01' + INTERVAL seq * 90 SECOND, CONCAT('h', seq MOD 7),
ELT(seq MOD 3 + 1, 'Web', 'web', 'DB'),
IF(seq MOD 11 = 0, NULL, ELT(seq MOD 4 + 1, 'Alpha', 'alpha', 'Beta', 'gamma')),
IF(seq MOD 6 = 0, NULL, (seq * 37) MOD 1000 / 8),
IF(seq MOD 5 = 0, NULL, seq MOD 13)
FROM seq_0_to_3999;
FLUSH TABLES t;
# rows still in the MemTable
INSERT INTO t SELECT '2024-05-01' + INTERVAL seq * 90 SECOND, CONCAT('h', seq MOD 7),
ELT(seq MOD 3 + 1, 'Web', 'web', 'DB'),
IF(seq MOD 11 = 0, NULL, ELT(seq MOD 4 + 1, 'Alpha', 'alpha', 'Beta', 'gamma')),
IF(seq MOD 6 = 0, NULL, (seq * 37) MOD 1000 / 8),
IF(seq MOD 5 = 0, NULL, seq MOD 13)
FROM seq_4000_to_4999;
INSERT INTO mirror.t SELECT * FROM test.t;
# COUNT/SUM/MIN/MAX/AVG by TAG
# SELECT host, COUNT(*) c, COUNT(n) cn, SUM(n) s, MIN(n) mn, MAX(n) mx, AVG(n) a FROM t GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# DECIMAL aggregates (the engine refuses them: the normal path must stay right)
# SELECT host, COUNT(*) c, SUM(amt) sa, AVG(amt) aa, MIN(amt) mn, MAX(amt) mx FROM t GROUP BY host ORDER BY host
# same output with and without pushdown and on InnoDB; the engine did not run it
# (the key is not selected: which of 'Alpha'/'alpha' names a ci group is unspecified, and OFF/InnoDB vs ON may pick differently)
