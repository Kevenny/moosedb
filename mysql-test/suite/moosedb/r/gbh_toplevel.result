# UPDATE and DELETE on rows in chunks and in the MemTable
UPDATE t SET n = n + 100, amt = amt + 1 WHERE host = 'h2' AND ts < '2024-05-02';
UPDATE t SET name = 'Zeta' WHERE host = 'h4' AND ts >= '2024-05-02';
UPDATE mirror.t SET n = n + 100, amt = amt + 1 WHERE host = 'h2' AND ts < '2024-05-02';
UPDATE mirror.t SET name = 'Zeta' WHERE host = 'h4' AND ts >= '2024-05-02';
DELETE FROM t WHERE host = 'h5' AND ts BETWEEN '2024-05-01 10:00:00' AND '2024-05-02 02:00:00';
DELETE FROM mirror.t WHERE host = 'h5' AND ts BETWEEN '2024-05-01 10:00:00' AND '2024-05-02 02:00:00';
DELETE FROM t WHERE svc = 'db' AND n = 3;
DELETE FROM mirror.t WHERE svc = 'db' AND n = 3;
# after UPDATE/DELETE: by TAG
