# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
# after a flush and with everything deleted
FLUSH TABLES t;
# after FLUSH
# SELECT COUNT(*) c, SUM(n) sa FROM t GROUP BY svc ORDER BY svc
# same output with and without pushdown and on InnoDB; the engine ran the GROUP BY only with pushdown ON (runs: OFF=0 ON=1)
DELETE FROM t;
DELETE FROM mirror.t;
# all rows deleted, grouped
