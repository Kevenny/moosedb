# this test counts handler calls / reads EXPLAIN of the scan path: the GROUP BY pushdown (default ON) would bypass it
SET SESSION moosedb_group_by_pushdown = OFF;
CREATE TABLE h (
ts    DATETIME(3) NOT NULL,
host  VARCHAR(8) NOT NULL COMMENT 'TAG',
v     INT,
INDEX ts_idx (ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR';
# 3 hosts, one row every 10 minutes for 6 hours; first half sealed
INSERT INTO h SELECT '2026-04-01 00:00:00' + INTERVAL seq * 10 MINUTE, CONCAT('h', seq MOD 3), seq FROM seq_0_to_35;
FLUSH TABLES h;
INSERT INTO h SELECT '2026-04-01 06:00:00' + INTERVAL seq * 10 MINUTE, CONCAT('h', seq MOD 3), 100 + seq FROM seq_0_to_35;
# Rows with identical timestamps keep all their copies (06:05, in the MemTable)
INSERT INTO h VALUES ('2026-04-01 06:05:00.000', 'dup', 1000), ('2026-04-01 06:05:00.000', 'dup', 1001);
CREATE TABLE ctl (ts DATETIME(3) NOT NULL, host VARCHAR(8) NOT NULL, v INT, INDEX(ts)) ENGINE=MyISAM;
INSERT INTO ctl SELECT * FROM h;
# ---- EXPLAIN ----
EXPLAIN SELECT * FROM h WHERE ts BETWEEN '2026-04-01 01:00:00' AND '2026-04-01 02:00:00';
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	h	range	ts_idx	ts_idx	7	NULL	7	#
EXPLAIN SELECT * FROM h WHERE ts >= '2026-04-01 05:00:00';
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	h	range	ts_idx	ts_idx	7	NULL	44	#
EXPLAIN SELECT * FROM h WHERE ts = '2026-04-01 05:00:00';
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	h	ref	ts_idx	ts_idx	7	const	1	#
EXPLAIN SELECT * FROM h ORDER BY ts DESC LIMIT 5;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	h	index	NULL	ts_idx	7	NULL	5	#
EXPLAIN SELECT * FROM h ORDER BY ts LIMIT 5;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	h	index	NULL	ts_idx	7	NULL	5	#
EXPLAIN SELECT * FROM h WHERE host = 'h1';
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	h	ALL	NULL	NULL	NULL	NULL	74	#
EXPLAIN SELECT * FROM h WHERE host = 'h1' AND ts > '2026-04-01 03:00:00';
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	h	ALL	ts_idx	NULL	NULL	NULL	74	#
EXPLAIN SELECT * FROM h WHERE v > 3 ORDER BY ts DESC;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	h	ALL	NULL	NULL	NULL	NULL	74	#
EXPLAIN SELECT host, COUNT(*) FROM h GROUP BY host;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	h	ALL	NULL	NULL	NULL	NULL	74	#
EXPLAIN SELECT MIN(ts), MAX(ts) FROM h;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	NULL	NULL	NULL	NULL	NULL	NULL	NULL	#
EXPLAIN SELECT a.v, b.v FROM h a JOIN h b ON a.ts = b.ts WHERE a.host = 'h0' AND b.host = 'h1';
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	a	ALL	ts_idx	NULL	NULL	NULL	74	#
1	SIMPLE	b	ref	ts_idx	ts_idx	7	test.a.ts	8	#
EXPLAIN SELECT * FROM h FORCE INDEX (ts_idx) WHERE v = 3;
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	h	ALL	NULL	NULL	NULL	NULL	74	#
EXPLAIN SELECT * FROM h IGNORE INDEX (ts_idx) WHERE ts > '2026-04-01 05:00:00';
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	h	ALL	NULL	NULL	NULL	NULL	74	#
SELECT * FROM h USE INDEX (nope);
ERROR 42000: Key 'nope' doesn't exist in table 'h'
EXPLAIN FORMAT=JSON SELECT ts FROM h WHERE ts < '2026-04-01 00:30:00' ORDER BY ts;
EXPLAIN
{
  "query_block": {
    "select_id": 1,
    "cost": COST,
    "nested_loop": [
      {
        "table": {
          "table_name": "h",
          "access_type": "range",
          "possible_keys": ["ts_idx"],
          "key": "ts_idx",
          "key_length": "7",
          "used_key_parts": ["ts"],
          "loops": 1,
          "rows": 3,
          "cost": COST,
          "filtered": 100,
          "attached_condition": "h.ts < '2026-04-01 00:30:00'"
        }
      }
    ]
  }
}
# Row estimates stay sane: a narrow range is cheaper than the whole table
EXPLAIN SELECT COUNT(*) FROM h WHERE ts BETWEEN '2026-04-01 00:00:00' AND '2026-04-01 00:09:59';
id	select_type	table	type	possible_keys	key	key_len	ref	rows	Extra
1	SIMPLE	h	range	ts_idx	ts_idx	7	NULL	1	#
SELECT TABLE_ROWS > 0 AS has_estimate FROM information_schema.TABLES WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 'h';
has_estimate
1
# ---- ORDER BY / LIMIT / OFFSET ----
SELECT ts, v FROM h ORDER BY ts LIMIT 3;
ts	v
2026-04-01 00:00:00.000	0
2026-04-01 00:10:00.000	1
2026-04-01 00:20:00.000	2
