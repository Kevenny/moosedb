2026-04-01 05:40:00.000	34
2026-04-01 05:30:00.000	33
SELECT ts, v FROM h WHERE ts < '2026-04-01 06:00:00' ORDER BY ts DESC LIMIT 2;
ts	v
2026-04-01 05:50:00.000	35
2026-04-01 05:40:00.000	34
SELECT ts, v FROM h WHERE ts <= '2026-04-01 06:00:00' ORDER BY ts DESC, v DESC LIMIT 4;
ts	v
2026-04-01 06:00:00.000	100
2026-04-01 05:50:00.000	35
2026-04-01 05:40:00.000	34
2026-04-01 05:30:00.000	33
SELECT ts, host, v FROM h WHERE host = 'dup' ORDER BY ts DESC, v DESC;
ts	host	v
2026-04-01 06:05:00.000	dup	1001
2026-04-01 06:05:00.000	dup	1000
SELECT ts, v FROM h ORDER BY ts LIMIT 0;
ts	v
SELECT ts, v FROM h ORDER BY ts LIMIT 100000 OFFSET 71;
ts	v
2026-04-01 11:30:00.000	133
2026-04-01 11:40:00.000	134
2026-04-01 11:50:00.000	135
SELECT ts, v FROM h ORDER BY ts LIMIT 5 OFFSET 100000;
ts	v
SELECT COUNT(*) FROM (SELECT ts FROM h ORDER BY ts DESC LIMIT 1000) x;
COUNT(*)
74
# Same answers as the control table for ordered scans (ties broken on v)
SELECT (SELECT GROUP_CONCAT(v ORDER BY ts, v) FROM h) = (SELECT GROUP_CONCAT(v ORDER BY ts, v) FROM ctl) AS same_order;
same_order
1
SELECT (SELECT GROUP_CONCAT(v ORDER BY ts DESC, v DESC) FROM h) = (SELECT GROUP_CONCAT(v ORDER BY ts DESC, v DESC) FROM ctl) AS same_order_desc;
same_order_desc
1
SELECT MIN(ts), MAX(ts), MIN(v), MAX(v) FROM h;
MIN(ts)	MAX(ts)	MIN(v)	MAX(v)
2026-04-01 00:00:00.000	2026-04-01 11:50:00.000	0	1001
SELECT ts FROM h WHERE ts = (SELECT MAX(ts) FROM h);
ts
2026-04-01 11:50:00.000
SELECT ts FROM h WHERE ts = (SELECT MIN(ts) FROM h);
ts
2026-04-01 00:00:00.000
# Index scan results are the same with the index ignored
SELECT COUNT(*), SUM(v) FROM h WHERE ts BETWEEN '2026-04-01 02:00:00' AND '2026-04-01 08:00:00';
COUNT(*)	SUM(v)
39	3943
SELECT COUNT(*), SUM(v) FROM h IGNORE INDEX (ts_idx) WHERE ts BETWEEN '2026-04-01 02:00:00' AND '2026-04-01 08:00:00';
COUNT(*)	SUM(v)
39	3943
SELECT COUNT(*), SUM(v) FROM ctl WHERE ts BETWEEN '2026-04-01 02:00:00' AND '2026-04-01 08:00:00';
COUNT(*)	SUM(v)
39	3943
# Direction changes inside one scan (ORDER BY ts DESC on a range, then LIMIT)
SELECT ts FROM h WHERE ts BETWEEN '2026-04-01 03:00:00' AND '2026-04-01 03:50:00' ORDER BY ts DESC;
ts
2026-04-01 03:50:00.000
2026-04-01 03:40:00.000
2026-04-01 03:30:00.000
2026-04-01 03:20:00.000
2026-04-01 03:10:00.000
2026-04-01 03:00:00.000
SELECT ts FROM h WHERE ts BETWEEN '2026-04-01 03:00:00' AND '2026-04-01 03:50:00' ORDER BY ts;
ts
2026-04-01 03:00:00.000
2026-04-01 03:10:00.000
2026-04-01 03:20:00.000
2026-04-01 03:30:00.000
2026-04-01 03:40:00.000
2026-04-01 03:50:00.000
SELECT ts FROM h WHERE ts > '2026-04-01 05:50:00' AND ts < '2026-04-01 06:10:00' ORDER BY ts DESC, v DESC;
ts
2026-04-01 06:05:00.000
2026-04-01 06:05:00.000
2026-04-01 06:00:00.000
# ---- HANDLER ----
# The engine does not advertise HA_CAN_SQL_HANDLER, so the server refuses the
# HANDLER interface for MooseDB tables (documented limitation, not a crash)
HANDLER h OPEN;
ERROR HY000: Storage engine MooseDB of the table `test`.`h` doesn't have this option
HANDLER h OPEN AS a;
ERROR HY000: Storage engine MooseDB of the table `test`.`h` doesn't have this option
HANDLER h READ ts_idx FIRST;
ERROR 42S02: Unknown table 'h' in HANDLER
HANDLER h CLOSE;
ERROR 42S02: Unknown table 'h' in HANDLER
# The table is unaffected
SELECT COUNT(*) FROM h;
COUNT(*)
74
FLUSH TABLES h;
SELECT COUNT(*) FROM h;
COUNT(*)
74
TRUNCATE TABLE h;
HANDLER h OPEN;
ERROR HY000: Storage engine MooseDB of the table `test`.`h` doesn't have this option
SELECT COUNT(*) FROM h;
COUNT(*)
0
DROP TABLE h, ctl;
