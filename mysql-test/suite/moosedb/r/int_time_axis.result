# Seal the MemTable: the extreme rows must flush into chunks (month bucket arithmetic at the edges of i64)
FLUSH TABLES zs;
# (INFORMATION_SCHEMA shows DATETIME values, which stop at year 9999; only the counts are shown)
SELECT COUNT(*) AS chunks, SUM(`ROWS`) AS chunk_rows FROM information_schema.MOOSEDB_CHUNKS WHERE TABLE_NAME = 'zs';
chunks	chunk_rows
7	12
