##################################################################
# DDL rules
##################################################################
# An integer column is the axis only when TIMESTAMP_COLUMN names it
CREATE TABLE e (clock INT NOT NULL, INDEX(clock)) ENGINE=MooseDB;
ERROR HY000: MooseDB: a MooseDB table needs a DATETIME/TIMESTAMP column with an index (INDEX ts_idx (ts)) or TIMESTAMP_COLUMN = '<column>'
CREATE TABLE e (ts DATETIME NOT NULL, clock INT NOT NULL, INDEX(clock)) ENGINE=MooseDB;
ERROR HY000: MooseDB: a MooseDB table needs a DATETIME/TIMESTAMP column with an index (INDEX ts_idx (ts)) or TIMESTAMP_COLUMN = '<column>'
# NOT NULL, stored, INT or BIGINT, not a TAG, indexed (non-unique)
CREATE TABLE e (clock INT, INDEX(clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR 42000: Table handler doesn't support NULL in given index. Please change column 'clock' to be NOT NULL or use another handler
CREATE TABLE e (clock SMALLINT NOT NULL, INDEX(clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: timestamp column 'clock' must be a stored DATETIME, TIMESTAMP, INT or BIGINT column
CREATE TABLE e (clock TINYINT NOT NULL, INDEX(clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: timestamp column 'clock' must be a stored DATETIME, TIMESTAMP, INT or BIGINT column
CREATE TABLE e (clock DOUBLE NOT NULL, INDEX(clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: timestamp column 'clock' must be a stored DATETIME, TIMESTAMP, INT or BIGINT column
CREATE TABLE e (clock INT NOT NULL COMMENT 'TAG', INDEX(clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: the timestamp column cannot be a TAG
CREATE TABLE e (clock INT NOT NULL, v INT) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: missing index on the timestamp column: add INDEX (clock)
CREATE TABLE e (clock INT NOT NULL, UNIQUE(clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: index 'clock' cannot be UNIQUE/PRIMARY: time-series rows are not unique by time
CREATE TABLE e (clock INT NOT NULL, v INT NOT NULL, INDEX(clock), INDEX(v)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: index 'v' is not supported: column 'v' is not a TAG column or the timestamp column. MooseDB indexes the timestamp column alone, or TAG columns optionally followed by the timestamp (INDEX (itemid, clock))
# An index on a DATETIME column is not the axis when TIMESTAMP_COLUMN says otherwise
CREATE TABLE e (ts DATETIME NOT NULL, clock INT NOT NULL, INDEX(ts)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
ERROR HY000: MooseDB: index 'ts' is not supported: column 'ts' is not a TAG column or the timestamp column. MooseDB indexes the timestamp column alone, or TAG columns optionally followed by the timestamp (INDEX (itemid, clock))
##################################################################
# Basic table: INT axis, integer TAG, ns as an ordinary column
##################################################################
CREATE TABLE z (
clock  INT NOT NULL,
itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG',
ns     INT NOT NULL,
value  DOUBLE NOT NULL,
INDEX clock_idx (clock)
) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY';
CREATE TABLE zi (
clock  INT NOT NULL,
itemid BIGINT UNSIGNED NOT NULL,
ns     INT NOT NULL,
value  DOUBLE NOT NULL,
KEY clock_idx (clock)
) ENGINE=InnoDB;
SHOW CREATE TABLE z;
Table	Create Table
z	CREATE TABLE `z` (
  `clock` int(11) NOT NULL,
  `itemid` bigint(20) unsigned NOT NULL COMMENT 'TAG',
  `ns` int(11) NOT NULL,
  `value` double NOT NULL,
  KEY `clock_idx` (`clock`)
) ENGINE=MooseDB DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci `TIMESTAMP_COLUMN`='clock' `CHUNK_INTERVAL`='1 DAY'
# 2000 rows, one every 10 minutes from 2026-01-01 00:00:00 UTC (7 daily chunks sealed + the second half in the MemTable)
INSERT INTO z SELECT 1767225600 + seq * 600, 1 + seq MOD 5, (seq * 7919) MOD 1000000, seq / 4 FROM seq_0_to_999;
INSERT INTO zi SELECT 1767225600 + seq * 600, 1 + seq MOD 5, (seq * 7919) MOD 1000000, seq / 4 FROM seq_0_to_999;
FLUSH TABLES z;
INSERT INTO z SELECT 1767225600 + seq * 600, 1 + seq MOD 5, (seq * 7919) MOD 1000000, seq / 4 FROM seq_1000_to_1999;
INSERT INTO zi SELECT 1767225600 + seq * 600, 1 + seq MOD 5, (seq * 7919) MOD 1000000, seq / 4 FROM seq_1000_to_1999;
SELECT COUNT(*), MIN(clock), MAX(clock), COUNT(DISTINCT itemid) FROM z;
COUNT(*)	MIN(clock)	MAX(clock)	COUNT(DISTINCT itemid)
2000	1767225600	1768425000	5
SELECT COUNT(*), MIN(clock), MAX(clock), COUNT(DISTINCT itemid) FROM zi;
COUNT(*)	MIN(clock)	MAX(clock)	COUNT(DISTINCT itemid)
2000	1767225600	1768425000	5
# Chunks are cut at UTC midnight of the epoch seconds
SELECT COUNT(*) AS chunks, MIN(TS_MIN) AS first_min, MAX(TS_MAX) AS last_max
FROM information_schema.MOOSEDB_CHUNKS WHERE TABLE_NAME = 'z';
chunks	first_min	last_max
7	2026-01-01 00:00:00.000000	2026-01-07 22:30:00.000000
SELECT TS_MIN, TS_MAX, `ROWS` FROM information_schema.MOOSEDB_CHUNKS
WHERE TABLE_NAME = 'z' ORDER BY CHUNK_ID LIMIT 2;
TS_MIN	TS_MAX	ROWS
2026-01-01 00:00:00.000000	2026-01-01 23:50:00.000000	144
2026-01-02 00:00:00.000000	2026-01-02 23:50:00.000000	144
