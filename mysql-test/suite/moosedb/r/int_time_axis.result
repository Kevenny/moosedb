##################################################################
# Writes of other shapes: multi-row, INSERT ... SELECT, REPLACE, TRUNCATE
##################################################################
CREATE TABLE zw (clock INT NOT NULL, itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', value DOUBLE NOT NULL, INDEX(clock))
ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
INSERT INTO zw VALUES (1767225600, 1, 1.5), (1767225601, 2, 2.5);
INSERT INTO zw SELECT clock + 10, itemid, value * 2 FROM zw;
INSERT INTO zw (clock, itemid, value) VALUES (1767225700, 3, 3.5), (1767225701, 3, 4.5);
REPLACE INTO zw VALUES (1767225800, 4, 5.5);
SELECT * FROM zw ORDER BY clock;
clock	itemid	value
1767225600	1	1.5
1767225601	2	2.5
1767225610	1	3
1767225611	2	5
1767225700	3	3.5
1767225701	3	4.5
1767225800	4	5.5
SELECT COUNT(*) FROM zw;
COUNT(*)
7
TRUNCATE TABLE zw;
SELECT COUNT(*) FROM zw;
COUNT(*)
0
INSERT INTO zw VALUES (1767225900, 9, 9.5);
SELECT * FROM zw;
clock	itemid	value
1767225900	9	9.5
DROP TABLE zw;
##################################################################
# ALTER TABLE changing the axis column type (rebuilds the table)
##################################################################
CREATE TABLE za (clock INT NOT NULL, v INT NOT NULL, INDEX(clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
INSERT INTO za VALUES (20260101, 1), (20260102, 2);
ALTER TABLE za MODIFY clock DATETIME NOT NULL;
SELECT clock, v FROM za ORDER BY clock;
clock	v
2026-01-01 00:00:00	1
2026-01-02 00:00:00	2
SELECT COUNT(*) FROM za WHERE clock > '2026-01-01 12:00:00';
COUNT(*)
1
# DATETIME -> BIGINT gives 20260101000000, beyond the supported range: refused, table intact
ALTER TABLE za MODIFY clock BIGINT NOT NULL;
ERROR HY000: Got error 1205 'column 'clock': time value outside the supported range (+/-9223372036854 seconds since 1970)' from MooseDB
SELECT clock, v FROM za ORDER BY clock;
clock	v
2026-01-01 00:00:00	1
2026-01-02 00:00:00	2
ALTER TABLE za MODIFY clock INT NOT NULL;
ERROR 22003: Out of range value for column 'clock' at row 1
SHOW CREATE TABLE za;
Table	Create Table
za	CREATE TABLE `za` (
  `clock` datetime NOT NULL,
  `v` int(11) NOT NULL,
  KEY `clock` (`clock`)
) ENGINE=MooseDB DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci `TIMESTAMP_COLUMN`='clock'
DROP TABLE za;
##################################################################
# Retention works on the integer axis (UNIX_TIMESTAMP based)
##################################################################
CREATE TABLE zr (clock INT NOT NULL, itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', v INT, INDEX(clock))
ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY' RETENTION_PERIOD='30 DAYS';
INSERT INTO zr VALUES
(UNIX_TIMESTAMP() - 400 * 86400, 1, 1),
(UNIX_TIMESTAMP() - 100 * 86400, 1, 2),
(UNIX_TIMESTAMP() - 1 * 86400, 1, 3),
(UNIX_TIMESTAMP(), 2, 4);
FLUSH TABLES zr;
SELECT EXPIRED_CHUNKS, RETENTION FROM information_schema.MOOSEDB_TABLES WHERE TABLE_NAME = 'zr';
EXPIRED_CHUNKS	RETENTION
2	30 DAYS
CALL moosedb_apply_retention('test.zr');
SELECT v FROM zr ORDER BY clock;
v
3
4
INSERT INTO zr VALUES (UNIX_TIMESTAMP() - 200 * 86400, 3, 5);
OPTIMIZE TABLE zr;
Table	Op	Msg_type	Msg_text
test.zr	optimize	status	OK
SELECT v FROM zr ORDER BY clock;
v
3
4
DROP TABLE zr;
DROP PROCEDURE moosedb_compact;
DROP PROCEDURE moosedb_apply_retention;
DROP FUNCTION moosedb_compact_impl;
DROP FUNCTION moosedb_retention_impl;
##################################################################
# Restart (rows in chunks + MemTable), TRUNCATE, then a crash (WAL replay)
##################################################################
INSERT INTO z SELECT 1768500000 + seq, 1 + seq MOD 5, seq, seq FROM seq_0_to_99;
INSERT INTO zi SELECT 1768500000 + seq, 1 + seq MOD 5, seq, seq FROM seq_0_to_99;
# WHERE clock >= 0
a	b	c	vs_innodb
2100	1767225600	1757111077	SAME
# restart
# WHERE clock >= 0
a	b	c	vs_innodb
2100	1767225600	1757111077	SAME
# WHERE itemid = 4 AND clock > 1768400000
a	b	c	vs_innodb
29	1768400400	1294536977	SAME
SELECT clock, itemid FROM z ORDER BY clock DESC LIMIT 2;
clock	itemid
1768500099	5
1768500098	4
SHOW CREATE TABLE z;
Table	Create Table
z	CREATE TABLE `z` (
  `clock` int(11) NOT NULL,
  `itemid` bigint(20) unsigned NOT NULL COMMENT 'TAG',
  `ns` int(11) NOT NULL,
  `value` double NOT NULL,
  KEY `clock_idx` (`clock`)
) ENGINE=MooseDB DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci `TIMESTAMP_COLUMN`='clock' `CHUNK_INTERVAL`='1 DAY'
# Rows only in the WAL survive kill -9 with the right clock values
