CREATE TABLE m (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL, value DOUBLE NOT NULL, ns INT NOT NULL,
PRIMARY KEY (itemid, clock, ns))
ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY' HOT_THRESHOLD='1 HOUR';
CREATE TABLE i (itemid BIGINT UNSIGNED NOT NULL, clock INT NOT NULL, value DOUBLE NOT NULL, ns INT NOT NULL,
PRIMARY KEY (itemid, clock, ns)) ENGINE=InnoDB;
CREATE TABLE sm (host VARCHAR(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_nopad_bin NOT NULL COMMENT 'TAG', clock INT NOT NULL, value INT NOT NULL, ns INT NOT NULL,
PRIMARY KEY (host, clock, ns))
ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY' HOT_THRESHOLD='1 HOUR';
CREATE TABLE si (host VARCHAR(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_nopad_bin NOT NULL, clock INT NOT NULL, value INT NOT NULL, ns INT NOT NULL,
PRIMARY KEY (host, clock, ns)) ENGINE=InnoDB;
INSERT INTO m SELECT 1 + a.seq, 1700000000 + b.seq * 10, a.seq * 100 + b.seq, b.seq MOD 3 FROM seq_0_to_19 a, seq_0_to_49 b;
INSERT INTO i SELECT 1 + a.seq, 1700000000 + b.seq * 10, a.seq * 100 + b.seq, b.seq MOD 3 FROM seq_0_to_19 a, seq_0_to_49 b;
INSERT INTO sm SELECT CONCAT('h', a.seq), 1700000000 + b.seq * 10, a.seq * 100 + b.seq, b.seq MOD 3 FROM seq_0_to_9 a, seq_0_to_49 b;
INSERT INTO si SELECT CONCAT('h', a.seq), 1700000000 + b.seq * 10, a.seq * 100 + b.seq, b.seq MOD 3 FROM seq_0_to_9 a, seq_0_to_49 b;
# the first 1000 rows now live in a sealed chunk, what follows in the MemTable
FLUSH TABLES m;
FLUSH TABLES sm;
# ---- ON DUPLICATE KEY UPDATE: all keys exist (chunk), then half exist and half do not
INSERT INTO m SELECT 1 + a.seq, 1700000000 + b.seq * 10, 7, b.seq MOD 3 FROM seq_0_to_19 a, seq_0_to_49 b ON DUPLICATE KEY UPDATE value = value + VALUES(value);
INSERT INTO i SELECT 1 + a.seq, 1700000000 + b.seq * 10, 7, b.seq MOD 3 FROM seq_0_to_19 a, seq_0_to_49 b ON DUPLICATE KEY UPDATE value = value + VALUES(value);
INSERT INTO m SELECT 1 + a.seq, 1700000000 + b.seq * 10 + 5 * (a.seq MOD 2), 3, b.seq MOD 3 FROM seq_0_to_19 a, seq_0_to_49 b ON DUPLICATE KEY UPDATE value = value * 2 + VALUES(value);
INSERT INTO i SELECT 1 + a.seq, 1700000000 + b.seq * 10 + 5 * (a.seq MOD 2), 3, b.seq MOD 3 FROM seq_0_to_19 a, seq_0_to_49 b ON DUPLICATE KEY UPDATE value = value * 2 + VALUES(value);
SELECT COUNT(*), SUM(value), SUM(clock), SUM(ns) FROM m;
COUNT(*)	SUM(value)	SUM(clock)	SUM(ns)
1500	1450250	2550000370000	1470
SELECT COUNT(*), SUM(value), SUM(clock), SUM(ns) FROM i;
COUNT(*)	SUM(value)	SUM(clock)	SUM(ns)
1500	1450250	2550000370000	1470
SELECT (SELECT COUNT(*) FROM (SELECT * FROM m EXCEPT SELECT * FROM i) a) + (SELECT COUNT(*) FROM (SELECT * FROM i EXCEPT SELECT * FROM m) b) AS rows_differing;
rows_differing
0
# ---- the same keys again: now the rows come from the MemTable and from the chunk
INSERT INTO m SELECT 1 + a.seq, 1700000000 + b.seq * 10 + 5 * (a.seq MOD 2), 1, b.seq MOD 3 FROM seq_0_to_19 a, seq_0_to_49 b ON DUPLICATE KEY UPDATE value = value + VALUES(value);
INSERT INTO i SELECT 1 + a.seq, 1700000000 + b.seq * 10 + 5 * (a.seq MOD 2), 1, b.seq MOD 3 FROM seq_0_to_19 a, seq_0_to_49 b ON DUPLICATE KEY UPDATE value = value + VALUES(value);
SELECT COUNT(*), SUM(value), SUM(clock), SUM(ns) FROM m;
COUNT(*)	SUM(value)	SUM(clock)	SUM(ns)
1500	1451250	2550000370000	1470
SELECT COUNT(*), SUM(value), SUM(clock), SUM(ns) FROM i;
COUNT(*)	SUM(value)	SUM(clock)	SUM(ns)
1500	1451250	2550000370000	1470
SELECT (SELECT COUNT(*) FROM (SELECT * FROM m EXCEPT SELECT * FROM i) a) + (SELECT COUNT(*) FROM (SELECT * FROM i EXCEPT SELECT * FROM m) b) AS rows_differing;
rows_differing
0
# ---- REPLACE of existing and new keys
REPLACE INTO m SELECT 1 + a.seq, 1700000000 + b.seq * 10 + 5 * (b.seq MOD 2), 100000 + b.seq, b.seq MOD 3 FROM seq_0_to_24 a, seq_0_to_49 b;
REPLACE INTO i SELECT 1 + a.seq, 1700000000 + b.seq * 10 + 5 * (b.seq MOD 2), 100000 + b.seq, b.seq MOD 3 FROM seq_0_to_24 a, seq_0_to_49 b;
SELECT COUNT(*), SUM(value), SUM(clock), SUM(ns) FROM m;
COUNT(*)	SUM(value)	SUM(clock)	SUM(ns)
2000	125756625	3400000495625	1965
SELECT COUNT(*), SUM(value), SUM(clock), SUM(ns) FROM i;
COUNT(*)	SUM(value)	SUM(clock)	SUM(ns)
2000	125756625	3400000495625	1965
SELECT (SELECT COUNT(*) FROM (SELECT * FROM m EXCEPT SELECT * FROM i) a) + (SELECT COUNT(*) FROM (SELECT * FROM i EXCEPT SELECT * FROM m) b) AS rows_differing;
rows_differing
0
# ---- reads with other projections in between, then the same updates again
SELECT COUNT(*) FROM m WHERE itemid = 3;
COUNT(*)
75
SELECT MAX(value) FROM m WHERE itemid = 4;
MAX(value)
100049
