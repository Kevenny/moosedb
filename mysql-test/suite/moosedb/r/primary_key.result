# A statement that spills to disk (MEMTABLE_SIZE 1 MiB) checks against its own staged chunks
CREATE TABLE big (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL, value DOUBLE NOT NULL, ns INT NOT NULL,
PRIMARY KEY (itemid, clock, ns)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' MEMTABLE_SIZE=1048576 CHUNK_INTERVAL='1 DAY';
