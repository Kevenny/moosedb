##################################################################
# DDL: the Zabbix 7.0 history tables as shipped, plus COMMENT 'TAG'
# on itemid and TIMESTAMP_COLUMN='clock'
##################################################################
CREATE DATABASE moo;
CREATE TABLE moo.history (
itemid                   bigint unsigned                           NOT NULL COMMENT 'TAG',
clock                    integer         DEFAULT '0'               NOT NULL,
value                    DOUBLE PRECISION DEFAULT '0.0000'         NOT NULL,
ns                       integer         DEFAULT '0'               NOT NULL,
PRIMARY KEY (itemid,clock,ns)
) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY' RETENTION_PERIOD='31 DAYS' HOT_THRESHOLD='1 DAY';
CREATE TABLE moo.history_uint (
itemid                   bigint unsigned                           NOT NULL COMMENT 'TAG',
clock                    integer         DEFAULT '0'               NOT NULL,
value                    bigint unsigned DEFAULT '0'               NOT NULL,
ns                       integer         DEFAULT '0'               NOT NULL,
PRIMARY KEY (itemid,clock,ns)
) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY' RETENTION_PERIOD='31 DAYS' HOT_THRESHOLD='1 DAY';
CREATE TABLE moo.history_str (
itemid                   bigint unsigned                           NOT NULL COMMENT 'TAG',
clock                    integer         DEFAULT '0'               NOT NULL,
value                    varchar(255)    DEFAULT ''                NOT NULL,
ns                       integer         DEFAULT '0'               NOT NULL,
PRIMARY KEY (itemid,clock,ns)
) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY' RETENTION_PERIOD='31 DAYS' HOT_THRESHOLD='1 DAY';
CREATE TABLE moo.history_log (
itemid                   bigint unsigned                           NOT NULL COMMENT 'TAG',
clock                    integer         DEFAULT '0'               NOT NULL,
timestamp                integer         DEFAULT '0'               NOT NULL,
source                   varchar(64)     DEFAULT ''                NOT NULL,
severity                 integer         DEFAULT '0'               NOT NULL,
value                    text                                      NOT NULL,
logeventid               integer         DEFAULT '0'               NOT NULL,
ns                       integer         DEFAULT '0'               NOT NULL,
PRIMARY KEY (itemid,clock,ns)
) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY' RETENTION_PERIOD='31 DAYS' HOT_THRESHOLD='1 DAY';
CREATE TABLE moo.history_text (
itemid                   bigint unsigned                           NOT NULL COMMENT 'TAG',
clock                    integer         DEFAULT '0'               NOT NULL,
value                    text                                      NOT NULL,
ns                       integer         DEFAULT '0'               NOT NULL,
PRIMARY KEY (itemid,clock,ns)
) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY' RETENTION_PERIOD='31 DAYS' HOT_THRESHOLD='1 DAY';
CREATE TABLE moo.history_bin (
itemid                   bigint unsigned                           NOT NULL COMMENT 'TAG',
clock                    integer         DEFAULT '0'               NOT NULL,
ns                       integer         DEFAULT '0'               NOT NULL,
value                    longblob                                  NOT NULL,
PRIMARY KEY (itemid,clock,ns)
) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY' RETENTION_PERIOD='31 DAYS' HOT_THRESHOLD='1 DAY';
SHOW CREATE TABLE moo.history;
Table	Create Table
history	CREATE TABLE `history` (
  `itemid` bigint(20) unsigned NOT NULL COMMENT 'TAG',
  `clock` int(11) NOT NULL DEFAULT 0,
  `value` double NOT NULL DEFAULT 0,
  `ns` int(11) NOT NULL DEFAULT 0,
  PRIMARY KEY (`itemid`,`clock`,`ns`)
) ENGINE=MooseDB DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci `TIMESTAMP_COLUMN`='clock' `CHUNK_INTERVAL`='1 DAY' `RETENTION_PERIOD`='31 DAYS' `HOT_THRESHOLD`='1 DAY'
SHOW CREATE TABLE moo.history_bin;
Table	Create Table
history_bin	CREATE TABLE `history_bin` (
  `itemid` bigint(20) unsigned NOT NULL COMMENT 'TAG',
  `clock` int(11) NOT NULL DEFAULT 0,
  `ns` int(11) NOT NULL DEFAULT 0,
  `value` longblob NOT NULL,
  PRIMARY KEY (`itemid`,`clock`,`ns`)
) ENGINE=MooseDB DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci `TIMESTAMP_COLUMN`='clock' `CHUNK_INTERVAL`='1 DAY' `RETENTION_PERIOD`='31 DAYS' `HOT_THRESHOLD`='1 DAY'
# No separate index on clock is needed: the key supplies the time axis
SELECT TABLE_NAME, INDEX_NAME, NON_UNIQUE, SEQ_IN_INDEX, COLUMN_NAME FROM information_schema.STATISTICS
WHERE TABLE_SCHEMA = 'moo' ORDER BY TABLE_NAME, SEQ_IN_INDEX;
TABLE_NAME	INDEX_NAME	NON_UNIQUE	SEQ_IN_INDEX	COLUMN_NAME
history	PRIMARY	0	1	itemid
history	PRIMARY	0	2	clock
history	PRIMARY	0	3	ns
history_bin	PRIMARY	0	1	itemid
history_bin	PRIMARY	0	2	clock
history_bin	PRIMARY	0	3	ns
history_log	PRIMARY	0	1	itemid
history_log	PRIMARY	0	2	clock
history_log	PRIMARY	0	3	ns
history_str	PRIMARY	0	1	itemid
history_str	PRIMARY	0	2	clock
history_str	PRIMARY	0	3	ns
history_text	PRIMARY	0	1	itemid
history_text	PRIMARY	0	2	clock
history_text	PRIMARY	0	3	ns
history_uint	PRIMARY	0	1	itemid
history_uint	PRIMARY	0	2	clock
history_uint	PRIMARY	0	3	ns
# Every one of them enforces its key: same row twice, same key with another value, other ns accepted
INSERT INTO moo.history (itemid, clock, value, ns) VALUES (42, 1700000000, 1.5, 7);
INSERT INTO moo.history (itemid, clock, value, ns) VALUES (42, 1700000000, 1.5, 7);
