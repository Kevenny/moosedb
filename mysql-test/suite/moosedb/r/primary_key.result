##################################################################
# Semantics against an InnoDB mirror (single-row statements)
##################################################################
CREATE TABLE um (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL DEFAULT 0, value DOUBLE NOT NULL DEFAULT 0, ns INT NOT NULL DEFAULT 0,
PRIMARY KEY (itemid, clock, ns)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
CREATE TABLE ui (itemid BIGINT UNSIGNED NOT NULL, clock INT NOT NULL DEFAULT 0, value DOUBLE NOT NULL DEFAULT 0, ns INT NOT NULL DEFAULT 0,
PRIMARY KEY (itemid, clock, ns)) ENGINE=InnoDB;
# ---- um
INSERT INTO um VALUES (1, 100, 1.5, 1), (1, 100, 2.5, 2), (1, 101, 3, 1), (2, 100, 4, 1);
INSERT INTO um VALUES (1, 100, 9, 1);
ERROR 23000: Duplicate entry '1-100-1' for key 'PRIMARY'
INSERT INTO um VALUES (2, 100, 9, 1);
ERROR 23000: Duplicate entry '2-100-1' for key 'PRIMARY'
# same time, another ns / another item / a later and an earlier time: accepted
INSERT INTO um VALUES (1, 100, 5, 3), (3, 100, 6, 1), (1, 102, 7, 1), (1, 99, 8, 1);
# the key again, now below the highest time of the series
INSERT INTO um VALUES (1, 99, 0, 1);
ERROR 23000: Duplicate entry '1-99-1' for key 'PRIMARY'
INSERT INTO um VALUES (1, 100, 0, 3);
ERROR 23000: Duplicate entry '1-100-3' for key 'PRIMARY'
# INSERT IGNORE: duplicates are skipped, with a warning each
INSERT IGNORE INTO um VALUES (1, 100, 9, 1), (1, 103, 9, 1), (1, 103, 9, 1), (5, 5, 5, 5);
Warnings:
Warning	1062	Duplicate entry '1-100-1' for key 'PRIMARY'
Warning	1062	Duplicate entry '1-103-1' for key 'PRIMARY'
SELECT @@warning_count AS warnings;
warnings
2
SHOW WARNINGS;
Level	Code	Message
Warning	1062	Duplicate entry '1-100-1' for key 'PRIMARY'
Warning	1062	Duplicate entry '1-103-1' for key 'PRIMARY'
# INSERT ... SELECT with duplicates inside the SELECT
INSERT IGNORE INTO um SELECT 7, 100 + seq DIV 2, seq, 0 FROM seq_1_to_6;
Warnings:
Warning	1062	Duplicate entry '7-101-0' for key 'PRIMARY'
Warning	1062	Duplicate entry '7-102-0' for key 'PRIMARY'
SELECT @@warning_count AS warnings;
warnings
2
