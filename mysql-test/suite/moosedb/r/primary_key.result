# 
a	b	c	vs_innodb
14	64	1168907469	SAME
# ---- the message names the key and the values
INSERT INTO um VALUES (123456789012, 1700000000, 1, 5), (123456789012, 1700000000, 1, 5);
ERROR 23000: Duplicate entry '123456789012-1700000000-5' for key 'PRIMARY'
SELECT COUNT(*) FROM um WHERE itemid = 123456789012;
COUNT(*)
1
INSERT INTO ui VALUES (123456789012, 1700000000, 1, 5), (123456789012, 1700000000, 1, 5);
ERROR 23000: Duplicate entry '123456789012-1700000000-5' for key 'PRIMARY'
SELECT COUNT(*) FROM ui WHERE itemid = 123456789012;
COUNT(*)
0
# (the rows before the duplicate stay in MooseDB, which has no multi-row rollback;
#  InnoDB rolls the statement back)
# ---- REPLACE and ON DUPLICATE KEY UPDATE need UPDATE/DELETE, which the engine does not have:
#      a key that exists is an explicit error, not a silent wrong answer
REPLACE INTO um VALUES (1, 100, 7, 1);
ERROR HY000: Storage engine MooseDB of the table `test`.`um` doesn't have this option
INSERT INTO um VALUES (1, 100, 7, 1) ON DUPLICATE KEY UPDATE value = 7;
ERROR HY000: Storage engine MooseDB of the table `test`.`um` doesn't have this option
INSERT INTO um VALUES (1, 100, 7, 1), (1, 777, 7, 1) ON DUPLICATE KEY UPDATE value = value + 1;
