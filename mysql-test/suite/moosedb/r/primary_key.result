##################################################################
# Answers and plans of the queries Zabbix runs on a table with this key
##################################################################
CREATE TABLE zm (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL DEFAULT 0, value DOUBLE NOT NULL DEFAULT 0, ns INT NOT NULL DEFAULT 0,
PRIMARY KEY (itemid, clock, ns)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY' HOT_THRESHOLD='1 HOUR';
CREATE TABLE zi (itemid BIGINT UNSIGNED NOT NULL, clock INT NOT NULL DEFAULT 0, value DOUBLE NOT NULL DEFAULT 0, ns INT NOT NULL DEFAULT 0,
PRIMARY KEY (itemid, clock, ns)) ENGINE=InnoDB;
CREATE TABLE it (itemid BIGINT UNSIGNED NOT NULL PRIMARY KEY, lastclock INT NOT NULL, lastns INT NOT NULL) ENGINE=InnoDB;
# 30 items, every 4th second of 100: samples ns 300 and 100, and ns 200 every 8th second;
# inserted out of order into two chunks and the MemTable
INSERT INTO zm SELECT 1 + a.seq, 1700000000 + b.seq, a.seq * 1000 + b.seq, 300 FROM seq_0_to_29 a, seq_0_to_99 b WHERE b.seq MOD 4 = 0;
INSERT INTO zi SELECT 1 + a.seq, 1700000000 + b.seq, a.seq * 1000 + b.seq, 300 FROM seq_0_to_29 a, seq_0_to_99 b WHERE b.seq MOD 4 = 0;
FLUSH TABLES zm;
INSERT INTO zm SELECT 1 + a.seq, 1700000000 + b.seq, a.seq * 1000 + b.seq + 0.25, 100 FROM seq_0_to_29 a, seq_0_to_99 b WHERE b.seq MOD 4 = 0;
INSERT INTO zi SELECT 1 + a.seq, 1700000000 + b.seq, a.seq * 1000 + b.seq + 0.25, 100 FROM seq_0_to_29 a, seq_0_to_99 b WHERE b.seq MOD 4 = 0;
FLUSH TABLES zm;
INSERT INTO zm SELECT 1 + a.seq, 1700000000 + b.seq, a.seq * 1000 + b.seq + 0.5, 200 FROM seq_0_to_29 a, seq_0_to_99 b WHERE b.seq MOD 8 = 0;
INSERT INTO zi SELECT 1 + a.seq, 1700000000 + b.seq, a.seq * 1000 + b.seq + 0.5, 200 FROM seq_0_to_29 a, seq_0_to_99 b WHERE b.seq MOD 8 = 0;
SELECT COUNT(*), COUNT(DISTINCT itemid), MIN(clock), MAX(clock) FROM zm;
COUNT(*)	COUNT(DISTINCT itemid)	MIN(clock)	MAX(clock)
1890	30	1700000000	1700000096
SELECT COUNT(*), COUNT(DISTINCT itemid), MIN(clock), MAX(clock) FROM zi;
COUNT(*)	COUNT(DISTINCT itemid)	MIN(clock)	MAX(clock)
1890	30	1700000000	1700000096
INSERT INTO it SELECT itemid, MAX(clock), 200 FROM zi GROUP BY itemid;
