CREATE TABLE enc (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL, value DOUBLE NOT NULL, ns INT NOT NULL,
PRIMARY KEY (itemid, clock, ns))
ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY' HOT_THRESHOLD='1 HOUR' ENCRYPTION='YES' ENCRYPTION_KEY_ID=1;
INSERT INTO enc SELECT 1 + a.seq, 1700000000 + b.seq * 10, a.seq * 100 + b.seq, b.seq MOD 3 FROM seq_0_to_9 a, seq_0_to_29 b;
FLUSH TABLES enc;
INSERT INTO enc SELECT 1 + a.seq, 1700000000 + b.seq * 10 + 5, a.seq, 0 FROM seq_0_to_9 a, seq_0_to_29 b;
SELECT ENCRYPTED, CHUNKS, COLD_CHUNKS, PENDING_ROWS FROM information_schema.MOOSEDB_TABLES WHERE TABLE_NAME = 'enc';
ENCRYPTED	CHUNKS	COLD_CHUNKS	PENDING_ROWS
YES	1	1	300
# a sealed (encrypted, cold) chunk, and the MemTable
INSERT INTO enc VALUES (3, 1700000100, 0, 1);
ERROR 23000: Duplicate entry '3-1700000100-1' for key 'PRIMARY'
INSERT INTO enc VALUES (3, 1700000105, 0, 0);
ERROR 23000: Duplicate entry '3-1700000105-0' for key 'PRIMARY'
INSERT INTO enc VALUES (3, 1700000100, 0, 5);
INSERT INTO enc VALUES (3, 1700000100, 0, 5);
ERROR 23000: Duplicate entry '3-1700000100-5' for key 'PRIMARY'
# clean restart, then kill -9 with rows only in the encrypted WAL
# restart
INSERT INTO enc VALUES (3, 1700000100, 0, 1);
ERROR 23000: Duplicate entry '3-1700000100-1' for key 'PRIMARY'
INSERT INTO enc VALUES (3, 1700000105, 0, 0);
ERROR 23000: Duplicate entry '3-1700000105-0' for key 'PRIMARY'
INSERT INTO enc VALUES (3, 1700000100, 0, 5);
ERROR 23000: Duplicate entry '3-1700000100-5' for key 'PRIMARY'
INSERT INTO enc VALUES (4, 1700000400, 0, 5), (4, 1700000400, 0, 6);
# Kill the server
# restart
INSERT INTO enc VALUES (4, 1700000400, 1, 6);
ERROR 23000: Duplicate entry '4-1700000400-6' for key 'PRIMARY'
INSERT INTO enc VALUES (3, 1700000100, 1, 5);
ERROR 23000: Duplicate entry '3-1700000100-5' for key 'PRIMARY'
INSERT INTO enc VALUES (5, 1700000010, 1, 1);
ERROR 23000: Duplicate entry '5-1700000010-1' for key 'PRIMARY'
INSERT INTO enc VALUES (4, 1700000400, 1, 7);
SELECT COUNT(*), SUM(value) FROM enc;
COUNT(*)	SUM(value)
604	140701
SELECT clock, ns FROM enc WHERE itemid = 4 ORDER BY clock DESC, ns DESC LIMIT 2;
clock	ns
1700000400	7
1700000400	6
CHECK TABLE enc;
Table	Op	Msg_type	Msg_text
test.enc	check	status	OK
DROP TABLE enc;
