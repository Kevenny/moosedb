# ---- Scope: global-only, except the GROUP BY pushdown session variables ----
SET SESSION moosedb_wal_sync_mode = 'write';
ERROR HY000: Variable 'moosedb_wal_sync_mode' is a GLOBAL variable and should be set with SET GLOBAL
SET moosedb_max_open_chunks = 5;
ERROR HY000: Variable 'moosedb_max_open_chunks' is a GLOBAL variable and should be set with SET GLOBAL
SELECT @@SESSION.moosedb_chunk_cache_size;
ERROR HY000: Variable 'moosedb_chunk_cache_size' is a GLOBAL variable
SELECT @@GLOBAL.moosedb_chunk_cache_size = @@moosedb_chunk_cache_size;
@@GLOBAL.moosedb_chunk_cache_size = @@moosedb_chunk_cache_size
1
# ---- moosedb_compaction_threads is read-only ----
SET GLOBAL moosedb_compaction_threads = 4;
ERROR HY000: Variable 'moosedb_compaction_threads' is a read only variable
SELECT @@GLOBAL.moosedb_compaction_threads;
@@GLOBAL.moosedb_compaction_threads
2
# ---- moosedb_wal_sync_mode (ENUM) ----
SET GLOBAL moosedb_wal_sync_mode = 'write';
SELECT @@GLOBAL.moosedb_wal_sync_mode;
@@GLOBAL.moosedb_wal_sync_mode
write
SET GLOBAL moosedb_wal_sync_mode = 'FSYNC';
SELECT @@GLOBAL.moosedb_wal_sync_mode;
@@GLOBAL.moosedb_wal_sync_mode
fsync
SET GLOBAL moosedb_wal_sync_mode = 0;
SELECT @@GLOBAL.moosedb_wal_sync_mode;
@@GLOBAL.moosedb_wal_sync_mode
fsync
SET GLOBAL moosedb_wal_sync_mode = 1;
SELECT @@GLOBAL.moosedb_wal_sync_mode;
@@GLOBAL.moosedb_wal_sync_mode
write
SET GLOBAL moosedb_wal_sync_mode = 'none';
ERROR 42000: Variable 'moosedb_wal_sync_mode' can't be set to the value of 'none'
SET GLOBAL moosedb_wal_sync_mode = 7;
ERROR 42000: Variable 'moosedb_wal_sync_mode' can't be set to the value of '7'
SET GLOBAL moosedb_wal_sync_mode = '';
ERROR 42000: Variable 'moosedb_wal_sync_mode' can't be set to the value of ''
SET GLOBAL moosedb_wal_sync_mode = 1.5;
ERROR 42000: Incorrect argument type to variable 'moosedb_wal_sync_mode'
SET GLOBAL moosedb_wal_sync_mode = DEFAULT;
SELECT @@GLOBAL.moosedb_wal_sync_mode;
@@GLOBAL.moosedb_wal_sync_mode
fsync
