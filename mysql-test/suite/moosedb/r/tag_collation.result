# Pushdown must prune series even for exotic collations
FLUSH STATUS;
SELECT COUNT(*) FROM tf WHERE ci = '😀';
COUNT(*)
4
SHOW SESSION STATUS LIKE 'Handler_read_rnd_next';
Variable_name	Value
Handler_read_rnd_next	5
