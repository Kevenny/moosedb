# this test counts handler calls / reads EXPLAIN of the scan path: the GROUP BY pushdown (default ON) would bypass it
SET SESSION moosedb_group_by_pushdown = OFF;
SET NAMES utf8mb4;
CREATE TABLE tf (
ts   DATETIME NOT NULL,
ci   VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL COMMENT 'TAG',
uni  VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci COMMENT 'TAG',
bin  VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin COMMENT 'TAG',
np   VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_nopad_bin COMMENT 'TAG',
ch   CHAR(8) CHARACTER SET latin1 COMMENT 'TAG',
n    INT,
INDEX(ts)
) ENGINE=MooseDB;
CREATE TABLE ctl LIKE tf;
ALTER TABLE ctl ENGINE=MyISAM;
