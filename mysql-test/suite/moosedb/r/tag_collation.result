# Second copy of the data in a sealed chunk
FLUSH TABLES tf;
INSERT INTO tf SELECT ts + INTERVAL 1 DAY, ci, uni, bin, np, ch, n + 100 FROM ctl;
INSERT INTO ctl SELECT ts + INTERVAL 1 DAY, ci, uni, bin, np, ch, n + 100 FROM ctl;
# Number of distinct series seen through each collation
SELECT COUNT(*) FROM tf;
COUNT(*)
24
SELECT COUNT(DISTINCT ci), COUNT(DISTINCT uni), COUNT(DISTINCT bin), COUNT(DISTINCT np), COUNT(DISTINCT ch) FROM tf;
COUNT(DISTINCT ci)	COUNT(DISTINCT uni)	COUNT(DISTINCT bin)	COUNT(DISTINCT np)	COUNT(DISTINCT ch)
7	6	8	11	6
SELECT COUNT(DISTINCT ci), COUNT(DISTINCT uni), COUNT(DISTINCT bin), COUNT(DISTINCT np), COUNT(DISTINCT ch) FROM ctl;
COUNT(DISTINCT ci)	COUNT(DISTINCT uni)	COUNT(DISTINCT bin)	COUNT(DISTINCT np)	COUNT(DISTINCT ch)
7	6	8	11	6
# Each CALL runs one predicate on tf and on ctl: status, predicate, tf count/sum(n), ctl count/sum(n)
CREATE PROCEDURE cmp(p TEXT CHARACTER SET utf8mb4)
BEGIN
EXECUTE IMMEDIATE CONCAT('SELECT CONCAT(COUNT(*), ''/'', IFNULL(SUM(n), 0)) INTO @a FROM tf WHERE ', p);
EXECUTE IMMEDIATE CONCAT('SELECT CONCAT(COUNT(*), ''/'', IFNULL(SUM(n), 0)) INTO @b FROM ctl WHERE ', p);
SELECT IF(@a = @b, 'OK', 'FAIL') AS status, p AS predicate, @a AS moosedb, @b AS control;
END//
