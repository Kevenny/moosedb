##################################################################
# Several TAG columns of different integer types, a VARCHAR TAG and a nullable TAG
##################################################################
CREATE TABLE mx (ts DATETIME NOT NULL,
itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG',
host   VARCHAR(8) NOT NULL COMMENT 'TAG',
tiny   TINYINT NOT NULL COMMENT 'TAG',
usmall SMALLINT UNSIGNED NOT NULL COMMENT 'TAG',
med    MEDIUMINT NOT NULL COMMENT 'TAG',
uint   INT UNSIGNED NOT NULL COMMENT 'TAG',
sint   INT NOT NULL COMMENT 'TAG',
nul    BIGINT COMMENT 'TAG',
v INT NOT NULL, INDEX(ts)) ENGINE=MooseDB;
CREATE TABLE ix (ts DATETIME NOT NULL, itemid BIGINT UNSIGNED NOT NULL, host VARCHAR(8) NOT NULL,
tiny TINYINT NOT NULL, usmall SMALLINT UNSIGNED NOT NULL, med MEDIUMINT NOT NULL,
uint INT UNSIGNED NOT NULL, sint INT NOT NULL, nul BIGINT, v INT NOT NULL, KEY(ts)) ENGINE=InnoDB;
INSERT INTO mx SELECT '2026-03-02 00:00:00' + INTERVAL seq SECOND, ELT(1 + seq MOD 6, '0', '1', '18446744073709551615', '123', '9007199254740993', '5'), CONCAT('h', seq MOD 4), ELT(1 + seq MOD 3, -128, 0, 127), ELT(1 + (seq DIV 3) MOD 2, 0, 65535), ELT(1 + (seq DIV 6) MOD 2, -8388608, 8388607), ELT(1 + (seq DIV 12) MOD 2, 0, 4294967295), ELT(1 + (seq DIV 24) MOD 2, -2147483648, 2147483647), IF(seq MOD 2, NULL, 7), seq FROM seq_0_to_239;
