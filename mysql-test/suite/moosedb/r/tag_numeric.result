##################################################################
# VARCHAR TAG holding numeric-looking text, compared with numbers
##################################################################
CREATE TABLE vt (ts DATETIME NOT NULL, tagv VARCHAR(16) NOT NULL COMMENT 'TAG', v INT NOT NULL, INDEX(ts))
ENGINE=MooseDB DEFAULT CHARSET=latin1;
CREATE TABLE vi (ts DATETIME NOT NULL, tagv VARCHAR(16) NOT NULL, v INT NOT NULL, KEY(ts))
ENGINE=InnoDB DEFAULT CHARSET=latin1;
INSERT INTO vt SELECT '2026-03-03 00:00:00' + INTERVAL seq SECOND, ELT(1 + seq MOD 12, '123', '0123', ' 12', '12abc', 'abc', '', '0', '1e2', '100', '123.0', '-5', '5'), seq FROM seq_0_to_59;
INSERT INTO vi SELECT '2026-03-03 00:00:00' + INTERVAL seq SECOND, ELT(1 + seq MOD 12, '123', '0123', ' 12', '12abc', 'abc', '', '0', '1e2', '100', '123.0', '-5', '5'), seq FROM seq_0_to_59;
