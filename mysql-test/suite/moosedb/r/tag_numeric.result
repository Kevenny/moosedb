##################################################################
# Large IN list (3000 values) on 2000 series
##################################################################
SET @thr_save= @@in_predicate_conversion_threshold;
SET in_predicate_conversion_threshold= 0;
CREATE TABLE bm (ts DATETIME NOT NULL, itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', v INT NOT NULL, INDEX(ts))
ENGINE=MooseDB;
CREATE TABLE bi (ts DATETIME NOT NULL, itemid BIGINT UNSIGNED NOT NULL, v INT NOT NULL, KEY(ts))
ENGINE=InnoDB;
INSERT INTO bm SELECT '2026-03-05 00:00:00' + INTERVAL seq SECOND, seq DIV 2 * 3 + 1, seq FROM seq_0_to_3999;
INSERT INTO bi SELECT * FROM bm;
SELECT COUNT(*), COUNT(DISTINCT itemid) FROM bm;
COUNT(*)	COUNT(DISTINCT itemid)
4000	2000
SELECT GROUP_CONCAT(seq) INTO @list FROM seq_1_to_3000;
SET @in= CONCAT('WHERE itemid IN (', @list, ')');
Variable_name	Value
Handler_read_rnd_next	2001
SELECT @a1 AS a, @b1 AS b, IF(@a1 <=> @a2 AND @b1 <=> @b2 AND @c1 <=> @c2, 'SAME', 'DIFFERENT') AS vs_innodb;
a	b	vs_innodb
2000	1999000	SAME
# Same list with some strings and fractions mixed in
Variable_name	Value
Handler_read_rnd_next	2005
SELECT @a1 AS a, @b1 AS b, IF(@a1 <=> @a2 AND @b1 <=> @b2 AND @c1 <=> @c2, 'SAME', 'DIFFERENT') AS vs_innodb;
a	b	vs_innodb
2004	2009670	SAME
SET in_predicate_conversion_threshold= @thr_save;
DROP TABLE bm, bi;
##################################################################
# More distinct (column, collation) indexes than the TAG cache holds (32):
# the 33rd column falls back to the direct comparison; answers must agree
##################################################################
# (DDL and INSERT of the 33-column tables not echoed)
CREATE TABLE verdicts (tag VARCHAR(100), same INT);
SELECT COUNT(*) AS queries, SUM(same) AS identical_to_innodb FROM verdicts;
queries	identical_to_innodb
66	66
