##################################################################
# ZEROFILL integer TAG: stored text is padded, never pushed (all rows read) but answers stay right
##################################################################
CREATE TABLE zm (ts DATETIME NOT NULL, zf INT(6) UNSIGNED ZEROFILL NOT NULL COMMENT 'TAG', v INT NOT NULL, INDEX(ts))
ENGINE=MooseDB;
CREATE TABLE zi (ts DATETIME NOT NULL, zf INT(6) UNSIGNED ZEROFILL NOT NULL, v INT NOT NULL, KEY(ts))
ENGINE=InnoDB;
INSERT INTO zm SELECT '2026-03-04 00:00:00' + INTERVAL seq SECOND, ELT(1 + seq MOD 4, 0, 7, 123, 4294967295), seq FROM seq_0_to_11;
