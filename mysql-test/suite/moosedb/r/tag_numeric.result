##################################################################
# Prepared statements (parameters are constants too)
##################################################################
PREPARE ps FROM 'SELECT COUNT(*), SUM(v) FROM m WHERE itemid = ?';
PREPARE psi FROM 'SELECT COUNT(*), SUM(v) FROM i WHERE itemid = ?';
SET @p= 123;
FLUSH STATUS;
EXECUTE ps USING @p;
COUNT(*)	SUM(v)
5	185
SHOW SESSION STATUS LIKE 'Handler_read_rnd_next';
Variable_name	Value
Handler_read_rnd_next	6
EXECUTE psi USING @p;
COUNT(*)	SUM(v)
5	185
SET @p= '123';
FLUSH STATUS;
EXECUTE ps USING @p;
COUNT(*)	SUM(v)
5	185
SHOW SESSION STATUS LIKE 'Handler_read_rnd_next';
Variable_name	Value
Handler_read_rnd_next	6
EXECUTE psi USING @p;
COUNT(*)	SUM(v)
5	185
SET @p= '0123';
EXECUTE ps USING @p;
COUNT(*)	SUM(v)
5	185
EXECUTE psi USING @p;
COUNT(*)	SUM(v)
5	185
SET @p= 123.5;
EXECUTE ps USING @p;
COUNT(*)	SUM(v)
0	NULL
EXECUTE psi USING @p;
COUNT(*)	SUM(v)
0	NULL
DEALLOCATE PREPARE ps;
DEALLOCATE PREPARE psi;
