CREATE TABLE m (ts DATETIME NOT NULL, itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG',
v INT NOT NULL, INDEX(ts)) ENGINE=MooseDB;
CREATE TABLE i (ts DATETIME NOT NULL, itemid BIGINT UNSIGNED NOT NULL,
v INT NOT NULL, KEY(ts)) ENGINE=InnoDB;
CREATE TABLE x (id BIGINT UNSIGNED NOT NULL, KEY(id)) ENGINE=InnoDB;
INSERT INTO x VALUES (123), (124), (1), (3), (18446744073709551615), (5);
# 16 series around the interesting boundaries, 5 rows each; half sealed, half in the MemTable
INSERT INTO m SELECT '2026-03-01 00:00:00' + INTERVAL seq SECOND, ELT(1 + seq MOD 16, '0', '1', '2', '3', '10', '123', '124', '1000', '4294967296', '9007199254740991', '9007199254740992', '9007199254740993', '9223372036854775807', '9223372036854775808', '18446744073709551614', '18446744073709551615'), seq FROM seq_0_to_39;
INSERT INTO i SELECT '2026-03-01 00:00:00' + INTERVAL seq SECOND, ELT(1 + seq MOD 16, '0', '1', '2', '3', '10', '123', '124', '1000', '4294967296', '9007199254740991', '9007199254740992', '9007199254740993', '9223372036854775807', '9223372036854775808', '18446744073709551614', '18446744073709551615'), seq FROM seq_0_to_39;
FLUSH TABLES m;
INSERT INTO m SELECT '2026-03-01 00:00:00' + INTERVAL seq SECOND, ELT(1 + seq MOD 16, '0', '1', '2', '3', '10', '123', '124', '1000', '4294967296', '9007199254740991', '9007199254740992', '9007199254740993', '9223372036854775807', '9223372036854775808', '18446744073709551614', '18446744073709551615'), seq FROM seq_40_to_79;
INSERT INTO i SELECT '2026-03-01 00:00:00' + INTERVAL seq SECOND, ELT(1 + seq MOD 16, '0', '1', '2', '3', '10', '123', '124', '1000', '4294967296', '9007199254740991', '9007199254740992', '9007199254740993', '9223372036854775807', '9223372036854775808', '18446744073709551614', '18446744073709551615'), seq FROM seq_40_to_79;
SELECT COUNT(*), COUNT(DISTINCT itemid), MAX(itemid) FROM m;
COUNT(*)	COUNT(DISTINCT itemid)	MAX(itemid)
80	16	18446744073709551615
SELECT COUNT(*), COUNT(DISTINCT itemid), MAX(itemid) FROM i;
COUNT(*)	COUNT(DISTINCT itemid)	MAX(itemid)
