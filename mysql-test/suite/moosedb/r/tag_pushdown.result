# this test counts handler calls / reads EXPLAIN of the scan path: the GROUP BY pushdown (default ON) would bypass it
SET SESSION moosedb_group_by_pushdown = OFF;
CREATE TABLE p (
ts     DATETIME NOT NULL,
host   VARCHAR(16) NOT NULL COMMENT 'TAG',
region VARCHAR(16) COMMENT 'TAG',
v      INT,
INDEX(ts)
) ENGINE=MooseDB DEFAULT CHARSET=latin1;
INSERT INTO p SELECT '2026-01-01' + INTERVAL seq SECOND,
ELT(1 + seq MOD 4, 'srv01', 'srv02', 'SRV03', 'srv04'),
IF(seq MOD 8 = 0, NULL, IF(seq MOD 2, 'east', 'west')), seq
FROM seq_0_to_999;
FLUSH TABLES p;
INSERT INTO p VALUES ('2026-01-02', 'srv01', 'east', 1000);
# Rows handed to the server = matching series only (+1 for EOF)
FLUSH STATUS;
SELECT COUNT(*), SUM(v) FROM p WHERE host = 'srv01';
COUNT(*)	SUM(v)
251	125500
SHOW SESSION STATUS LIKE 'Handler_read_rnd_next';
Variable_name	Value
Handler_read_rnd_next	252
# Case-insensitive collation: 'srv03' finds 'SRV03'
FLUSH STATUS;
SELECT COUNT(*) FROM p WHERE host = 'srv03';
COUNT(*)
250
SHOW SESSION STATUS LIKE 'Handler_read_rnd_next';
Variable_name	Value
Handler_read_rnd_next	251
SELECT COUNT(*) FROM p WHERE host = 'srv03' COLLATE latin1_bin;
COUNT(*)
0
SELECT COUNT(*) FROM p WHERE host = 'srv01 ';
COUNT(*)
251
# IN lists, conjunctions of several tags, NULL tags
FLUSH STATUS;
SELECT host, region, COUNT(*) FROM p WHERE host IN ('srv01', 'srv02', NULL) AND region = 'east'
  GROUP BY host, region ORDER BY host;
host	region	COUNT(*)
srv01	east	1
srv02	east	250
SHOW SESSION STATUS LIKE 'Handler_read_rnd_next';
Variable_name	Value
Handler_read_rnd_next	255
SELECT COUNT(*) FROM p WHERE region IS NULL;
COUNT(*)
125
SELECT COUNT(*) FROM p WHERE region = NULL;
COUNT(*)
0
SELECT COUNT(*) FROM p WHERE host NOT IN ('srv01');
COUNT(*)
750
SELECT COUNT(*) FROM p WHERE host = 'srv01' OR v = 3;
COUNT(*)
252
# Combined with the timestamp index
FLUSH STATUS;
SELECT COUNT(*) FROM p WHERE host = 'srv02' AND ts BETWEEN '2026-01-01 00:01:00' AND '2026-01-01 00:02:00';
COUNT(*)
15
SHOW SESSION STATUS LIKE 'Handler_read_next';
Variable_name	Value
Handler_read_next	15
# Joins push the constant side only
CREATE TABLE hosts (name VARCHAR(16)) ENGINE=MyISAM;
INSERT INTO hosts VALUES ('srv04'), ('nope');
SELECT h.name, COUNT(p.v) FROM hosts h LEFT JOIN p ON p.host = h.name GROUP BY h.name ORDER BY h.name;
name	COUNT(p.v)
nope	0
srv04	250
SELECT COUNT(*) FROM p WHERE host = (SELECT MIN(name) FROM hosts);
COUNT(*)
0
# Unknown values match nothing
FLUSH STATUS;
SELECT COUNT(*) FROM p WHERE host = 'nope';
COUNT(*)
0
SHOW SESSION STATUS LIKE 'Handler_read_rnd_next';
Variable_name	Value
Handler_read_rnd_next	1
DROP TABLE p, hosts;
