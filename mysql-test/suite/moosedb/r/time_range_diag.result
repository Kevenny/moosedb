# Multi-table DELETE and DELETE that reads through the pruned scan
##################################################################
TRUNCATE m;
TRUNCATE i;
INSERT INTO m SELECT '2026-03-01 00:00:00' + INTERVAL seq MINUTE, CONCAT('h', seq MOD 3), seq FROM seq_0_to_59;
INSERT INTO i SELECT '2026-03-01 00:00:00' + INTERVAL seq MINUTE, CONCAT('h', seq MOD 3), seq FROM seq_0_to_59;
DELETE m FROM m JOIN s ON m.host = s.host AND m.ts = s.ts WHERE m.ts > '2026-03-01 00:05:00';
DELETE i FROM i JOIN s ON i.host = s.host AND i.ts = s.ts WHERE i.ts > '2026-03-01 00:05:00';
DELETE m FROM m JOIN s ON m.host = s.host WHERE m.ts BETWEEN '2026-03-01 00:40:00' AND '2026-03-01 00:45:00' AND s.k = 1;
DELETE i FROM i JOIN s ON i.host = s.host WHERE i.ts BETWEEN '2026-03-01 00:40:00' AND '2026-03-01 00:45:00' AND s.k = 1;
DELETE FROM m WHERE ts < '2026-03-01 00:03:00' AND v MOD 2 = 0 ORDER BY ts LIMIT 2;
DELETE FROM i WHERE ts < '2026-03-01 00:03:00' AND v MOD 2 = 0 ORDER BY ts LIMIT 2;
