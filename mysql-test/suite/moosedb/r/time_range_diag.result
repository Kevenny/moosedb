CREATE TABLE m (ts DATETIME NOT NULL, host VARCHAR(8) NOT NULL COMMENT 'TAG',
v INT NOT NULL, INDEX(ts)) ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR';
CREATE TABLE i (ts DATETIME NOT NULL, host VARCHAR(8) NOT NULL,
v INT NOT NULL, KEY(ts)) ENGINE=InnoDB;
CREATE TABLE s (ts DATETIME NOT NULL, host VARCHAR(8) NOT NULL, v INT NOT NULL, k INT NOT NULL) ENGINE=InnoDB;
INSERT INTO s VALUES ('2026-03-01 00:10:00', 'h0', 3, 1), ('2026-03-01 00:30:00', 'h1', 7, 2),
('2026-03-01 00:55:00', 'h2', 9, 3), ('2027-01-01 00:00:00', 'h0', 1, 4);
