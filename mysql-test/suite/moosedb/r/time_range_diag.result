# stored procedure: loop with a variable in the bound
CREATE PROCEDURE p_m(OUT r VARCHAR(500))
BEGIN
DECLARE n INT DEFAULT 0;
DECLARE c INT;
DECLARE b DATETIME;
SET r = '';
WHILE n < 6 DO
SET b = '2026-03-01 00:00:00' + INTERVAL (n * 11) MINUTE;
SELECT COUNT(*) INTO c FROM m IGNORE INDEX(ts) WHERE ts > b;
SET r = CONCAT(r, c, ',');
SET n = n + 1;
END WHILE;
END|
CREATE PROCEDURE p_i(OUT r VARCHAR(500))
BEGIN
DECLARE n INT DEFAULT 0;
DECLARE c INT;
DECLARE b DATETIME;
SET r = '';
WHILE n < 6 DO
SET b = '2026-03-01 00:00:00' + INTERVAL (n * 11) MINUTE;
SELECT COUNT(*) INTO c FROM i IGNORE INDEX(ts) WHERE ts > b;
SET r = CONCAT(r, c, ',');
SET n = n + 1;
END WHILE;
END|
CALL p_m(@r1);
CALL p_i(@r2);
CALL p_m(@r3);
SELECT @r1 AS counts, IF(@r1 = @r2 AND @r1 = @r3, 'SAME', 'DIFFERENT') AS vs_innodb;
counts	vs_innodb
118,96,74,52,30,8,	SAME
DROP PROCEDURE p_m;
DROP PROCEDURE p_i;
