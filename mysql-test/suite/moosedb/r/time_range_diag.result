# PREPARE ts > ? executed with different values
SET @sm = 'SELECT COUNT(*), SUM(v), MIN(ts), MAX(ts) INTO @c1, @s1, @a1, @b1 FROM m IGNORE INDEX(ts) WHERE ts > ?';
SET @si = 'SELECT COUNT(*), SUM(v), MIN(ts), MAX(ts) INTO @c2, @s2, @a2, @b2 FROM i IGNORE INDEX(ts) WHERE ts > ?';
PREPARE pm FROM @sm;
PREPARE pi FROM @si;
