# Fractional stored values (DATETIME(3)) against constants with more or fewer digits
CREATE TABLE m (ts DATETIME(3) NOT NULL, host VARCHAR(8) NOT NULL COMMENT 'TAG',
v INT NOT NULL, INDEX(ts)) ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR';
CREATE TABLE i (ts DATETIME(3) NOT NULL, host VARCHAR(8) NOT NULL,
v INT NOT NULL, KEY(ts)) ENGINE=InnoDB;
INSERT INTO m SELECT '2026-03-01 00:00:00' + INTERVAL (seq * 250) MICROSECOND, CONCAT('h', seq MOD 3), seq FROM seq_0_to_399;
INSERT INTO i SELECT '2026-03-01 00:00:00' + INTERVAL (seq * 250) MICROSECOND, CONCAT('h', seq MOD 3), seq FROM seq_0_to_399;
FLUSH TABLES m;
