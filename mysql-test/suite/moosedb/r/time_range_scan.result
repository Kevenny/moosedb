CREATE TABLE m (ts DATETIME NOT NULL, host VARCHAR(8) NOT NULL COMMENT 'TAG',
v INT NOT NULL, INDEX(ts)) ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR';
CREATE TABLE i (ts DATETIME NOT NULL, host VARCHAR(8) NOT NULL,
v INT NOT NULL, KEY(ts)) ENGINE=InnoDB;
# 10 hosts x 240 minutes: 2 sealed batches (4 hourly chunks) and a MemTable tail
INSERT INTO m SELECT '2026-03-01 00:00:00' + INTERVAL s.seq MINUTE, CONCAT('h', h.seq), s.seq * 10 + h.seq FROM seq_0_to_119 s JOIN seq_0_to_9 h;
INSERT INTO i SELECT '2026-03-01 00:00:00' + INTERVAL s.seq MINUTE, CONCAT('h', h.seq), s.seq * 10 + h.seq FROM seq_0_to_119 s JOIN seq_0_to_9 h;
FLUSH TABLES m;
INSERT INTO m SELECT '2026-03-01 00:00:00' + INTERVAL s.seq MINUTE, CONCAT('h', h.seq), s.seq * 10 + h.seq FROM seq_120_to_199 s JOIN seq_0_to_9 h;
INSERT INTO i SELECT '2026-03-01 00:00:00' + INTERVAL s.seq MINUTE, CONCAT('h', h.seq), s.seq * 10 + h.seq FROM seq_120_to_199 s JOIN seq_0_to_9 h;
FLUSH TABLES m;
INSERT INTO m SELECT '2026-03-01 00:00:00' + INTERVAL s.seq MINUTE, CONCAT('h', h.seq), s.seq * 10 + h.seq FROM seq_200_to_239 s JOIN seq_0_to_9 h;
INSERT INTO i SELECT '2026-03-01 00:00:00' + INTERVAL s.seq MINUTE, CONCAT('h', h.seq), s.seq * 10 + h.seq FROM seq_200_to_239 s JOIN seq_0_to_9 h;
SELECT COUNT(*) FROM m;
COUNT(*)
