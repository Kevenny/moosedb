CREATE TABLE z (
ts   DATETIME NOT NULL,
host VARCHAR(8) NOT NULL COMMENT 'TAG',
i    INT,
d    DOUBLE,
vb   VARCHAR(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin,
vc   VARCHAR(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci,
t    TIMESTAMP NULL DEFAULT NULL,
df   DOUBLE(10,2),
INDEX(ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 DAY';
# 6 days (= 6 chunks), 2 series; day k holds i in [k*100, k*100+99],
# d in [k*10, k*10+9.9], vb/vc 'k-..' ; NULLs sprinkled; one flush per day
CREATE DATABASE mirror;
CREATE TABLE mirror.z LIKE test.z;
ALTER TABLE mirror.z ENGINE=InnoDB;
INSERT INTO mirror.z SELECT * FROM test.z;
