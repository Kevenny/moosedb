#
# Basic DDL/DML of the MooseDB engine (spec §17).
#
--source suite/moosedb/include/have_moosedb.inc

CREATE TABLE t1 (
    ts     DATETIME(6) NOT NULL,
    host   VARCHAR(64) NOT NULL COMMENT 'TAG',
    value  DOUBLE,
    INDEX ts_idx (ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR' RETENTION_PERIOD='FOREVER';

INSERT INTO t1 VALUES
    ('2026-10-01 10:00:00.000000', 'srv01', 42.5),
    ('2026-10-01 10:00:01.000000', 'srv01', 43.1),
    ('2026-10-01 10:00:02.000000', 'srv02', 11.2);

SELECT COUNT(*) FROM t1;
--sorted_result
SELECT * FROM t1 WHERE host = 'srv01';
SELECT * FROM t1 WHERE ts BETWEEN '2026-10-01 10:00:00' AND '2026-10-01 10:00:01';

--echo # UPDATE is not supported; row-level DELETE is (delete.test)
--error ER_ILLEGAL_HA
UPDATE t1 SET value = 0 WHERE host = 'srv01';
DELETE FROM t1 WHERE host = 'srv01';
SELECT ROW_COUNT();
SELECT COUNT(*) FROM t1;

--echo # Rows survive FLUSH TABLES (MemTable sealed into a chunk)
FLUSH TABLES t1;
INSERT INTO t1 VALUES ('2026-10-01 11:30:00', 'srv03', NULL);
SELECT * FROM t1 ORDER BY ts;
SELECT host, COUNT(*), SUM(value) FROM t1 GROUP BY host ORDER BY host;

--echo # DELETE without WHERE empties the table
DELETE FROM t1;
SELECT COUNT(*) FROM t1;

INSERT INTO t1 VALUES ('2026-10-02 00:00:00', 'srv01', 1);
TRUNCATE TABLE t1;
SELECT COUNT(*) FROM t1;
INSERT INTO t1 VALUES ('2026-10-02 00:00:00', 'srv09', 9);
SELECT * FROM t1;

--echo # RENAME keeps the data
RENAME TABLE t1 TO t2;
SELECT * FROM t2;
DROP TABLE t2;
