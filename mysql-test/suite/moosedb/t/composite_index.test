#
# Composite indexes (TAG_1, ..., TAG_k [, time]): which definitions are
# accepted, the plans the optimizer builds with them (ref / range /
# "optimized away"), and that every access path gives the answer an InnoDB
# mirror gives -- for integer and VARCHAR TAGs, DATETIME and integer time
# axes, series in the MemTable and in sealed chunks, rows of the statement
# itself, TRUNCATE, retention and a restart.
#
# The Handler_read_* counters prove the lookups are index lookups: a full
# scan would show Handler_read_rnd_next of the table size.
#
--source include/not_embedded.inc
--source include/have_innodb.inc
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc

--exec $MYSQL test < $MOOSEDB_INSTALL_SQL

--echo ##################################################################
--echo # DDL: which indexes are accepted
--echo ##################################################################
--echo # TAG columns followed by the time column, any number of them
CREATE TABLE a1 (clock INT NOT NULL, itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', value DOUBLE,
                 INDEX clock_idx (clock), INDEX item_clock (itemid, clock))
  ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
SHOW CREATE TABLE a1;
SHOW INDEX FROM a1;
CREATE TABLE a2 (ts DATETIME NOT NULL, host VARCHAR(20) NOT NULL COMMENT 'TAG', item INT NOT NULL COMMENT 'TAG',
                 v INT, INDEX (ts), INDEX (host, item, ts), INDEX (item, host, ts), INDEX (host, ts))
  ENGINE=MooseDB;
--echo # TAG columns without the time column
CREATE TABLE a3 (ts TIMESTAMP NOT NULL, host CHAR(8) NOT NULL COMMENT 'TAG', item SMALLINT NOT NULL COMMENT 'TAG',
                 INDEX (ts), INDEX (host), INDEX (host, item))
  ENGINE=MooseDB;
--echo # The indexes survive ALTER TABLE ... ADD/DROP INDEX
ALTER TABLE a3 DROP INDEX host, ADD INDEX (item, host, ts);
SHOW INDEX FROM a3;
DROP TABLE a1, a2, a3;

--echo # UNIQUE / PRIMARY (all TAGs, time) is accepted (primary_key.test); a key without the time is refused
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock INT NOT NULL, itemid BIGINT NOT NULL COMMENT 'TAG', INDEX (clock), UNIQUE (itemid)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--echo # Refused: the time column must be the last part
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock INT NOT NULL, itemid BIGINT NOT NULL COMMENT 'TAG', INDEX (clock), INDEX (clock, itemid)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--echo # Refused: a part that is neither a TAG nor the time column
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock INT NOT NULL, itemid BIGINT NOT NULL COMMENT 'TAG', v INT NOT NULL, INDEX (clock), INDEX (itemid, v)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock INT NOT NULL, itemid BIGINT NOT NULL COMMENT 'TAG', v INT NOT NULL, INDEX (clock), INDEX (itemid, v, clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--echo # Refused: TAG columns of an unsupported type, or only partly indexed
--error ER_NULL_COLUMN_IN_INDEX
CREATE TABLE e (clock INT NOT NULL, itemid BIGINT COMMENT 'TAG', INDEX (clock), INDEX (itemid, clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock INT NOT NULL, d DOUBLE NOT NULL COMMENT 'TAG', INDEX (clock), INDEX (d, clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock INT NOT NULL, d DECIMAL(10,2) NOT NULL COMMENT 'TAG', INDEX (clock), INDEX (d)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock INT NOT NULL, y YEAR NOT NULL COMMENT 'TAG', INDEX (clock), INDEX (y)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock INT NOT NULL, e ENUM('a','b') NOT NULL COMMENT 'TAG', INDEX (clock), INDEX (e)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--error ER_BLOB_USED_AS_KEY
CREATE TABLE e (clock INT NOT NULL, t TEXT NOT NULL COMMENT 'TAG', INDEX (clock), INDEX (t(8))) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock INT NOT NULL, n VARCHAR(40) NOT NULL COMMENT 'TAG', INDEX (clock), INDEX (n(8), clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--echo # Refused: a column twice, descending parts, FULLTEXT
--error ER_DUP_FIELDNAME
CREATE TABLE e (clock INT NOT NULL, itemid BIGINT NOT NULL COMMENT 'TAG', INDEX (clock), INDEX (itemid, itemid, clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock INT NOT NULL, itemid BIGINT NOT NULL COMMENT 'TAG', INDEX (clock), INDEX (itemid, clock DESC)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock INT NOT NULL, itemid BIGINT NOT NULL COMMENT 'TAG', INDEX (clock DESC)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--error ER_TABLE_CANT_HANDLE_FT
CREATE TABLE e (clock INT NOT NULL, n VARCHAR(40) NOT NULL COMMENT 'TAG', INDEX (clock), FULLTEXT (n)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--echo # The index on the time column alone is still required
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock INT NOT NULL, itemid BIGINT NOT NULL COMMENT 'TAG', INDEX (itemid, clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';

--echo ##################################################################
--echo # Data: 60 items on 4 hosts, 120 samples each, 3 chunks (1 HOUR),
--echo # first half sealed, second half in the MemTable
--echo ##################################################################
CREATE TABLE m (
  hostid BIGINT UNSIGNED NOT NULL COMMENT 'TAG',
  itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG',
  clock  INT NOT NULL,
  value  DOUBLE NOT NULL,
  ns     INT NOT NULL,
  INDEX clock_idx (clock),
  INDEX item_clock (itemid, clock)
) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 HOUR';
CREATE TABLE i (
  hostid BIGINT UNSIGNED NOT NULL,
  itemid BIGINT UNSIGNED NOT NULL,
  clock  INT NOT NULL,
  value  DOUBLE NOT NULL,
  ns     INT NOT NULL,
  KEY clock_idx (clock)
) ENGINE=InnoDB;
--let $gen= SELECT 1 + (a.seq MOD 4), 100 + a.seq, 1700000000 + b.seq * 60, ROUND(a.seq * 1000 + b.seq + (b.seq MOD 7) / 10, 1), (a.seq * 7919 + b.seq * 104729) MOD 1000000000
eval INSERT INTO m $gen FROM seq_1_to_60 a, seq_0_to_59 b;
eval INSERT INTO i $gen FROM seq_1_to_60 a, seq_0_to_59 b;
FLUSH TABLES m;
eval INSERT INTO m $gen FROM seq_1_to_60 a, seq_60_to_119 b;
eval INSERT INTO i $gen FROM seq_1_to_60 a, seq_60_to_119 b;
--echo # Item 105 also has two samples at the same second (different ns), item 999 one sample
INSERT INTO m VALUES (2, 105, 1700000600, -1, 5), (2, 105, 1700000600, -2, 999999999), (3, 999, 1700003000, 9, 9);
INSERT INTO i VALUES (2, 105, 1700000600, -1, 5), (2, 105, 1700000600, -2, 999999999), (3, 999, 1700003000, 9, 9);
SELECT COUNT(*), COUNT(DISTINCT itemid), MIN(clock), MAX(clock) FROM m;
SELECT COUNT(*), COUNT(DISTINCT itemid), MIN(clock), MAX(clock) FROM i;

--let $mt= m
--let $it= i
--let $agg= COUNT(*), ROUND(SUM(value), 3), BIT_XOR(CRC32(CONCAT(itemid, '|', clock, '|', ns, '|', value)))
--let $show= 1
--let $status= 1

--echo ##################################################################
--echo # EXPLAIN: the optimizer uses the composite index
--echo ##################################################################
EXPLAIN SELECT * FROM m WHERE itemid = 105;
EXPLAIN SELECT * FROM m WHERE itemid = 105 AND clock BETWEEN 1700001000 AND 1700002000;
EXPLAIN SELECT * FROM m WHERE itemid = 105 AND clock > 1700005000;
EXPLAIN SELECT * FROM m WHERE itemid = 105 AND clock < 1700000500;
EXPLAIN SELECT * FROM m WHERE itemid = 105 AND clock = 1700000600;
EXPLAIN SELECT * FROM m WHERE itemid IN (101, 105, 110) AND clock >= 1700006000;
EXPLAIN SELECT * FROM m WHERE itemid = 105 ORDER BY clock DESC LIMIT 1;
EXPLAIN SELECT * FROM m WHERE itemid = 105 ORDER BY clock LIMIT 3;
EXPLAIN SELECT MAX(clock) FROM m WHERE itemid = 105 AND clock > 1700000000;
EXPLAIN SELECT MIN(clock) FROM m WHERE itemid = 105;
--echo # Without the item the time-only index serves the range, as before
EXPLAIN SELECT * FROM m WHERE clock BETWEEN 1700001000 AND 1700002000;
--echo # A nonexistent item: estimated at one row
EXPLAIN SELECT * FROM m WHERE itemid = 424242;

