--let $q= SELECT h.itemid, h.clock, h.value FROM {T} h JOIN (SELECT itemid, MAX(clock) c FROM {T} WHERE itemid IN (SELECT 200 + seq FROM seq_1_to_30 WHERE seq MOD 2 = 0) GROUP BY itemid) l ON h.itemid=l.itemid AND h.clock=l.c ORDER BY h.itemid
--let $label= filtered view: last value of fifteen items
--source suite/moosedb/include/cmp_query.inc
--echo # Series created between two runs of the same IN: new items, and a new series of an existing item (merged into its tuple)
INSERT INTO n VALUES (4, 205, 1700009000, 7), (1, 2001, 1700009000, 8), (2, 2002, 1700009100, 9);
INSERT INTO ni VALUES (4, 205, 1700009000, 7), (1, 2001, 1700009000, 8), (2, 2002, 1700009100, 9);
