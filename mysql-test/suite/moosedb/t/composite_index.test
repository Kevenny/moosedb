EXPLAIN SELECT clock FROM m WHERE itemid = 110 AND clock BETWEEN 1700001000 AND 1700002000 ORDER BY clock DESC;
--let $show= 0
--let $q= SELECT clock FROM {T} WHERE itemid = 110 AND clock BETWEEN 1700001000 AND 1700002000 ORDER BY clock DESC
