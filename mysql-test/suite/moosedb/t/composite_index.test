--echo ##################################################################
--echo # No order between TAG values is announced: ORDER BY / GROUP BY on a
--echo # TAG are sorts (never an index scan that would return a wrong order)
--echo ##################################################################
EXPLAIN SELECT itemid, clock FROM m ORDER BY itemid, clock LIMIT 3;
EXPLAIN SELECT itemid, MAX(clock) FROM m GROUP BY itemid;
EXPLAIN SELECT DISTINCT itemid FROM m;
