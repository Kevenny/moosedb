--echo # Loose scan over an IN: the ordered view holds only the series the WHERE allows
--let $show= 0
CREATE TABLE n (
  hostid BIGINT UNSIGNED NOT NULL COMMENT 'TAG',
  itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG',
  clock  INT NOT NULL,
  value  DOUBLE NOT NULL,
  INDEX clock_idx (clock),
  INDEX item_clock (itemid, clock),
  INDEX host_item_clock (hostid, itemid, clock)
) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 HOUR';
CREATE TABLE ni (
  hostid BIGINT UNSIGNED NOT NULL,
  itemid BIGINT UNSIGNED NOT NULL,
  clock  INT NOT NULL,
  value  DOUBLE NOT NULL,
  KEY clock_idx (clock)
) ENGINE=InnoDB;
--let $gen= SELECT 1 + (a.seq MOD 3), 200 + a.seq, 1700000000 + b.seq * 60, a.seq * 100 + b.seq
eval INSERT INTO n $gen FROM seq_1_to_30 a, seq_0_to_9 b;
eval INSERT INTO ni $gen FROM seq_1_to_30 a, seq_0_to_9 b;
--let $mt= n
--let $it= ni
