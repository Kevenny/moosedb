--let $c= 1700003000
--let $lo= 1700001500
--let $hi= 1700004500
--let $ops= =,<,<=,>,>=,<>
--let $n= 6
--let $k= 1
while ($k <= $n)
{
  --let $op= `SELECT ELT($k, '=', '<', '<=', '>', '>=', '<>')`
