--echo ##################################################################
--echo # MIN/MAX of a TAG with a range condition: the ordered index reads
--echo ##################################################################
--echo # 105 is a series, 500 and 0 are not (160 and 999 are the last ones, 101 the first)
EXPLAIN SELECT MAX(itemid) FROM m WHERE itemid <= 500;
EXPLAIN SELECT MIN(itemid) FROM m WHERE itemid > 105;
--let $c= 0
while ($c < 4)
{
  --let $v= `SELECT ELT(1 + $c, 105, 500, 1000, 0)`
  --let $k= 1
  while ($k <= 4)
  {
    --let $op= `SELECT ELT($k, '<', '<=', '>', '>=')`
    --let $q= SELECT MAX(itemid), MIN(itemid) FROM {T} WHERE itemid $op $v
    --let $label= MAX/MIN(itemid) WHERE itemid $op $v
    --source suite/moosedb/include/cmp_query.inc
    inc $k;
  }
  inc $c;
}
--let $q= SELECT MAX(itemid) FROM {T} WHERE itemid <= 105 AND clock > 0
--let $label= MAX(itemid) WHERE itemid <= 105 AND clock > 0 (an extra condition: not the index)
