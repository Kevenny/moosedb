--source suite/moosedb/include/cmp_query.inc
--let $q= SELECT hostid, itemid, MIN(clock) FROM {T} WHERE hostid IN (2,9) AND itemid > 210 GROUP BY hostid, itemid ORDER BY hostid, itemid
