--let $q= SELECT itemid, MAX(clock) FROM {T} WHERE itemid IN (9001,9002) GROUP BY itemid
--let $label= filtered view: IN of nonexistent items only
--source suite/moosedb/include/cmp_query.inc
--let $q= SELECT itemid, MAX(clock) FROM {T} WHERE itemid IN (201,9001,230,9002) GROUP BY itemid ORDER BY itemid DESC
--let $label= filtered view: IN with nonexistent items among real ones
--source suite/moosedb/include/cmp_query.inc
