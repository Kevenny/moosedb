--let $it= i

--echo ##################################################################
--echo # VARCHAR TAG, DATETIME axis, case-insensitive collation
--echo ##################################################################
CREATE TABLE v (
  ts   DATETIME(3) NOT NULL,
  name VARCHAR(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL COMMENT 'TAG',
  v    INT NOT NULL,
  INDEX (ts), INDEX name_ts (name, ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR';
CREATE TABLE vi (
  ts   DATETIME(3) NOT NULL,
  name VARCHAR(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL,
  v    INT NOT NULL,
  KEY (ts)
) ENGINE=InnoDB;
--echo # 'alpha' and 'Alpha' are two series that compare equal; 'ALPHA ' too (PAD SPACE)
--let $vgen= SELECT '2026-03-01 00:00:00' + INTERVAL seq * 5 MINUTE, ELT(1 + seq MOD 6, 'alpha', 'Alpha', 'beta', 'ALPHA ', 'Gamma', 'delta'), seq
eval INSERT INTO v $vgen FROM seq_0_to_59;
eval INSERT INTO vi $vgen FROM seq_0_to_59;
FLUSH TABLES v;
eval INSERT INTO v $vgen FROM seq_60_to_119;
eval INSERT INTO vi $vgen FROM seq_60_to_119;
--let $mt= v
--let $it= vi
EXPLAIN SELECT * FROM v WHERE name = 'ALPHA' AND ts > '2026-03-01 05:00:00';
--let $agg= COUNT(*), SUM(v), BIT_XOR(CRC32(CONCAT(ts, '|', name, '|', v)))
--let $q= SELECT $agg FROM {T} WHERE name = 'ALPHA'
--let $label= name = 'ALPHA' (three series)
--let $show= 1
--source suite/moosedb/include/cmp_query.inc
--let $show= 0
--let $q= SELECT $agg FROM {T} WHERE name = 'alpha ' AND ts >= '2026-03-01 02:00:00' AND ts < '2026-03-01 04:30:00'
--let $label= name = 'alpha ' AND ts in a window
--source suite/moosedb/include/cmp_query.inc
--let $q= SELECT $agg FROM {T} WHERE name IN ('BETA', 'gamma', 'nothing') AND ts BETWEEN '2026-03-01 01:00:00' AND '2026-03-01 08:00:00'
--let $label= name IN (...) AND ts BETWEEN
--source suite/moosedb/include/cmp_query.inc
--let $q= SELECT $agg FROM {T} WHERE name = _utf8mb4'ALPHA' COLLATE utf8mb4_bin
--let $label= name = _utf8mb4'ALPHA' COLLATE utf8mb4_bin (a different comparison: not the index)
--source suite/moosedb/include/cmp_query.inc
--let $show= 1
--let $q= SELECT ts, name FROM {T} WHERE name = 'Alpha' ORDER BY ts DESC LIMIT 4
--let $label= name = 'Alpha' ORDER BY ts DESC LIMIT 4 (series 'alpha', 'Alpha', 'ALPHA ' merged by time)
--source suite/moosedb/include/cmp_query.inc
--let $q= SELECT MAX(ts), MIN(ts) FROM {T} WHERE name = 'ALPHA'
--let $label= MAX/MIN(ts) of a name
--source suite/moosedb/include/cmp_query.inc
--let $q= SELECT MAX(name), MIN(name) FROM {T}
--let $label= MAX/MIN(name) in collation order (ci: 'Gamma' > 'delta', 'alpha' = 'Alpha' = 'ALPHA ')
--source suite/moosedb/include/cmp_query.inc
--let $q= SELECT MIN(ts) FROM {T} WHERE name = 'beta' AND ts > '2026-03-01 07:00:00'
--let $label= MIN(ts) after a time
--source suite/moosedb/include/cmp_query.inc
--let $mt= m
--let $it= i
DROP TABLE v, vi;

--echo ##################################################################
--echo # TIMESTAMP axis with two TAGs of different kinds (CHAR + SMALLINT); the
--echo # CHAR tag has series 'a' and 'A' that the case-insensitive collation says are equal
--echo ##################################################################
SET time_zone = '+03:00';
CREATE TABLE tt (
  ts   TIMESTAMP(2) NOT NULL DEFAULT '2026-01-01 00:00:00',
  site CHAR(6) NOT NULL COMMENT 'TAG',
  n    SMALLINT NOT NULL COMMENT 'TAG',
  v    INT NOT NULL,
  INDEX (ts), INDEX (site, n, ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR';
CREATE TABLE tti LIKE tt;
ALTER TABLE tti ENGINE=InnoDB;
ALTER TABLE tti DROP INDEX site;
--let $tgen= SELECT '2026-03-01 00:00:00' + INTERVAL seq * 10 MINUTE, ELT(1 + seq MOD 4, 'a', 'b', 'c', 'A'), CAST(seq MOD 5 AS SIGNED) - 2, seq
eval INSERT INTO tt $tgen FROM seq_0_to_89;
eval INSERT INTO tti $tgen FROM seq_0_to_89;
--let $mt= tt
--let $it= tti
--let $agg= COUNT(*), SUM(v), BIT_XOR(CRC32(CONCAT(ts, '|', site, '|', n, '|', v)))
--let $q= SELECT $agg FROM {T} WHERE site = 'b' AND n = -1
--let $label= site = 'b' AND n = -1 (a negative SMALLINT tag)
--source suite/moosedb/include/cmp_query.inc
--let $q= SELECT $agg FROM {T} WHERE site = 'b' AND n = -1 AND ts > '2026-03-01 05:00:00' AND ts <= '2026-03-01 11:00:00'
--let $label= site = 'b' AND n = -1 AND ts in a window (TIMESTAMP in +03:00)
--source suite/moosedb/include/cmp_query.inc
--let $q= SELECT $agg FROM {T} WHERE site = 'c' AND n IN (-2, 0, 2, 7)
--let $label= site = 'c' AND n IN (-2, 0, 2, 7)
--source suite/moosedb/include/cmp_query.inc
--let $show= 1
--let $q= SELECT ts, n FROM {T} WHERE site = 'a' AND n = 1 ORDER BY ts DESC LIMIT 3
--let $label= site = 'a' AND n = 1 ORDER BY ts DESC LIMIT 3 (series 'a' and 'A' merged)
--source suite/moosedb/include/cmp_query.inc
--let $q= SELECT $agg FROM {T} WHERE site = 'A'
--let $label= site = 'A' (the CHAR column compares equal to the series 'a', byte-wise they differ)
--source suite/moosedb/include/cmp_query.inc
--let $q= SELECT $agg FROM {T} WHERE site = 'a' AND n = 1
--let $label= site = 'a' AND n = 1
--source suite/moosedb/include/cmp_query.inc
--let $q= SELECT ts, site FROM {T} WHERE site = 'a' AND n = -2 ORDER BY ts LIMIT 4
--let $label= site = 'a' AND n = -2 ORDER BY ts LIMIT 4 (both spellings, merged)
--source suite/moosedb/include/cmp_query.inc
--let $q= SELECT MIN(n), MAX(n), LOWER(MIN(site)), MAX(site) FROM {T}
--let $label= MIN/MAX of a signed SMALLINT tag (-2 < 2, not '-2' > '2') and of a CHAR tag
--source suite/moosedb/include/cmp_query.inc
--let $q= SELECT MAX(n) FROM {T} WHERE site = 'b'
--let $label= MAX(n) WHERE site = 'b' (partial prefix, numeric order)
--source suite/moosedb/include/cmp_query.inc
--let $q= SELECT MIN(n) FROM {T} WHERE site = 'b'
--let $label= MIN(n) WHERE site = 'b'
--source suite/moosedb/include/cmp_query.inc
SET time_zone = DEFAULT;
DROP TABLE tt, tti;
