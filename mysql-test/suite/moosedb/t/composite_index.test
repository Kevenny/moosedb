--echo ##################################################################
--echo # The Zabbix self-join (getAggregationByIntervalFromSql, AGGREGATE_LAST)
--echo ##################################################################
--let $zq= SELECT h.itemid,h.value,h.clock,h.ns,s.tick FROM {T} h JOIN (SELECT h2.itemid,h2.clock,MAX(h2.ns) AS ns,s2.tick FROM {T} h2 JOIN (SELECT itemid,CAST(clock AS SIGNED)-MOD(CAST(clock AS SIGNED),3600) AS tick,MAX(clock) AS clock FROM {T} WHERE itemid=105 AND clock BETWEEN 1700000000 AND 1700007200 GROUP BY itemid,CAST(clock AS SIGNED)-MOD(CAST(clock AS SIGNED),3600)) s2 ON h2.itemid=s2.itemid AND h2.clock=s2.clock WHERE h2.clock BETWEEN 1700000000 AND 1700007200 GROUP BY h2.itemid,h2.clock,s2.tick) s ON h.itemid=s.itemid AND h.clock=s.clock AND h.ns=s.ns WHERE h.clock BETWEEN 1700000000 AND 1700007200
--let $q= $zq ORDER BY h.itemid, h.clock, h.ns
--let $label= AGGREGATE_LAST for one item, 2 hours
--let $show= 1
--let $status= 1
--source suite/moosedb/include/cmp_query.inc
EXPLAIN SELECT h.itemid,h.value,h.clock,h.ns,s.tick FROM m h JOIN (SELECT h2.itemid,h2.clock,MAX(h2.ns) AS ns,s2.tick FROM m h2 JOIN (SELECT itemid,CAST(clock AS SIGNED)-MOD(CAST(clock AS SIGNED),3600) AS tick,MAX(clock) AS clock FROM m WHERE itemid=105 AND clock BETWEEN 1700000000 AND 1700007200 GROUP BY itemid,CAST(clock AS SIGNED)-MOD(CAST(clock AS SIGNED),3600)) s2 ON h2.itemid=s2.itemid AND h2.clock=s2.clock WHERE h2.clock BETWEEN 1700000000 AND 1700007200 GROUP BY h2.itemid,h2.clock,s2.tick) s ON h.itemid=s.itemid AND h.clock=s.clock AND h.ns=s.ns WHERE h.clock BETWEEN 1700000000 AND 1700007200;
--let $show= 0
--let $status= 0
--let $q= SELECT x.itemid, x.tick, x.v FROM (SELECT h.itemid, CAST(h.clock AS SIGNED)-MOD(CAST(h.clock AS SIGNED),3600) AS tick, h.value AS v FROM {T} h JOIN (SELECT itemid, MAX(clock) AS clock FROM {T} WHERE itemid IN (101,102,103) GROUP BY itemid, CAST(clock AS SIGNED)-MOD(CAST(clock AS SIGNED),3600)) s ON h.itemid=s.itemid AND h.clock=s.clock) x ORDER BY x.itemid, x.tick
--let $label= last value per hour for three items
--source suite/moosedb/include/cmp_query.inc
--echo # Join with a driving table: one index lookup per outer row
CREATE TABLE d (itemid BIGINT UNSIGNED NOT NULL, since INT NOT NULL, KEY (itemid)) ENGINE=InnoDB;
INSERT INTO d VALUES (101, 1700006000), (120, 1700000000), (424242, 0), (160, 1700007100);
EXPLAIN SELECT COUNT(*), ROUND(SUM(m.value), 3) FROM d JOIN m ON m.itemid = d.itemid AND m.clock >= d.since;
FLUSH STATUS;
SELECT COUNT(*), ROUND(SUM(m.value), 3) FROM d JOIN m ON m.itemid = d.itemid AND m.clock >= d.since;
--echo # 4 driving rows = 4 index lookups (Handler_read_key counts the InnoDB side too: its 4-row scan is rnd_next)
SHOW SESSION STATUS WHERE Variable_name IN ('Handler_read_key', 'Handler_read_next', 'Handler_read_rnd_next');
SELECT COUNT(*), ROUND(SUM(i.value), 3) FROM d JOIN i ON i.itemid = d.itemid AND i.clock >= d.since;
--let $q= SELECT d.itemid, d.since, (SELECT MAX(t.clock) FROM {T} t WHERE t.itemid = d.itemid AND t.clock >= d.since) AS last, (SELECT COUNT(*) FROM {T} t WHERE t.itemid = d.itemid) AS n FROM d ORDER BY d.itemid
--let $label= correlated MAX(clock) and COUNT per driving row
--source suite/moosedb/include/cmp_query.inc
DROP TABLE d;

--echo ##################################################################
--echo # Several TAGs: a prefix of the tags merges the series by time
--echo ##################################################################
CREATE TABLE m2 (
  hostid BIGINT UNSIGNED NOT NULL COMMENT 'TAG',
  itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG',
  clock  INT NOT NULL,
  value  DOUBLE NOT NULL,
  ns     INT NOT NULL,
  INDEX clock_idx (clock),
  INDEX host_item_clock (hostid, itemid, clock)
) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 HOUR';
INSERT INTO m2 SELECT * FROM m;
FLUSH TABLES m2;
INSERT INTO m2 SELECT hostid, itemid, clock + 7200, value, ns FROM m WHERE clock < 1700001800;
CREATE TABLE i2 LIKE i;
INSERT INTO i2 SELECT * FROM i;
INSERT INTO i2 SELECT hostid, itemid, clock + 7200, value, ns FROM i WHERE clock < 1700001800;
--let $mt= m2
--let $it= i2
EXPLAIN SELECT * FROM m2 WHERE hostid = 2;
EXPLAIN SELECT * FROM m2 WHERE hostid = 3 AND itemid = 106 AND clock > 1700000000;
EXPLAIN SELECT * FROM m2 WHERE hostid = 2 AND clock > 1700000000;
