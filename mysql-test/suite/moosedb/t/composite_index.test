--let $q= SELECT h.itemid, h.clock, h.value FROM {T} h JOIN (SELECT itemid, MAX(clock) c FROM {T} WHERE itemid IN (101,102,103,104,105) GROUP BY itemid) l ON h.itemid=l.itemid AND h.clock=l.c ORDER BY h.itemid, h.ns
--let $label= last value of five items
