--echo ##################################################################
--echo # TAG-only index: ref lookups for joins on the tag
--echo ##################################################################
CREATE TABLE ti (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL, value DOUBLE NOT NULL, INDEX (clock), INDEX (itemid))
  ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 HOUR';
INSERT INTO ti SELECT itemid, clock, value FROM m;
CREATE TABLE d (itemid BIGINT UNSIGNED NOT NULL, KEY (itemid)) ENGINE=InnoDB;
INSERT INTO d VALUES (101), (130), (424242);
EXPLAIN SELECT d.itemid, COUNT(*) FROM d JOIN ti ON ti.itemid = d.itemid GROUP BY d.itemid;
EXPLAIN SELECT * FROM ti WHERE itemid = 130;
FLUSH STATUS;
SELECT COUNT(*), ROUND(SUM(ti.value), 3) FROM d JOIN ti ON ti.itemid = d.itemid;
SHOW SESSION STATUS WHERE Variable_name IN ('Handler_read_key', 'Handler_read_next', 'Handler_read_rnd_next');
SELECT COUNT(*), ROUND(SUM(m.value), 3) FROM d JOIN m ON m.itemid = d.itemid;
SELECT MAX(itemid), MIN(itemid) FROM ti;
SELECT MAX(itemid) FROM ti WHERE itemid < 130;
DROP TABLE d, ti;

--echo ##################################################################
--echo # Rows of the statement itself stay invisible to its own index reads
--echo ##################################################################
SELECT COUNT(*) FROM m WHERE itemid = 105;
INSERT INTO m SELECT hostid, itemid, clock + 100000, value, ns FROM m WHERE itemid = 105;
INSERT INTO i SELECT hostid, itemid, clock + 100000, value, ns FROM i WHERE itemid = 105;
SELECT COUNT(*) FROM m WHERE itemid = 105;
--echo # A self-join through the index while inserting: the join sees the old rows only
INSERT INTO m SELECT a.hostid, a.itemid, a.clock + 200000, a.value, b.ns FROM m a JOIN m b ON a.itemid = b.itemid AND a.clock = b.clock WHERE a.itemid = 106;
INSERT INTO i SELECT a.hostid, a.itemid, a.clock + 200000, a.value, b.ns FROM i a JOIN i b ON a.itemid = b.itemid AND a.clock = b.clock WHERE a.itemid = 106;
SELECT COUNT(*) FROM m WHERE itemid = 106;
--let $q= SELECT $agg FROM {T} WHERE itemid IN (105, 106)
--let $label= items 105 and 106 after the self-inserts
--source suite/moosedb/include/cmp_query.inc

--echo # A new series is visible to the next statement at once
INSERT INTO m VALUES (1, 7777, 1700000001, 1, 1);
INSERT INTO i VALUES (1, 7777, 1700000001, 1, 1);
--let $q= SELECT $agg FROM {T} WHERE itemid = 7777
--let $label= itemid = 7777 (series created by the previous statement)
--source suite/moosedb/include/cmp_query.inc
--let $q= SELECT MAX(itemid), MAX(clock) FROM {T} WHERE itemid >= 7777
--let $label= MAX(itemid) sees the new series
--source suite/moosedb/include/cmp_query.inc

--echo ##################################################################
--echo # Restart: the same answers from the WAL and the sealed chunks
--echo ##################################################################
FLUSH TABLES m;
INSERT INTO m VALUES (4, 8888, 1700000005, 2, 2);
INSERT INTO i VALUES (4, 8888, 1700000005, 2, 2);
--source include/restart_mysqld.inc
--let $q= SELECT $agg FROM {T} WHERE itemid IN (105, 7777, 8888, 130)
--let $label= after restart: itemid IN (105, 7777, 8888, 130)
--source suite/moosedb/include/cmp_query.inc
--let $q= SELECT MAX(clock), MIN(clock) FROM {T} WHERE itemid = 8888
--let $label= after restart: MAX/MIN(clock) of a series that only lived in the WAL
--source suite/moosedb/include/cmp_query.inc
--let $q= SELECT MAX(itemid), MIN(itemid) FROM {T}
--let $label= after restart: MAX/MIN(itemid)
--source suite/moosedb/include/cmp_query.inc
CHECK TABLE m;

--echo ##################################################################
--echo # Retention: series without rows are skipped by the ordered reads
--echo ##################################################################
CREATE TABLE r (
  ts DATETIME NOT NULL, k INT NOT NULL COMMENT 'TAG', v INT NOT NULL,
  INDEX (ts), INDEX (k, ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 DAY' RETENTION_PERIOD='30 DAYS';
INSERT INTO r VALUES (NOW() - INTERVAL 400 DAY, 1, 10), (NOW() - INTERVAL 399 DAY, 2, 20),
                     (NOW() - INTERVAL 1 DAY, 3, 30), (NOW(), 4, 40), (NOW() - INTERVAL 398 DAY, 5, 50);
FLUSH TABLES r;
SELECT SERIES, ROW_COUNT FROM information_schema.MOOSEDB_TABLES WHERE TABLE_NAME = 'r';
SELECT MIN(k), MAX(k), COUNT(*) FROM r;
SELECT COUNT(*) FROM r WHERE k = 1;
CALL moosedb_apply_retention('test.r');
--echo # the series 1, 2 and 5 are still registered, but hold no rows now
SELECT SERIES, ROW_COUNT FROM information_schema.MOOSEDB_TABLES WHERE TABLE_NAME = 'r';
SELECT MIN(k), MAX(k), COUNT(*) FROM r;
SELECT MAX(ts) IS NULL AS no_rows FROM r WHERE k = 1;
SELECT v FROM r WHERE k = 1;
SELECT v FROM r WHERE k = 3 AND ts > NOW() - INTERVAL 2 DAY;
SELECT MIN(k) FROM r WHERE ts > NOW() - INTERVAL 2 DAY;
DROP TABLE r;

--echo ##################################################################
--echo # The ordered view grows with new series: merged into the previous one
--echo # (series sharing a tuple of the key end up in one entry)
--echo ##################################################################
CREATE TABLE gm (ts INT NOT NULL, host VARCHAR(8) NOT NULL COMMENT 'TAG', item INT NOT NULL COMMENT 'TAG', v INT NOT NULL,
                 INDEX (ts), INDEX hk (host, ts), INDEX ihk (item, host, ts)) ENGINE=MooseDB TIMESTAMP_COLUMN='ts';
CREATE TABLE gi (ts INT NOT NULL, host VARCHAR(8) NOT NULL, item INT NOT NULL, v INT NOT NULL,
                 INDEX (ts), INDEX hk (host, ts), INDEX ihk (item, host, ts)) ENGINE=InnoDB;
INSERT INTO gm SELECT seq, CONCAT('h', seq MOD 7), seq MOD 11, seq FROM seq_1_to_200;
INSERT INTO gi SELECT * FROM gm;
--let $mt= gm
--let $it= gi
--let $round= 0
while ($round < 3)
{
  --let $q= SELECT host, MAX(ts), COUNT(*) FROM {T} FORCE INDEX (hk) GROUP BY host ORDER BY host
  --let $label= round $round: GROUP BY host over (host, ts)
  --source suite/moosedb/include/cmp_query.inc
  --let $q= SELECT COUNT(DISTINCT host), MIN(host), MAX(host) FROM {T}
  --let $label= round $round: COUNT(DISTINCT host), MIN/MAX(host)
  --source suite/moosedb/include/cmp_query.inc
  --let $q= SELECT item, host, MAX(ts) FROM {T} FORCE INDEX (ihk) GROUP BY item, host ORDER BY item, host
  --let $label= round $round: GROUP BY item, host over (item, host, ts)
  --source suite/moosedb/include/cmp_query.inc
  --let $q= SELECT MIN(item), MAX(item) FROM {T} WHERE item > 5
  --let $label= round $round: MIN/MAX(item) with a range on it
  --source suite/moosedb/include/cmp_query.inc
  --echo # new series: existing hosts with new items, new hosts sorting first, last and in between
  eval INSERT INTO gm VALUES (300 + $round, 'h3', 20 + $round, 1), (300 + $round, 'a$round', -1 - $round, 2),
                             (300 + $round, 'z$round', 99 + $round, 3), (300 + $round, 'h0$round', 7, 4);
  eval INSERT INTO gi VALUES (300 + $round, 'h3', 20 + $round, 1), (300 + $round, 'a$round', -1 - $round, 2),
                             (300 + $round, 'z$round', 99 + $round, 3), (300 + $round, 'h0$round', 7, 4);
  --inc $round
}
DROP TABLE gm, gi;

--echo ##################################################################
--echo # Forward walks read tuples in blocks (one grouped scan per block):
--echo # 3000 series, rows in a chunk and in the MemTable, UNIQUE key ties
--echo ##################################################################
CREATE TABLE bm (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL, ns INT NOT NULL, v INT NOT NULL,
                 PRIMARY KEY (itemid, clock, ns)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
CREATE TABLE bi (itemid BIGINT UNSIGNED NOT NULL, clock INT NOT NULL, ns INT NOT NULL, v INT NOT NULL,
                 PRIMARY KEY (itemid, clock, ns)) ENGINE=InnoDB;
INSERT INTO bm SELECT seq, 1000 + seq MOD 5, 0, seq FROM seq_1_to_3000;
FLUSH TABLES bm;
INSERT INTO bm SELECT seq * 2, 1000 + seq MOD 5, 1, seq FROM seq_1_to_1500;
INSERT INTO bm SELECT seq * 3, 900, 0, seq FROM seq_1_to_1000;
INSERT INTO bi SELECT * FROM bm;
