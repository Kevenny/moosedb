#
# Composite index walk (host, ts) + a value predicate on a column outside the
# index: `file = X AND host = Y` reads through the index, and the engine hands
# the predicate to the core (zone maps / Blooms prune chunk entries, VARCHAR
# is filtered exactly). Every answer, in index order, must equal the InnoDB
# mirror's; conditions that cannot be proven safe (_ci collation, OR, IS NULL)
# must not be tested at all.
#
--source include/not_embedded.inc
--source include/have_innodb.inc
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc

CREATE TABLE g (
  ts   DATETIME NOT NULL,
  host VARCHAR(8) NOT NULL COMMENT 'TAG',
  fb   VARCHAR(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin,
  fc   VARCHAR(16) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci,
  n    INT,
  INDEX (ts),
  INDEX ix_host_ts (host, ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 DAY';

--echo # 4 days (= 4 chunks) x 6 hosts, one flush per day; 'rare' only on host h2, day 2
--disable_query_log
let $day= 0;
while ($day < 4)
{
  eval INSERT INTO g
    SELECT '2024-03-01' + INTERVAL $day DAY + INTERVAL seq MINUTE,
           CONCAT('h', seq MOD 6),
           IF(seq MOD 13 = 0, NULL, IF($day = 2 AND seq MOD 6 = 2 AND seq MOD 50 = 8, 'rare', CONCAT('f', $day, '-', seq MOD 7))),
           IF(seq MOD 13 = 0, NULL, CONCAT('F', $day, '-', seq MOD 7)),
           seq
    FROM seq_0_to_299;
  FLUSH TABLES g;
  inc $day;
}
--enable_query_log

CREATE DATABASE mirror;
CREATE TABLE mirror.g LIKE test.g;
ALTER TABLE mirror.g ENGINE=InnoDB;
INSERT INTO mirror.g SELECT * FROM test.g;

--let $mt= test.g
--let $it= mirror.g
--let $show= 0
--let $status= 0

--echo # ---- one tuple of the index (host = Y) ----
