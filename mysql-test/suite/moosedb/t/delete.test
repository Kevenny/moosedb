#
# DELETE: the statements the Zabbix housekeeper and history.clear send,
#   delete from history where itemid=X and clock<CUT [limit N]
#   delete from history where itemid in (...)
#   delete from history where clock<CUT
# plus the general case (any WHERE, LIMIT, ORDER BY, multi-table). Every
# statement runs on the MooseDB table and on an InnoDB mirror; the affected
# rows (ROW_COUNT) and the whole table are compared after each step.
#
# The data goes through every place a row can be: the MemTable, sealed hot
# and cold chunks, compacted chunks, a clean restart and kill -9 with the
# delete only in the WAL. Reinserting a deleted key (PRIMARY KEY), REPLACE /
# ON DUPLICATE KEY UPDATE after a delete, MIN/MAX/last value, TRUNCATE,
# retention, INFORMATION_SCHEMA and COUNT(*) are checked as well.
#
--source include/not_embedded.inc
--source include/have_innodb.inc
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc

--echo # Zabbix 7.0 history, without a key (v3) and with PRIMARY KEY (itemid,clock,ns) (v4), and InnoDB mirrors
CREATE TABLE h3 (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL DEFAULT 0, value DOUBLE NOT NULL DEFAULT 0, ns INT NOT NULL DEFAULT 0,
                 INDEX (clock), INDEX (itemid, clock))
  ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY' HOT_THRESHOLD='1 DAY';
CREATE TABLE h4 (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL DEFAULT 0, value DOUBLE NOT NULL DEFAULT 0, ns INT NOT NULL DEFAULT 0,
                 PRIMARY KEY (itemid, clock, ns))
  ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY' HOT_THRESHOLD='1 DAY';
CREATE TABLE i3 (itemid BIGINT UNSIGNED NOT NULL, clock INT NOT NULL DEFAULT 0, value DOUBLE NOT NULL DEFAULT 0, ns INT NOT NULL DEFAULT 0,
                 INDEX (clock), INDEX (itemid, clock)) ENGINE=InnoDB;
CREATE TABLE i4 (itemid BIGINT UNSIGNED NOT NULL, clock INT NOT NULL DEFAULT 0, value DOUBLE NOT NULL DEFAULT 0, ns INT NOT NULL DEFAULT 0,
                 PRIMARY KEY (itemid, clock, ns)) ENGINE=InnoDB;

--echo # 12 items x 3 days (1 value a minute from 2026-01-01 00:00 UTC; 1767225600), the last day only in the MemTable
--disable_query_log
let $d= 0;
while ($d < 3)
{
  eval INSERT INTO h3 SELECT 1 + a.seq, 1767225600 + $d * 86400 + b.seq * 60, a.seq * 1000 + b.seq, b.seq MOD 2 FROM seq_0_to_11 a, seq_0_to_1439 b;
  eval INSERT INTO h4 SELECT 1 + a.seq, 1767225600 + $d * 86400 + b.seq * 60, a.seq * 1000 + b.seq, b.seq MOD 2 FROM seq_0_to_11 a, seq_0_to_1439 b;
  eval INSERT INTO i3 SELECT 1 + a.seq, 1767225600 + $d * 86400 + b.seq * 60, a.seq * 1000 + b.seq, b.seq MOD 2 FROM seq_0_to_11 a, seq_0_to_1439 b;
  eval INSERT INTO i4 SELECT 1 + a.seq, 1767225600 + $d * 86400 + b.seq * 60, a.seq * 1000 + b.seq, b.seq MOD 2 FROM seq_0_to_11 a, seq_0_to_1439 b;
  if ($d < 2)
  {
    FLUSH TABLES h3, h4;
  }
  inc $d;
}
--enable_query_log
SELECT COUNT(*) FROM h3;
SELECT COUNT(*) FROM h4;
SELECT TABLE_NAME, CHUNKS, PENDING_ROWS, ROW_COUNT FROM information_schema.MOOSEDB_TABLES WHERE TABLE_NAME IN ('h3','h4') ORDER BY 1;

# Compares the whole table, then the answers of a few reads, with the mirror.
--let $all= SELECT itemid, clock, ns, value FROM {T} ORDER BY itemid, clock, ns
--let $agg= SELECT itemid, COUNT(*), MIN(clock), MAX(clock), SUM(value) FROM {T} GROUP BY itemid ORDER BY itemid

--echo ##################################################################
--echo # The housekeeper: one DELETE per item, autocommit
--echo ##################################################################
DELETE FROM h3 WHERE itemid = 3 AND clock < 1767225600 + 3600;
SELECT ROW_COUNT();
DELETE FROM i3 WHERE itemid = 3 AND clock < 1767225600 + 3600;
SELECT ROW_COUNT();
DELETE FROM h4 WHERE itemid = 3 AND clock < 1767225600 + 3600;
SELECT ROW_COUNT();
DELETE FROM i4 WHERE itemid = 3 AND clock < 1767225600 + 3600;
SELECT ROW_COUNT();
--let $mt= h3
--let $it= i3
--let $q= $all
--let $label= v3 after delete itemid=3 clock<CUT
--source suite/moosedb/include/cmp_query.inc
--let $q= $agg
--let $label= v3 per-item aggregates
--source suite/moosedb/include/cmp_query.inc
--let $mt= h4
--let $it= i4
--let $q= $all
--let $label= v4 after delete itemid=3 clock<CUT
--source suite/moosedb/include/cmp_query.inc
--let $q= $agg
--let $label= v4 per-item aggregates
--source suite/moosedb/include/cmp_query.inc

--echo # the statistics follow: COUNT(*) comes from the table's row count
SELECT (SELECT COUNT(*) FROM h3) = (SELECT COUNT(*) FROM i3) AS v3_count_same, (SELECT COUNT(*) FROM h4) = (SELECT COUNT(*) FROM i4) AS v4_count_same;
SELECT ROW_COUNT FROM information_schema.MOOSEDB_TABLES WHERE TABLE_NAME = 'h4';

--echo # same item again: nothing left in the range
DELETE FROM h4 WHERE itemid = 3 AND clock < 1767225600 + 3600;
SELECT ROW_COUNT();
--echo # a range that straddles the chunk and the MemTable (days 2 and 3), and a point
DELETE FROM h3 WHERE itemid = 5 AND clock BETWEEN 1767225600 + 86400 - 600 AND 1767225600 + 2 * 86400 + 600;
SELECT ROW_COUNT();
DELETE FROM i3 WHERE itemid = 5 AND clock BETWEEN 1767225600 + 86400 - 600 AND 1767225600 + 2 * 86400 + 600;
SELECT ROW_COUNT();
DELETE FROM h4 WHERE itemid = 5 AND clock BETWEEN 1767225600 + 86400 - 600 AND 1767225600 + 2 * 86400 + 600;
SELECT ROW_COUNT();
DELETE FROM i4 WHERE itemid = 5 AND clock BETWEEN 1767225600 + 86400 - 600 AND 1767225600 + 2 * 86400 + 600;
SELECT ROW_COUNT();
DELETE FROM h4 WHERE itemid = 6 AND clock = 1767225600 + 120 AND ns = 0;
SELECT ROW_COUNT();
DELETE FROM i4 WHERE itemid = 6 AND clock = 1767225600 + 120 AND ns = 0;
SELECT ROW_COUNT();
DELETE FROM h3 WHERE itemid = 6 AND clock = 1767225600 + 120 AND ns = 0;
DELETE FROM i3 WHERE itemid = 6 AND clock = 1767225600 + 120 AND ns = 0;
--let $mt= h3
--let $it= i3
--let $q= $all
--let $label= v3
--source suite/moosedb/include/cmp_query.inc
--let $mt= h4
--let $it= i4
--source suite/moosedb/include/cmp_query.inc

--echo ##################################################################
--echo # With a LIMIT (MaxHousekeeperDelete): the range fits, or it does not
--echo ##################################################################
DELETE FROM h4 WHERE itemid = 7 AND clock < 1767225600 + 600 LIMIT 5000;
SELECT ROW_COUNT();
DELETE FROM i4 WHERE itemid = 7 AND clock < 1767225600 + 600 LIMIT 5000;
SELECT ROW_COUNT();
--echo # LIMIT below the matching rows: exactly N rows go, not the whole range
DELETE FROM h4 WHERE itemid = 8 AND clock < 1767225600 + 3600 LIMIT 7;
SELECT ROW_COUNT();
SELECT COUNT(*) FROM h4 WHERE itemid = 8 AND clock < 1767225600 + 3600;
DELETE FROM h3 WHERE itemid = 8 AND clock < 1767225600 + 3600 LIMIT 7;
SELECT ROW_COUNT();
SELECT COUNT(*) FROM h3 WHERE itemid = 8 AND clock < 1767225600 + 3600;
--echo # (the mirror: the same rows are not comparable, the count is)
DELETE FROM i4 WHERE itemid = 8 AND clock < 1767225600 + 3600 LIMIT 7;
SELECT ROW_COUNT();
SELECT COUNT(*) FROM i4 WHERE itemid = 8 AND clock < 1767225600 + 3600;
DELETE FROM i3 WHERE itemid = 8 AND clock < 1767225600 + 3600 LIMIT 7;
--echo # bring the mirrors to the same rows: remove what is left of the range from all four
DELETE FROM h4 WHERE itemid = 8 AND clock < 1767225600 + 3600;
DELETE FROM h3 WHERE itemid = 8 AND clock < 1767225600 + 3600;
DELETE FROM i4 WHERE itemid = 8 AND clock < 1767225600 + 3600;
DELETE FROM i3 WHERE itemid = 8 AND clock < 1767225600 + 3600;
--echo # ORDER BY ... LIMIT deletes the oldest rows
DELETE FROM h4 WHERE itemid = 9 ORDER BY clock LIMIT 10;
SELECT ROW_COUNT();
DELETE FROM i4 WHERE itemid = 9 ORDER BY clock LIMIT 10;
SELECT ROW_COUNT();
DELETE FROM h3 WHERE itemid = 9 ORDER BY clock LIMIT 10;
DELETE FROM i3 WHERE itemid = 9 ORDER BY clock LIMIT 10;
--let $mt= h3
--let $it= i3
--let $q= $all
--let $label= v3
--source suite/moosedb/include/cmp_query.inc
--let $mt= h4
--let $it= i4
--source suite/moosedb/include/cmp_query.inc

--echo ##################################################################
--echo # history.clear: itemid IN (...); and clock < CUT for every item
--echo ##################################################################
DELETE FROM h3 WHERE itemid IN (1, 2, 11, 999);
SELECT ROW_COUNT();
DELETE FROM i3 WHERE itemid IN (1, 2, 11, 999);
SELECT ROW_COUNT();
DELETE FROM h4 WHERE itemid IN (1, 2, 11, 999);
SELECT ROW_COUNT();
DELETE FROM i4 WHERE itemid IN (1, 2, 11, 999);
SELECT ROW_COUNT();
DELETE FROM h4 WHERE itemid IN ('10', 12) AND clock >= 1767225600 + 2 * 86400;
SELECT ROW_COUNT();
DELETE FROM i4 WHERE itemid IN ('10', 12) AND clock >= 1767225600 + 2 * 86400;
SELECT ROW_COUNT();
DELETE FROM h3 WHERE itemid IN ('10', 12) AND clock >= 1767225600 + 2 * 86400;
DELETE FROM i3 WHERE itemid IN ('10', 12) AND clock >= 1767225600 + 2 * 86400;
DELETE FROM h3 WHERE clock < 1767225600 + 1800;
SELECT ROW_COUNT();
DELETE FROM i3 WHERE clock < 1767225600 + 1800;
SELECT ROW_COUNT();
DELETE FROM h4 WHERE clock < 1767225600 + 1800;
SELECT ROW_COUNT();
DELETE FROM i4 WHERE clock < 1767225600 + 1800;
SELECT ROW_COUNT();
--let $mt= h3
--let $it= i3
--let $q= $all
--let $label= v3
--source suite/moosedb/include/cmp_query.inc
--let $mt= h4
