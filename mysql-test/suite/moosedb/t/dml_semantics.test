#
# Statement semantics of an append-only, non-transactional engine:
# BEGIN/ROLLBACK, SAVEPOINT, autocommit, LOCK TABLES, INSERT IGNORE, REPLACE,
# ON DUPLICATE KEY UPDATE, multi-row INSERT failing in the middle, large
# INSERT ... SELECT, LOAD DATA, UPDATE/DELETE and multi-table statements.
#
# A MyISAM table ("c") receives the same statements: where the engine class is
# the same, the visible outcome must be the same.
#
--source include/not_embedded.inc
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc
let $MYSQLD_TMP= $MYSQLTEST_VARDIR/tmp;

CREATE TABLE t (ts DATETIME NOT NULL, host VARCHAR(8) NOT NULL COMMENT 'TAG', v INT NOT NULL, INDEX(ts))
  ENGINE=MooseDB MEMTABLE_SIZE=1048576;
CREATE TABLE c (ts DATETIME NOT NULL, host VARCHAR(8) NOT NULL, v INT NOT NULL, INDEX(ts)) ENGINE=MyISAM;

--echo # ---- Transactions: the engine is not transactional ----
SELECT ENGINE, TRANSACTIONS, XA, SAVEPOINTS FROM information_schema.ENGINES WHERE ENGINE IN ('MooseDB', 'MyISAM') ORDER BY ENGINE;
BEGIN;
INSERT INTO t VALUES ('2026-01-01', 'a', 1);
INSERT INTO t VALUES ('2026-01-02', 'a', 2);
--echo # ROLLBACK warns that the rows stay
ROLLBACK;
SELECT ts, v FROM t ORDER BY ts;
START TRANSACTION;
INSERT INTO t VALUES ('2026-01-03', 'a', 3);
SAVEPOINT s1;
INSERT INTO t VALUES ('2026-01-04', 'a', 4);
ROLLBACK TO SAVEPOINT s1;
COMMIT;
SELECT ts, v FROM t ORDER BY ts;

--echo # A transaction mixing both kinds of table: nothing is rolled back
BEGIN;
INSERT INTO c VALUES ('2026-01-01', 'a', 1);
INSERT INTO t VALUES ('2026-01-05', 'a', 5);
ROLLBACK;
SELECT COUNT(*) FROM c;
SELECT COUNT(*) FROM t;

--echo # autocommit=0 does not delay visibility or durability of rows
SET autocommit = 0;
INSERT INTO t VALUES ('2026-01-06', 'a', 6);
connect (other,localhost,root,,test);
SELECT COUNT(*) FROM t;
disconnect other;
connection default;
ROLLBACK;
SELECT COUNT(*) FROM t;
SET autocommit = 1;

--echo # LOCK TABLES
LOCK TABLES t WRITE;
INSERT INTO t VALUES ('2026-01-07', 'a', 7);
SELECT COUNT(*) FROM t;
UNLOCK TABLES;
LOCK TABLES t READ;
--error ER_TABLE_NOT_LOCKED_FOR_WRITE
INSERT INTO t VALUES ('2026-01-08', 'a', 8);
UNLOCK TABLES;
LOCK TABLES t WRITE, c WRITE;
INSERT INTO t SELECT ts, host, v FROM c;
INSERT INTO c SELECT ts, host, v FROM t;
SELECT COUNT(*) FROM t;
SELECT COUNT(*) FROM c;
UNLOCK TABLES;

TRUNCATE TABLE t;
TRUNCATE TABLE c;

--echo # ---- INSERT IGNORE / REPLACE / ON DUPLICATE KEY ----
--echo # Not-null violations are warnings under IGNORE, like in the control table
INSERT IGNORE INTO t VALUES ('2026-02-01', 'a', 1), ('2026-02-02', NULL, 2), ('2026-02-03', 'b', NULL), ('2026-02-04', 'c', 3);
INSERT IGNORE INTO c VALUES ('2026-02-01', 'a', 1), ('2026-02-02', NULL, 2), ('2026-02-03', 'b', NULL), ('2026-02-04', 'c', 3);
SELECT ts, host, v FROM t ORDER BY ts;
SELECT ts, host, v FROM c ORDER BY ts;

--echo # There is no unique key, so REPLACE and ON DUPLICATE KEY UPDATE never find
--echo # a duplicate: they behave as plain INSERT (same as MyISAM without keys)
REPLACE INTO t VALUES ('2026-03-01', 'a', 1);
REPLACE INTO t VALUES ('2026-03-01', 'a', 1);
INSERT INTO t VALUES ('2026-03-01', 'a', 1) ON DUPLICATE KEY UPDATE v = 99;
REPLACE INTO c VALUES ('2026-03-01', 'a', 1);
REPLACE INTO c VALUES ('2026-03-01', 'a', 1);
INSERT INTO c VALUES ('2026-03-01', 'a', 1) ON DUPLICATE KEY UPDATE v = 99;
SELECT COUNT(*), SUM(v) FROM t WHERE ts = '2026-03-01';
SELECT COUNT(*), SUM(v) FROM c WHERE ts = '2026-03-01';
REPLACE INTO t SELECT ts, host, v FROM t WHERE ts = '2026-03-01';
SELECT COUNT(*) FROM t WHERE ts = '2026-03-01';

--echo # ---- Multi-row statements failing in the middle ----
--echo # Rows before the failing one stay (no statement rollback), as in MyISAM
--error ER_GET_ERRMSG
INSERT INTO t VALUES ('2026-05-01', 'a', 1), ('0000-00-00', 'a', 2), ('2026-05-03', 'a', 3);
INSERT INTO t VALUES ('2026-05-04', 'a', 4), ('2026-05-05', 'a', 5), ('2026-05-06', 'a', 6);
SELECT COUNT(*) FROM t WHERE ts >= '2026-05-01';
SET sql_mode = '';
--error ER_GET_ERRMSG
INSERT INTO t VALUES ('2026-05-10', 'a', 1), ('0000-00-00', 'a', 2), ('2026-05-12', 'a', 3);
--echo # IGNORE does not downgrade this engine error to a warning
--error ER_GET_ERRMSG
INSERT IGNORE INTO t VALUES ('2026-05-20', 'a', 1), ('0000-00-00', 'a', 2), ('2026-05-22', 'a', 3);
SET sql_mode = DEFAULT;
SELECT ts FROM t WHERE ts >= '2026-05-10' ORDER BY ts;
--echo # Data too long / NULL / bad numeric values are caught by the server
--error ER_DATA_TOO_LONG
INSERT INTO t VALUES ('2026-06-01', 'toolongvalue', 1);
--error ER_BAD_NULL_ERROR
INSERT INTO t VALUES ('2026-06-02', 'a', NULL);
--error ER_TRUNCATED_WRONG_VALUE_FOR_FIELD
INSERT INTO t VALUES ('2026-06-03', 'a', 'abc');
--error ER_TRUNCATED_WRONG_VALUE
INSERT INTO t VALUES ('not a date', 'a', 1);
--error ER_WRONG_VALUE_COUNT_ON_ROW
INSERT INTO t VALUES ('2026-06-04', 'a');
--error ER_NO_DEFAULT_FOR_FIELD
INSERT INTO t (host, v) VALUES ('a', 1);
SELECT COUNT(*) FROM t WHERE ts >= '2026-06-01';
--echo # A failing statement leaves the table usable
INSERT INTO t VALUES ('2026-06-05', 'ok', 5);
SELECT host, v FROM t WHERE ts >= '2026-06-01';

--echo # ---- INSERT ... SELECT ----
TRUNCATE TABLE t;
TRUNCATE TABLE c;
--echo # Error half way: the rows produced so far are kept, as in the control
--error ER_DATA_OUT_OF_RANGE
INSERT INTO t SELECT '2026-07-01' + INTERVAL seq DAY, 'a', 10 DIV (5 - seq) FROM seq_0_to_9;
--error ER_DATA_OUT_OF_RANGE
INSERT INTO c SELECT '2026-07-01' + INTERVAL seq DAY, 'a', 10 DIV (5 - seq) FROM seq_0_to_9;
SELECT COUNT(*), SUM(v) FROM t;
SELECT COUNT(*), SUM(v) FROM c;
TRUNCATE TABLE t;
TRUNCATE TABLE c;
--echo # 200000 rows in one statement (several MemTable flushes and chunks)
INSERT INTO t SELECT '2026-01-01' + INTERVAL seq SECOND, CONCAT('h', seq MOD 50), seq FROM seq_0_to_199999;
SELECT COUNT(*), SUM(v), MIN(ts), MAX(ts), COUNT(DISTINCT host) FROM t;
SELECT CHUNKS > 1 AS several_chunks, ROW_COUNT FROM information_schema.MOOSEDB_TABLES WHERE TABLE_NAME = 't';
--echo # Reading and writing the same table in one statement (snapshot semantics)
INSERT INTO t SELECT ts + INTERVAL 1 YEAR, host, v FROM t;
SELECT COUNT(*), SUM(v) FROM t;
INSERT INTO t SELECT ts + INTERVAL 2 YEAR, host, v FROM t WHERE host = 'h7';
SELECT COUNT(*) FROM t;
--echo # An empty source adds nothing
INSERT INTO t SELECT ts, host, v FROM t WHERE ts < '2000-01-01';
SELECT COUNT(*) FROM t;
TRUNCATE TABLE t;

--echo # ---- LOAD DATA ----
CREATE TABLE src (ts DATETIME NOT NULL, host VARCHAR(8) NOT NULL, v INT NOT NULL) ENGINE=MyISAM;
INSERT INTO src SELECT '2026-01-01' + INTERVAL seq MINUTE, CONCAT('h', seq MOD 7), seq FROM seq_0_to_9999;
--replace_result $MYSQLTEST_VARDIR VARDIR
eval SELECT * FROM src INTO OUTFILE '$MYSQLD_TMP/tf_load.txt';
--replace_result $MYSQLTEST_VARDIR VARDIR
eval LOAD DATA INFILE '$MYSQLD_TMP/tf_load.txt' INTO TABLE t;
SELECT COUNT(*), SUM(v), MIN(ts), MAX(ts), COUNT(DISTINCT host) FROM t;
SELECT COUNT(*) FROM t WHERE host = 'h3';
--echo # LOAD DATA with IGNORE/REPLACE and a duplicated file adds rows again
--replace_result $MYSQLTEST_VARDIR VARDIR
eval LOAD DATA INFILE '$MYSQLD_TMP/tf_load.txt' IGNORE INTO TABLE t;
--replace_result $MYSQLTEST_VARDIR VARDIR
eval LOAD DATA INFILE '$MYSQLD_TMP/tf_load.txt' REPLACE INTO TABLE t;
SELECT COUNT(*) FROM t;
--echo # Rows are durable at statement end: they survive a flush
FLUSH TABLES t;
SELECT COUNT(*), SUM(v) FROM t;
TRUNCATE TABLE t;
--echo # Bad lines: rejected rows stop the load in strict mode, the good ones before stay
--write_file $MYSQLD_TMP/tf_bad.txt
2026-01-01 00:00:00	a	1
2026-01-01 00:00:01	b	2
0000-00-00 00:00:00	c	3
2026-01-01 00:00:03	d	4
EOF
--replace_result $MYSQLTEST_VARDIR VARDIR
--error ER_GET_ERRMSG
eval LOAD DATA INFILE '$MYSQLD_TMP/tf_bad.txt' INTO TABLE t;
SELECT host FROM t ORDER BY ts;
TRUNCATE TABLE t;
--echo # IGNORE does not skip the row either; the rows before it stay
--replace_result $MYSQLTEST_VARDIR VARDIR
--error ER_GET_ERRMSG
eval LOAD DATA INFILE '$MYSQLD_TMP/tf_bad.txt' IGNORE INTO TABLE t;
SELECT host FROM t ORDER BY ts;
--remove_file $MYSQLD_TMP/tf_bad.txt
--remove_file $MYSQLD_TMP/tf_load.txt
DROP TABLE src;
TRUNCATE TABLE t;

--echo # ---- UPDATE / DELETE / multi-table statements ----
INSERT INTO t VALUES ('2026-01-01', 'a', 1), ('2026-01-02', 'b', 2);
INSERT INTO c VALUES ('2026-01-01', 'a', 1), ('2026-01-02', 'b', 2);
--error ER_ILLEGAL_HA
UPDATE t SET v = v + 1;
--error ER_ILLEGAL_HA
UPDATE t SET v = 0 WHERE host = 'a';
--error ER_ILLEGAL_HA
UPDATE t SET v = 0 ORDER BY ts LIMIT 1;
--error ER_ILLEGAL_HA
UPDATE t, c SET t.v = c.v + 100 WHERE t.host = c.host;
--error ER_ILLEGAL_HA
UPDATE c, t SET t.v = 7 WHERE t.host = c.host;
--echo # DELETE is supported (delete.test): range, ORDER BY/LIMIT and multi-table forms
DELETE FROM t WHERE ts < '2030-01-01';
SELECT ROW_COUNT();
INSERT INTO t VALUES ('2026-01-01', 'a', 1), ('2026-01-02', 'b', 2);
DELETE FROM t ORDER BY ts LIMIT 1;
SELECT ROW_COUNT();
SELECT ts, host, v FROM t;
INSERT INTO t VALUES ('2026-01-01', 'a', 1);
DELETE t FROM t JOIN c ON t.host = c.host;
SELECT ROW_COUNT();
INSERT INTO t VALUES ('2026-01-01', 'a', 1), ('2026-01-02', 'b', 2);
--echo # An impossible WHERE never reaches the engine
DELETE FROM t WHERE 1 = 0;
UPDATE t SET v = 0 WHERE 1 = 0;
--echo # A MooseDB table can be the source of a subquery in a statement on another engine
UPDATE c SET v = 0 WHERE host IN (SELECT host FROM t);
SELECT SUM(v) FROM c;
SELECT ts, host, v FROM t ORDER BY ts;
DELETE FROM c WHERE host IN (SELECT host FROM t);
SELECT COUNT(*) FROM c;
SELECT COUNT(*) FROM t;
--echo # DELETE without WHERE empties the table
DELETE FROM t;
SELECT COUNT(*) FROM t;

DROP TABLE t, c;
