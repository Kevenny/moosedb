#
# GROUP BY done by the engine (moosedb_group_by_pushdown): differential test.
# Every case runs three times -- pushdown OFF, pushdown ON, and on an InnoDB
# copy of the table -- and the three complete outputs (rows, warnings, column
# metadata) must be identical (include/gbh_diff.inc). The query counter
# Moosedb_gbh_queries proves that the ON run really was done by the engine.
#
--source include/not_embedded.inc
--source include/have_innodb.inc
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc

--let $refused= 0
--let $sorted= 0
--let $show= 0
--let $pre=

CREATE TABLE g (
  ts      DATETIME NOT NULL,
  host    VARCHAR(16) NOT NULL COMMENT 'TAG',
  iface   INT NOT NULL COMMENT 'TAG',
  proc    VARCHAR(24) COMMENT 'TAG',
  file    VARCHAR(32),
  code    INT,
  bytes   BIGINT,
  latency INT,
  INDEX(ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 DAY';

--echo # 20000 rows in chunks, 10000 more left in the MemTable
INSERT INTO g SELECT '2024-03-01' + INTERVAL seq * 20 SECOND,
                     CONCAT('h', seq MOD 23), seq MOD 4,
                     IF(seq MOD 13 = 0, NULL, CONCAT('p', seq MOD 17)),
                     CONCAT('/f/', seq MOD 41),
                     IF(seq MOD 9 = 0, NULL, seq MOD 7),
                     (seq * 7919) MOD 100000 + 5000000000,
                     IF(seq MOD 5 = 0, NULL, (seq * 31) MOD 997)
  FROM seq_0_to_19999;
FLUSH TABLES g;
INSERT INTO g SELECT '2024-03-01' + INTERVAL seq * 20 SECOND,
                     CONCAT('h', seq MOD 23), seq MOD 4,
                     IF(seq MOD 13 = 0, NULL, CONCAT('p', seq MOD 17)),
                     CONCAT('/f/', seq MOD 41),
                     IF(seq MOD 9 = 0, NULL, seq MOD 7),
                     (seq * 7919) MOD 100000 + 5000000000,
                     IF(seq MOD 5 = 0, NULL, (seq * 31) MOD 997)
  FROM seq_20000_to_29999;

CREATE DATABASE mirror;
CREATE TABLE mirror.g LIKE test.g;
ALTER TABLE mirror.g ENGINE=InnoDB;
INSERT INTO mirror.g SELECT * FROM test.g;
SELECT (SELECT COUNT(*) FROM test.g) = (SELECT COUNT(*) FROM mirror.g) AS same_rows;

