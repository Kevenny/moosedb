--echo ##########################################################
--echo # HAVING, ORDER BY, LIMIT / OFFSET
--echo ##########################################################
--let $label= HAVING on the aggregate and on a hidden aggregate
--let $q= SELECT host, COUNT(*) c FROM g GROUP BY host HAVING c > 1300 AND SUM(bytes) > 0 ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--let $label= HAVING on the key moves to the WHERE as a TAG range: not captured, refused
--let $refused= 1
--let $q= SELECT host, COUNT(*) c FROM g GROUP BY host HAVING host > 'h2' ORDER BY c, host
--source suite/moosedb/include/gbh_diff.inc

--let $label= HAVING with LIMIT and OFFSET (top-N must not cut before HAVING)
--let $q= SELECT host, SUM(bytes) s FROM g GROUP BY host HAVING s > 0 AND COUNT(*) > 1300 ORDER BY s DESC LIMIT 3 OFFSET 1
--source suite/moosedb/include/gbh_diff.inc

--let $label= ORDER BY aggregate ASC
--let $q= SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY c, host
--source suite/moosedb/include/gbh_diff.inc

--let $label= ORDER BY aggregate DESC, key DESC
--let $q= SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY c DESC, host DESC
--source suite/moosedb/include/gbh_diff.inc

--let $label= ORDER BY key DESC with LIMIT
--let $q= SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY host DESC LIMIT 4
--source suite/moosedb/include/gbh_diff.inc

--let $label= ORDER BY AVG DESC (after the division)
--let $q= SELECT host, AVG(latency) a FROM g GROUP BY host ORDER BY a DESC, host LIMIT 6
--source suite/moosedb/include/gbh_diff.inc

--let $label= ORDER BY MIN / MAX of the time axis, NULL aggregates first
--let $q= SELECT host, MIN(ts) t0, MAX(ts) t1, MAX(latency) m FROM g GROUP BY host ORDER BY t1 DESC, t0, host LIMIT 5
--source suite/moosedb/include/gbh_diff.inc

--let $label= ORDER BY an aggregate that is not selected
--let $q= SELECT host FROM g GROUP BY host ORDER BY SUM(bytes) DESC, host LIMIT 5
--source suite/moosedb/include/gbh_diff.inc

--let $label= ORDER BY SUM with NULL sums
--let $q= SELECT code, SUM(latency) s FROM g WHERE ts < '2024-03-01 00:01:00' GROUP BY code ORDER BY s, code
--source suite/moosedb/include/gbh_diff.inc

--let $label= LIMIT 0 (the server answers it without the hook)
--let $refused= 1
--let $q= SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY host LIMIT 0
--source suite/moosedb/include/gbh_diff.inc

--let $label= LIMIT beyond the number of groups, OFFSET beyond too
--let $q= SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY host LIMIT 100 OFFSET 20
--source suite/moosedb/include/gbh_diff.inc

--let $label= LIMIT without ORDER BY (implicit order)
--let $q= SELECT host, COUNT(*) c FROM g GROUP BY host LIMIT 3 OFFSET 2
--source suite/moosedb/include/gbh_diff.inc

--let $label= FOUND_ROWS() after a pushed-down LIMIT
--let $q= SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY host LIMIT 3; SELECT FOUND_ROWS();
--source suite/moosedb/include/gbh_diff.inc

--let $label= FOUND_ROWS() with HAVING and OFFSET
--let $q= SELECT host, COUNT(*) c FROM g GROUP BY host HAVING c > 1300 ORDER BY host LIMIT 4 OFFSET 1; SELECT FOUND_ROWS();
--source suite/moosedb/include/gbh_diff.inc

--let $label= SQL_CALC_FOUND_ROWS is refused (the server leaves FOUND_ROWS stale)
--let $refused= 1
--let $q= SELECT SQL_CALC_FOUND_ROWS host, COUNT(*) c FROM g GROUP BY host ORDER BY host LIMIT 3; SELECT FOUND_ROWS();
--source suite/moosedb/include/gbh_diff.inc

--echo ##########################################################
--echo # PREPARE / EXECUTE, EXPLAIN
--echo ##########################################################
--let $label= the plan is rebuilt at each EXECUTE with the new parameters
--let $pre= PREPARE p FROM 'SELECT host, COUNT(*) c, MAX(bytes) m FROM g WHERE ts >= ? AND ts < ? AND host IN (?, ?) GROUP BY host ORDER BY host'; SET @a = '2024-03-02', @b = '2024-03-03', @c = 'h1', @d = 'h5';
--let $q= EXECUTE p USING @a, @b, @c, @d; SET @a = '2024-03-04', @b = '2024-03-06', @c = 'h9', @d = 'h5'; EXECUTE p USING @a, @b, @c, @d;
--source suite/moosedb/include/gbh_diff.inc

--let $label= a session variable changed between EXECUTEs
--let $pre= PREPARE p FROM 'SELECT iface, COUNT(*) c FROM g GROUP BY iface ORDER BY iface'; SET SESSION moosedb_group_by_pushdown = 0; EXECUTE p; SET SESSION moosedb_group_by_pushdown = 1;
--let $q= EXECUTE p;
--source suite/moosedb/include/gbh_diff.inc

SET SESSION moosedb_group_by_pushdown = 1;
--echo # EXPLAIN shows the engine handles the GROUP BY (and opens nothing)
EXPLAIN SELECT host, COUNT(*) c FROM g GROUP BY host;
EXPLAIN FORMAT=JSON SELECT host, COUNT(*) c FROM g WHERE host = 'h1' GROUP BY host;
EXPLAIN SELECT host, COUNT(*) c FROM g WHERE file = '/f/1' GROUP BY host;
SET SESSION moosedb_group_by_pushdown = 0;
EXPLAIN SELECT host, COUNT(*) c FROM g GROUP BY host;
SET SESSION moosedb_group_by_pushdown = DEFAULT;

--echo ##########################################################
--echo # DELETE (tombstones), MemTable and chunks together
--echo ##########################################################
DELETE FROM test.g WHERE host = 'h5' AND ts < '2024-03-03';
DELETE FROM mirror.g WHERE host = 'h5' AND ts < '2024-03-03';
DELETE FROM test.g WHERE ts >= '2024-03-06 12:00:00' AND iface = 1;
DELETE FROM mirror.g WHERE ts >= '2024-03-06 12:00:00' AND iface = 1;
SELECT (SELECT COUNT(*) FROM test.g) = (SELECT COUNT(*) FROM mirror.g) AS same_rows_after_delete;

--let $label= after DELETE: counts and sums per host
--let $q= SELECT host, COUNT(*) c, SUM(bytes) s, MIN(ts) t0, MAX(ts) t1 FROM g GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--let $label= after DELETE: integer TAG
--let $q= SELECT iface, COUNT(*) c, MAX(latency) m FROM g GROUP BY iface ORDER BY iface
--source suite/moosedb/include/gbh_diff.inc

--let $label= after DELETE: a host that lost rows, by time range
--let $q= SELECT iface, COUNT(*) c FROM g WHERE host = 'h5' AND ts < '2024-03-04' GROUP BY iface ORDER BY iface
--source suite/moosedb/include/gbh_diff.inc

OPTIMIZE TABLE test.g;
--let $label= after OPTIMIZE (compacted chunks)
--let $q= SELECT host, COUNT(*) c, SUM(bytes) s FROM g GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--echo ##########################################################
--echo # One thread and many threads give the same answer
--echo ##########################################################
SET GLOBAL moosedb_agg_threads = 1;
--let $label= threads = 1
--let $q= SELECT host, proc, COUNT(*) c, SUM(bytes) s, AVG(latency) a FROM g GROUP BY host, proc ORDER BY host, proc
--source suite/moosedb/include/gbh_diff.inc
SET GLOBAL moosedb_agg_threads = 8;
--let $label= threads = 8
--let $q= SELECT host, proc, COUNT(*) c, SUM(bytes) s, AVG(latency) a FROM g GROUP BY host, proc ORDER BY host, proc
--source suite/moosedb/include/gbh_diff.inc
SET GLOBAL moosedb_agg_threads = DEFAULT;

--echo ##########################################################
--echo # Refused shapes keep their answer
