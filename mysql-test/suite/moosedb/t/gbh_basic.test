--echo ##########################################################
--echo # Review fixes
--echo ##########################################################
--let $label= COUNT of a TAG column is refused (the core cannot), same answer
--let $refused= 1
--let $q= SELECT host, COUNT(host) c FROM g GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--let $label= COUNT of an integer TAG is refused too
--let $refused= 1
--let $q= SELECT iface, COUNT(iface) c FROM g GROUP BY iface ORDER BY iface
--source suite/moosedb/include/gbh_diff.inc

--let $label= COUNT of a plain column is done by the engine
--let $q= SELECT host, COUNT(file) cf, COUNT(code) cc FROM g GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--let $label= COUNT(constant that is NULL) counts nothing: refused, same answer
--let $refused= 1
--let $q= SELECT host, COUNT(NULLIF(1,1)) a, COUNT(CAST(NULL AS SIGNED)) b, COUNT(IF(1,NULL,2)) c FROM g GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--let $label= COUNT(non-NULL constant) is COUNT(*)
--let $q= SELECT host, COUNT(1) a, COUNT(7) b FROM g GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--let $label= the same key twice in the select list
--let $q= SELECT host, host h2, COUNT(*) c FROM g GROUP BY host ORDER BY host LIMIT 4
--source suite/moosedb/include/gbh_diff.inc

--let $label= aggregate before the key
--let $q= SELECT COUNT(*) c, host FROM g GROUP BY host ORDER BY host LIMIT 4
--source suite/moosedb/include/gbh_diff.inc

--let $label= keys only in ORDER BY and HAVING
--let $q= SELECT COUNT(*) c FROM g GROUP BY host, iface HAVING iface = 2 AND SUM(bytes) > 0 ORDER BY host DESC, iface LIMIT 5
--source suite/moosedb/include/gbh_diff.inc

--let $label= GROUP BY a BIGINT UNSIGNED column with the high bit set (unsigned order)
--let $q= SELECT w, COUNT(*) c, SUM(s) ss FROM b GROUP BY w ORDER BY w DESC
--source suite/moosedb/include/gbh_diff.inc

--let $label= GROUP BY a BIGINT UNSIGNED column, ASC
--let $q= SELECT w, COUNT(*) c FROM b GROUP BY w ORDER BY w
--source suite/moosedb/include/gbh_diff.inc

--let $label= LOCK TABLES ... READ around the aggregate
--let $pre= LOCK TABLES g READ;
--let $q= SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY host LIMIT 3; UNLOCK TABLES;
--source suite/moosedb/include/gbh_diff.inc

CREATE TABLE tsx (
  ts TIMESTAMP NOT NULL,
  k  VARCHAR(8) NOT NULL COMMENT 'TAG',
  n  INT,
  INDEX(ts)
) ENGINE=MooseDB;
INSERT INTO tsx VALUES ('2024-02-01 00:00:01', 'a', 1), ('2024-02-01 00:00:02', 'a', 2), ('2024-02-01 00:00:03', 'b', 3);
CREATE TABLE mirror.tsx LIKE test.tsx;
ALTER TABLE mirror.tsx ENGINE=InnoDB;
INSERT INTO mirror.tsx SELECT * FROM test.tsx;
--let $label= a TIMESTAMP axis with a time bound is refused (not captured), same answer
--let $refused= 1
--let $q= SELECT k, COUNT(*) c, SUM(n) s FROM tsx WHERE ts >= '2024-02-01 00:00:02' GROUP BY k ORDER BY k
--source suite/moosedb/include/gbh_diff.inc
--let $label= a TIMESTAMP axis without a time bound is fine
--let $q= SELECT k, COUNT(*) c, SUM(n) s FROM tsx GROUP BY k ORDER BY k
--source suite/moosedb/include/gbh_diff.inc

--echo # Fractions beyond 6 digits in a time bound: the engine uses the server's
--echo # own conversion (flags and rounding of the comparison)
CREATE TABLE fr (
  ts DATETIME(6) NOT NULL,
  k  VARCHAR(8) NOT NULL COMMENT 'TAG',
  n  INT,
  INDEX(ts)
) ENGINE=MooseDB;
INSERT INTO fr VALUES
  ('2024-01-01 00:00:20.999998', 'a', 1), ('2024-01-01 00:00:20.999999', 'a', 2),
  ('2024-01-01 00:00:21.000000', 'b', 4), ('2024-01-01 00:00:21.000001', 'b', 8),
  ('2024-01-01 00:00:21.000002', 'c', 16);
CREATE TABLE mirror.fr LIKE test.fr;
ALTER TABLE mirror.fr ENGINE=InnoDB;
INSERT INTO mirror.fr SELECT * FROM test.fr;
--let $c= '2024-01-01 00:00:20.9999995'
--let $label= fraction < (string)
--let $q= SELECT k, COUNT(*) c, SUM(n) s FROM fr WHERE ts < $c GROUP BY k ORDER BY k
--source suite/moosedb/include/gbh_diff.inc
--let $label= fraction <= (string)
--let $q= SELECT k, COUNT(*) c, SUM(n) s FROM fr WHERE ts <= $c GROUP BY k ORDER BY k
--source suite/moosedb/include/gbh_diff.inc
--let $label= fraction > (string)
--let $q= SELECT k, COUNT(*) c, SUM(n) s FROM fr WHERE ts > $c GROUP BY k ORDER BY k
--source suite/moosedb/include/gbh_diff.inc
--let $label= fraction >= (string)
--let $q= SELECT k, COUNT(*) c, SUM(n) s FROM fr WHERE ts >= $c GROUP BY k ORDER BY k
--source suite/moosedb/include/gbh_diff.inc
--let $label= fraction BETWEEN (string)
--let $q= SELECT k, COUNT(*) c, SUM(n) s FROM fr WHERE ts BETWEEN $c AND '2024-01-01 00:00:21.0000015' GROUP BY k ORDER BY k
--source suite/moosedb/include/gbh_diff.inc
--let $c= 20240101000020.9999995
--let $label= fraction < (number)
--let $q= SELECT k, COUNT(*) c, SUM(n) s FROM fr WHERE ts < $c GROUP BY k ORDER BY k
--source suite/moosedb/include/gbh_diff.inc
--let $label= fraction <= (number)
