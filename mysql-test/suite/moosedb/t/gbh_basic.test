--let $refused= 1
--let $label= expression over an aggregate
--let $q= SELECT host, SUM(bytes) / 2 q FROM g GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--let $refused= 1
--let $label= COUNT(DISTINCT)
--let $q= SELECT host, COUNT(DISTINCT code) c FROM g GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--let $refused= 1
--let $label= GROUP BY the time column
--let $q= SELECT ts, COUNT(*) c FROM g WHERE ts < '2024-03-01 00:01:00' GROUP BY ts ORDER BY ts
--source suite/moosedb/include/gbh_diff.inc

--let $refused= 1
--let $label= derived table
--let $q= SELECT * FROM (SELECT host, COUNT(*) c FROM g GROUP BY host) d ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--let $refused= 1
