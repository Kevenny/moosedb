--echo ##########################################################
--echo # Session counters
--echo ##########################################################
SET SESSION moosedb_group_by_pushdown = ON;
--let $c0= `SELECT VARIABLE_VALUE FROM information_schema.GLOBAL_STATUS WHERE VARIABLE_NAME = 'MOOSEDB_GBH_QUERIES'`
SELECT COUNT(*) FROM (SELECT host FROM g GROUP BY host) x;
--let $c1= `SELECT VARIABLE_VALUE FROM information_schema.GLOBAL_STATUS WHERE VARIABLE_NAME = 'MOOSEDB_GBH_QUERIES'`
--echo # a derived table is not taken over: counter moved by
--let $dc= `SELECT $c1 - $c0`
--echo # counter moved by $dc
SET SESSION moosedb_group_by_pushdown = DEFAULT;

DROP DATABASE mirror;
DROP TABLE g, b, tsx, fr;
