--source suite/moosedb/include/gbh_diff.inc
--let $label= prepared statement with the format as a parameter
--let $either= 1
--let $q= SET @f = '%Y-%m-%d %H'; PREPARE st FROM 'SELECT DATE_FORMAT(ts, ?) x, COUNT(*) c FROM b GROUP BY x ORDER BY x'; EXECUTE st USING @f;
--source suite/moosedb/include/gbh_diff.inc
--let $either= 1
--let $q= SET @f = '%Y-%m'; PREPARE st FROM 'SELECT DATE_FORMAT(ts, ?) x, COUNT(*) c FROM b GROUP BY x ORDER BY x'; EXECUTE st USING @f;
--source suite/moosedb/include/gbh_diff.inc
--let $label= DATETIME(3), and MIN/MAX of the axis, COUNT(col), SUM with a bucket
CREATE TABLE s3 (
  ts DATETIME(3) NOT NULL,
  host VARCHAR(16) NOT NULL COMMENT 'TAG',
  v BIGINT NOT NULL,
  INDEX(ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 DAY';
INSERT INTO s3 SELECT '2024-03-01 23:59:00.001' + INTERVAL seq * 997000 MICROSECOND, CONCAT('h', seq MOD 2), seq FROM seq_0_to_1999;
CREATE TABLE mirror.s3 LIKE test.s3;
ALTER TABLE mirror.s3 ENGINE=InnoDB;
INSERT INTO mirror.s3 SELECT * FROM test.s3;
--let $q= SELECT DATE_FORMAT(ts, '%Y-%m-%d %H:%i:%s') x, COUNT(*) c, MIN(ts) a, MAX(ts) z FROM s3 GROUP BY x ORDER BY x
--source suite/moosedb/include/gbh_diff.inc
--let $q= SELECT DATE(ts) d, COUNT(*) c, MIN(ts) a, MAX(ts) z FROM s3 GROUP BY d ORDER BY d
--source suite/moosedb/include/gbh_diff.inc
--let $q= SELECT DATE_FORMAT(ts, '%Y-%m-%d %H:%i') m, COUNT(t2) n, COUNT(*) c, MIN(ts) a, MAX(ts) z, SUM(v) s FROM b GROUP BY m ORDER BY m
--source suite/moosedb/include/gbh_diff.inc
--let $label= moosedb_agg_threads = 1 and 4
--let $thr= `SELECT @@global.moosedb_agg_threads`
SET GLOBAL moosedb_agg_threads = 1;
--let $q= SELECT DATE_FORMAT(ts, '%Y-%m-%d %H:%i') m, COUNT(*) c, SUM(v) s FROM b GROUP BY m ORDER BY m
--source suite/moosedb/include/gbh_diff.inc
SET GLOBAL moosedb_agg_threads = 4;
--let $q= SELECT DATE_FORMAT(ts, '%Y-%m-%d %H:%i') m, COUNT(*) c, SUM(v) s FROM b GROUP BY m ORDER BY m
--source suite/moosedb/include/gbh_diff.inc
--let $q= SELECT host, DATE(ts) d, COUNT(*) c FROM b GROUP BY host, d ORDER BY host, d
--source suite/moosedb/include/gbh_diff.inc
--disable_query_log
eval SET GLOBAL moosedb_agg_threads = $thr;
--enable_query_log

DROP DATABASE mirror;
DROP TABLE b, s, s3;
