--let $label= DOUBLE(10,2): the server compares with an epsilon
--let $q= SELECT host, COUNT(*) c FROM g WHERE df > 1.5 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc
--let $refused= 1
--let $label= FLOAT(8,3)
--let $q= SELECT host, COUNT(*) c FROM g WHERE ff >= 0.1 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc
--let $refused= 1
--let $label= a refused float conjunct next to an accepted one
--let $q= SELECT host, COUNT(*) c FROM g WHERE d > 1 AND f <> 0.5 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--echo # ---- zone maps: the bounds of the WHERE prune chunks (Moosedb_prune_*) ----
--let $expect= 1
--let $label= p >= 45 (days 4 and 5 only)
--let $q= SELECT host, COUNT(*) c FROM g WHERE p >= 45 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_prune_case.inc
--let $label= p > 49.9, scalar
--let $q= SELECT COUNT(*), SUM(i) FROM g WHERE p > 49.9
--source suite/moosedb/include/gbh_prune_case.inc
--let $label= p < 5
--let $q= SELECT host, COUNT(*) c FROM g WHERE p < 5 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_prune_case.inc
--let $label= p BETWEEN
--let $q= SELECT host, COUNT(*) c, SUM(i) s FROM g WHERE p BETWEEN 20.5 AND 21.5 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_prune_case.inc
--let $label= p = 31.5
--let $q= SELECT host, COUNT(*) c FROM g WHERE p = 31.5 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_prune_case.inc
--let $label= p IN (hull of the list)
--let $q= SELECT host, COUNT(*) c FROM g WHERE p IN (1.5, 2.5) GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_prune_case.inc
--let $label= p with an INT filter
--let $q= SELECT i, COUNT(*) c FROM g WHERE p >= 45 AND i < 3 GROUP BY i ORDER BY i
--source suite/moosedb/include/gbh_prune_case.inc
--let $expect= 0
--let $label= whole range: nothing to prune
--let $q= SELECT host, COUNT(*) c FROM g WHERE p > -1 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_prune_case.inc
--let $refused= 1
--let $label= DOUBLE(10,2) never prunes
--let $q= SELECT host, COUNT(*) c FROM g WHERE df >= 45 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_prune_case.inc

DROP DATABASE mirror;
DROP TABLE g;
