--let $q= SELECT host, COUNT(*) c FROM g WHERE d IS NOT NULL GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc
--let $refused= 1
--let $label= NULL constant
--let $q= SELECT host, COUNT(*) c FROM g WHERE d > NULL GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc
--let $refused= 1
--let $label= IN with a NULL
--let $q= SELECT host, COUNT(*) c FROM g WHERE d IN (0.25, NULL) GROUP BY host ORDER BY host
