--let $q= SELECT host, COUNT(*) c FROM g WHERE d NOT IN (1.5, 2) GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc
--let $refused= 1
--let $label= NOT BETWEEN
--let $q= SELECT host, COUNT(*) c FROM g WHERE d NOT BETWEEN -1 AND 1 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc
--let $refused= 1
