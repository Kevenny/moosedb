--let $refused= 1
--let $label= column x column
--let $q= SELECT host, COUNT(*) c FROM g WHERE d > f GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc
--let $refused= 1
--let $label= DOUBLE x INT column
--let $q= SELECT host, COUNT(*) c FROM g WHERE d > i GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc
--let $refused= 1
--let $label= string constant
--let $q= SELECT host, COUNT(*) c FROM g WHERE d > '1.5' GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc
--let $refused= 1
--let $label= temporal constant
--let $q= SELECT host, COUNT(*) c FROM g WHERE d > TIMESTAMP'2000-01-01 00:00:00' GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc
--let $refused= 1
--let $label= non-constant function
--let $q= SELECT host, COUNT(*) c FROM g WHERE d > RAND() * 0 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc
--let $refused= 1
