#
# GROUP BY done by the engine:
#  1. binary PAD SPACE string keys (utf8mb4_bin, latin1_bin, utf8mb3_bin) are
#     grouped by the core on the value without trailing spaces (no merge in the
#     handler) and take the core top-N, ties broken in the collation order;
#  2. aggregates without GROUP BY (implicit grouping, always one row).
# Every query is compared with the server without pushdown and with InnoDB.
#
--source include/not_embedded.inc
--source include/have_innodb.inc
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc

--let $refused= 0
--let $sorted= 0
--let $show= 0
--let $pre=

CREATE TABLE p (
  ts   DATETIME NOT NULL,
  host VARCHAR(16) NOT NULL COMMENT 'TAG',
  kp   VARCHAR(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin,
  kl   VARCHAR(8) CHARACTER SET latin1 COLLATE latin1_bin,
  ku   VARCHAR(8) CHARACTER SET utf8mb3 COLLATE utf8mb3_bin,
  kb   VARCHAR(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_nopad_bin,
  kc   VARCHAR(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci,
  v    BIGINT NOT NULL,
  bg   BIGINT NOT NULL,
  w    INT,
  INDEX(ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 DAY';
CREATE TABLE e (
  ts   DATETIME NOT NULL,
  host VARCHAR(16) NOT NULL COMMENT 'TAG',
  kp   VARCHAR(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin,
  v    BIGINT NOT NULL,
  w    INT,
  INDEX(ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 DAY';

--echo # classes of kp under PAD SPACE: {a, 'a ', 'a   '}, {'', '  '}, 'a<0x01>', 'a<TAB>', ' a', 'a b', 'b', NULL
--echo # 20000 rows in chunks, 10000 more in the MemTable
INSERT INTO p SELECT '2024-03-01' + INTERVAL seq * 20 SECOND, CONCAT('h', seq MOD 5),
    k, k, k, k, k, (seq * 37) MOD 1000, 9223372036854775807 - seq MOD 3,
    IF(seq MOD 4 = 0, NULL, seq MOD 50)
  FROM (SELECT seq, ELT(seq MOD 11 + 1, 'a', 'a ', 'a   ', '', '  ', CONCAT('a', CHAR(1)), CONCAT('a', CHAR(9)), ' a', 'a b ', 'b', NULL) k
        FROM seq_0_to_19999) x;
FLUSH TABLES p;
INSERT INTO p SELECT '2024-03-01' + INTERVAL seq * 20 SECOND, CONCAT('h', seq MOD 5),
    k, k, k, k, k, (seq * 37) MOD 1000, 9223372036854775807 - seq MOD 3,
    IF(seq MOD 4 = 0, NULL, seq MOD 50)
  FROM (SELECT seq, ELT(seq MOD 11 + 1, 'a', 'a ', 'a   ', '', '  ', CONCAT('a', CHAR(1)), CONCAT('a', CHAR(9)), ' a', 'a b ', 'b', NULL) k
        FROM seq_20000_to_29999) x;
CREATE DATABASE mirror;
CREATE TABLE mirror.p LIKE test.p;
ALTER TABLE mirror.p ENGINE=InnoDB;
INSERT INTO mirror.p SELECT * FROM test.p;
CREATE TABLE mirror.e LIKE test.e;
ALTER TABLE mirror.e ENGINE=InnoDB;

# The key shown for a class ('a', 'a ', 'a   ') is one of its values, whichever the plan sees
# first on the server and the shortest on the engine: compare without Max_length.
--let $nomaxlen= 1
--echo ##########################################################
--echo # PAD SPACE keys: one group per class, one of its values as the key
--echo ##########################################################
--let $label= groups (a, 'a ' and 'a   ' are one group; '' and '  ' too)
--let $q= SELECT kp, COUNT(*) c, SUM(v) s, MIN(ts) t FROM p GROUP BY kp ORDER BY kp
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT kl, COUNT(*) c FROM p GROUP BY kl ORDER BY kl
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT ku, COUNT(*) c FROM p GROUP BY ku ORDER BY ku
--source suite/moosedb/include/gbh_sc.inc
--let $label= PAD SPACE key together with a TAG
--let $q= SELECT host, kp, COUNT(*) c FROM p GROUP BY host, kp ORDER BY host, kp
--source suite/moosedb/include/gbh_sc.inc

--echo ##########################################################
--echo # Core top-N on PAD SPACE keys (topn=1): ties at the LIMIT boundary follow the
--echo # collation order, not the byte order ('a<0x01>' sorts before 'a': 0x01 < ' ')
--echo ##########################################################
