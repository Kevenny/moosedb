--echo ##########################################################
--echo # The key of a PAD SPACE group is its SHORTEST real member (bytes shown with cat -A,
--echo # end of line shown as a dollar sign by cat -A, a tab as ^I, spaces are visible before it)
--echo ##########################################################
CREATE TABLE r (ts DATETIME NOT NULL, host VARCHAR(8) NOT NULL COMMENT 'TAG', k VARCHAR(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO r VALUES ('2024-03-01 00:00:01', 'a', 'x   '), ('2024-03-01 00:00:02', 'a', 'x  '), ('2024-03-01 00:00:03', 'a', 'y '),
  ('2024-03-01 00:00:04', 'a', 'w'), ('2024-03-01 00:00:05', 'b', 'v '), ('2024-03-01 00:00:06', 'b', 'a b ');
FLUSH TABLES r;
INSERT INTO r VALUES ('2024-03-01 00:00:07', 'b', 'x    '), ('2024-03-01 00:00:08', 'b', 'y   '), ('2024-03-01 00:00:09', 'b', 'y'),
  ('2024-03-01 00:00:10', 'a', 'v   '), ('2024-03-01 00:00:11', 'a', NULL), ('2024-03-01 00:00:12', 'a', 'u  '), ('2024-03-01 00:00:13', 'a', '  ');
--let $hx_cl= $MYSQL -uroot -S$MASTER_MYSOCK -N -B --init-command="SET SESSION moosedb_group_by_pushdown=1" test
--let $hx_c0= `SELECT VARIABLE_VALUE FROM information_schema.GLOBAL_STATUS WHERE VARIABLE_NAME = 'MOOSEDB_GBH_QUERIES'`
--echo # expected: u (3 chars), v (2: the chunk row beats the MemTable 4), w, x (3), y (1: from the MemTable), 'a b ' (alone, keeps its space), '  ' (alone: the trimmed '' is not a member, so it is not returned), NULL
--exec $hx_cl -e "SELECT k, COUNT(*) FROM r GROUP BY k ORDER BY k" 2>&1 | cat -A
--exec $hx_cl -e "SELECT k, COUNT(*) c FROM r GROUP BY k ORDER BY c DESC, k LIMIT 4" 2>&1 | cat -A
--exec $hx_cl -e "SELECT host, k, COUNT(*) c FROM r GROUP BY host, k ORDER BY host, k" 2>&1 | cat -A
--let $hx_c1= `SELECT VARIABLE_VALUE - $hx_c0 FROM information_schema.GLOBAL_STATUS WHERE VARIABLE_NAME = 'MOOSEDB_GBH_QUERIES'`
--echo # engine runs: $hx_c1
DROP TABLE r;
DROP DATABASE mirror;
DROP TABLE p, e;
