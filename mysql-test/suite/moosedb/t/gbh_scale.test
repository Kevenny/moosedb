#
# GROUP BY done by the engine at scale: hundreds of thousands of groups, the
# memory budget (a clear error, not a crash or a wrong answer), max_statement_time
# and KILL QUERY during the aggregation, one thread against many.
#
--source include/not_embedded.inc
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc

CREATE TABLE s (
  ts   DATETIME NOT NULL,
  host VARCHAR(16) NOT NULL COMMENT 'TAG',
  file VARCHAR(32),
  n    INT,
  INDEX(ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 DAY';
--echo # 2 million rows, 700001 distinct files
INSERT INTO s SELECT '2024-01-01' + INTERVAL seq SECOND, CONCAT('host', seq MOD 100),
                     CONCAT('/var/f', seq MOD 700001), seq MOD 1000
  FROM seq_0_to_1999999;
FLUSH TABLES s;
SELECT COUNT(*) FROM s;

--echo ##### the same answer with the engine and without it
--disable_result_log
SET SESSION moosedb_group_by_pushdown = OFF;
SELECT file, COUNT(*), SUM(n) INTO @f_off, @c_off, @s_off FROM s GROUP BY file ORDER BY COUNT(*) DESC, file LIMIT 1;
SELECT host, COUNT(*), SUM(n) INTO @h_off, @hc_off, @hs_off FROM s GROUP BY host ORDER BY SUM(n) DESC, host LIMIT 1;
SET SESSION moosedb_group_by_pushdown = ON;
SELECT file, COUNT(*), SUM(n) INTO @f_on, @c_on, @s_on FROM s GROUP BY file ORDER BY COUNT(*) DESC, file LIMIT 1;
SELECT host, COUNT(*), SUM(n) INTO @h_on, @hc_on, @hs_on FROM s GROUP BY host ORDER BY SUM(n) DESC, host LIMIT 1;
--enable_result_log
SELECT @f_off = @f_on AND @c_off = @c_on AND @s_off = @s_on AS file_same,
       @h_off = @h_on AND @hc_off = @hc_on AND @hs_off = @hs_on AS host_same;
SELECT @f_on, @c_on, @s_on, @h_on, @hc_on, @hs_on;

--echo ##### one thread and eight threads
SET GLOBAL moosedb_agg_threads = 1;
--disable_result_log
SELECT file, COUNT(*), SUM(n) INTO @f_1, @c_1, @s_1 FROM s GROUP BY file ORDER BY COUNT(*) DESC, file LIMIT 1;
SET GLOBAL moosedb_agg_threads = 8;
SELECT file, COUNT(*), SUM(n) INTO @f_8, @c_8, @s_8 FROM s GROUP BY file ORDER BY COUNT(*) DESC, file LIMIT 1;
--enable_result_log
SET GLOBAL moosedb_agg_threads = DEFAULT;
SELECT @f_1 = @f_8 AND @c_1 = @c_8 AND @s_1 = @s_8 AND @f_1 = @f_on AS threads_same;

--echo ##### the memory budget: 700001 groups do not fit 16 MiB
SET SESSION moosedb_agg_max_memory = 16777216;
SELECT @@SESSION.moosedb_agg_max_memory;
--replace_regex /[0-9][0-9]* bytes/N bytes/
--error ER_UNKNOWN_ERROR
SELECT file, COUNT(*) c FROM s GROUP BY file ORDER BY file LIMIT 3;
--echo # a few groups still fit
SELECT host, COUNT(*) c FROM s GROUP BY host ORDER BY host LIMIT 3;
--echo # and the session is fine afterwards
SELECT COUNT(*) FROM s WHERE host = 'host7';
SET SESSION moosedb_agg_max_memory = DEFAULT;
SELECT file, COUNT(*) c FROM s GROUP BY file ORDER BY file LIMIT 3;

--echo ##### max_statement_time stops the aggregation
SET SESSION max_statement_time = 0.001;
--error ER_STATEMENT_TIMEOUT
SELECT file, COUNT(*) c FROM s GROUP BY file ORDER BY c DESC, file LIMIT 3;
SET SESSION max_statement_time = DEFAULT;
SELECT host, COUNT(*) c FROM s GROUP BY host ORDER BY host LIMIT 2;

--echo ##### KILL QUERY during the aggregation
--let $kid= `SELECT CONNECTION_ID()`
connect (con2,localhost,root,,test);
SET SESSION moosedb_group_by_pushdown = ON;
SET SESSION moosedb_agg_max_memory = 4294967296;
--let $victim= `SELECT CONNECTION_ID()`
--send SELECT file, COUNT(*) c, SUM(n) s FROM s GROUP BY file ORDER BY c DESC, file LIMIT 5
connection default;
let $wait_condition= SELECT COUNT(*) = 1 FROM information_schema.PROCESSLIST WHERE ID = $victim AND INFO LIKE 'SELECT file, COUNT(*) c, SUM(n) s%';
--source include/wait_condition.inc
--sleep 0.05
--disable_query_log
--error 0,ER_NO_SUCH_THREAD
eval KILL QUERY $victim;
--enable_query_log
connection con2;
--disable_result_log
--error 0,ER_QUERY_INTERRUPTED
--reap
--enable_result_log
--echo # the connection is still usable
SELECT COUNT(*) FROM s WHERE host = 'host9';
connection default;
disconnect con2;

DROP TABLE s;
