#
# GROUP BY pushdown: which queries the engine takes over (moosedb_gbh_debug
# prints the verdict as a note). With moosedb_group_by_pushdown ON an accepted
# query is computed by the engine, a refused one runs the normal way; either
# way every answer must stay identical to the InnoDB mirror's.
#
--source include/not_embedded.inc
--source include/have_innodb.inc
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc

CREATE TABLE g (
  ts     DATETIME NOT NULL,
  host   VARCHAR(16) NOT NULL COMMENT 'TAG',
  region VARCHAR(8) COMMENT 'TAG',
  code   VARCHAR(8),
  n      INT,
  big    BIGINT,
  d      DECIMAL(10,2),
  f      DOUBLE,
  INDEX(ts)
) ENGINE=MooseDB;
INSERT INTO g SELECT '2024-01-01' + INTERVAL seq * 10 MINUTE,
                     CONCAT('h', seq MOD 5),
                     IF(seq MOD 7 = 0, NULL, CONCAT('r', seq MOD 3)),
                     CONCAT('c', seq MOD 4),
                     IF(seq MOD 11 = 0, NULL, seq MOD 50),
                     seq * 1000000007, seq / 4, seq / 3
  FROM seq_0_to_399;
CREATE TABLE gi LIKE g;
ALTER TABLE gi ENGINE=InnoDB;
INSERT INTO gi SELECT * FROM g;
FLUSH TABLES g;

--let $mt= g
--let $it= gi

--echo ##### Switches: pushdown OFF and debug OFF -> no verdict at all
SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY host;
SET SESSION moosedb_group_by_pushdown = ON;
SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY host;

--echo ##### Debug ON, pushdown OFF: the analysis still reports
SET SESSION moosedb_group_by_pushdown = OFF;
SET SESSION moosedb_gbh_debug = ON;
SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY host;

SET SESSION moosedb_group_by_pushdown = ON;

--echo ##########################################################
--echo # Accepted
--echo ##########################################################
