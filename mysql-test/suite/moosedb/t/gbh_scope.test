SET SESSION moosedb_group_by_pushdown = OFF;
--let $q= SELECT host, region, COUNT(*) c, SUM(n) s, MIN(ts) t0 FROM {T} WHERE ts >= '2024-01-02 00:00:00' GROUP BY host, region ORDER BY host, region
