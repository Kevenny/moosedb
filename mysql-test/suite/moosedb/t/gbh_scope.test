--let $label= two TAGs, every supported aggregate
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT code, n, COUNT(*) c FROM {T} GROUP BY code, n ORDER BY code, n LIMIT 7
--let $label= VARCHAR and INT group columns, LIMIT
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT host, COUNT(*) c, SUM(n) s FROM {T} WHERE ts >= '2024-01-02 00:00:00' AND ts < '2024-01-03 00:00:00' AND host IN ('h1','h2','h3') AND region = 'r1' AND n BETWEEN 3 AND 40 AND code LIKE 'c%' AND big IS NOT NULL AND d > 1.5 AND f <> 2 GROUP BY host ORDER BY host
--let $label= WHERE: conjunction of time range, IN, =, BETWEEN, LIKE, IS NOT NULL, comparisons
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT host, COUNT(*) c FROM {T} WHERE region IS NULL AND n <=> 5 GROUP BY host ORDER BY host
--let $label= WHERE: IS NULL and <=>
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT host, COUNT(*) c FROM {T} WHERE 3 < n GROUP BY host ORDER BY host
--let $label= WHERE: constant on the left
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT host, COUNT(*) c, SUM(n) s FROM {T} GROUP BY host HAVING c > 70 AND SUM(n) > 100 ORDER BY s DESC, host
--let $label= HAVING (done by the server), ORDER BY an aggregate
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT host, COUNT(*) c FROM {T} GROUP BY host ORDER BY c DESC, host LIMIT 2 OFFSET 1
--let $label= ORDER BY aggregate DESC with LIMIT and OFFSET
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT host, COUNT(*) c FROM {T} GROUP BY host ORDER BY SUM(n), host
--let $label= ORDER BY an aggregate that is not selected (hidden item)
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT COUNT(*) c FROM {T} GROUP BY host, region ORDER BY c, host, region
--let $label= GROUP BY columns that are not selected
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT 7 k, 'x' s, host, COUNT(*) c FROM {T} GROUP BY host ORDER BY host
--let $label= constants in the select list
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT x.host AS hh, COUNT(*) AS c FROM {T} AS x GROUP BY hh ORDER BY hh DESC
--let $label= table and column aliases, ORDER BY the group column DESC
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT host, COUNT(*) c FROM {T} GROUP BY 1 ORDER BY 1
--let $label= GROUP BY position
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT host, COUNT(*) c FROM {T} GROUP BY host ORDER BY NULL
--let $label= ORDER BY NULL
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT host, COUNT(*) c FROM {T} WHERE code NOT LIKE 'c1%' GROUP BY host ORDER BY host
--let $label= NOT LIKE (the optimizer keeps a negated LIKE, still a column predicate)
--source suite/moosedb/include/gbh_case.inc
--echo # EXPLAIN reaches the hook too
EXPLAIN SELECT host, COUNT(*) c FROM g GROUP BY host;

--echo # Prepared statement: analysed again at every EXECUTE, parameters bound
PREPARE p FROM 'SELECT host, COUNT(*) c FROM g WHERE ts >= ? AND n > ? GROUP BY host ORDER BY host';
SET @a= '2024-01-03 00:00:00', @b= 10;
EXECUTE p USING @a, @b;
SET @a= '2024-01-04 00:00:00', @b= 40;
EXECUTE p USING @a, @b;
DEALLOCATE PREPARE p;

--echo ##########################################################
--echo # Refused: what the statement is part of
--echo ##########################################################
--let $q= SELECT COUNT(*) c, SUM(n) s FROM {T} WHERE n > 5
--let $label= aggregates without GROUP BY: accepted (one implicit group), see gbh_pad_scalar
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT COUNT(*) + 1 c FROM {T} WHERE n > 5
--let $label= expression over an aggregate, no GROUP BY
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT COUNT(DISTINCT n) c FROM {T}
--let $label= COUNT(DISTINCT), no GROUP BY
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT host FROM {T} WHERE n > 45 ORDER BY ts LIMIT 5
--let $label= plain SELECT
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT host, COUNT(*) c FROM {T} GROUP BY host UNION ALL SELECT region, COUNT(*) FROM {T} GROUP BY region ORDER BY 1, 2
--let $label= UNION (each part is refused)
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT * FROM (SELECT host, COUNT(*) c FROM {T} GROUP BY host) d ORDER BY host
--let $label= derived table
--source suite/moosedb/include/gbh_case.inc

--let $q= WITH w AS (SELECT host, COUNT(*) c FROM {T} GROUP BY host) SELECT * FROM w ORDER BY host
--let $label= CTE
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT host FROM {T} WHERE n IN (SELECT COUNT(*) FROM {T} t2 GROUP BY t2.host) GROUP BY host ORDER BY host
--let $label= subquery (and the outer query)
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT (SELECT SUM(c) FROM (SELECT COUNT(*) c FROM {T} t3 GROUP BY t3.region) z) s, host FROM {T} GROUP BY host ORDER BY host
--let $label= derived table inside a scalar subquery
--source suite/moosedb/include/gbh_case.inc

--let $q= SELECT t1.host, COUNT(*) c FROM {T} t1 JOIN {T} t2 ON t2.n = t1.n AND t2.host = t1.host GROUP BY t1.host ORDER BY t1.host
--let $label= two tables
--source suite/moosedb/include/gbh_case.inc

CREATE VIEW gv AS SELECT * FROM g;
CREATE VIEW gvi AS SELECT * FROM gi;
CREATE VIEW gvg AS SELECT host, COUNT(*) c FROM g GROUP BY host;
CREATE VIEW gvgi AS SELECT host, COUNT(*) c FROM gi GROUP BY host;
--echo # merged view: the hook is not called at all (no verdict)
SELECT host, COUNT(*) c FROM gv GROUP BY host ORDER BY host;
SELECT host, COUNT(*) c FROM gvi GROUP BY host ORDER BY host;
--echo # view with a GROUP BY inside
SELECT * FROM gvg ORDER BY host;
SELECT * FROM gvgi ORDER BY host;
DROP VIEW gv, gvi, gvg, gvgi;

--echo # statements that are not a top-level SELECT
CREATE TABLE cs AS SELECT host, COUNT(*) c FROM g GROUP BY host;
INSERT INTO cs SELECT code, COUNT(*) FROM g GROUP BY code;
SELECT COUNT(*) FROM cs;
DROP TABLE cs;
CREATE TABLE cs2 (host VARCHAR(16), c BIGINT) ENGINE=InnoDB;
INSERT INTO cs2 SELECT host, COUNT(*) FROM g GROUP BY host;
SELECT COUNT(*) FROM cs2;
DROP TABLE cs2;

--echo # inside a stored procedure, a function and a trigger
DELIMITER |;
CREATE PROCEDURE pr() BEGIN SELECT host, COUNT(*) c FROM g GROUP BY host ORDER BY host; END|
CREATE FUNCTION fn() RETURNS BIGINT DETERMINISTIC BEGIN DECLARE r BIGINT; SELECT SUM(c) INTO r FROM (SELECT COUNT(*) c FROM g GROUP BY host) z; RETURN r; END|
DELIMITER ;|
CALL pr();
SELECT fn();
DROP PROCEDURE pr;
DROP FUNCTION fn;

--echo ##########################################################
--echo # Refused: clauses
--echo ##########################################################
--let $q= SELECT DISTINCT COUNT(*) c FROM {T} GROUP BY host ORDER BY c
--let $label= DISTINCT
--source suite/moosedb/include/gbh_case.inc
--echo # ROLLUP (CREATE ... SELECT cannot hold its NULL row, so compared directly)
SELECT host, COUNT(*) c FROM g GROUP BY host WITH ROLLUP;
SELECT host, COUNT(*) c FROM gi GROUP BY host WITH ROLLUP;


--let $q= SELECT host, COUNT(*) c, COUNT(*) OVER () w FROM {T} GROUP BY host ORDER BY host
