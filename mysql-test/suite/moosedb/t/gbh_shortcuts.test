#
# GROUP BY done by the engine: the two shortcuts of the core.
#  1. col = const / col IN (consts) on a byte-exact comparison is filtered by
#     the core as a value set (no dictionary phase); any other predicate keeps
#     the dictionary + mask path.
#  2. ORDER BY one aggregate LIMIT K with one key is a top-N done by the core.
# Differential (OFF / ON / InnoDB identical) and the counters show which path ran.
#
--source include/not_embedded.inc
--source include/have_innodb.inc
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc

--let $refused= 0
--let $sorted= 0
--let $show= 0
--let $pre=

CREATE TABLE g (
  ts    DATETIME NOT NULL,
  host  VARCHAR(16) NOT NULL COMMENT 'TAG',
  kb    VARCHAR(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_nopad_bin,
  kp    VARCHAR(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin,
  kc    VARCHAR(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci,
  i     INT,
  ui    INT UNSIGNED,
  bu    BIGINT UNSIGNED,
  bi    BIGINT,
  ty    TINYINT,
  bytes BIGINT NOT NULL,
  INDEX(ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 DAY';

--echo # 20000 rows in chunks, 10000 more in the MemTable
INSERT INTO g SELECT '2024-03-01' + INTERVAL seq * 20 SECOND, CONCAT('h', seq MOD 7),
    IF(seq MOD 11 = 0, NULL, ELT(seq MOD 6 + 1, 'a', 'a ', 'b', 'B', '', 'c d')),
    IF(seq MOD 11 = 0, NULL, ELT(seq MOD 6 + 1, 'a', 'a ', 'b', 'B', '', 'c d')),
    IF(seq MOD 11 = 0, NULL, ELT(seq MOD 6 + 1, 'a', 'a ', 'b', 'B', '', 'c d')),
    IF(seq MOD 13 = 0, NULL, seq MOD 20),
    IF(seq MOD 17 = 0, NULL, 4294967295 - seq MOD 5),
    IF(seq MOD 19 = 0, NULL, IF(seq MOD 2, 18446744073709551615 - seq MOD 4, seq MOD 4)),
    IF(seq MOD 23 = 0, NULL, IF(seq MOD 2, -9223372036854775807 - 1 + CAST(seq MOD 3 AS SIGNED), CAST(seq MOD 3 AS SIGNED))),
    IF(seq MOD 2, 127, -128),
    seq MOD 1000
  FROM seq_0_to_19999;
FLUSH TABLES g;
INSERT INTO g SELECT '2024-03-01' + INTERVAL seq * 20 SECOND, CONCAT('h', seq MOD 7),
    IF(seq MOD 11 = 0, NULL, ELT(seq MOD 6 + 1, 'a', 'a ', 'b', 'B', '', 'c d')),
    IF(seq MOD 11 = 0, NULL, ELT(seq MOD 6 + 1, 'a', 'a ', 'b', 'B', '', 'c d')),
    IF(seq MOD 11 = 0, NULL, ELT(seq MOD 6 + 1, 'a', 'a ', 'b', 'B', '', 'c d')),
    IF(seq MOD 13 = 0, NULL, seq MOD 20),
    IF(seq MOD 17 = 0, NULL, 4294967295 - seq MOD 5),
    IF(seq MOD 19 = 0, NULL, IF(seq MOD 2, 18446744073709551615 - seq MOD 4, seq MOD 4)),
    IF(seq MOD 23 = 0, NULL, IF(seq MOD 2, -9223372036854775807 - 1 + CAST(seq MOD 3 AS SIGNED), CAST(seq MOD 3 AS SIGNED))),
    IF(seq MOD 2, 127, -128),
    seq MOD 1000
  FROM seq_20000_to_29999;
CREATE DATABASE mirror;
CREATE TABLE mirror.g LIKE test.g;
ALTER TABLE mirror.g ENGINE=InnoDB;
INSERT INTO mirror.g SELECT * FROM test.g;

--echo ##########################################################
--echo # Exact value sets (integers, binary NO PAD strings)
--echo ##########################################################
--let $label= string, utf8mb4_nopad_bin: trailing spaces are significant
--let $q= SELECT host, COUNT(*) c FROM g WHERE kb = 'a' GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT host, COUNT(*) c FROM g WHERE kb IN ('a ', 'b', 'zz', '') GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT host, COUNT(*) c FROM g WHERE 'B' = kb GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT kb, COUNT(*) c FROM g WHERE kb IN ('a', 'a ', 'c d') GROUP BY kb ORDER BY kb
--source suite/moosedb/include/gbh_sc.inc

--let $label= integers: range of the column, signed and unsigned constants
--let $q= SELECT host, COUNT(*) c FROM g WHERE i = 5 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT host, COUNT(*) c FROM g WHERE i IN (1, 2, 300000000000, -7, 19) GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT host, COUNT(*) c FROM g WHERE ui IN (4294967295, 4294967296, -1, 4294967293) GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT host, COUNT(*) c FROM g WHERE ty IN (127, -128, 128, -129) GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT host, COUNT(*) c FROM g WHERE bu = 18446744073709551615 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT host, COUNT(*) c FROM g WHERE bu IN (18446744073709551614, 9223372036854775808, 3, -4) GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT host, COUNT(*) c FROM g WHERE bi IN (-9223372036854775808, 18446744073709551615, 2) GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc

--let $label= nothing can match (empty value set)
--let $q= SELECT host, COUNT(*) c FROM g WHERE bu = -5 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT host, COUNT(*) c FROM g WHERE ui = 4294967296 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc

--let $label= exact filters combined: two exact, exact + dictionary, TAG + time
--let $q= SELECT host, COUNT(*) c FROM g WHERE kb = 'a' AND i IN (1, 2, 3) GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT host, COUNT(*) c FROM g WHERE kb = 'a' AND i > 3 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT host, COUNT(*) c, SUM(bytes) s FROM g WHERE kb IN ('b', 'B') AND host IN ('h1', 'h2') AND ts >= '2024-03-02' AND ts < '2024-03-04' GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc

--let $label= prepared statement: the value set is rebuilt at every EXECUTE
--let $q= PREPARE p FROM 'SELECT host, COUNT(*) c FROM g WHERE kb = ? AND i IN (?, ?) GROUP BY host ORDER BY host'; SET @a= 'a'; SET @b= 3; SET @c= 4; EXECUTE p USING @a, @b, @c; SET @a= 'b '; SET @b= 5; EXECUTE p USING @a, @b, @c; SET @a= NULL; EXECUTE p USING @a, @b, @c; DEALLOCATE PREPARE p;
--source suite/moosedb/include/gbh_sc.inc

--echo ##########################################################
--echo # Dictionary + mask (exact filters=0), except kp (binary PAD SPACE: exact with pad_space)
--echo ##########################################################
--let $label= PAD SPACE binary collation (utf8mb4_bin): trailing spaces ignored, exact value set with pad_space
--let $q= SELECT host, COUNT(*) c FROM g WHERE kp = 'a' GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT host, COUNT(*) c FROM g WHERE kp IN ('a ', 'b') GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $label= case-insensitive collation
--let $q= SELECT host, COUNT(*) c FROM g WHERE kc = 'A' GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $label= OR, NOT IN, <>, <=>, NULL in the list, decimal constant
--let $q= SELECT host, COUNT(*) c FROM g WHERE kb = 'a' OR kb = 'b' GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT host, COUNT(*) c FROM g WHERE kb NOT IN ('a', 'b') GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT host, COUNT(*) c FROM g WHERE kb <=> 'a' GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT host, COUNT(*) c FROM g WHERE i IN (1, NULL, 2) GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT host, COUNT(*) c FROM g WHERE i = 5e0 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT host, COUNT(*) c FROM g WHERE i = 5 AND i <> 7 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc
--let $label= explicit COLLATE on the constant: the comparison is not on the column (refused)
--let $refused= 1
--let $q= SELECT host, COUNT(*) c FROM g WHERE kb = 'A' COLLATE utf8mb4_general_ci GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_sc.inc

--echo ##########################################################
--echo # Top-N in the core
--echo ##########################################################
--let $label= integer key, ORDER BY SUM DESC LIMIT (no ties expected)
--let $q= SELECT i, SUM(bytes) s FROM g GROUP BY i ORDER BY s DESC LIMIT 6
--source suite/moosedb/include/gbh_sc.inc
--let $label= ascending, with OFFSET
--let $q= SELECT i, SUM(bytes) s, COUNT(*) c FROM g GROUP BY i ORDER BY s LIMIT 4 OFFSET 2
--source suite/moosedb/include/gbh_sc.inc
--let $label= MIN / MAX of an integer and of the time axis, COUNT(col) with NULL groups
--let $q= SELECT bi, MIN(ts) t FROM g GROUP BY bi ORDER BY t LIMIT 3
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT ui, SUM(i) c FROM g GROUP BY ui ORDER BY c DESC LIMIT 2
--source suite/moosedb/include/gbh_sc.inc
--let $label= binary NO PAD string key
--let $q= SELECT kb, SUM(bytes) s FROM g GROUP BY kb ORDER BY s DESC LIMIT 3
--source suite/moosedb/include/gbh_sc.inc
--let $label= LIMIT larger than the number of groups (two ORDER BY terms: not the core top-N)
--let $q= SELECT ty, COUNT(*) c FROM g GROUP BY ty ORDER BY c DESC, ty LIMIT 10
--source suite/moosedb/include/gbh_sc.inc
--let $label= top-N together with filters
--let $q= SELECT i, SUM(bytes) s FROM g WHERE kb IN ('a', 'b') AND ts >= '2024-03-02' GROUP BY i ORDER BY s DESC LIMIT 4
--source suite/moosedb/include/gbh_sc.inc

--echo ##########################################################
--echo # Top-N ties at the LIMIT boundary: the core keeps the same groups as the
--echo # handler's own sort (ties broken by ascending key)
--echo ##########################################################
SET SESSION moosedb_group_by_pushdown = ON;
--let $tdir= $MYSQLTEST_VARDIR/tmp
--let $tcl= $MYSQL -uroot -S$MASTER_MYSOCK --table --init-command="SET SESSION moosedb_group_by_pushdown=1" test
--exec $tcl -e "SELECT i, COUNT(*) c FROM g WHERE i IS NOT NULL AND i < 10 GROUP BY i ORDER BY c LIMIT 5" > $tdir/tie_core.txt 2>&1
--exec $tcl -e "SELECT i, COUNT(*) c FROM g WHERE i IS NOT NULL AND i < 10 GROUP BY i ORDER BY c, i LIMIT 5" > $tdir/tie_sort.txt 2>&1
--diff_files $tdir/tie_core.txt $tdir/tie_sort.txt
--exec $tcl -e "SELECT kb, COUNT(*) c FROM g GROUP BY kb ORDER BY c DESC LIMIT 3" > $tdir/tie_core.txt 2>&1
--exec $tcl -e "SELECT kb, COUNT(*) c FROM g GROUP BY kb ORDER BY c DESC, kb LIMIT 3" > $tdir/tie_sort.txt 2>&1
--diff_files $tdir/tie_core.txt $tdir/tie_sort.txt
--exec $tcl -e "SELECT ty, COUNT(*) c FROM g GROUP BY ty ORDER BY c LIMIT 1" > $tdir/tie_core.txt 2>&1
--exec $tcl -e "SELECT ty, COUNT(*) c FROM g GROUP BY ty ORDER BY c, ty LIMIT 1" > $tdir/tie_sort.txt 2>&1
--diff_files $tdir/tie_core.txt $tdir/tie_sort.txt
--echo # the core top-N keeps exactly the groups (and the order) of the handler's own sort
--let $label= ties everywhere: the second ORDER BY term makes the order total
--let $q= SELECT i, COUNT(*) c FROM g WHERE i IS NOT NULL AND ts < '2024-03-01 01:00:00' GROUP BY i ORDER BY c, i LIMIT 5
--source suite/moosedb/include/gbh_sc.inc

--echo ##########################################################
--echo # Top-N not used (same answer, topn=0)
--echo ##########################################################
--let $label= TAG key (tiebreak would be the series id, not the TAG value)
--let $q= SELECT host, SUM(bytes) s FROM g GROUP BY host ORDER BY s DESC LIMIT 3
--source suite/moosedb/include/gbh_sc.inc
--let $label= case-insensitive and PAD SPACE keys are merged by the collation
--let $q= SELECT SUM(bytes) s FROM g GROUP BY kc ORDER BY s DESC LIMIT 3
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT SUM(bytes) s FROM g GROUP BY kp ORDER BY s DESC LIMIT 3
--source suite/moosedb/include/gbh_sc.inc
--let $label= BIGINT UNSIGNED key
--let $q= SELECT bu, SUM(bytes) s FROM g GROUP BY bu ORDER BY s DESC LIMIT 3
--source suite/moosedb/include/gbh_sc.inc
--let $label= AVG, HAVING, no LIMIT, ORDER BY the key
--let $q= SELECT i, AVG(bytes) a FROM g GROUP BY i ORDER BY a DESC LIMIT 3
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT i, SUM(bytes) s FROM g GROUP BY i HAVING s > 100 ORDER BY s DESC LIMIT 3
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT i, SUM(bytes) s FROM g GROUP BY i ORDER BY s DESC
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT i, SUM(bytes) s FROM g GROUP BY i ORDER BY i DESC LIMIT 3
--source suite/moosedb/include/gbh_sc.inc
--let $label= two keys
--let $q= SELECT i, ty, SUM(bytes) s FROM g GROUP BY i, ty ORDER BY s DESC, i, ty LIMIT 3
--source suite/moosedb/include/gbh_sc.inc

--echo ##########################################################
--echo # Top-N with ORDER BY aggregate, key ASC (total SQL order, ties at the boundary)
--echo ##########################################################
--let $label= integer key (NULL group among the ties), aggregate DESC / ASC
--let $q= SELECT i, COUNT(*) c FROM g WHERE ts < '2024-03-01 00:10:00' GROUP BY i ORDER BY c DESC, i LIMIT 4
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT i, COUNT(*) c FROM g WHERE ts < '2024-03-01 00:10:00' GROUP BY i ORDER BY c, i LIMIT 4
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT i, COUNT(*) c FROM g WHERE i IS NOT NULL AND i < 10 GROUP BY i ORDER BY c, i LIMIT 5 OFFSET 1
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT i, SUM(bytes) s, COUNT(*) c FROM g WHERE i < 12 GROUP BY i ORDER BY c DESC, i LIMIT 3
--source suite/moosedb/include/gbh_sc.inc
--let $label= NO PAD string key (NULL key, ties)
--let $q= SELECT kb, COUNT(*) c FROM g WHERE ts < '2024-03-01 00:20:00' GROUP BY kb ORDER BY c DESC, kb LIMIT 3
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT kb, MIN(ts) t FROM g GROUP BY kb ORDER BY t, kb LIMIT 4
--source suite/moosedb/include/gbh_sc.inc
--let $label= key DESC in the second term, BIGINT UNSIGNED key, PAD SPACE string key: no core top-N
--let $q= SELECT i, COUNT(*) c FROM g WHERE i < 10 GROUP BY i ORDER BY c, i DESC LIMIT 4
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT bu, COUNT(*) c FROM g WHERE ts < '2024-03-01 00:10:00' GROUP BY bu ORDER BY c DESC, bu LIMIT 3
--source suite/moosedb/include/gbh_sc.inc
--let $q= SELECT COUNT(*) c FROM g GROUP BY kp ORDER BY c DESC, kp LIMIT 3
--source suite/moosedb/include/gbh_sc.inc

DROP DATABASE mirror;
DROP TABLE g;
