#
# GROUP BY done by the engine: WHERE with predicates on ordinary columns
# (moosedb_group_by_pushdown). The engine lists the distinct values of each
# filtered column over the query's time range and series, the server's own Items
# decide each value, and the engine filters by the verdicts. Differential test
# (OFF / ON / InnoDB must print the same), include/gbh_diff.inc.
#
--source include/not_embedded.inc
--source include/have_innodb.inc
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc

--let $refused= 0
--let $sorted= 0
--let $show= 0
--let $pre=

CREATE TABLE g (
  ts    DATETIME NOT NULL,
  host  VARCHAR(16) NOT NULL COMMENT 'TAG',
  proc  VARCHAR(8) COMMENT 'TAG',
  op    VARCHAR(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin,
  nm    VARCHAR(12) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci,
  ch    CHAR(6) CHARACTER SET latin1 COLLATE latin1_swedish_ci,
  file  VARCHAR(40) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL,
  n     INT,
  u     BIGINT UNSIGNED,
  bytes BIGINT NOT NULL,
  INDEX(ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 DAY';

--echo # 20000 rows in chunks, 10000 more left in the MemTable
INSERT INTO g SELECT '2024-03-01' + INTERVAL seq * 20 SECOND,
                     CONCAT('h', seq MOD 7),
                     IF(seq MOD 11 = 0, NULL, CONCAT('p', seq MOD 5)),
                     IF(seq MOD 13 = 0, NULL, ELT(seq MOD 5 + 1, 'read', 'write', 'open', 'close', 'READ')),
                     IF(seq MOD 17 = 0, NULL, ELT(seq MOD 4 + 1, 'READ', 'read ', 'Read', 'rEAD  ')),
                     IF(seq MOD 19 = 0, NULL, ELT(seq MOD 3 + 1, 'ab', 'AB ', 'b')),
                     CONCAT('/d', seq MOD 50, '/f', seq MOD 20011),
                     IF(seq MOD 9 = 0, NULL, CAST(seq MOD 100 AS SIGNED) - 20),
                     IF(seq MOD 8 = 0, NULL, IF(seq MOD 2, 18446744073709551615 - seq, seq)),
                     (seq * 7) MOD 1000
  FROM seq_0_to_19999;
FLUSH TABLES g;
INSERT INTO g SELECT '2024-03-01' + INTERVAL seq * 20 SECOND,
                     CONCAT('h', seq MOD 7),
                     IF(seq MOD 11 = 0, NULL, CONCAT('p', seq MOD 5)),
                     IF(seq MOD 13 = 0, NULL, ELT(seq MOD 5 + 1, 'read', 'write', 'open', 'close', 'READ')),
                     IF(seq MOD 17 = 0, NULL, ELT(seq MOD 4 + 1, 'READ', 'read ', 'Read', 'rEAD  ')),
                     IF(seq MOD 19 = 0, NULL, ELT(seq MOD 3 + 1, 'ab', 'AB ', 'b')),
                     CONCAT('/d', seq MOD 50, '/f', seq MOD 20011),
                     IF(seq MOD 9 = 0, NULL, CAST(seq MOD 100 AS SIGNED) - 20),
                     IF(seq MOD 8 = 0, NULL, IF(seq MOD 2, 18446744073709551615 - seq, seq)),
                     (seq * 7) MOD 1000
  FROM seq_20000_to_29999;

CREATE DATABASE mirror;
CREATE TABLE mirror.g LIKE test.g;
ALTER TABLE mirror.g ENGINE=InnoDB;
INSERT INTO mirror.g SELECT * FROM test.g;
SELECT (SELECT COUNT(*) FROM test.g) = (SELECT COUNT(*) FROM mirror.g) AS same_rows;

