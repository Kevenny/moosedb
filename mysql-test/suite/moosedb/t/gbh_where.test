--source suite/moosedb/include/gbh_diff.inc

--echo ##########################################################
--echo # Combinations
--echo ##########################################################
--let $label= TAG IN + time range + a column predicate
--let $q= SELECT host, COUNT(*) c, SUM(bytes) s FROM g WHERE host IN ('h1', 'h4') AND ts >= '2024-03-02 00:00:00' AND ts < '2024-03-04 12:00:00' AND op = 'read' GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--let $label= predicates on two different columns (AND), each its own dictionary
--let $q= SELECT host, COUNT(*) c FROM g WHERE op = 'read' AND n > 10 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc
--let $q= SELECT proc, COUNT(*) c, MIN(ts) t0 FROM g WHERE op IN ('read', 'READ') AND nm = 'read' AND u > 9223372036854775808 AND file LIKE '/d1%' GROUP BY proc ORDER BY proc
--source suite/moosedb/include/gbh_diff.inc

--let $label= predicates together with every aggregate
--let $q= SELECT host, proc, COUNT(*) c, COUNT(n) cn, SUM(n) sn, AVG(n) an, MIN(n) mn, MAX(n) xn, MIN(ts) t0, MAX(ts) t1 FROM g WHERE op <> 'open' AND n IS NOT NULL GROUP BY host, proc ORDER BY host, proc
--source suite/moosedb/include/gbh_diff.inc

--let $label= HAVING, ORDER BY aggregate, LIMIT / OFFSET with a predicate
--let $q= SELECT host, COUNT(*) c, SUM(bytes) s FROM g WHERE op = 'read' GROUP BY host HAVING c > 100 ORDER BY s DESC, host LIMIT 3 OFFSET 1
--source suite/moosedb/include/gbh_diff.inc

--echo ##########################################################
--echo # Prepared statements: the parameters are bound at every EXECUTE
--echo ##########################################################
--let $label= PREPARE / EXECUTE with different parameters
--let $q= PREPARE p FROM 'SELECT host, COUNT(*) c FROM g WHERE op = ? AND n > ? GROUP BY host ORDER BY host'; SET @a= 'read'; SET @b= 10; EXECUTE p USING @a, @b; SET @a= 'open'; SET @b= -30; EXECUTE p USING @a, @b; SET @a= NULL; EXECUTE p USING @a, @b; DEALLOCATE PREPARE p;
--source suite/moosedb/include/gbh_diff.inc
--let $q= PREPARE p FROM 'SELECT proc, COUNT(*) c FROM g WHERE file IN (?, ?) AND ts >= ? GROUP BY proc ORDER BY proc'; SET @a= '/d7/f7'; SET @b= '/d8/f8'; SET @c= '2024-03-02'; EXECUTE p USING @a, @b, @c; SET @a= '/d9/f9'; SET @c= '2024-03-06'; EXECUTE p USING @a, @b, @c; DEALLOCATE PREPARE p;
--source suite/moosedb/include/gbh_diff.inc

--echo ##########################################################
--echo # Refused (same answer, the engine does not run them)
--echo ##########################################################
--let $label= one conjunct over two columns (OR across columns)
--let $refused= 1
--let $q= SELECT host, COUNT(*) c FROM g WHERE op = 'read' OR n > 70 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--let $label= comparison between two columns
--let $refused= 1
--let $q= SELECT host, COUNT(*) c FROM g WHERE n > bytes GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--let $label= a function of the column
--let $refused= 1
--let $q= SELECT host, COUNT(*) c FROM g WHERE UPPER(op) = 'READ' GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--let $label= a string column against a number (the server converts and warns per row)
--let $refused= 1
--let $q= SELECT host, COUNT(*) c FROM g WHERE op = 5 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--let $label= a function that is not constant for the statement (SLEEP)
--let $refused= 1
--let $q= SELECT host, COUNT(*) c FROM g WHERE n > SLEEP(0) GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--let $label= subquery
--let $refused= 1
--let $q= SELECT host, COUNT(*) c FROM g WHERE n > (SELECT MIN(n) FROM g t2) + 90 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--let $label= predicate on a TAG column that is not =/IN
--let $refused= 1
--let $q= SELECT host, COUNT(*) c FROM g WHERE host LIKE 'h1%' GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--echo ##########################################################
--echo # DELETE (tombstones) and the dictionary
--echo ##########################################################
DELETE FROM test.g WHERE host = 'h2' AND ts < '2024-03-03';
DELETE FROM mirror.g WHERE host = 'h2' AND ts < '2024-03-03';
DELETE FROM test.g WHERE op = 'open' AND n > 30;
DELETE FROM mirror.g WHERE op = 'open' AND n > 30;
DELETE FROM test.g WHERE file = '/d7/f7';
DELETE FROM mirror.g WHERE file = '/d7/f7';
--let $label= after DELETE: the deleted values leave the dictionary and the counts
--let $q= SELECT host, COUNT(*) c FROM g WHERE op IN ('read', 'open') GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc
--let $q= SELECT proc, COUNT(*) c FROM g WHERE file IN ('/d7/f7', '/d8/f8') GROUP BY proc ORDER BY proc
--source suite/moosedb/include/gbh_diff.inc
--let $q= SELECT op, COUNT(*) c FROM g WHERE n > 30 GROUP BY op ORDER BY op
--source suite/moosedb/include/gbh_diff.inc
FLUSH TABLES g;
OPTIMIZE TABLE g;
--let $q= SELECT host, COUNT(*) c FROM g WHERE op IN ('read', 'open') AND n > 0 GROUP BY host ORDER BY host
--source suite/moosedb/include/gbh_diff.inc

--echo ##########################################################
--echo # The laboratory queries (q02, q05, q05b) are accepted
--echo ##########################################################
CREATE TABLE e (
  ts         DATETIME(6)  NOT NULL,
  host       VARCHAR(32)  NOT NULL COMMENT 'TAG',
  process    VARCHAR(63)  NOT NULL COMMENT 'TAG',
  user_name  VARCHAR(32)  NOT NULL,
  folder     VARCHAR(255) NOT NULL,
  file       VARCHAR(512) NOT NULL,
  op         VARCHAR(8)   NOT NULL,
  bytes      BIGINT       NOT NULL,
  latency_us INT          NOT NULL,
  INDEX ix_ts (ts)
) ENGINE=MooseDB TIMESTAMP_COLUMN='ts' CHUNK_INTERVAL='1 DAY';
INSERT INTO e SELECT '2024-03-01' + INTERVAL seq * 7 SECOND, CONCAT('host', seq MOD 9),
                     CONCAT('proc', seq MOD 13), CONCAT('u', seq MOD 5),
                     CONCAT('/srv/d', seq MOD 31), CONCAT('/srv/d', seq MOD 31, '/f', seq MOD 997),
                     ELT(seq MOD 3 + 1, 'read', 'write', 'open'), seq MOD 4096, seq MOD 500
  FROM seq_0_to_29999;
CREATE TABLE mirror.e LIKE test.e;
ALTER TABLE mirror.e ENGINE=InnoDB;
INSERT INTO mirror.e SELECT * FROM test.e;

--let $label= q02: top folders read in an hour
--let $q= SELECT folder, COUNT(*) AS n FROM e WHERE op = 'read' AND ts >= '2024-03-01 03:00:00' AND ts < '2024-03-01 04:00:00' GROUP BY folder ORDER BY n DESC, folder LIMIT 20
--source suite/moosedb/include/gbh_diff.inc
--let $label= q05: who accesses a file (no time predicate)
--let $q= SELECT host, process, COUNT(*) AS n FROM e WHERE file = '/srv/d5/f5' GROUP BY host, process ORDER BY n DESC, host, process LIMIT 50
--source suite/moosedb/include/gbh_diff.inc
--let $label= q05b: who accesses a file, in a day
--let $q= SELECT host, process, COUNT(*) AS n FROM e WHERE file = '/srv/d5/f5' AND ts >= '2024-03-01' AND ts < '2024-03-02' GROUP BY host, process ORDER BY n DESC, host, process LIMIT 50
--source suite/moosedb/include/gbh_diff.inc

DROP TABLE e;
DROP DATABASE mirror;
DROP TABLE g;
