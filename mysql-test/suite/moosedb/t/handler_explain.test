#
# HANDLER statements, EXPLAIN plans, ORDER BY ts ASC/DESC with LIMIT/OFFSET,
# index hints and covering/non-covering access over MemTable + chunks.
#
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc
--echo # this test counts handler calls / reads EXPLAIN of the scan path: the GROUP BY pushdown (default ON) would bypass it
SET SESSION moosedb_group_by_pushdown = OFF;

CREATE TABLE h (
    ts    DATETIME(3) NOT NULL,
    host  VARCHAR(8) NOT NULL COMMENT 'TAG',
    v     INT,
    INDEX ts_idx (ts)
) ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR';
--echo # 3 hosts, one row every 10 minutes for 6 hours; first half sealed
INSERT INTO h SELECT '2026-04-01 00:00:00' + INTERVAL seq * 10 MINUTE, CONCAT('h', seq MOD 3), seq FROM seq_0_to_35;
FLUSH TABLES h;
INSERT INTO h SELECT '2026-04-01 06:00:00' + INTERVAL seq * 10 MINUTE, CONCAT('h', seq MOD 3), 100 + seq FROM seq_0_to_35;
--echo # Rows with identical timestamps keep all their copies (06:05, in the MemTable)
INSERT INTO h VALUES ('2026-04-01 06:05:00.000', 'dup', 1000), ('2026-04-01 06:05:00.000', 'dup', 1001);

CREATE TABLE ctl (ts DATETIME(3) NOT NULL, host VARCHAR(8) NOT NULL, v INT, INDEX(ts)) ENGINE=MyISAM;
INSERT INTO ctl SELECT * FROM h;

--echo # ---- EXPLAIN ----
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM h WHERE ts BETWEEN '2026-04-01 01:00:00' AND '2026-04-01 02:00:00';
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM h WHERE ts >= '2026-04-01 05:00:00';
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM h WHERE ts = '2026-04-01 05:00:00';
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM h ORDER BY ts DESC LIMIT 5;
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM h ORDER BY ts LIMIT 5;
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM h WHERE host = 'h1';
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM h WHERE host = 'h1' AND ts > '2026-04-01 03:00:00';
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM h WHERE v > 3 ORDER BY ts DESC;
--replace_column 10 # 11 #
EXPLAIN SELECT host, COUNT(*) FROM h GROUP BY host;
--replace_column 10 # 11 #
EXPLAIN SELECT MIN(ts), MAX(ts) FROM h;
--replace_column 10 # 11 #
EXPLAIN SELECT a.v, b.v FROM h a JOIN h b ON a.ts = b.ts WHERE a.host = 'h0' AND b.host = 'h1';
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM h FORCE INDEX (ts_idx) WHERE v = 3;
--replace_column 10 # 11 #
EXPLAIN SELECT * FROM h IGNORE INDEX (ts_idx) WHERE ts > '2026-04-01 05:00:00';
--error ER_KEY_DOES_NOT_EXISTS
SELECT * FROM h USE INDEX (nope);
--replace_regex /"cost": [0-9.e-]+/"cost": COST/
EXPLAIN FORMAT=JSON SELECT ts FROM h WHERE ts < '2026-04-01 00:30:00' ORDER BY ts;

--echo # Row estimates stay sane: a narrow range is cheaper than the whole table
--replace_column 10 # 11 #
EXPLAIN SELECT COUNT(*) FROM h WHERE ts BETWEEN '2026-04-01 00:00:00' AND '2026-04-01 00:09:59';
SELECT TABLE_ROWS > 0 AS has_estimate FROM information_schema.TABLES WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 'h';

--echo # ---- ORDER BY / LIMIT / OFFSET ----
SELECT ts, v FROM h ORDER BY ts LIMIT 3;
SELECT ts, v FROM h ORDER BY ts DESC LIMIT 3;
SELECT ts, v FROM h ORDER BY ts LIMIT 3 OFFSET 34;
SELECT ts, v FROM h ORDER BY ts DESC LIMIT 2 OFFSET 33;
SELECT ts, v FROM h WHERE ts > '2026-04-01 05:30:00' ORDER BY ts LIMIT 3;
SELECT ts, v FROM h WHERE ts >= '2026-04-01 05:30:00' ORDER BY ts DESC LIMIT 4 OFFSET 38;
SELECT ts, v FROM h WHERE ts < '2026-04-01 06:00:00' ORDER BY ts DESC LIMIT 2;
SELECT ts, v FROM h WHERE ts <= '2026-04-01 06:00:00' ORDER BY ts DESC, v DESC LIMIT 4;
SELECT ts, host, v FROM h WHERE host = 'dup' ORDER BY ts DESC, v DESC;
SELECT ts, v FROM h ORDER BY ts LIMIT 0;
SELECT ts, v FROM h ORDER BY ts LIMIT 100000 OFFSET 71;
SELECT ts, v FROM h ORDER BY ts LIMIT 5 OFFSET 100000;
SELECT COUNT(*) FROM (SELECT ts FROM h ORDER BY ts DESC LIMIT 1000) x;
--echo # Same answers as the control table for ordered scans (ties broken on v)
SELECT (SELECT GROUP_CONCAT(v ORDER BY ts, v) FROM h) = (SELECT GROUP_CONCAT(v ORDER BY ts, v) FROM ctl) AS same_order;
SELECT (SELECT GROUP_CONCAT(v ORDER BY ts DESC, v DESC) FROM h) = (SELECT GROUP_CONCAT(v ORDER BY ts DESC, v DESC) FROM ctl) AS same_order_desc;
SELECT MIN(ts), MAX(ts), MIN(v), MAX(v) FROM h;
SELECT ts FROM h WHERE ts = (SELECT MAX(ts) FROM h);
SELECT ts FROM h WHERE ts = (SELECT MIN(ts) FROM h);
--echo # Index scan results are the same with the index ignored
SELECT COUNT(*), SUM(v) FROM h WHERE ts BETWEEN '2026-04-01 02:00:00' AND '2026-04-01 08:00:00';
SELECT COUNT(*), SUM(v) FROM h IGNORE INDEX (ts_idx) WHERE ts BETWEEN '2026-04-01 02:00:00' AND '2026-04-01 08:00:00';
SELECT COUNT(*), SUM(v) FROM ctl WHERE ts BETWEEN '2026-04-01 02:00:00' AND '2026-04-01 08:00:00';

--echo # Direction changes inside one scan (ORDER BY ts DESC on a range, then LIMIT)
SELECT ts FROM h WHERE ts BETWEEN '2026-04-01 03:00:00' AND '2026-04-01 03:50:00' ORDER BY ts DESC;
SELECT ts FROM h WHERE ts BETWEEN '2026-04-01 03:00:00' AND '2026-04-01 03:50:00' ORDER BY ts;
SELECT ts FROM h WHERE ts > '2026-04-01 05:50:00' AND ts < '2026-04-01 06:10:00' ORDER BY ts DESC, v DESC;

--echo # ---- HANDLER ----
--echo # The engine does not advertise HA_CAN_SQL_HANDLER, so the server refuses the
--echo # HANDLER interface for MooseDB tables (documented limitation, not a crash)
--error ER_ILLEGAL_HA
HANDLER h OPEN;
--error ER_ILLEGAL_HA
HANDLER h OPEN AS a;
--error ER_UNKNOWN_TABLE
HANDLER h READ ts_idx FIRST;
--error ER_UNKNOWN_TABLE
HANDLER h CLOSE;
--echo # The table is unaffected
SELECT COUNT(*) FROM h;
FLUSH TABLES h;
SELECT COUNT(*) FROM h;
TRUNCATE TABLE h;
--error ER_ILLEGAL_HA
HANDLER h OPEN;
SELECT COUNT(*) FROM h;

DROP TABLE h, ctl;
