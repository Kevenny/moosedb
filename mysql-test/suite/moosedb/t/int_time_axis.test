CREATE TABLE zq (clock INT NOT NULL, v INT NOT NULL, INDEX(clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
CREATE TABLE zqi (clock INT NOT NULL, v INT NOT NULL, KEY(clock)) ENGINE=InnoDB;
INSERT INTO zq VALUES (-2147483648, 1), (-1, 2), (0, 3), (2147483647, 4);
INSERT INTO zqi SELECT * FROM zq;
--let $mt= zq
--let $it= zqi
--let $tail= WHERE clock < 0
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock <= -2147483648
--source suite/moosedb/include/mirror_cmp.inc
