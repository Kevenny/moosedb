--echo # The scan really uses the index: reads only the rows of the range
EXPLAIN SELECT COUNT(*) FROM z WHERE clock BETWEEN 1767825000 AND 1767826200;
FLUSH STATUS;
SELECT COUNT(*) FROM z WHERE clock BETWEEN 1767825000 AND 1767826200;
SHOW SESSION STATUS WHERE Variable_name IN ('Handler_read_key', 'Handler_read_next', 'Handler_read_rnd_next', 'Handler_read_first');
FLUSH STATUS;
SELECT COUNT(*) FROM z WHERE clock > 1768400000;
SHOW SESSION STATUS WHERE Variable_name IN ('Handler_read_key', 'Handler_read_next', 'Handler_read_rnd_next', 'Handler_read_first');

--echo ##################################################################
--echo # ORDER BY clock, LIMIT, MIN/MAX
--echo ##################################################################
EXPLAIN SELECT clock, itemid FROM z ORDER BY clock DESC LIMIT 5;
SELECT clock, itemid, ns FROM z ORDER BY clock DESC LIMIT 5;
SELECT clock, itemid, ns FROM zi ORDER BY clock DESC LIMIT 5;
SELECT clock, itemid, ns FROM z ORDER BY clock LIMIT 3;
SELECT clock, itemid, ns FROM zi ORDER BY clock LIMIT 3;
SELECT clock, itemid, ns FROM z WHERE clock < 1767825600 ORDER BY clock DESC LIMIT 3;
SELECT clock, itemid, ns FROM zi WHERE clock < 1767825600 ORDER BY clock DESC LIMIT 3;
SELECT clock, itemid, ns FROM z WHERE clock >= 1767825600 ORDER BY clock LIMIT 3 OFFSET 2;
SELECT clock, itemid, ns FROM zi WHERE clock >= 1767825600 ORDER BY clock LIMIT 3 OFFSET 2;
--echo # Zabbix pattern: one item, newest first
SELECT clock, itemid, value FROM z WHERE itemid = 3 ORDER BY clock DESC LIMIT 4;
SELECT clock, itemid, value FROM zi WHERE itemid = 3 ORDER BY clock DESC LIMIT 4;
SELECT clock, itemid, value FROM z WHERE itemid IN (2, 4) AND clock <= 1768000000 ORDER BY clock DESC LIMIT 4;
SELECT clock, itemid, value FROM zi WHERE itemid IN (2, 4) AND clock <= 1768000000 ORDER BY clock DESC LIMIT 4;
--echo # Min/max by the index
EXPLAIN SELECT MIN(clock), MAX(clock) FROM z;
SELECT MIN(clock), MAX(clock) FROM z;
SELECT MIN(clock), MAX(clock) FROM zi;
SELECT MIN(clock), MAX(clock) FROM z WHERE clock > 1767825600 AND clock < 1768000000;
SELECT MIN(clock), MAX(clock) FROM zi WHERE clock > 1767825600 AND clock < 1768000000;
SELECT MIN(clock), MAX(clock) FROM z WHERE clock > 1768425000;
SELECT MIN(clock), MAX(clock) FROM zi WHERE clock > 1768425000;
SELECT COUNT(*), MIN(clock), MAX(clock) FROM z WHERE itemid = 5;
SELECT COUNT(*), MIN(clock), MAX(clock) FROM zi WHERE itemid = 5;

--echo # ns is an ordinary column: ORDER BY clock, ns is a filesort and stays correct
CREATE TABLE zt (clock INT NOT NULL, itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', ns INT NOT NULL, value DOUBLE NOT NULL,
  INDEX (clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 HOUR';
CREATE TABLE zti (clock INT NOT NULL, itemid BIGINT UNSIGNED NOT NULL, ns INT NOT NULL, value DOUBLE NOT NULL,
  KEY (clock)) ENGINE=InnoDB;
--let $row= 1767225600 + seq DIV 6, 1 + seq MOD 3, 999999999 - (seq * 7) MOD 100, seq
eval INSERT INTO zt SELECT $row FROM seq_0_to_59;
eval INSERT INTO zti SELECT $row FROM seq_0_to_59;
FLUSH TABLES zt;
eval INSERT INTO zt SELECT $row FROM seq_60_to_119;
eval INSERT INTO zti SELECT $row FROM seq_60_to_119;
SELECT clock, ns, itemid FROM zt ORDER BY clock DESC, ns DESC LIMIT 7;
SELECT clock, ns, itemid FROM zti ORDER BY clock DESC, ns DESC LIMIT 7;
SELECT clock, ns, itemid FROM zt ORDER BY clock, ns LIMIT 7;
SELECT clock, ns, itemid FROM zti ORDER BY clock, ns LIMIT 7;
SELECT clock, COUNT(*) FROM zt WHERE clock BETWEEN 1767225603 AND 1767225605 GROUP BY clock;
SELECT clock, COUNT(*) FROM zti WHERE clock BETWEEN 1767225603 AND 1767225605 GROUP BY clock;
--let $mt= zt
--let $it= zti
--let $tail= WHERE clock = 1767225605
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock > 1767225605 AND ns > 999999950
--source suite/moosedb/include/mirror_cmp.inc
DROP TABLE zt, zti;
--let $mt= z
--let $it= zi

--echo ##################################################################
--echo # Value range: BIGINT / BIGINT UNSIGNED / INT UNSIGNED / signed negatives
--echo ##################################################################
--let $sel= COUNT(*), MIN(clock), BIT_XOR(CRC32(CONCAT(clock, '|', v)))
CREATE TABLE zs (clock BIGINT NOT NULL, v INT NOT NULL, INDEX(clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 MONTH';
CREATE TABLE zsi (clock BIGINT NOT NULL, v INT NOT NULL, KEY(clock)) ENGINE=InnoDB;
--echo # The limits are +/-9223372036854 s (about year 292277): beyond that secs * 1e6 would overflow a signed 64-bit microsecond count
INSERT INTO zs VALUES (-9223372036854, 1), (-86400 * 365 * 100, 2), (-86400, 3), (-1, 4), (0, 5), (1, 6), (86399, 7), (1767225600, 8), (253402300799, 9), (9223372036853, 10), (9223372036854, 11);
INSERT INTO zsi SELECT * FROM zs;
--error ER_GET_ERRMSG
INSERT INTO zs VALUES (9223372036855, 12);
--error ER_GET_ERRMSG
INSERT INTO zs VALUES (-9223372036855, 13);
--error ER_GET_ERRMSG
INSERT INTO zs VALUES (9223372036854775807, 14);
--error ER_GET_ERRMSG
INSERT INTO zs VALUES (-9223372036854775808, 15);
--echo # A failing statement leaves nothing, as in InnoDB
--error ER_GET_ERRMSG
INSERT INTO zs VALUES (100, 16), (9223372036855, 17), (200, 18);
INSERT INTO zs VALUES (100, 16);
INSERT INTO zsi VALUES (100, 16);
SELECT COUNT(*), MIN(clock), MAX(clock) FROM zs;
SELECT COUNT(*), MIN(clock), MAX(clock) FROM zsi;
SELECT clock, v FROM zs ORDER BY clock;
SELECT clock, v FROM zsi ORDER BY clock;
SELECT clock, v FROM zs ORDER BY clock DESC LIMIT 4;
SELECT clock, v FROM zsi ORDER BY clock DESC LIMIT 4;
--let $mt= zs
--let $it= zsi
--let $tail= WHERE clock < 0
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock <= 0
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock = -1
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock BETWEEN -2 AND 2
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock BETWEEN -86400 AND -1
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock >= 9223372036854
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock > 9223372036853
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock > 9223372036854
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock <= -9223372036854
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock < -9223372036854
--source suite/moosedb/include/mirror_cmp.inc
--echo # Bounds beyond the representable range saturate instead of wrapping
--let $tail= WHERE clock > 9223372036855
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock >= 9223372036855
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock < 9223372036855
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock <= 9223372036855
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock = 9223372036855
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock < -9223372036855
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock >= -9223372036855
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock BETWEEN -9223372036855 AND 9223372036855
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock > 9223372036854775806
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock < -9223372036854775807
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE clock = 253402300799
--source suite/moosedb/include/mirror_cmp.inc
--echo # Seal the MemTable: the extreme rows must flush into chunks (month bucket arithmetic at the edges of i64)
FLUSH TABLES zs;
--echo # (INFORMATION_SCHEMA shows DATETIME values, which stop at year 9999; only the counts are shown)
SELECT COUNT(*) AS chunks, SUM(`ROWS`) AS chunk_rows FROM information_schema.MOOSEDB_CHUNKS WHERE TABLE_NAME = 'zs';
CHECK TABLE zs;
OPTIMIZE TABLE zs;
SELECT COUNT(*), MIN(clock), MAX(clock) FROM zs;
--echo # Saturated bounds with backward / ordered index scans
SELECT clock, v FROM zs WHERE clock <= 9223372036855 ORDER BY clock DESC LIMIT 3;
SELECT clock, v FROM zsi WHERE clock <= 9223372036855 ORDER BY clock DESC LIMIT 3;
SELECT clock, v FROM zs WHERE clock < -9223372036855 ORDER BY clock DESC;
SELECT clock, v FROM zsi WHERE clock < -9223372036855 ORDER BY clock DESC;
SELECT clock, v FROM zs WHERE clock >= -9223372036855 ORDER BY clock LIMIT 2;
SELECT clock, v FROM zsi WHERE clock >= -9223372036855 ORDER BY clock LIMIT 2;
SELECT clock, v FROM zs WHERE clock < 9223372036855 AND clock > -9223372036855 ORDER BY clock DESC LIMIT 2;
SELECT clock, v FROM zsi WHERE clock < 9223372036855 AND clock > -9223372036855 ORDER BY clock DESC LIMIT 2;
DROP TABLE zs, zsi;

CREATE TABLE zu (clock BIGINT UNSIGNED NOT NULL, v INT NOT NULL, INDEX(clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 MONTH';
CREATE TABLE zui (clock BIGINT UNSIGNED NOT NULL, v INT NOT NULL, KEY(clock)) ENGINE=InnoDB;
INSERT INTO zu VALUES (0, 1), (1, 2), (1767225600, 3), (9223372036853, 4), (9223372036854, 5);
INSERT INTO zui SELECT * FROM zu;
--echo # Above LONGLONG_MAX (negative as a signed value) and above the supported range
--error ER_GET_ERRMSG
INSERT INTO zu VALUES (9223372036855, 6);
--error ER_GET_ERRMSG
INSERT INTO zu VALUES (9223372036854775808, 7);
--error ER_GET_ERRMSG
INSERT INTO zu VALUES (18446744073709551615, 8);
--error ER_GET_ERRMSG
INSERT INTO zu VALUES (18446744073709551614, 9);
SELECT clock, v FROM zu ORDER BY clock;
