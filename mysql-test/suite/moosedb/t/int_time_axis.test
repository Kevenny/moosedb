CREATE TABLE zn (clock INT UNSIGNED NOT NULL, v INT NOT NULL, INDEX(clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
CREATE TABLE zni (clock INT UNSIGNED NOT NULL, v INT NOT NULL, KEY(clock)) ENGINE=InnoDB;
INSERT INTO zn VALUES (0, 1), (2147483647, 2), (2147483648, 3), (4294967294, 4), (4294967295, 5);
INSERT INTO zni SELECT * FROM zn;
