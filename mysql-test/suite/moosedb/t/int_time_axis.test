#
# INT / BIGINT time axis: TIMESTAMP_COLUMN names an integer column that holds
# seconds since 1970-01-01 UTC (Zabbix: clock INT). The engine stores secs *
# 1e6 microseconds, so chunking, retention and range pruning work as for
# DATETIME. Every query runs on the MooseDB table and on an InnoDB mirror;
# "SAME" means identical count, minimum and row checksum.
#
--source include/not_embedded.inc
--source include/have_innodb.inc
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc

--let $quiet= 0
--let $show_status= 0
--let $mt= z
--let $it= zi
--let $sel= COUNT(*), MIN(clock), BIT_XOR(CRC32(CONCAT(clock, '|', itemid, '|', ns)))

--echo ##################################################################
--echo # DDL rules
--echo ##################################################################
--echo # An integer column is the axis only when TIMESTAMP_COLUMN names it
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock INT NOT NULL, INDEX(clock)) ENGINE=MooseDB;
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (ts DATETIME NOT NULL, clock INT NOT NULL, INDEX(clock)) ENGINE=MooseDB;
--echo # NOT NULL, stored, INT or BIGINT, not a TAG, indexed (non-unique)
--error ER_NULL_COLUMN_IN_INDEX
CREATE TABLE e (clock INT, INDEX(clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock SMALLINT NOT NULL, INDEX(clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock TINYINT NOT NULL, INDEX(clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock DOUBLE NOT NULL, INDEX(clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock INT NOT NULL COMMENT 'TAG', INDEX(clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock INT NOT NULL, v INT) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--echo # (UNIQUE on the axis of a table without TAG columns is accepted: primary_key.test)
CREATE TABLE e (clock INT NOT NULL, UNIQUE(clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
DROP TABLE e;
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (clock INT NOT NULL, v INT NOT NULL, INDEX(clock), INDEX(v)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--echo # An index on a DATETIME column is not the axis when TIMESTAMP_COLUMN says otherwise
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE e (ts DATETIME NOT NULL, clock INT NOT NULL, INDEX(ts)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';

--echo ##################################################################
--echo # Basic table: INT axis, integer TAG, ns as an ordinary column
--echo ##################################################################
CREATE TABLE z (
  clock  INT NOT NULL,
  itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG',
  ns     INT NOT NULL,
  value  DOUBLE NOT NULL,
  INDEX clock_idx (clock)
) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY';
CREATE TABLE zi (
  clock  INT NOT NULL,
  itemid BIGINT UNSIGNED NOT NULL,
  ns     INT NOT NULL,
  value  DOUBLE NOT NULL,
  KEY clock_idx (clock)
) ENGINE=InnoDB;
SHOW CREATE TABLE z;

--echo # 2000 rows, one every 10 minutes from 2026-01-01 00:00:00 UTC (7 daily chunks sealed + the second half in the MemTable)
--let $row= 1767225600 + seq * 600, 1 + seq MOD 5, (seq * 7919) MOD 1000000, seq / 4
eval INSERT INTO z SELECT $row FROM seq_0_to_999;
eval INSERT INTO zi SELECT $row FROM seq_0_to_999;
FLUSH TABLES z;
eval INSERT INTO z SELECT $row FROM seq_1000_to_1999;
eval INSERT INTO zi SELECT $row FROM seq_1000_to_1999;
SELECT COUNT(*), MIN(clock), MAX(clock), COUNT(DISTINCT itemid) FROM z;
SELECT COUNT(*), MIN(clock), MAX(clock), COUNT(DISTINCT itemid) FROM zi;

--echo # Chunks are cut at UTC midnight of the epoch seconds
SELECT COUNT(*) AS chunks, MIN(TS_MIN) AS first_min, MAX(TS_MAX) AS last_max
  FROM information_schema.MOOSEDB_CHUNKS WHERE TABLE_NAME = 'z';
SELECT TS_MIN, TS_MAX, `ROWS` FROM information_schema.MOOSEDB_CHUNKS
  WHERE TABLE_NAME = 'z' ORDER BY CHUNK_ID LIMIT 2;

