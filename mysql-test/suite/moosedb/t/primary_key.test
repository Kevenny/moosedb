--echo ##################################################################
--echo # unique_checks = 0: bulk load without the check (a risk the user takes)
--echo ##################################################################
CREATE TABLE uc (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL, value DOUBLE NOT NULL, ns INT NOT NULL,
                 PRIMARY KEY (itemid, clock, ns)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
INSERT INTO uc VALUES (1, 100, 1, 1), (1, 101, 1, 1);
SET unique_checks = 0;
INSERT INTO uc VALUES (1, 100, 2, 1), (1, 102, 2, 1);
SET unique_checks = 1;
SELECT clock, ns, value FROM uc ORDER BY clock, value;
--echo # new rows are checked again, and the rows stored without the check are known
--error ER_DUP_ENTRY
INSERT INTO uc VALUES (1, 102, 3, 1);
--error ER_DUP_ENTRY
INSERT INTO uc VALUES (1, 100, 3, 1);
INSERT INTO uc VALUES (1, 103, 3, 1);
SELECT COUNT(*) FROM uc;
DROP TABLE uc;

--echo ##################################################################
--echo # LOCK TABLES, stored routines, triggers
--echo ##################################################################
CREATE TABLE lk (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL, ns INT NOT NULL,
                 PRIMARY KEY (itemid, clock, ns)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
CREATE TABLE lk_log (n INT) ENGINE=InnoDB;
LOCK TABLES lk WRITE;
INSERT INTO lk VALUES (1, 100, 1);
--error ER_DUP_ENTRY
INSERT INTO lk VALUES (1, 100, 1);
INSERT INTO lk VALUES (1, 100, 2), (1, 101, 1);
--error ER_DUP_ENTRY
INSERT INTO lk VALUES (1, 102, 1), (1, 101, 1);
INSERT IGNORE INTO lk VALUES (1, 100, 2), (1, 103, 1);
SELECT @@warning_count;
UNLOCK TABLES;
SELECT * FROM lk ORDER BY clock, ns;
DELIMITER |;
CREATE PROCEDURE lk_p(IN c INT)
BEGIN
  INSERT INTO lk VALUES (2, c, 1);
  INSERT INTO lk VALUES (2, c, 1);
END|
DELIMITER ;|
--error ER_DUP_ENTRY
CALL lk_p(50);
SELECT * FROM lk WHERE itemid = 2;
CREATE TABLE lk_src (itemid BIGINT UNSIGNED NOT NULL, clock INT NOT NULL, ns INT NOT NULL) ENGINE=InnoDB;
CREATE TRIGGER lk_t AFTER INSERT ON lk_src FOR EACH ROW INSERT INTO lk VALUES (NEW.itemid, NEW.clock, NEW.ns);
INSERT INTO lk_src VALUES (3, 1, 1), (3, 2, 1);
--error ER_DUP_ENTRY
INSERT INTO lk_src VALUES (3, 3, 1), (3, 2, 1);
SELECT * FROM lk WHERE itemid = 3 ORDER BY clock;
DROP TRIGGER lk_t;
DROP PROCEDURE lk_p;
DROP TABLE lk, lk_log, lk_src;

--echo ##################################################################
--echo # TRUNCATE and retention forget the keys
--echo ##################################################################
CREATE TABLE tr (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL, value DOUBLE NOT NULL, ns INT NOT NULL,
                 PRIMARY KEY (itemid, clock, ns)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY' RETENTION_PERIOD='30 DAYS';
INSERT INTO tr VALUES (1, 100, 1, 1), (1, 101, 1, 1);
FLUSH TABLES tr;
INSERT INTO tr VALUES (1, 102, 1, 1);
--error ER_DUP_ENTRY
INSERT INTO tr VALUES (1, 100, 2, 1);
TRUNCATE TABLE tr;
SELECT COUNT(*) FROM tr;
INSERT INTO tr VALUES (1, 100, 2, 1), (1, 101, 2, 1), (1, 102, 2, 1);
--error ER_DUP_ENTRY
INSERT INTO tr VALUES (1, 101, 3, 1);
SELECT clock, value FROM tr ORDER BY clock;
--echo # retention: the key of an expired row can be inserted again
TRUNCATE TABLE tr;
SET @now= UNIX_TIMESTAMP();
INSERT INTO tr VALUES (1, @now - 200 * 86400, 1, 1), (1, @now - 100 * 86400, 1, 1), (1, @now - 3600, 1, 1);
FLUSH TABLES tr;
--replace_regex /-[0-9]{9,10}-1/-<clock>-1/
--error ER_DUP_ENTRY
INSERT INTO tr VALUES (1, @now - 200 * 86400, 2, 1);
CALL moosedb_apply_retention('test.tr');
SELECT COUNT(*) AS rows_left FROM tr;
INSERT INTO tr VALUES (1, @now - 200 * 86400, 2, 1);
--replace_regex /-[0-9]{9,10}-1/-<clock>-1/
--error ER_DUP_ENTRY
INSERT INTO tr VALUES (1, @now - 200 * 86400, 3, 1);
--replace_regex /-[0-9]{9,10}-1/-<clock>-1/
--error ER_DUP_ENTRY
INSERT INTO tr VALUES (1, @now - 3600, 3, 1);
DROP TABLE tr;

--echo ##################################################################
--echo # ALTER TABLE
--echo ##################################################################
CREATE TABLE al (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL, ns INT NOT NULL, INDEX (clock))
  ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
INSERT INTO al VALUES (1, 100, 1), (1, 100, 1), (1, 101, 1);
--echo # adding the key to a table that holds a duplicate fails
--error ER_DUP_ENTRY
ALTER TABLE al ADD PRIMARY KEY (itemid, clock, ns);
SELECT COUNT(*) FROM al;
TRUNCATE TABLE al;
INSERT INTO al VALUES (1, 100, 1), (1, 100, 2), (1, 101, 1);
ALTER TABLE al ADD PRIMARY KEY (itemid, clock, ns);
SHOW CREATE TABLE al;
--error ER_DUP_ENTRY
INSERT INTO al VALUES (1, 100, 2);
SELECT * FROM al ORDER BY clock, ns;
--echo # the key can be dropped again; the table then needs an index on the time column
ALTER TABLE al DROP PRIMARY KEY;
INSERT INTO al VALUES (1, 100, 2);
SELECT COUNT(*) FROM al;
CREATE TABLE al2 (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL, PRIMARY KEY (itemid, clock)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';
--error ER_ILLEGAL_HA_CREATE_OPTION
ALTER TABLE al2 DROP PRIMARY KEY;
ALTER TABLE al2 DROP PRIMARY KEY, ADD INDEX (clock);
DROP TABLE al2;
--echo # converting an InnoDB table with the key
CREATE TABLE cv (itemid BIGINT UNSIGNED NOT NULL, clock INT NOT NULL, ns INT NOT NULL, PRIMARY KEY (itemid, clock, ns)) ENGINE=InnoDB;
INSERT INTO cv VALUES (1, 1, 1), (1, 1, 2), (2, 1, 1);
ALTER TABLE cv ENGINE=MooseDB TIMESTAMP_COLUMN='clock', MODIFY itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG';
SHOW CREATE TABLE cv;
--error ER_DUP_ENTRY
INSERT INTO cv VALUES (1, 1, 2);
SELECT * FROM cv ORDER BY itemid, clock, ns;
DROP TABLE al, cv;

--echo ##################################################################
--echo # Range over the whole key (itemid, clock, ns): clock BETWEEN with ns =, >, <
--echo # (the start key of the range names every key part) -- never ER_ILLEGAL_HA
--echo ##################################################################
CREATE TABLE rk (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL, value DOUBLE NOT NULL, ns INT NOT NULL, PRIMARY KEY (itemid, clock, ns))
  ENGINE=MooseDB TIMESTAMP_COLUMN='clock' CHUNK_INTERVAL='1 DAY';
CREATE TABLE ri (itemid BIGINT UNSIGNED NOT NULL, clock INT NOT NULL, value DOUBLE NOT NULL, ns INT NOT NULL, PRIMARY KEY (itemid, clock, ns)) ENGINE=InnoDB;
INSERT INTO rk SELECT 1 + a.seq, 1700000000 + b.seq, b.seq, c.seq FROM seq_0_to_2 a, seq_0_to_29 b, seq_0_to_2 c;
INSERT INTO ri SELECT * FROM rk;
FLUSH TABLES rk;
INSERT INTO rk SELECT 1 + a.seq, 1700000030 + b.seq, b.seq, c.seq FROM seq_0_to_2 a, seq_0_to_9 b, seq_0_to_2 c;
INSERT INTO ri SELECT * FROM rk WHERE clock >= 1700000030;
