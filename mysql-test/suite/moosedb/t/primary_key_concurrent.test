#
# PRIMARY KEY (itemid, clock, ns) with several sessions: statements are
# invisible to each other until they end, so a statement that needs a series
# another statement is writing waits for it and then checks against what was
# committed. Two inserts of one key: exactly one wins. Also: other series are
# not held up, a lock wait timeout, KILL QUERY of a waiting statement, a
# cycle of waiting statements (deadlock), unique_checks=0 not waiting.
#
--source include/not_embedded.inc
--source include/have_innodb.inc
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc

CREATE TABLE t (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL, value DOUBLE NOT NULL, ns INT NOT NULL,
                PRIMARY KEY (itemid, clock, ns)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock';

connect (holder, localhost, root,,);
connect (waiter, localhost, root,,);
connect (other, localhost, root,,);

--echo ##################################################################
--echo # One statement holds series 7 for 3 seconds (its second row is slow)
--echo ##################################################################
connection holder;
send INSERT INTO t SELECT 7, 500 + seq, SLEEP(IF(seq = 2, 3, 0)), 1 FROM seq_1_to_2;

connection default;
--echo # (wait until the first row of the holder is written and its statement is sleeping)
--let $sleeping_like= INSERT INTO t SELECT 7%
--let $sleeping_n= 1
--source suite/moosedb/include/wait_statement_sleeping.inc

--echo # Another series is not held up
connection other;
INSERT INTO t VALUES (8, 501, 1, 1);
SELECT COUNT(*) AS rows_visible_now FROM t;

--echo # The same key as the holder's first row: waits for it, then is a duplicate
connection waiter;
send INSERT INTO t VALUES (7, 501, 2, 1);

--echo # A different key of the same series also waits, and then succeeds
connection other;
send INSERT INTO t VALUES (7, 900, 3, 1);

connection holder;
reap;
connection waiter;
--error ER_DUP_ENTRY
reap;
--echo # (a duplicate of a row nobody could see yet: the statement did wait for the holder)
connection other;
reap;
connection default;
SELECT itemid, clock, value, ns FROM t ORDER BY itemid, clock, ns;

--echo ##################################################################
--echo # Lock wait timeout
--echo ##################################################################
SET @old_timeout = @@GLOBAL.moosedb_unique_lock_wait_timeout;
SET GLOBAL moosedb_unique_lock_wait_timeout = 1;
connection holder;
send INSERT INTO t SELECT 20, 100 + seq, SLEEP(IF(seq = 2, 4, 0)), 1 FROM seq_1_to_2;
connection default;
--let $sleeping_like= INSERT INTO t SELECT 20,%
--let $sleeping_n= 1
--source suite/moosedb/include/wait_statement_sleeping.inc
connection waiter;
--error ER_LOCK_WAIT_TIMEOUT
INSERT INTO t VALUES (20, 999, 1, 1);
connection holder;
reap;
connection default;
SET GLOBAL moosedb_unique_lock_wait_timeout = @old_timeout;
SELECT COUNT(*) FROM t WHERE itemid = 20;

--echo # With the timeout at 0 a busy series fails at once
SET GLOBAL moosedb_unique_lock_wait_timeout = 0;
connection holder;
send INSERT INTO t SELECT 21, 100 + seq, SLEEP(IF(seq = 2, 2, 0)), 1 FROM seq_1_to_2;
connection default;
--let $sleeping_like= INSERT INTO t SELECT 21,%
--let $sleeping_n= 1
--source suite/moosedb/include/wait_statement_sleeping.inc
connection waiter;
--error ER_LOCK_WAIT_TIMEOUT
INSERT INTO t VALUES (21, 999, 1, 1);
connection holder;
reap;
connection default;
SET GLOBAL moosedb_unique_lock_wait_timeout = @old_timeout;

--echo ##################################################################
--echo # KILL QUERY of a statement that waits for a series
--echo ##################################################################
connection holder;
send INSERT INTO t SELECT 30, 100 + seq, SLEEP(IF(seq = 2, 4, 0)), 1 FROM seq_1_to_2;
connection default;
--let $sleeping_like= INSERT INTO t SELECT 30,%
--let $sleeping_n= 1
--source suite/moosedb/include/wait_statement_sleeping.inc
connection waiter;
let $waiter_id= `SELECT CONNECTION_ID()`;
send INSERT INTO t VALUES (30, 999, 1, 1);
connection default;
let $wait_condition= SELECT COUNT(*) = 1 FROM information_schema.PROCESSLIST WHERE ID = $waiter_id AND INFO LIKE 'INSERT INTO t VALUES (30%';
--source include/wait_condition.inc
--replace_result $waiter_id <waiter>
eval KILL QUERY $waiter_id;
connection waiter;
--error ER_QUERY_INTERRUPTED
reap;
connection holder;
reap;
connection default;
SELECT COUNT(*) AS rows_of_30 FROM t WHERE itemid = 30;
INSERT INTO t VALUES (30, 999, 1, 1);

--echo ##################################################################
--echo # Two statements that each hold the series the other one needs
--echo ##################################################################
connection holder;
send INSERT INTO t SELECT 40 + seq - 1, 100, SLEEP(IF(seq = 2, 6, 0)), 1 FROM seq_1_to_2;
connection waiter;
send INSERT INTO t SELECT 42 - seq, 200, SLEEP(IF(seq = 2, 6, 0)), 1 FROM seq_1_to_2;
connection default;
--let $sleeping_like= INSERT INTO t SELECT 4%
--let $sleeping_n= 2
--source suite/moosedb/include/wait_statement_sleeping.inc
connection holder;
--disable_result_log
--error 0,ER_LOCK_DEADLOCK
reap;
connection waiter;
--error 0,ER_LOCK_DEADLOCK
reap;
--enable_result_log
connection default;
--echo # (each statement wrote its first row; the one that closed the cycle lost its second row)
SELECT COUNT(*) AS rows_written FROM t WHERE itemid IN (40, 41);

--echo ##################################################################
--echo # unique_checks = 0 does not wait for anybody
--echo ##################################################################
connection holder;
send INSERT INTO t SELECT 50, 100 + seq, SLEEP(IF(seq = 2, 6, 0)), 1 FROM seq_1_to_2;
connection default;
--let $sleeping_like= INSERT INTO t SELECT 50,%
--let $sleeping_n= 1
--source suite/moosedb/include/wait_statement_sleeping.inc
connection waiter;
SET unique_checks = 0;
INSERT INTO t VALUES (50, 999, 1, 1);
--echo # the holder is still asleep: this insert did not wait for it
SELECT COUNT(*) AS holder_still_sleeping FROM information_schema.PROCESSLIST WHERE INFO LIKE 'INSERT INTO t SELECT 50,%' AND STATE = 'User sleep';
SET unique_checks = 1;
connection holder;
reap;
connection default;
SELECT COUNT(*) AS rows_of_50 FROM t WHERE itemid = 50;

--echo ##################################################################
--echo # Three sessions inserting overlapping keys, all starting on the same series: each key is stored once
--echo ##################################################################
connection default;
CREATE TABLE ov (itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', clock INT NOT NULL, ns INT NOT NULL,
                 PRIMARY KEY (itemid, clock, ns)) ENGINE=MooseDB TIMESTAMP_COLUMN='clock' MEMTABLE_SIZE=1048576;
CREATE TABLE ov_i (itemid BIGINT UNSIGNED NOT NULL, clock INT NOT NULL, ns INT NOT NULL, PRIMARY KEY (itemid, clock, ns)) ENGINE=InnoDB;
--disable_warnings
connection holder;
send INSERT IGNORE INTO ov SELECT 1 + seq MOD 5, 1000 + seq DIV 5, 1 FROM seq_1_to_40000;
connection waiter;
send INSERT IGNORE INTO ov SELECT 1 + seq MOD 5, 1000 + (40001 - seq) DIV 5, 1 FROM seq_1_to_40000;
connection other;
INSERT IGNORE INTO ov SELECT 1 + seq MOD 5, 1000 + (seq * 7) MOD 8000, 1 FROM seq_1_to_40000;
connection holder;
reap;
connection waiter;
reap;
connection default;
SELECT COUNT(*) AS rows_stored, COUNT(DISTINCT itemid, clock, ns) AS distinct_keys FROM ov;
--echo # the same three statements, one after the other, on InnoDB
INSERT IGNORE INTO ov_i SELECT 1 + seq MOD 5, 1000 + seq DIV 5, 1 FROM seq_1_to_40000;
INSERT IGNORE INTO ov_i SELECT 1 + seq MOD 5, 1000 + (40001 - seq) DIV 5, 1 FROM seq_1_to_40000;
INSERT IGNORE INTO ov_i SELECT 1 + seq MOD 5, 1000 + (seq * 7) MOD 8000, 1 FROM seq_1_to_40000;
--enable_warnings
SELECT (SELECT COUNT(*) FROM ov) = (SELECT COUNT(*) FROM ov_i) AS same_row_count,
       (SELECT BIT_XOR(CRC32(CONCAT(itemid, '|', clock, '|', ns))) FROM ov) = (SELECT BIT_XOR(CRC32(CONCAT(itemid, '|', clock, '|', ns))) FROM ov_i) AS same_keys;

disconnect holder;
disconnect waiter;
disconnect other;
connection default;
DROP TABLE t, ov, ov_i;
