#
# System variables: scope, validation, limits and their effect on a running
# table. Every variable is restored at the end.
#
--source include/not_embedded.inc
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc


--echo # ---- Scope: global-only, except the GROUP BY pushdown session variables ----
--error ER_GLOBAL_VARIABLE
SET SESSION moosedb_wal_sync_mode = 'write';
--error ER_GLOBAL_VARIABLE
SET moosedb_max_open_chunks = 5;
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@SESSION.moosedb_chunk_cache_size;
SELECT @@GLOBAL.moosedb_chunk_cache_size = @@moosedb_chunk_cache_size;

--echo # ---- moosedb_compaction_threads is read-only ----
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SET GLOBAL moosedb_compaction_threads = 4;
SELECT @@GLOBAL.moosedb_compaction_threads;

--echo # ---- moosedb_wal_sync_mode (ENUM) ----
SET GLOBAL moosedb_wal_sync_mode = 'write';
SELECT @@GLOBAL.moosedb_wal_sync_mode;
SET GLOBAL moosedb_wal_sync_mode = 'FSYNC';
SELECT @@GLOBAL.moosedb_wal_sync_mode;
SET GLOBAL moosedb_wal_sync_mode = 0;
SELECT @@GLOBAL.moosedb_wal_sync_mode;
SET GLOBAL moosedb_wal_sync_mode = 1;
SELECT @@GLOBAL.moosedb_wal_sync_mode;
--error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL moosedb_wal_sync_mode = 'none';
--error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL moosedb_wal_sync_mode = 7;
--error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL moosedb_wal_sync_mode = '';
--error ER_WRONG_TYPE_FOR_VAR
SET GLOBAL moosedb_wal_sync_mode = 1.5;
SET GLOBAL moosedb_wal_sync_mode = DEFAULT;
SELECT @@GLOBAL.moosedb_wal_sync_mode;

--echo # ---- Numeric limits: out-of-range values are clamped with a warning ----
SET GLOBAL moosedb_max_open_chunks = 0;
SELECT @@GLOBAL.moosedb_max_open_chunks;
SET GLOBAL moosedb_max_open_chunks = 100000000;
SELECT @@GLOBAL.moosedb_max_open_chunks;
--error ER_WRONG_TYPE_FOR_VAR
SET GLOBAL moosedb_max_open_chunks = 'many';
--error ER_WRONG_TYPE_FOR_VAR
SET GLOBAL moosedb_max_open_chunks = 1.5;
SET GLOBAL moosedb_max_open_chunks = -1;
SELECT @@GLOBAL.moosedb_max_open_chunks;
SET GLOBAL moosedb_compaction_trigger_chunks = 1;
SELECT @@GLOBAL.moosedb_compaction_trigger_chunks;
SET GLOBAL moosedb_compaction_trigger_chunks = 99999;
SELECT @@GLOBAL.moosedb_compaction_trigger_chunks;
SET GLOBAL moosedb_memtable_flush_threshold = 100;
SELECT @@GLOBAL.moosedb_memtable_flush_threshold;
SET GLOBAL moosedb_memtable_flush_threshold = 1073741824;
SELECT @@GLOBAL.moosedb_memtable_flush_threshold;
SET GLOBAL moosedb_bloom_filter_false_positive_rate = 0;
SELECT @@GLOBAL.moosedb_bloom_filter_false_positive_rate;
SET GLOBAL moosedb_bloom_filter_false_positive_rate = 0.9;
SELECT @@GLOBAL.moosedb_bloom_filter_false_positive_rate;
SET GLOBAL moosedb_bloom_filter_false_positive_rate = -0.5;
SELECT @@GLOBAL.moosedb_bloom_filter_false_positive_rate;
SET GLOBAL moosedb_bloom_filter_false_positive_rate = 0.25;
SELECT @@GLOBAL.moosedb_bloom_filter_false_positive_rate;
SET GLOBAL moosedb_retention_check_interval = 0;
SELECT @@GLOBAL.moosedb_retention_check_interval;
SET GLOBAL moosedb_retention_check_interval = 4294967295;
SELECT @@GLOBAL.moosedb_retention_check_interval;
SET GLOBAL moosedb_chunk_cache_size = 0;
SELECT @@GLOBAL.moosedb_chunk_cache_size;
SET GLOBAL moosedb_chunk_cache_size = 18446744073709551615;
SELECT @@GLOBAL.moosedb_chunk_cache_size;
SET GLOBAL moosedb_chunk_cache_size = DEFAULT;
SELECT @@GLOBAL.moosedb_chunk_cache_size;
SET GLOBAL moosedb_batch_memory_budget = 1;
SELECT @@GLOBAL.moosedb_batch_memory_budget;
SET GLOBAL moosedb_batch_memory_budget = 18446744073709551615;
SELECT @@GLOBAL.moosedb_batch_memory_budget;
SET GLOBAL moosedb_batch_memory_budget = DEFAULT;
SELECT @@GLOBAL.moosedb_batch_memory_budget;
SET GLOBAL moosedb_max_open_chunks = DEFAULT, moosedb_compaction_trigger_chunks = DEFAULT,
           moosedb_memtable_flush_threshold = DEFAULT, moosedb_bloom_filter_false_positive_rate = DEFAULT,
           moosedb_retention_check_interval = DEFAULT;
SELECT @@GLOBAL.moosedb_max_open_chunks, @@GLOBAL.moosedb_compaction_trigger_chunks,
       @@GLOBAL.moosedb_memtable_flush_threshold, @@GLOBAL.moosedb_bloom_filter_false_positive_rate,
       @@GLOBAL.moosedb_retention_check_interval;

--echo # ---- GROUP BY pushdown variables ----
SELECT @@GLOBAL.moosedb_group_by_pushdown, @@SESSION.moosedb_group_by_pushdown;
SET SESSION moosedb_group_by_pushdown = ON;
SELECT @@SESSION.moosedb_group_by_pushdown;
SET SESSION moosedb_group_by_pushdown = DEFAULT;
SELECT @@SESSION.moosedb_group_by_pushdown;
--error ER_WRONG_VALUE_FOR_VAR
SET SESSION moosedb_group_by_pushdown = 'maybe';
SELECT @@GLOBAL.moosedb_gbh_debug, @@SESSION.moosedb_gbh_debug;
SELECT @@SESSION.moosedb_agg_max_memory = 1073741824 AS default_1gib;
SET SESSION moosedb_agg_max_memory = 1;
SELECT @@SESSION.moosedb_agg_max_memory;
SET SESSION moosedb_agg_max_memory = 18446744073709551615;
SELECT @@SESSION.moosedb_agg_max_memory;
SET SESSION moosedb_agg_max_memory = 2147483648;
SELECT @@SESSION.moosedb_agg_max_memory;
SET SESSION moosedb_agg_max_memory = DEFAULT;
SELECT @@SESSION.moosedb_agg_max_memory = 1073741824 AS back_to_default;
--error ER_INCORRECT_GLOBAL_LOCAL_VAR
SELECT @@SESSION.moosedb_agg_threads;
--error ER_GLOBAL_VARIABLE
SET SESSION moosedb_agg_threads = 2;
SELECT @@GLOBAL.moosedb_agg_threads BETWEEN 1 AND 4 AS default_in_1_4;
SET GLOBAL moosedb_agg_threads = 0;
SELECT @@GLOBAL.moosedb_agg_threads;
SET GLOBAL moosedb_agg_threads = 1000;
SELECT @@GLOBAL.moosedb_agg_threads;
SET GLOBAL moosedb_agg_threads = 3;
SELECT @@GLOBAL.moosedb_agg_threads;
SET GLOBAL moosedb_agg_threads = DEFAULT;
SELECT @@GLOBAL.moosedb_agg_threads BETWEEN 1 AND 4 AS default_in_1_4;

--echo # ---- Variables listed in the server's catalogue ----
SELECT VARIABLE_NAME, VARIABLE_SCOPE, VARIABLE_TYPE, READ_ONLY, NUMERIC_MIN_VALUE, NUMERIC_MAX_VALUE
  FROM information_schema.SYSTEM_VARIABLES WHERE VARIABLE_NAME LIKE 'MOOSEDB%' ORDER BY VARIABLE_NAME;

--echo # ---- Effects on a running table ----
CREATE TABLE s (ts DATETIME NOT NULL, host VARCHAR(8) NOT NULL COMMENT 'TAG', v INT, INDEX(ts))
  ENGINE=MooseDB CHUNK_INTERVAL='1 HOUR';
--echo # 60 chunks, queried with a 1-descriptor cache and no block cache
INSERT INTO s SELECT '2026-05-01' + INTERVAL seq * 30 MINUTE, CONCAT('h', seq MOD 4), seq FROM seq_0_to_119;
FLUSH TABLES s;
SET GLOBAL moosedb_max_open_chunks = 1;
SET GLOBAL moosedb_chunk_cache_size = 0;
SELECT COUNT(*), SUM(v), COUNT(DISTINCT host) FROM s;
SELECT host, COUNT(*) FROM s WHERE ts BETWEEN '2026-05-01 10:00:00' AND '2026-05-02 02:00:00' GROUP BY host ORDER BY host;
SELECT ts FROM s ORDER BY ts DESC LIMIT 3;
SELECT v FROM s WHERE v BETWEEN 50 AND 52 ORDER BY v DESC;
CHECK TABLE s;
SET GLOBAL moosedb_chunk_cache_size = 4096;
SELECT COUNT(*), SUM(v) FROM s;
SET GLOBAL moosedb_max_open_chunks = DEFAULT;
SET GLOBAL moosedb_chunk_cache_size = DEFAULT;
SELECT COUNT(*), SUM(v) FROM s;

--echo # MemTable threshold applies to tables opened afterwards
SET GLOBAL moosedb_memtable_flush_threshold = 1048576;
CREATE TABLE small (ts DATETIME NOT NULL, v BIGINT, INDEX(ts)) ENGINE=MooseDB CHUNK_INTERVAL='1 MONTH';
FLUSH TABLES;
INSERT INTO small SELECT '2026-05-01' + INTERVAL seq SECOND, seq FROM seq_0_to_199999;
SELECT SUM(PENDING_ROWS) < 200000 AS flushed_by_threshold, COUNT(*) FROM information_schema.MOOSEDB_TABLES WHERE TABLE_NAME = 'small';
SELECT COUNT(*), SUM(v) FROM small;
SET GLOBAL moosedb_memtable_flush_threshold = DEFAULT;
--echo # An explicit MEMTABLE_SIZE wins over the variable
--echo # MEMTABLE_SIZE above 96 MiB is refused (a flushed block must stay below 256 MiB)
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE big (ts DATETIME NOT NULL, v BIGINT, INDEX(ts)) ENGINE=MooseDB CHUNK_INTERVAL='1 MONTH' MEMTABLE_SIZE=1073741824;
CREATE TABLE big (ts DATETIME NOT NULL, v BIGINT, INDEX(ts)) ENGINE=MooseDB CHUNK_INTERVAL='1 MONTH' MEMTABLE_SIZE=50331648;
SET GLOBAL moosedb_memtable_flush_threshold = 1048576;
FLUSH TABLES;
INSERT INTO big SELECT '2026-05-01' + INTERVAL seq SECOND, seq FROM seq_0_to_199999;
SELECT PENDING_ROWS, CHUNKS FROM information_schema.MOOSEDB_TABLES WHERE TABLE_NAME = 'big';
SET GLOBAL moosedb_memtable_flush_threshold = DEFAULT;

--echo # WAL sync mode 'write': rows are still visible, durable across a mysqld crash
SET GLOBAL moosedb_wal_sync_mode = 'write';
CREATE TABLE w (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=MooseDB;
INSERT INTO w SELECT '2026-05-01' + INTERVAL seq SECOND, seq FROM seq_1_to_500;
LOCK TABLES w WRITE;
INSERT INTO w VALUES ('2026-06-01', 0);
UNLOCK TABLES;
SELECT COUNT(*), SUM(v) FROM w;
--source include/kill_mysqld.inc
--source include/start_mysqld.inc
SELECT @@GLOBAL.moosedb_wal_sync_mode;
SELECT COUNT(*), SUM(v) FROM w;
SELECT COUNT(*) FROM s;
CHECK TABLE w;

--echo # retention_check_interval = 0 disables background sweeps
CREATE TABLE r (ts DATETIME NOT NULL, v INT, INDEX(ts)) ENGINE=MooseDB RETENTION_PERIOD='30 DAYS';
INSERT INTO r VALUES (NOW() - INTERVAL 200 DAY, 1), (NOW(), 2);
FLUSH TABLES r;
SET GLOBAL moosedb_retention_check_interval = 0;
SELECT COUNT(*) FROM r;
--sleep 3
SELECT COUNT(*) FROM r;
SET GLOBAL moosedb_retention_check_interval = DEFAULT;
OPTIMIZE TABLE r;
SELECT COUNT(*) FROM r;

--echo # Variables survive in SHOW VARIABLES with their current values
SET GLOBAL moosedb_max_open_chunks = 77;
SHOW GLOBAL VARIABLES LIKE 'moosedb_max_open_chunks';
SHOW SESSION VARIABLES LIKE 'moosedb_max_open_chunks';
SET GLOBAL moosedb_max_open_chunks = DEFAULT;

DROP TABLE s, small, big, w, r;
SET GLOBAL moosedb_wal_sync_mode = DEFAULT;
SET GLOBAL moosedb_memtable_flush_threshold = DEFAULT;
SET GLOBAL moosedb_compaction_trigger_chunks = DEFAULT;
SET GLOBAL moosedb_retention_check_interval = DEFAULT;
SET GLOBAL moosedb_bloom_filter_false_positive_rate = DEFAULT;
SET GLOBAL moosedb_chunk_cache_size = DEFAULT;
SET GLOBAL moosedb_max_open_chunks = DEFAULT;
SET GLOBAL moosedb_batch_memory_budget = DEFAULT;
