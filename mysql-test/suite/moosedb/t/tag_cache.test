#
# TAG pushdown cache: the per-collation value index is built incrementally
# from the series list (append-only) and dropped on TRUNCATE. Every step is
# checked against a MyISAM oracle holding the same rows, plus collation
# stress (PAD SPACE trailing blanks, _ci with accents, bin, nopad, latin1,
# emoji) over many series and large IN lists.
#
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc
--echo # this test counts handler calls / reads EXPLAIN of the scan path: the GROUP BY pushdown (default ON) would bypass it
SET SESSION moosedb_group_by_pushdown = OFF;
SET NAMES utf8mb4;

CREATE TABLE tf (
    ts  DATETIME NOT NULL,
    ci  VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci COMMENT 'TAG',
    uni VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci COMMENT 'TAG',
    bin VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin COMMENT 'TAG',
    np  VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_nopad_bin COMMENT 'TAG',
    ch  CHAR(8) CHARACTER SET latin1 COMMENT 'TAG',
    n   INT,
    INDEX(ts)
) ENGINE=MooseDB;
CREATE TABLE ctl LIKE tf;
ALTER TABLE ctl ENGINE=MyISAM;

DELIMITER //;
CREATE PROCEDURE cmp(p TEXT CHARACTER SET utf8mb4)
BEGIN
  EXECUTE IMMEDIATE CONCAT('SELECT CONCAT(COUNT(*), ''/'', IFNULL(SUM(n), 0)) INTO @a FROM tf WHERE ', p);
  EXECUTE IMMEDIATE CONCAT('SELECT CONCAT(COUNT(*), ''/'', IFNULL(SUM(n), 0)) INTO @b FROM ctl WHERE ', p);
  SELECT IF(@a = @b, 'OK', 'FAIL') AS status, p AS predicate, @a AS moosedb, @b AS control;
END//
CREATE PROCEDURE cmpq(lbl VARCHAR(40), p TEXT CHARACTER SET utf8mb4)
BEGIN
  EXECUTE IMMEDIATE CONCAT('SELECT CONCAT(COUNT(*), ''/'', IFNULL(SUM(n), 0)) INTO @a FROM tf WHERE ', p);
  EXECUTE IMMEDIATE CONCAT('SELECT CONCAT(COUNT(*), ''/'', IFNULL(SUM(n), 0)) INTO @b FROM ctl WHERE ', p);
  SELECT IF(@a = @b, 'OK', 'FAIL') AS status, lbl AS predicate, @a AS moosedb, @b AS control;
END//
CREATE PROCEDURE sweep()
BEGIN
  CALL cmp("ci = 'abc'");
  CALL cmp("ci IN ('ABC ', 'ñandu', 'zzz', '😀')");
  CALL cmp("uni = 'ABÇ'");
  CALL cmp("uni IN ('nandu', 'STRASSE', '')");
  CALL cmp("bin = 'abc'");
  CALL cmp("bin IN ('abc ', 'abc  ', 'ABC')");
  CALL cmp("np = 'abc '");
  CALL cmp("np IN ('abc', 'abc  ', '')");
  CALL cmp("ch IN ('abc', 'N', 's  ')");
  CALL cmp("ci = 'abc' AND ch = 'ABC'");
  CALL cmp("ci = 'abc' COLLATE utf8mb4_bin");
  CALL cmp("ci = 'abc ' COLLATE utf8mb4_general_nopad_ci");
END//
DELIMITER ;//

let $rows=
('2026-01-01 00:00:01', 'abc',   'abc',  'abc',   'abc',   'abc',  1),
('2026-01-01 00:00:02', 'ABC',   'ÀBC',  'ABC',   'ABC',   'ABC',  2),
('2026-01-01 00:00:03', 'abc ',  'abc ', 'abc ',  'abc ',  'abc ', 3),
('2026-01-01 00:00:04', 'abc  ', 'abç',  'abc  ', 'abc  ', 'N',    4),
('2026-01-01 00:00:05', '',      '',     '',      '',      '',     5),
('2026-01-01 00:00:06', 'ñandu', 'NANDU','ñandú', 'ñandú', 's',    6),
('2026-01-01 00:00:07', '😀',    '😀',   '😀',    '😀',    NULL,   7),
('2026-01-01 00:00:08', 'Straße','STRASSE','Straße','Straße','x',   8);
eval INSERT INTO tf VALUES $rows;
eval INSERT INTO ctl VALUES $rows;

--echo # 1. first use builds the indexes
CALL sweep();

--echo # 2. new series appended: only the tail is indexed, old ones stay found
INSERT INTO tf VALUES ('2026-01-02 00:00:01', 'ABC   ', 'abç ', 'abc', 'abc ', 'abc', 100), ('2026-01-02 00:00:02', 'zzz', 'Ñandu', 'new', 'abc  ', 'n', 101);
INSERT INTO ctl VALUES ('2026-01-02 00:00:01', 'ABC   ', 'abç ', 'abc', 'abc ', 'abc', 100), ('2026-01-02 00:00:02', 'zzz', 'Ñandu', 'new', 'abc  ', 'n', 101);
CALL sweep();

--echo # 3. flushed chunk + new series after the flush
FLUSH TABLES tf;
INSERT INTO tf VALUES ('2026-01-03 00:00:01', 'abc', 'abc', 'abc  ', 'abc', 'zz', 200);
INSERT INTO ctl VALUES ('2026-01-03 00:00:01', 'abc', 'abc', 'abc  ', 'abc', 'zz', 200);
CALL sweep();

--echo # 4. TRUNCATE drops the cache (an empty table is queried in between)
TRUNCATE TABLE tf;
TRUNCATE TABLE ctl;
CALL sweep();
let $rows=
('2026-02-01 00:00:01', 'xyz',   'xyz',  'xyz',   'xyz',   'xyz',  1),
('2026-02-01 00:00:02', 'abc ',  'abc',  'abc',   'abc ',  'abc',  2),
('2026-02-01 00:00:03', 'Ñandu', 'ñandú','ñandú', 'abc  ', 'n',    3),
('2026-02-01 00:00:04', '😀',    '😀',   '😀',    '😀',    's',    4);
eval INSERT INTO tf VALUES $rows;
eval INSERT INTO ctl VALUES $rows;
CALL sweep();
INSERT INTO tf VALUES ('2026-02-02 00:00:01', 'abc', 'abc', 'abc', 'abc', 'abc', 50);
INSERT INTO ctl VALUES ('2026-02-02 00:00:01', 'abc', 'abc', 'abc', 'abc', 'abc', 50);
CALL sweep();

--echo # 5. many series and a large IN list (collation-equivalent values)
TRUNCATE TABLE tf;
TRUNCATE TABLE ctl;
INSERT INTO tf SELECT '2026-03-01' + INTERVAL seq SECOND, CONCAT('Host', seq), CONCAT('hôst', seq MOD 5000), CONCAT('h', seq MOD 777, IF(seq MOD 3 = 0, ' ', '')), CONCAT('h', seq MOD 50), CONCAT('c', seq MOD 90), seq FROM seq_0_to_9999;
INSERT INTO ctl SELECT * FROM tf;
SELECT COUNT(*) FROM tf;
SELECT CONCAT(GROUP_CONCAT(CONCAT('\'HOST', seq, ' \', \'HÔST', seq, '\', \'h', seq, '  \'') SEPARATOR ', '), ', \'nope\'') INTO @in FROM seq_0_to_119;
CALL cmpq('ci IN big list', CONCAT('ci IN (', @in, ')'));
CALL cmpq('uni IN big list', CONCAT('uni IN (', @in, ')'));
CALL cmpq('bin IN big list', CONCAT('bin IN (', @in, ')'));
CALL cmpq('np IN big list', CONCAT('np IN (', @in, ')'));
CALL cmpq('ci IN big list AND ch', CONCAT('ci IN (', @in, ') AND ch IN (\'C1\', \'c2 \', \'c7\')'));
CALL cmp("uni = 'HOST5' OR ci = 'host5'");
INSERT INTO tf SELECT '2026-04-01' + INTERVAL seq SECOND, CONCAT('host', seq), CONCAT('HÔST', seq), 'zz', 'zz', 'zz', seq + 100000 FROM seq_0_to_199;
INSERT INTO ctl SELECT * FROM tf WHERE n >= 100000;
CALL cmpq('ci IN big list after append', CONCAT('ci IN (', @in, ')'));
CALL cmpq('uni IN big list after append', CONCAT('uni IN (', @in, ')'));
CALL cmp("ci = 'HOST150' AND uni = 'hôst150'");

--echo # 6. pruning still happens (few rows read for one series)
FLUSH STATUS;
SELECT COUNT(*) FROM tf WHERE np = 'h7';
SHOW SESSION STATUS LIKE 'Handler_read_rnd_next';

--echo # 7. TRUNCATE with a warm cache and the same number of series, no query
--echo #    in between: only the log identity (epoch) can tell the lists apart
TRUNCATE TABLE tf;
TRUNCATE TABLE ctl;
INSERT INTO tf VALUES ('2026-05-01 00:00:01', 'aaa', 'aaa', 'aaa', 'aaa', 'a', 1), ('2026-05-01 00:00:02', 'bbb', 'bbb', 'bbb', 'bbb', 'b', 2);
INSERT INTO ctl SELECT * FROM tf;
CALL cmp("ci IN ('aaa', 'bbb')");
TRUNCATE TABLE tf;
TRUNCATE TABLE ctl;
INSERT INTO tf VALUES ('2026-05-02 00:00:01', 'bbb', 'bbb', 'bbb', 'bbb', 'b', 10), ('2026-05-02 00:00:02', 'ccc', 'ccc', 'ccc', 'ccc', 'c', 20);
INSERT INTO ctl SELECT * FROM tf;
CALL cmp("ci IN ('aaa', 'bbb')");
CALL cmp("ci = 'ccc'");
CALL cmp("uni IN ('AAA', 'ccc')");

DROP PROCEDURE cmp;
DROP PROCEDURE cmpq;
DROP PROCEDURE sweep;
DROP TABLE tf, ctl;

--echo # 8. expansions, contractions, ignorables and other collation families
CREATE TABLE tx (
    ts  DATETIME NOT NULL,
    uni VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci COMMENT 'TAG',
    u14 VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_uca1400_ai_ci COMMENT 'TAG',
    de  VARCHAR(32) CHARACTER SET latin1 COLLATE latin1_german2_ci COMMENT 'TAG',
    cz  VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_czech_ci COMMENT 'TAG',
    u16 VARCHAR(32) CHARACTER SET utf16 COLLATE utf16_general_ci COMMENT 'TAG',
    n   INT,
    INDEX(ts)
) ENGINE=MooseDB;
CREATE TABLE cx LIKE tx;
ALTER TABLE cx ENGINE=MyISAM;
DELIMITER //;
CREATE PROCEDURE cmpx(p TEXT CHARACTER SET utf8mb4)
BEGIN
  EXECUTE IMMEDIATE CONCAT('SELECT CONCAT(COUNT(*), ''/'', IFNULL(SUM(n), 0)) INTO @a FROM tx WHERE ', p);
  EXECUTE IMMEDIATE CONCAT('SELECT CONCAT(COUNT(*), ''/'', IFNULL(SUM(n), 0)) INTO @b FROM cx WHERE ', p);
  SELECT IF(@a = @b, 'OK', 'FAIL') AS status, p AS predicate, @a AS moosedb, @b AS control;
END//
DELIMITER ;//
# U+200B zero-width space = E2808B, U+00AD soft hyphen = C2AD
let $rows=
('2026-06-01 00:00:01', 'Straße', 'Straße', 'Straße', 'chata', 'Straße', 1),
('2026-06-01 00:00:02', 'STRASSE', 'strasse', 'STRASSE', 'hata', 'strasse', 2),
('2026-06-01 00:00:03', 'Mädchen', 'Madchen', 'Maedchen', 'cHata', 'MÄDCHEN', 3),
('2026-06-01 00:00:04', CONCAT('ab', _utf8mb4 X'E2808B', 'c'), CONCAT('ab', _utf8mb4 X'C2AD', 'c'), 'abc', 'ch', 'abc ', 4),
('2026-06-01 00:00:05', 'abc', 'abc', 'äbc', 'c', CONCAT('abc', _utf8mb4 X'E2808B'), 5),
('2026-06-01 00:00:06', 'æ', 'ae', 'ä', 'h', 'ß', 6);
eval INSERT INTO tx VALUES $rows;
eval INSERT INTO cx VALUES $rows;
CALL cmpx("uni = 'strasse'");
CALL cmpx("uni IN ('STRAßE', 'abc', 'ae')");
CALL cmpx("u14 IN ('STRASSE', 'MÄDCHEN', 'abc', 'AE')");
CALL cmpx("de IN ('strasse', 'MAEDCHEN', 'AEBC', 'ae')");
CALL cmpx("cz IN ('CHATA', 'ch', 'c', 'h')");
CALL cmpx("u16 IN ('STRASSE', 'mädchen', 'abc', 'ss')");
CALL cmpx(CONCAT("uni = 'ab", _utf8mb4 X'E2808B', "c'"));
INSERT INTO tx VALUES ('2026-06-02 00:00:01', 'strasse', 'STRAßE', 'straße', 'CH', 'STRASSE', 100);
INSERT INTO cx VALUES ('2026-06-02 00:00:01', 'strasse', 'STRAßE', 'straße', 'CH', 'STRASSE', 100);
CALL cmpx("uni = 'Straße' AND u14 = 'strasse'");
CALL cmpx("de = 'STRASSE' AND cz = 'ch'");
DROP PROCEDURE cmpx;
DROP TABLE tx, cx;
