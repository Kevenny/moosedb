#
# TAG pushdown against collations: utf8mb4 (emoji, accents), PAD SPACE vs
# NO PAD, trailing spaces, binary collations, empty and NULL TAG values. A
# MyISAM table with the same rows is the oracle: every predicate must return
# exactly the same count on both tables, whether or not it is pushed down.
#
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc
--echo # this test counts handler calls / reads EXPLAIN of the scan path: the GROUP BY pushdown (default ON) would bypass it
SET SESSION moosedb_group_by_pushdown = OFF;
SET NAMES utf8mb4;

CREATE TABLE tf (
    ts   DATETIME NOT NULL,
    ci   VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL COMMENT 'TAG',
    uni  VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci COMMENT 'TAG',
    bin  VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin COMMENT 'TAG',
    np   VARCHAR(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_nopad_bin COMMENT 'TAG',
    ch   CHAR(8) CHARACTER SET latin1 COMMENT 'TAG',
    n    INT,
    INDEX(ts)
) ENGINE=MooseDB;
CREATE TABLE ctl LIKE tf;
ALTER TABLE ctl ENGINE=MyISAM;

let $rows=
('2026-01-01 00:00:01', 'abc',    'abc',    'abc',    'abc',    'abc',    1),
('2026-01-01 00:00:02', 'ABC',    'ÀBC',    'ABC',    'ABC',    'ABC',    2),
('2026-01-01 00:00:03', 'abc ',   'abc ',   'abc ',   'abc ',   'abc ',   3),
('2026-01-01 00:00:04', 'abc  ',  'abç',    'abc  ',  'abc  ',  'abc  ',  4),
('2026-01-01 00:00:05', '',       '',       '',       '',       '',       5),
('2026-01-01 00:00:06', ' ',      ' ',      ' ',      ' ',      ' ',      6),
('2026-01-01 00:00:07', '😀',     '😀',     '😀',     '😀',     '?',      7),
('2026-01-01 00:00:08', '🚀',     '🚀',     '🚀',     '🚀',     NULL,     8),
('2026-01-01 00:00:09', 'ñandú',  'NANDU',  'ñandú',  'ñandú',  'n',      9),
('2026-01-01 00:00:10', 'Straße', 'STRASSE','Straße', 'Straße', 's',      10),
('2026-01-01 00:00:11', 'a\tb',   NULL,     NULL,     NULL,     NULL,     11),
('2026-01-01 00:00:12', '日本語', '日本語', '日本語', '日本語', 'x',      12);
eval INSERT INTO tf VALUES $rows;
eval INSERT INTO ctl VALUES $rows;
--echo # Second copy of the data in a sealed chunk
FLUSH TABLES tf;
INSERT INTO tf SELECT ts + INTERVAL 1 DAY, ci, uni, bin, np, ch, n + 100 FROM ctl;
INSERT INTO ctl SELECT ts + INTERVAL 1 DAY, ci, uni, bin, np, ch, n + 100 FROM ctl;

--echo # Number of distinct series seen through each collation
SELECT COUNT(*) FROM tf;
SELECT COUNT(DISTINCT ci), COUNT(DISTINCT uni), COUNT(DISTINCT bin), COUNT(DISTINCT np), COUNT(DISTINCT ch) FROM tf;
SELECT COUNT(DISTINCT ci), COUNT(DISTINCT uni), COUNT(DISTINCT bin), COUNT(DISTINCT np), COUNT(DISTINCT ch) FROM ctl;

--echo # Each CALL runs one predicate on tf and on ctl: status, predicate, tf count/sum(n), ctl count/sum(n)
DELIMITER //;
CREATE PROCEDURE cmp(p TEXT CHARACTER SET utf8mb4)
BEGIN
  EXECUTE IMMEDIATE CONCAT('SELECT CONCAT(COUNT(*), ''/'', IFNULL(SUM(n), 0)) INTO @a FROM tf WHERE ', p);
  EXECUTE IMMEDIATE CONCAT('SELECT CONCAT(COUNT(*), ''/'', IFNULL(SUM(n), 0)) INTO @b FROM ctl WHERE ', p);
  SELECT IF(@a = @b, 'OK', 'FAIL') AS status, p AS predicate, @a AS moosedb, @b AS control;
END//
DELIMITER ;//

CALL cmp("ci = 'abc'");
CALL cmp("ci = 'ABC'");
CALL cmp("ci = 'abc  '");
CALL cmp("ci = ''");
CALL cmp("ci = ' '");
CALL cmp("ci = '😀'");
CALL cmp("ci = '🚀'");
CALL cmp("ci = 'nandu'");
CALL cmp("ci = 'ñandú'");
CALL cmp("ci = 'strasse'");
CALL cmp("ci = 'Straße'");
CALL cmp("ci IN ('abc', '😀')");
CALL cmp("ci IN ('', ' ')");
CALL cmp("ci = 'abc' COLLATE utf8mb4_bin");
CALL cmp("ci = 'abc ' COLLATE utf8mb4_bin");
CALL cmp("ci = 'abc' COLLATE utf8mb4_nopad_bin");
CALL cmp("ci = 'ABC' COLLATE utf8mb4_general_nopad_ci");
CALL cmp("ci = 'abc ' COLLATE utf8mb4_general_nopad_ci");
CALL cmp("uni = 'abc'");
CALL cmp("uni = 'ABC'");
CALL cmp("uni = 'abç'");
CALL cmp("uni = 'abc '");
CALL cmp("uni = 'nandu'");
CALL cmp("uni = 'strasse'");
CALL cmp("uni = '😀'");
CALL cmp("uni = '🚀'");
CALL cmp("uni = '😀' COLLATE utf8mb4_bin");
CALL cmp("uni IN ('abc', 'ñandú')");
CALL cmp("uni = ''");
CALL cmp("uni IS NULL");
CALL cmp("uni = NULL");
CALL cmp("bin = 'abc'");
CALL cmp("bin = 'ABC'");
CALL cmp("bin = 'abc  '");
CALL cmp("bin = ''");
CALL cmp("bin = '😀'");
CALL cmp("bin IN ('abc', 'ABC', 'abc  ')");
CALL cmp("bin = 'ABC' COLLATE utf8mb4_general_ci");
CALL cmp("bin = 'abc' COLLATE utf8mb4_unicode_ci");
CALL cmp("np = 'abc'");
CALL cmp("np = 'abc '");
CALL cmp("np = 'abc  '");
CALL cmp("np = 'abc   '");
CALL cmp("np = ''");
CALL cmp("np = ' '");
CALL cmp("np IN ('abc', 'abc ')");
CALL cmp("np = 'abc' COLLATE utf8mb4_general_ci");
CALL cmp("ch = 'abc'");
CALL cmp("ch = 'abc   '");
CALL cmp("ch = 'ABC'");
CALL cmp("ch = ''");
CALL cmp("ch = ' '");
CALL cmp("ch = '?'");
CALL cmp("ch = 'n'");
CALL cmp("ch IS NULL");
CALL cmp("ch IN ('s', 'x', 'zzz')");
CALL cmp("ch = _latin1'abc' COLLATE latin1_bin");
CALL cmp("ci = 'abc' AND uni = 'abc'");
CALL cmp("ci = 'abc' AND uni = 'ÀBC'");
CALL cmp("ci = 'abc' AND bin = 'ABC'");
CALL cmp("ci = 'abc' AND np = 'abc '");
CALL cmp("ci IN ('abc', 'xyz') AND ch IN ('abc', 'ABC')");
CALL cmp("ci = 'abc' AND n > 100");
CALL cmp("ci = 'abc' OR n = 5");
CALL cmp("NOT (ci = 'abc')");
CALL cmp("ci <> 'abc'");
CALL cmp("ci LIKE 'ab%'");
CALL cmp("ci = 'a\tb'");
CALL cmp("ci = CONCAT('ab', 'c')");
CALL cmp("ci = LOWER('ABC')");
CALL cmp("ci = ch");
DROP PROCEDURE cmp;

--echo # Pushdown must prune series even for exotic collations
FLUSH STATUS;
SELECT COUNT(*) FROM tf WHERE ci = '😀';
SHOW SESSION STATUS LIKE 'Handler_read_rnd_next';
FLUSH STATUS;
SELECT COUNT(*) FROM tf WHERE bin = 'ñandú';
SHOW SESSION STATUS LIKE 'Handler_read_rnd_next';

DROP TABLE tf, ctl;
