#
# A VARCHAR TAG whose key is longer than 255 bytes (utf8mb4 VARCHAR(64) is 256)
# is a whole-column key part, not a prefix: the engine must accept it in a
# composite index, and still refuse a real prefix.
#
--source include/not_embedded.inc
--source include/have_innodb.inc
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc

SET NAMES utf8mb4;
CREATE TABLE l64 (ts DATETIME NOT NULL, process VARCHAR(64) CHARACTER SET utf8mb4 NOT NULL COMMENT 'TAG', v INT,
                  INDEX(ts), INDEX(process, ts)) ENGINE=MooseDB;
CREATE TABLE l255 (ts DATETIME NOT NULL, process VARCHAR(255) CHARACTER SET utf8mb4 NOT NULL COMMENT 'TAG', v INT,
                   INDEX(ts), INDEX(process, ts)) ENGINE=MooseDB;
CREATE TABLE l300 (ts DATETIME NOT NULL, process VARCHAR(300) CHARACTER SET latin1 NOT NULL COMMENT 'TAG', v INT,
                   INDEX(ts), INDEX(process, ts)) ENGINE=MooseDB;
CREATE TABLE l63 (ts DATETIME NOT NULL, process VARCHAR(63) CHARACTER SET utf8mb4 NOT NULL COMMENT 'TAG', v INT,
                  INDEX(ts), INDEX(process, ts)) ENGINE=MooseDB;
SHOW CREATE TABLE l64;

--echo # a real prefix is still refused
--error ER_ILLEGAL_HA_CREATE_OPTION
CREATE TABLE lp (ts DATETIME NOT NULL, process VARCHAR(64) CHARACTER SET utf8mb4 NOT NULL COMMENT 'TAG', v INT,
                 INDEX(ts), INDEX(process(8), ts)) ENGINE=MooseDB;
SHOW WARNINGS;

INSERT INTO l64 SELECT '2024-01-01' + INTERVAL seq SECOND, CONCAT('proc-', seq MOD 5, REPEAT('é', 40)), seq FROM seq_0_to_99;
INSERT INTO l255 SELECT '2024-01-01' + INTERVAL seq SECOND, CONCAT('proc-', seq MOD 5, REPEAT('é', 200)), seq FROM seq_0_to_99;
INSERT INTO l300 SELECT '2024-01-01' + INTERVAL seq SECOND, CONCAT('proc-', seq MOD 5, REPEAT('x', 280)), seq FROM seq_0_to_99;
INSERT INTO l63 SELECT '2024-01-01' + INTERVAL seq SECOND, CONCAT('proc-', seq MOD 5), seq FROM seq_0_to_99;
FLUSH TABLES;

SELECT COUNT(*), SUM(v) FROM l64 WHERE process = CONCAT('proc-2', REPEAT('é', 40));
SELECT COUNT(*), SUM(v) FROM l255 WHERE process = CONCAT('proc-3', REPEAT('é', 200)) AND ts < '2024-01-01 00:00:50';
SELECT COUNT(*), SUM(v) FROM l300 WHERE process = CONCAT('proc-4', REPEAT('x', 280));
SELECT COUNT(*), SUM(v) FROM l63 WHERE process = 'proc-1';
EXPLAIN SELECT COUNT(*) FROM l64 WHERE process = CONCAT('proc-2', REPEAT('é', 40));
SELECT COUNT(*) AS groups_l64 FROM (SELECT process FROM l64 GROUP BY process) x;

DROP TABLE l64, l255, l300, l63;
