--echo # A VARCHAR TAG compared with a number is NOT pushed: the server compares as DOUBLE ('h1' = 0)
--let $tail= WHERE host = 0
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE host = 1
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE host IN (0, 1)
--source suite/moosedb/include/mirror_cmp.inc
--echo # ... while a string constant on it is still pushed
--let $tail= WHERE host = 'h1'
--source suite/moosedb/include/mirror_cmp.inc

--echo # Combined with the timestamp index
--let $tail= WHERE itemid = 123 AND ts BETWEEN '2026-03-02 00:00:30' AND '2026-03-02 00:02:00'
--source suite/moosedb/include/mirror_cmp.inc

DROP TABLE mx, ix;

--echo ##################################################################
--echo # VARCHAR TAG holding numeric-looking text, compared with numbers
--echo ##################################################################
--let $mt= vt
--let $it= vi
--let $sel= COUNT(*), SUM(v), BIT_XOR(CRC32(CONCAT(tagv, '|', v)))
CREATE TABLE vt (ts DATETIME NOT NULL, tagv VARCHAR(16) NOT NULL COMMENT 'TAG', v INT NOT NULL, INDEX(ts))
  ENGINE=MooseDB DEFAULT CHARSET=latin1;
CREATE TABLE vi (ts DATETIME NOT NULL, tagv VARCHAR(16) NOT NULL, v INT NOT NULL, KEY(ts))
  ENGINE=InnoDB DEFAULT CHARSET=latin1;
--let $row= SELECT '2026-03-03 00:00:00' + INTERVAL seq SECOND, ELT(1 + seq MOD 12, '123', '0123', ' 12', '12abc', 'abc', '', '0', '1e2', '100', '123.0', '-5', '5'), seq FROM seq_0_to_59
eval INSERT INTO vt $row;
eval INSERT INTO vi $row;
--echo # '0123' = 123 and '123.0' = 123 for the server: no numeric pushdown on VARCHAR (61 rows read)
--let $tail= WHERE tagv = 123
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE tagv = 0
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE tagv = 100
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE tagv = 12
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE tagv IN (5, 123)
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE tagv = 123.0
--source suite/moosedb/include/mirror_cmp.inc
--echo # String constant: string comparison, pushed
--let $tail= WHERE tagv = '123'
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE tagv = '0123'
--source suite/moosedb/include/mirror_cmp.inc
DROP TABLE vt, vi;

--echo ##################################################################
--echo # ZEROFILL integer TAG: stored text is padded, never pushed (all rows read) but answers stay right
--echo ##################################################################
--let $mt= zm
--let $it= zi
--let $sel= COUNT(*), SUM(v), BIT_XOR(CRC32(CONCAT(zf, '|', v)))
CREATE TABLE zm (ts DATETIME NOT NULL, zf INT(6) UNSIGNED ZEROFILL NOT NULL COMMENT 'TAG', v INT NOT NULL, INDEX(ts))
  ENGINE=MooseDB;
CREATE TABLE zi (ts DATETIME NOT NULL, zf INT(6) UNSIGNED ZEROFILL NOT NULL, v INT NOT NULL, KEY(ts))
  ENGINE=InnoDB;
--let $row= SELECT '2026-03-04 00:00:00' + INTERVAL seq SECOND, ELT(1 + seq MOD 4, 0, 7, 123, 4294967295), seq FROM seq_0_to_11
eval INSERT INTO zm $row;
eval INSERT INTO zi $row;
SELECT zf, COUNT(*) FROM zm GROUP BY zf ORDER BY zf;
--let $tail= WHERE zf = 123
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE zf = '000123'
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE zf IN (7, 123)
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE zf = 4294967295
--source suite/moosedb/include/mirror_cmp.inc
DROP TABLE zm, zi;

--echo ##################################################################
--echo # Large IN list (3000 values) on 2000 series
--echo ##################################################################
SET @thr_save= @@in_predicate_conversion_threshold;
SET in_predicate_conversion_threshold= 0;
--let $mt= bm
--let $it= bi
--let $sel= COUNT(*), SUM(v), BIT_XOR(CRC32(CONCAT(itemid, '|', v)))
CREATE TABLE bm (ts DATETIME NOT NULL, itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG', v INT NOT NULL, INDEX(ts))
  ENGINE=MooseDB;
CREATE TABLE bi (ts DATETIME NOT NULL, itemid BIGINT UNSIGNED NOT NULL, v INT NOT NULL, KEY(ts))
  ENGINE=InnoDB;
INSERT INTO bm SELECT '2026-03-05 00:00:00' + INTERVAL seq SECOND, seq DIV 2 * 3 + 1, seq FROM seq_0_to_3999;
INSERT INTO bi SELECT * FROM bm;
SELECT COUNT(*), COUNT(DISTINCT itemid) FROM bm;
SELECT GROUP_CONCAT(seq) INTO @list FROM seq_1_to_3000;
SET @in= CONCAT('WHERE itemid IN (', @list, ')');
--disable_query_log
--disable_warnings
SET @q1= CONCAT('SELECT COUNT(*), SUM(v), BIT_XOR(CRC32(CONCAT(itemid, ''|'', v))) INTO @a1, @b1, @c1 FROM bm AS tt ', @in);
SET @q2= CONCAT('SELECT COUNT(*), SUM(v), BIT_XOR(CRC32(CONCAT(itemid, ''|'', v))) INTO @a2, @b2, @c2 FROM bi AS tt ', @in);
PREPARE s1 FROM @q1;
PREPARE s2 FROM @q2;
FLUSH STATUS;
EXECUTE s1;
SHOW SESSION STATUS LIKE 'Handler_read_rnd_next';
EXECUTE s2;
--enable_warnings
--enable_query_log
SELECT @a1 AS a, @b1 AS b, IF(@a1 <=> @a2 AND @b1 <=> @b2 AND @c1 <=> @c2, 'SAME', 'DIFFERENT') AS vs_innodb;
--echo # Same list with some strings and fractions mixed in
--disable_query_log
--disable_warnings
SET @in= CONCAT('WHERE itemid IN (', @list, ', ''4000'', 4003.0, 4006.5, -1)');
SET @q1= CONCAT('SELECT COUNT(*), SUM(v), BIT_XOR(CRC32(CONCAT(itemid, ''|'', v))) INTO @a1, @b1, @c1 FROM bm AS tt ', @in);
SET @q2= CONCAT('SELECT COUNT(*), SUM(v), BIT_XOR(CRC32(CONCAT(itemid, ''|'', v))) INTO @a2, @b2, @c2 FROM bi AS tt ', @in);
DEALLOCATE PREPARE s1;
DEALLOCATE PREPARE s2;
PREPARE s1 FROM @q1;
PREPARE s2 FROM @q2;
FLUSH STATUS;
EXECUTE s1;
SHOW SESSION STATUS LIKE 'Handler_read_rnd_next';
EXECUTE s2;
DEALLOCATE PREPARE s1;
DEALLOCATE PREPARE s2;
--enable_warnings
--enable_query_log
SELECT @a1 AS a, @b1 AS b, IF(@a1 <=> @a2 AND @b1 <=> @b2 AND @c1 <=> @c2, 'SAME', 'DIFFERENT') AS vs_innodb;
SET in_predicate_conversion_threshold= @thr_save;
DROP TABLE bm, bi;

--echo ##################################################################
--echo # More distinct (column, collation) indexes than the TAG cache holds (32):
--echo # the 33rd column falls back to the direct comparison; answers must agree
--echo ##################################################################
--let $cols= c1 TINYINT NOT NULL COMMENT 'TAG'
--let $icols= c1 TINYINT NOT NULL
--let $exprs= CAST((seq * 1 + 1) MOD 7 AS SIGNED) - 3
--let $k= 2
while ($k <= 33)
{
  --let $cols= $cols, c$k TINYINT NOT NULL COMMENT 'TAG'
  --let $icols= $icols, c$k TINYINT NOT NULL
  --let $exprs= $exprs, CAST((seq * $k + $k) MOD 7 AS SIGNED) - 3
  inc $k;
}
--echo # (DDL and INSERT of the 33-column tables not echoed)
--disable_query_log
eval CREATE TABLE wm (ts DATETIME NOT NULL, $cols, v INT NOT NULL, INDEX(ts)) ENGINE=MooseDB;
eval CREATE TABLE wi (ts DATETIME NOT NULL, $icols, v INT NOT NULL, KEY(ts)) ENGINE=InnoDB;
eval INSERT INTO wm SELECT '2026-03-06 00:00:00' + INTERVAL seq SECOND, $exprs, seq FROM seq_0_to_139;
INSERT INTO wi SELECT * FROM wm;
--enable_query_log
CREATE TABLE verdicts (tag VARCHAR(100), same INT);
--let $mt= wm
--let $it= wi
--let $sel= COUNT(*), SUM(v), BIT_XOR(CRC32(v))
--let $quiet= 1
--let $show_status= 0
--let $k= 1
while ($k <= 33)
{
  --let $tail= WHERE c$k = 0 AND v > 3
  --source suite/moosedb/include/mirror_cmp.inc
  --let $tail= WHERE c$k IN (-3, 3, 9)
  --source suite/moosedb/include/mirror_cmp.inc
  inc $k;
}
--let $quiet= 0
SELECT COUNT(*) AS queries, SUM(same) AS identical_to_innodb FROM verdicts;
--echo # Column 1 (cached) and column 33 (direct comparison) prune the same way (20 rows -> 21)
--let $show_status= 1
--let $tail= WHERE c1 = 0
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE c33 = 0
--source suite/moosedb/include/mirror_cmp.inc
DROP TABLE wm, wi, verdicts;
