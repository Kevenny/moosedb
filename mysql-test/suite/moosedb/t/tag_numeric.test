#
# Pushdown of predicates on INTEGER TAG columns (TINYINT..BIGINT, signed and
# unsigned) with numeric and numeric-looking constants, as sent by the Zabbix
# server (itemid = 123, itemid IN (1,2,3), no quotes).
#
# Every query runs on the MooseDB table and on an InnoDB mirror holding the
# same rows; "SAME" means identical row count, sum and row checksum. The
# Handler_read_rnd_next line shows how many rows the engine handed to the
# server: just the matching series (+1 for the end of the scan) when the
# predicate was pushed, every row (+1) when it was not pushed.
#
# The mirror has no index on the tag columns: an index range would round the
# constant (itemid = 123.5 -> 124) while the table scan the engine is compared
# with evaluates the predicate exactly; both are legitimate server behaviour.
#
--source include/have_innodb.inc
--source include/have_sequence.inc
--source suite/moosedb/include/have_moosedb.inc

--let $quiet= 0
--let $show_status= 1
--let $mt= m
--let $it= i
--let $sel= COUNT(*), SUM(v), BIT_XOR(CRC32(CONCAT(itemid, '|', v)))

CREATE TABLE m (ts DATETIME NOT NULL, itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG',
                v INT NOT NULL, INDEX(ts)) ENGINE=MooseDB;
CREATE TABLE i (ts DATETIME NOT NULL, itemid BIGINT UNSIGNED NOT NULL,
                v INT NOT NULL, KEY(ts)) ENGINE=InnoDB;
# join partner for the multiple-equality (Item_equal) cases
CREATE TABLE x (id BIGINT UNSIGNED NOT NULL, KEY(id)) ENGINE=InnoDB;
INSERT INTO x VALUES (123), (124), (1), (3), (18446744073709551615), (5);

--echo # 16 series around the interesting boundaries, 5 rows each; half sealed, half in the MemTable
--let $ids= ELT(1 + seq MOD 16, '0', '1', '2', '3', '10', '123', '124', '1000', '4294967296', '9007199254740991', '9007199254740992', '9007199254740993', '9223372036854775807', '9223372036854775808', '18446744073709551614', '18446744073709551615')
eval INSERT INTO m SELECT '2026-03-01 00:00:00' + INTERVAL seq SECOND, $ids, seq FROM seq_0_to_39;
eval INSERT INTO i SELECT '2026-03-01 00:00:00' + INTERVAL seq SECOND, $ids, seq FROM seq_0_to_39;
FLUSH TABLES m;
eval INSERT INTO m SELECT '2026-03-01 00:00:00' + INTERVAL seq SECOND, $ids, seq FROM seq_40_to_79;
eval INSERT INTO i SELECT '2026-03-01 00:00:00' + INTERVAL seq SECOND, $ids, seq FROM seq_40_to_79;
SELECT COUNT(*), COUNT(DISTINCT itemid), MAX(itemid) FROM m;
SELECT COUNT(*), COUNT(DISTINCT itemid), MAX(itemid) FROM i;

