--let $tail= WHERE itemid = v AND v = 1
--source suite/moosedb/include/mirror_cmp.inc
--echo # Join without a constant: nothing to push (81)
--let $tail= JOIN x ON tt.itemid = x.id
--source suite/moosedb/include/mirror_cmp.inc

--echo ##################################################################
--echo # Mixed-type IN lists: the server may compare the whole list as DOUBLE,
--echo # where 2^53 and 2^53+1 are equal -> a constant >= 2^53 next to a DOUBLE or
--echo # string constant is never pushed (81); INT/DECIMAL-only lists are exact
--echo ##################################################################
--let $tail= WHERE itemid IN (9007199254740993, 1e0)
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE itemid IN (9007199254740992, '1')
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE itemid IN (9007199254740992, 1.5e0)
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE itemid IN (9007199254740993, '1')
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE itemid IN (9007199254740993, NULL, 1e0)
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE itemid IN (18446744073709551615, 1e0)
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE itemid IN (18446744073709551616, 1e0)
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE itemid IN (18446744073709551616.5, 1e0)
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE itemid IN (-9007199254740993, 'x')
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE itemid IN (9007199254740993, 3, '2', 1.0e1)
--source suite/moosedb/include/mirror_cmp.inc
--echo # Small constants of mixed types are still pushed
--let $tail= WHERE itemid IN (3, 1e0, '2', 10.0)
--source suite/moosedb/include/mirror_cmp.inc
--echo # INT/DECIMAL only: exact, pushed
--let $tail= WHERE itemid IN (9007199254740993, 9007199254740992)
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE itemid IN (9007199254740993, 5.0)
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE itemid IN (18446744073709551616, 9007199254740993.0)
--source suite/moosedb/include/mirror_cmp.inc

--echo ##################################################################
--echo # Multiple equalities across column types (joined column DOUBLE, DECIMAL,
--echo # VARCHAR: not pushed, 81; integer columns of any width/sign: pushed)
--echo ##################################################################
CREATE TABLE xd (d DOUBLE NOT NULL, dec20 DECIMAL(20,0) NOT NULL, vc VARCHAR(30) NOT NULL,
                 ti TINYINT NOT NULL, ub BIGINT UNSIGNED NOT NULL) ENGINE=InnoDB;
INSERT INTO xd VALUES (9007199254740992, 9007199254740993, '9007199254740993', 3, 9007199254740993),
                      (3, 3, '3', 1, 18446744073709551615),
                      (1, 1, '1', 2, 0);
--let $tail= JOIN xd ON tt.itemid = xd.d WHERE xd.d = 9007199254740993
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= JOIN xd ON tt.itemid = xd.d WHERE xd.d = 9007199254740992
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= JOIN xd ON tt.itemid = xd.d WHERE xd.d = 3
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= JOIN xd ON tt.itemid = xd.dec20 WHERE xd.dec20 = 9007199254740993
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= JOIN xd ON tt.itemid = xd.vc WHERE xd.vc = '9007199254740993'
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= JOIN xd ON tt.itemid = xd.vc WHERE xd.vc = '3'
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= JOIN xd ON tt.itemid = xd.ti WHERE xd.ti = 3
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= JOIN xd ON tt.itemid = xd.ub WHERE xd.ub = 9007199254740993
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= JOIN xd ON tt.itemid = xd.ub WHERE xd.ub = 18446744073709551615
--source suite/moosedb/include/mirror_cmp.inc
DROP TABLE xd;

--echo ##################################################################
--echo # Prepared statements (parameters are constants too)
--echo ##################################################################
PREPARE ps FROM 'SELECT COUNT(*), SUM(v) FROM m WHERE itemid = ?';
PREPARE psi FROM 'SELECT COUNT(*), SUM(v) FROM i WHERE itemid = ?';
SET @p= 123;
FLUSH STATUS;
EXECUTE ps USING @p;
SHOW SESSION STATUS LIKE 'Handler_read_rnd_next';
EXECUTE psi USING @p;
SET @p= '123';
FLUSH STATUS;
EXECUTE ps USING @p;
SHOW SESSION STATUS LIKE 'Handler_read_rnd_next';
EXECUTE psi USING @p;
SET @p= '0123';
EXECUTE ps USING @p;
EXECUTE psi USING @p;
SET @p= 123.5;
EXECUTE ps USING @p;
EXECUTE psi USING @p;
DEALLOCATE PREPARE ps;
DEALLOCATE PREPARE psi;

--echo ##################################################################
--echo # TAG cache: new series appended after the cache was built, TRUNCATE
--echo ##################################################################
--let $show_status= 0
--let $tail= WHERE itemid IN (777, 123)
--source suite/moosedb/include/mirror_cmp.inc
INSERT INTO m VALUES ('2026-04-01', 777, 1000), ('2026-04-01', 123, 1001);
INSERT INTO i VALUES ('2026-04-01', 777, 1000), ('2026-04-01', 123, 1001);
--source suite/moosedb/include/mirror_cmp.inc
TRUNCATE TABLE m;
TRUNCATE TABLE i;
--source suite/moosedb/include/mirror_cmp.inc
INSERT INTO m VALUES ('2026-04-02', 123, 5), ('2026-04-02', 124, 6);
INSERT INTO i VALUES ('2026-04-02', 123, 5), ('2026-04-02', 124, 6);
--source suite/moosedb/include/mirror_cmp.inc
--let $show_status= 1

DROP TABLE m, i, x;

--echo ##################################################################
--echo # Several TAG columns of different integer types, a VARCHAR TAG and a nullable TAG
--echo ##################################################################
--let $mt= mx
--let $it= ix
--let $sel= COUNT(*), SUM(v), BIT_XOR(CRC32(CONCAT_WS('|', itemid, host, tiny, usmall, med, uint, sint, IFNULL(nul, 'N'), v)))
CREATE TABLE mx (ts DATETIME NOT NULL,
  itemid BIGINT UNSIGNED NOT NULL COMMENT 'TAG',
  host   VARCHAR(8) NOT NULL COMMENT 'TAG',
  tiny   TINYINT NOT NULL COMMENT 'TAG',
  usmall SMALLINT UNSIGNED NOT NULL COMMENT 'TAG',
  med    MEDIUMINT NOT NULL COMMENT 'TAG',
  uint   INT UNSIGNED NOT NULL COMMENT 'TAG',
  sint   INT NOT NULL COMMENT 'TAG',
  nul    BIGINT COMMENT 'TAG',
  v INT NOT NULL, INDEX(ts)) ENGINE=MooseDB;
CREATE TABLE ix (ts DATETIME NOT NULL, itemid BIGINT UNSIGNED NOT NULL, host VARCHAR(8) NOT NULL,
  tiny TINYINT NOT NULL, usmall SMALLINT UNSIGNED NOT NULL, med MEDIUMINT NOT NULL,
  uint INT UNSIGNED NOT NULL, sint INT NOT NULL, nul BIGINT, v INT NOT NULL, KEY(ts)) ENGINE=InnoDB;
--let $row= SELECT '2026-03-02 00:00:00' + INTERVAL seq SECOND, ELT(1 + seq MOD 6, '0', '1', '18446744073709551615', '123', '9007199254740993', '5'), CONCAT('h', seq MOD 4), ELT(1 + seq MOD 3, -128, 0, 127), ELT(1 + (seq DIV 3) MOD 2, 0, 65535), ELT(1 + (seq DIV 6) MOD 2, -8388608, 8388607), ELT(1 + (seq DIV 12) MOD 2, 0, 4294967295), ELT(1 + (seq DIV 24) MOD 2, -2147483648, 2147483647), IF(seq MOD 2, NULL, 7), seq FROM seq_0_to_239
eval INSERT INTO mx $row;
eval INSERT INTO ix $row;
SELECT COUNT(*), COUNT(DISTINCT itemid, host, tiny, usmall, med, uint, sint, nul) FROM mx;

