--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE uint = 4.2949672955e9
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE sint = -2147483648.0
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE sint = -2147483648.1
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE tiny = 1e308
--source suite/moosedb/include/mirror_cmp.inc

--echo # Nullable integer TAG
--let $tail= WHERE nul = 7
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE nul IS NULL
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE nul = NULL
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE nul IN (7, NULL)
--source suite/moosedb/include/mirror_cmp.inc
--let $tail= WHERE nul = 8
